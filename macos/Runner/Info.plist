<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- whispaste:// hands the user back from a web page, e.g. the newsletter
	     confirmation (lib/services/app_link.dart). Same scheme on every
	     channel: test/parity/url_scheme_registration_parity_test.dart. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>de.whispaste.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>whispaste</string>
			</array>
		</dict>
	</array>
	<!-- "Open With" > WhisPaste for the audio types file transcription reads
	     (#1684; audioImportExtensions in
	     lib/services/audio/import/audio_file_decoder.dart, guard:
	     test/parity/open_with_parity_test.dart). Viewer with rank Alternate
	     on public.audio only: QuickTime and Music claim most audio through
	     public.audio as well, so their rank Default always wins. A claim on a
	     concrete type (org.xiph.flac, extensions) would make WhisPaste the
	     double-click app for FLAC/Ogg/Opus (measured on macOS 27). Audio types
	     WhisPaste cannot read get the import refusal line. Finder hands the
	     files to application(_:open:) in AppDelegate.swift, sandbox access
	     included. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Audio</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.audio</string>
			</array>
		</dict>
	</array>
	<!-- Ogg/Opus has no system type on every macOS release; declared here so
	     .ogg and .opus files conform to public.audio and match the document
	     type above. A type the
	     system or another app declares takes precedence. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.xiph.ogg-audio</string>
			<key>UTTypeDescription</key>
			<string>Ogg Audio</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.audio</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>ogg</string>
					<string>opus</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>de</string>
		<string>es</string>
		<string>he</string>
		<string>pt</string>
		<string>ru</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>WhisPaste needs microphone access for speech-to-text dictation.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>WhisPaste may use this to paste your dictated text into other apps when the primary method is unavailable.</string>
	<!-- Sparkle self-update (PRD Säule E). EdDSA public key matches the private
	     key that signs appcast.xml in CI (secret SPARKLE_SIGNING_KEY). The feed
	     URL below is the stable default for the first launch check; the Dart
	     side sets the same feed at runtime via setFeedURL(appcastFeedUrl())
	     from lib/services/auto_updater_service.dart. -->
	<key>SUPublicEDKey</key>
	<string>Ek8FS/co3CPMeZt7ss9XMDkga7jIG6RWNWbefZhtRck=</string>
	<key>SUFeedURL</key>
	<string>https://github.com/whispaste/whispaste/releases/latest/download/appcast.xml</string>
	<!-- Sparkle never schedules checks or asks for permission on its own: the
	     Dart side runs the automatic checks (start + every 24 h) only while
	     Settings → Updates → "Check for Updates" is on
	     (lib/services/auto_updater_service.dart). -->
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<!-- Export compliance: WhisPaste only ever talks HTTPS/TLS via the OS-provided
	     networking stack (Sentry, Supabase, OpenAI, Deepgram, Sparkle appcast,
	     GitHub) — no proprietary or custom cryptography. That's exempt encryption,
	     so this is `false` ("does NOT use non-exempt encryption"). Without this
	     key, every single upload shows as "Missing Compliance" in App Store
	     Connect and needs a manual per-build answer; with it, Xcode/ASC can
	     auto-determine compliance from the binary. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Render with Skia, not Impeller (#445). Impeller stages glyph uploads in a
	     host buffer that it reuses after four frames without waiting for the GPU
	     (impeller/core/host_buffer.cc). A GPU job of about 60 ms, such as a
	     whisper.cpp run on Metal, delays the upload past that reuse, so the glyph
	     atlas keeps other data for good: broken text and icons until restart.
	     The key is read per process, so it covers every engine. Criterion for
	     lifting it: BUILD.md, "Renderer". -->
	<key>FLTEnableImpeller</key>
	<false/>
</dict>
</plist>
