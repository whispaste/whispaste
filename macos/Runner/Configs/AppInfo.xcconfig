// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = WhisPaste

// The application's bundle identifier: the Developer-ID (DMG/Homebrew) identity. The Mac App Store build overrides it
// with de.whispaste.app in its own MAS configuration: macOS binds privacy
// grants to bundle ID + signature, and a shared ID left a stale, unremovable
// entry behind whenever a user switched between the two.
PRODUCT_BUNDLE_IDENTIFIER = de.whispaste.direct

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 com.whispaste. All rights reserved.
