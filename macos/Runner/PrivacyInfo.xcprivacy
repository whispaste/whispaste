<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App-level Privacy Manifest for WhisPaste (macOS).

  Required since 2024-05-01: apps using "Required Reason APIs" must declare them,
  or App Store Connect rejects the upload. This file covers the app's own code and
  first-party Flutter usage; bundled plugins/SDKs (record, flutter_secure_storage,
  path_provider, package_info_plus, sentry, …) ship their own PrivacyInfo.xcprivacy.

  ⚠️ Must be added to the Runner target in Xcode (Build Phases → Copy Bundle
  Resources) so it lands in the .app bundle — see docs/store-release.md.

  The reason codes below are the conservative defaults for a Flutter desktop app;
  verify against the plugins actually compiled in before the first submission.

  libwhisper (whisper.cpp v1.8.4, Metal+CPU) — verified 2026-07-15 for Issue 11:
  it is the first natively-embedded third-party library in the binary, so its
  Required Reason API surface was audited against .build/deps/whisper.cpp/v1.8.4
  (the sources actually compiled on macOS: ggml.c, ggml-cpu/ggml-cpu.cpp,
  ggml-metal/ggml-metal-device.m; the virtgpu/openvino/hexagon/sycl/kleidiai/arm
  backends are NOT compiled here). Findings:
    - clock_gettime(CLOCK_MONOTONIC) — ggml.c:538,544 (perf timing). Covered by
      the already-declared SystemBootTime (35F9.1).
    - sysctlbyname("machdep.cpu.brand_string") — ggml-cpu.cpp:293-295, and Metal
      device props (hasUnifiedMemory, recommendedMaxWorkingSetSize) — these are
      NOT Required Reason APIs (hardware capability, not privacy-restricted).
    - Model loading uses plain fopen/fread — no mmap, no stat/st_mtime, no
      statvfs, no NSUserDefaults. So libwhisper adds NO new Required Reason API
      category; the FileTimestamp/DiskSpace/UserDefaults codes below remain
      justified only by the app's own first-party usage, not by libwhisper.
  => No reason code added or removed on account of libwhisper.
-->
<plist version="1.0">
<dict>
  <key>NSPrivacyTracking</key>
  <false/>
  <key>NSPrivacyTrackingDomains</key>
  <array/>
  <key>NSPrivacyCollectedDataTypes</key>
  <array>
    <dict>
      <!-- Crash diagnostics via Sentry (de.sentry.io), not linked to identity,
           not used for tracking, app-functionality purpose only. -->
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeCrashData</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <dict>
      <!-- Opt-in only: sent exclusively when the user configures their own
           OpenAI or Deepgram API key under Settings → Cloud Providers
           (OpenAiTranscriber/DeepgramTranscriber post the recorded WAV
           bytes to api.openai.com / api.deepgram.com for transcription).
           On-device Whisper/Parakeet transcription — the default — never
           sends audio anywhere. Not linked to a WhisPaste user identity
           (no account system); not used for tracking. Matches the App Store
           Connect privacy nutrition label already published for this app
           (see docs/store-release.md). -->
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeAudioData</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
  </array>
  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>CA92.1</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>C617.1</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>E174.1</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>35F9.1</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
