# Fastlane lanes for WhisPaste macOS distribution.
#
# Two distribution tracks from ONE codebase (see lib/core/config/build_config.dart):
#   - mas_release    → Mac App Store (sandboxed, NO auto-paste)
#   - devid_release  → Developer-ID notarized .app/.dmg (full auto-paste)
#
# Authentication reuses an existing shared App Store Connect API key already
# provisioned for another of the maintainer's projects — values loaded from
# a local, never-committed credentials file (load_credentials.rb below), not
# hardcoded here. This repo is public; account-identifying values (Apple ID,
# Team ID, API key IDs) must never be committed — see
# ~/.claude/infrastructure/microsoft-partner-center.md for the convention
# this project follows for every external credential.
#
# ── PREREQUISITES (see docs/store-release.md) ─────────────────────────────────
#   1. Bundle-ID migrated to de.whispaste.app.
#   2. Xcode build configurations wired:
#        - MAS build: CODE_SIGN_ENTITLEMENTS = Runner/AppStore.entitlements
#          (sandbox=true) + OTHER_SWIFT_FLAGS includes "-D MAS_BUILD".
#        - Developer-ID build: CODE_SIGN_ENTITLEMENTS = Runner/Release.entitlements
#          (sandbox=false) + Hardened Runtime ON.
#   3. Certificates present in keychain (Mac App Distribution + Mac Installer
#      Distribution for MAS; Developer ID Application + Installer for direct).
#   4. ~/.config/whispaste-ios-credentials/fastlane.env populated (see
#      load_credentials.rb) — FASTLANE_APPLE_ID, FASTLANE_TEAM_ID, ASC_KEY_ID,
#      ASC_ISSUER_ID.

require_relative 'load_credentials'

ASC_KEY_ID    = ENV.fetch("ASC_KEY_ID")
ASC_ISSUER_ID = ENV.fetch("ASC_ISSUER_ID")
ASC_KEY_PATH  = File.expand_path(ENV.fetch("ASC_KEY_PATH", "~/.appstoreconnect/private_keys/AuthKey_#{ASC_KEY_ID}.p8"))
FASTLANE_TEAM_ID = ENV.fetch("FASTLANE_TEAM_ID")

# Absolute path to the repo root (the directory CONTAINING `fastlane/`).
#
# Two fastlane path conventions collide in this file and must not be mixed as
# bare relative strings: `sh()` subprocesses run relative to `fastlane/`
# itself, while native actions (`build_mac_app`/gym, etc.) resolve their own
# relative path options against the directory the `fastlane` command was
# invoked FROM — which is not necessarily `fastlane/`'s parent either (it can
# differ depending on how the process was launched). A `"../macos/..."` value
# written for one convention silently resolves one directory level too far
# under the other, and the error only shows up as a missing-file failure deep
# into the lane. Using this absolute constant everywhere removes the
# ambiguity entirely — verified against `whispaste@cd8720d8`'s
# `mac devid_release` run, which failed with exactly this symptom.
PROJECT_ROOT = File.expand_path("..", __dir__)

def load_asc_api_key
  app_store_connect_api_key(
    key_id:        ASC_KEY_ID,
    issuer_id:     ASC_ISSUER_ID,
    key_filepath:  ASC_KEY_PATH,
    in_house:      false,
    duration:      1200
  )
end

default_platform(:mac)

platform :mac do
  desc "Verify App Store Connect API access"
  lane :validate do
    load_asc_api_key
    UI.success("App Store Connect API key OK (Team #{FASTLANE_TEAM_ID})")
  end

  desc "Push fastlane/metadata (name/subtitle/keywords/description/…) without rebuilding or re-uploading the binary"
  lane :mac_metadata_only do
    load_asc_api_key
    upload_to_app_store(
      platform:                 "osx",
      skip_binary_upload:       true,
      skip_screenshots:         true,
      skip_app_version_update:  true,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end

  desc "Build + upload the Mac App Store build (sandboxed, no auto-paste)"
  lane :mas_release do
    load_asc_api_key
    # precheck (metadata hygiene against App Review Guidelines) is skipped here:
    # fastlane 2.237.0's precheck crashes with `undefined method 'copyright' for
    # nil:NilClass` (Precheck::RuleProcessor.generate_version_items_to_check)
    # against a brand-new App Store Connect app record that has no app version/
    # metadata yet at all — nothing for it to check. Re-add once real metadata
    # exists in fastlane/metadata (see the upload_to_app_store skip_metadata note
    # below) and this has been confirmed fixed upstream.

    # This first build only populates Flutter's ephemeral DART_DEFINES state
    # (kIsMasBuild) for the "Flutter Assemble" step that build_mac_app's own
    # xcodebuild invocation runs internally — its own .app output (built
    # against the "Release" Xcode configuration) is NOT the MAS artifact and
    # is discarded. The real MAS build happens below via `configuration:
    # "MAS"`, the project's separate Xcode configuration carrying
    # `-D MAS_BUILD` (the Swift compile-time guard) and AppStore.entitlements
    # (the sandbox). Passing `--dart-define=WHISPASTE_MAS=true` alone, or
    # building against the "Release" configuration, does NOT make the binary
    # sandbox-clean — confirmed by a real symbol scan (CGEventPost/
    # CGEventCreateKeyboardEvent/tccutil present) before this fix.
    # RBENV_VERSION=system: this lane itself runs under a pinned rbenv Ruby
    # (needed for the Gemfile.lock-pinned Bundler version 4.0.11). `bundle exec`
    # sets RUBYOPT="-r bundler/setup", which restricts every Ruby script this
    # subprocess tree spawns to EXACTLY the gems in fastlane's Gemfile.lock —
    # including `pod` (a Ruby gem executable itself), which Flutter's internal
    # `pod install` invokes. CocoaPods isn't in that Gemfile.lock, so bundler's
    # isolation makes it invisible ("CocoaPods is installed but broken") even
    # though it's genuinely installed for the system Ruby. Root-caused via
    # RBENV_VERSION=4.0.2 rbenv exec bundle exec ruby -e 'p ENV["RUBYOPT"]' —
    # unsetting only RBENV_VERSION (an earlier, incomplete fix) does not clear
    # this Bundler-set isolation, so it's unset explicitly here too.
    Dir.chdir(PROJECT_ROOT) do
      # RBENV_VERSION=system is set (not just RBENV_VERSION unset) belt-and-
      # braces: unsetting alone worked across several runs, then intermittently
      # stopped shielding a `pod install` triggered by an Xcode-project change.
      # Root-caused (was "still unexplained" in docs/store-release.md): this
      # whole lane runs under `RBENV_VERSION=4.0.2 rbenv exec bundle exec
      # fastlane ...` — `rbenv exec` doesn't just export RBENV_VERSION, it
      # also PREPENDS that version's own bin dirs
      # (~/.rbenv/versions/4.0.2/{bin,lib/ruby/gems/4.0.0/bin}) directly onto
      # PATH, ahead of ~/.rbenv/shims. Setting RBENV_VERSION=system for this
      # child process doesn't undo that PATH damage — shims are never
      # consulted at all, so `which pod` still resolves to
      # ~/.rbenv/versions/4.0.2/bin/pod (a Bundler-wrapped stub requiring
      # `cocoapods` in fastlane's Gemfile.lock, which it deliberately isn't)
      # instead of falling through to the real Homebrew-installed pod.
      # Root-caused via `RBENV_VERSION=4.0.2 rbenv exec bundle exec ruby -e
      # 'puts ENV["PATH"]'`. Explicitly prepending the known-good locations
      # fixes it deterministically, no more flakiness.
      #
      # BUNDLER_SETUP (distinct from RUBYOPT!) is a second, independent leak:
      # RubyGems' own bootstrap (rubygems.rb) does
      # `require ENV["BUNDLER_SETUP"] if ENV["BUNDLER_SETUP"] && !defined?(Bundler)`
      # unconditionally, regardless of RUBYOPT — `bundle exec` sets this var
      # too, and unsetting only RUBYOPT/GEM_HOME/etc. still leaves the real
      # Homebrew `pod` binary auto-requiring the *outer* fastlane Gemfile's
      # bundler/setup and failing with "Could not find fastlane-2.237.0 ...
      # in locally installed gems". Must be unset explicitly alongside
      # RUBYOPT, not implied by it.
      sh("env -u BUNDLE_GEMFILE -u GEM_HOME -u GEM_PATH -u GEM_ROOT -u RUBYOPT -u RUBYLIB " \
         "-u BUNDLE_BIN_PATH -u BUNDLE_PATH -u BUNDLER_VERSION -u BUNDLER_SETUP -u RBENV_DIR " \
         "RBENV_VERSION=system " \
         "PATH=\"/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH\" " \
         "flutter build macos --release --dart-define=WHISPASTE_MAS=true")
    end

    build_mac_app(
      workspace:        File.join(PROJECT_ROOT, "macos/Runner.xcworkspace"),
      scheme:           "Runner",                # must be marked "Shared" in Xcode
      configuration:    "MAS",
      export_method:    "app-store",             # produces a signed .pkg
      export_team_id:   FASTLANE_TEAM_ID,
      output_directory: File.join(PROJECT_ROOT, "build/fastlane"),
      output_name:      "WhisPaste",
      # Without an explicit signingStyle, xcodebuild's -exportArchive step
      # defaults to MANUAL signing during export (regardless of the Xcode
      # project's own CODE_SIGN_STYLE = Automatic) and fails with "No
      # profiles for 'de.whispaste.app' were found". signingStyle:
      # "automatic" alone did NOT fix it either — headless xcodebuild (no
      # Xcode GUI account session) can't dynamically resolve automatic
      # signing during export the way Xcode's own UI can. Mapping the
      # profile explicitly (created via `fastlane sigh --platform macos`,
      # name below must match exactly) sidesteps automatic resolution
      # entirely and is what actually works non-interactively.
      export_options: {
        signingStyle:        "manual",
        provisioningProfiles: { "de.whispaste.app" => "de.whispaste.app AppStore" }
      }
    )

    upload_to_app_store(
      platform:          "osx",
      pkg:               lane_context[SharedValues::PKG_OUTPUT_PATH],
      submit_for_review: false,
      skip_screenshots:  false,     # fastlane/screenshots/{en-US,de-DE} populated 2026-07-28 (1440x900, from tools/appstore-screens/output/*/mac)
      skip_metadata:     false,     # fastlane/metadata/{en-US,de-DE} populated 2026-07-28
      precheck_include_in_app_purchases: false,
      # Required so deliver actually creates an app_store_review_detail
      # object on ASC. Without it, review_information() (deliver's own
      # code) no-ops on a nil/empty app_review_information hash, then the
      # very next internal step, review_attachment_file(), unconditionally
      # calls fetch_app_store_review_detail with no rescue (unlike its
      # neighbor) and crashes with "No data" since nothing was ever created.
      # `notes:` is read explicitly here (not left to deliver's own
      # metadata-folder auto-merge) for the same reason the rest of this
      # hash is explicit: this whole block exists because deliver's
      # merge-from-nil-hash path already crashed once (see comment above).
      # fastlane/metadata/review_information/notes.txt explains the
      # PostEvent/Accessibility permission (Guideline 2.4.5) to the
      # reviewer — see docs/store-release.md for the full rationale.
      app_review_information: {
        first_name:    ENV.fetch("FASTLANE_REVIEW_FIRST_NAME"),
        last_name:     ENV.fetch("FASTLANE_REVIEW_LAST_NAME"),
        phone_number:  ENV.fetch("FASTLANE_REVIEW_PHONE"),
        email_address: ENV.fetch("FASTLANE_APPLE_ID"),
        notes:         File.read(File.join(PROJECT_ROOT, "fastlane/metadata/review_information/notes.txt"))
      },
      # Without force: true, deliver generates fastlane/Preview.html and
      # interactively asks "Does the Preview ... look okay for you?" — this
      # lane runs non-interactively (CI or a backgrounded local run), which
      # crashes with FastlaneCore::Interface::FastlaneCrash instead of
      # hanging. submit_for_review stays false regardless, so this only
      # skips the metadata/screenshot preview confirmation, not the actual
      # Store submission gate.
      force: true
    )
  end

  desc "Build + notarize the Developer-ID build (direct download / Homebrew)"
  lane :devid_release do
    # Developer-ID auto-paste build — full feature set, distributed outside MAS.
    #
    # Prerequisites (see docs/store-release.md):
    #   - Developer ID Application certificate in keychain
    #   - ASC API key at ASC_KEY_PATH (see load_credentials.rb / fastlane.env)
    #   - create-dmg installed: brew install create-dmg
    #
    # Skip path: set SKIP_NOTARIZATION=1 to build+sign without notarizing/stapling
    # (useful for quick local smoke tests without internet access).

    api_key = load_asc_api_key

    # See the detailed comment on the equivalent line in mas_release: bundle
    # exec's RUBYOPT="-r bundler/setup" breaks Flutter's internal `pod install`
    # by hiding CocoaPods from this subprocess tree unless explicitly cleared,
    # and `rbenv exec`'s own PATH prepending (not just RBENV_VERSION) means
    # unsetting/resetting RBENV_VERSION alone isn't enough either — the PATH
    # override below is required too.
    Dir.chdir(PROJECT_ROOT) do
      sh("env -u BUNDLE_GEMFILE -u GEM_HOME -u GEM_PATH -u GEM_ROOT -u RUBYOPT -u RUBYLIB " \
         "-u BUNDLE_BIN_PATH -u BUNDLE_PATH -u BUNDLER_VERSION -u BUNDLER_SETUP -u RBENV_DIR " \
         "RBENV_VERSION=system " \
         "PATH=\"/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH\" " \
         "flutter build macos --release")
    end

    # build_mac_app (gym/build_app) only populates lane_context's shared
    # values for a .ipa or .pkg output (see build_app.rb's extname check) —
    # for a plain .app export (developer-id method), NEITHER branch matches,
    # so no SharedValues key is ever set. `SharedValues::APP_PATH` referenced
    # here previously doesn't exist at all in fastlane 2.237.0 (verified via
    # `uninitialized constant` NameError on a real run) — the action's own
    # return value is the only source of the exported .app path.
    app_path = build_mac_app(
      workspace:        File.join(PROJECT_ROOT, "macos/Runner.xcworkspace"),
      scheme:           "Runner",
      configuration:    "Release",
      export_method:    "developer-id",
      export_team_id:   FASTLANE_TEAM_ID,
      output_directory: File.join(PROJECT_ROOT, "build/fastlane"),
      output_name:      "WhisPaste"
    )
    app_path ||= File.join(PROJECT_ROOT, "build/fastlane/WhisPaste.app")

    unless ENV["SKIP_NOTARIZATION"] == "1"
      # notarize submits via notarytool, waits for Apple's response, and
      # staples the ticket to the .app on success.
      notarize(
        package:      app_path,
        bundle_id:    "de.whispaste.app",
        api_key:      api_key
      )
    end

    # Wrap the notarized+stapled .app in a DMG for the website/Homebrew artifact.
    dmg_path = File.join(PROJECT_ROOT, "build/fastlane/WhisPaste.dmg")
    sh(
      "create-dmg",
      "--volname",       "WhisPaste",
      "--window-size",   "500",
      "320",
      "--icon-size",     "80",
      "--app-drop-link", "380",
      "170",
      "--icon",          "WhisPaste.app",
      "120",
      "170",
      dmg_path,
      app_path
    )

    # Post-build smoke: verify staple ticket and Gatekeeper acceptance.
    sh("stapler validate #{app_path}")
    sh("spctl --assess --type exec --verbose #{app_path}")

    UI.success("Developer-ID build complete: #{dmg_path}")
    UI.success("App path: #{app_path}")
  end
end
