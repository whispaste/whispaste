# Template only — copy the keys below into
# ~/.config/whispaste-ios-credentials/fastlane.env (chmod 600) with your own
# real values. That file is NEVER committed; this template is safe to be
# public because it contains no real account identifiers.
FASTLANE_APPLE_ID=your-apple-id@example.com
FASTLANE_TEAM_ID=YOUR_TEAM_ID
ASC_KEY_ID=YOUR_ASC_KEY_ID
ASC_ISSUER_ID=YOUR_ASC_ISSUER_ID
# Optional — defaults to ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
# ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_YOUR_ASC_KEY_ID.p8
