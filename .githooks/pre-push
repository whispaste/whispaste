#!/usr/bin/env bash
#
# WhisPaste — pre-push Hook (OSS-Allowlist-Guard, dritte Schicht)
#
# Fängt Commits ab, die den pre-commit-Hook umgangen haben
# (`git commit --no-verify`). Scannt den gesamten Push-Range + HEAD-Baum.
#
# Aktivierung: `git config core.hooksPath .githooks`.
# Bash-3.2-kompatibel (macOS /bin/bash) — kein mapfile/readarray.
#
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
ALLOWLIST="$ROOT/.ossallowlist"
ATTESTSH="$ROOT/scripts/docs-attest.sh"
DRIFTSH="$ROOT/scripts/docs-drift.sh"
REMOTE="${1:-}"
ZERO="0000000000000000000000000000000000000000"

# Git liefert die Ref-Update-Zeilen (<local ref> <local sha1> <remote ref>
# <remote sha1>) EINMALIG über stdin (nicht-seekbare Pipe). Alle Abschnitte
# unten brauchen dieselben Zeilen -- EINMAL vollständig einlesen und danach
# per Array wiederverwenden. Ein zweites `while read` direkt von stdin bekäme
# sofort EOF (0 Zeilen), seine Prüfung liefe seither leise ins Leere, ohne
# Fehlermeldung -- exakt der Bug, der hier bis 2026-08-14 unbemerkt Abschnitt
# 2 (Force-push-auf-main-Schutz), 3 (Secret-/Bot-/AI-Trailer-Scan der
# Push-Range) und 6 (docs-drift) wirkungslos gemacht hat.
REF_LINES=()
while IFS= read -r _refline; do
  [ -z "$_refline" ] && continue
  REF_LINES+=("$_refline")
done

# Two-Path-Sync Advisory (Lektion aus 1.2.43: Store submitted, Tag vergessen
# → Website/Downloads/Sentry asynchron). Advisory-only, nie blockierend.
# Der Hook sieht nur die git-Seite; die Store-Submission läuft außerhalb und
# ist primär über wp-release-windows.sh (release/github-sync) abgesichert.
advise_two_path_sync() {
  case "$1" in
    refs/tags/v*)
      cat >&2 <<EOF
  note: ${1#refs/tags/} gepusht → release.yml triggert (Website/Sentry/Scoop).
        Two-Path-Sync sicherstellen: Store-Submission erfolgt?
        (wp-release-windows.sh release | github-sync | submit <msix>)
EOF
      ;;
  esac
}

# ── 1. Allowlist-Schranke (Push-Range + HEAD-Baum) ──────────────────────
if [ ! -f "$ALLOWLIST" ]; then
  echo "pre-push: WARN — .ossallowlist nicht gefunden, Guard inaktiv." >&2
else
  ALLOWED=()
  while IFS= read -r line; do
    case "$line" in ''|\#*) continue ;; esac
    ALLOWED+=("$line")
  done < "$ALLOWLIST"

  is_allowed() {
    local p="$1" a
    for a in "${ALLOWED[@]}"; do
      [ "$p" = "$a" ] && return 0
      case "$a" in */) [[ "$p" == "$a"* ]] && return 0 ;; esac
    done
    return 1
  }

  violations=()
  block() { cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT durch .ossallowlist                         ║
╠══════════════════════════════════════════════════════════════╣
║  $1
╚══════════════════════════════════════════════════════════════╝
EOF
    printf '  - %s\n' "${violations[@]}" >&2
    cat >&2 <<EOF

Nicht-öffentliche Pfade würden auf origin landen.
Datei mit `git rm --cached` aus dem Tracking nehmen oder nach
.scratch/ verschieben. Bei bewusster Ausnahme: .ossallowlist
erweitern (nach Review).
EOF
    exit 1
  }

  for _refline in "${REF_LINES[@]}"; do
    read -r local_ref local_sha remote_ref remote_sha <<<"$_refline" || true
    [ "$local_sha" = "$ZERO" ] && continue

    if [ "$remote_sha" != "$ZERO" ]; then
      range="${remote_sha}..${local_sha}"
    else
      range="$(git rev-list "$local_sha" --not --branches --remotes 2>/dev/null \
        || echo "$local_sha")"
    fi

    # (a) Im Range hinzugefügte Dateien
    while IFS= read -r path; do
      [ -z "$path" ] && continue
      ! is_allowed "$path" && violations+=("$path")
    done < <(git log --diff-filter=A --name-only --pretty=format: "$range" 2>/dev/null || true)

    # (b) HEAD-Baum komplett (aktuell getrackte Dateien am Push-Stand)
    while IFS= read -r path; do
      [ -z "$path" ] && continue
      ! is_allowed "$path" && violations+=("$path")
    done < <(git ls-tree -r --name-only "$local_sha" 2>/dev/null || true)

    advise_two_path_sync "$remote_ref"
  done

  if [ ${#violations[@]} -gt 0 ]; then
    unique=()
    while IFS= read -r line; do
      [ -n "$line" ] && unique+=("$line")
    done < <(printf '%s\n' "${violations[@]}" | sort -u)
    violations=("${unique[@]}")
    block "Nicht-öffentliche Pfade im Push:"
  fi
fi

# ── 2. Force-push auf main blockiert ───────────────────────────────────
for _refline in "${REF_LINES[@]}"; do
  read -r _lr local_sha rref remote_sha <<<"$_refline" || true
  [ "$local_sha" = "$ZERO" ] && continue
  branch="${rref#refs/heads/}"
  if [ "$branch" = "main" ] && [ "$remote_sha" != "$ZERO" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      if [ "${WP_ALLOW_FORCE_MAIN:-}" != "1" ]; then
        cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  BLOCKIERT: Force-push auf main
║  main ist ein Release-Branch — seine History muss linear
║  bleiben. Remote-Tip $remote_sha ist kein Ancestor von $local_sha.
║  Override (GEFÄHRLICH): WP_ALLOW_FORCE_MAIN=1 git push
╚══════════════════════════════════════════════════════════════╝
EOF
        exit 1
      fi
      echo "WP_ALLOW_FORCE_MAIN=1 — Force-push auf main erlaubt"
    fi
  fi
done

# ── 3. Full Push-Range Scan (PROTECTED, Secrets, AI-Trailer) ───────────
B1="SUPA"; B2="BASE_SERVICE_ROLE_KEY"; B3="ADMIN_API"; B4="_KEY"
SECRET_PATTERNS="${B1}${B2}=.{20,}|${B3}${B4}=.{20,}|sk-[a-zA-Z0-9]{20,}|ghp_[a-zA-Z0-9]{20,}"
AI_TRAILER_RE='^[Cc]o-[Aa]uthored-[Bb]y:.*(anthropic|copilot|claude|cursor|codeium|opencode)'
# Kein bare `noreply@github\.com` hier: das ist die Committer-Identität, die
# GitHubs eigener "Merge pull request"-Button JEDEM per Web-UI gemergten PR
# gibt (Author bleibt der echte Mensch) -- kein Bot-Signal, sondern die
# normale Signatur für jeden über GitHub gemergten Sprout/Bolt/Palette-PR
# dieses Projekts. Echte Bot-Accounts (dependabot[bot], github-actions[bot])
# nutzen `<id>+name[bot]@users.noreply.github.com`, weiterhin erfasst.
BOT_RE='(co-?pilot|anthropic|claude|opencode|github-actions|dependabot|\[bot\]|users\.noreply\.github\.com)'

# beta-appcast-pointer ist eine reine CI-verwaltete Orphan-Branch (appcast-beta.xml,
# force-gepusht von release.yml/publish_beta_fallback.sh) -- deren Commits sind
# IMMER github-actions[bot]-authored. Der Bot-Author-Check unten ist für
# menschliche/Agent-Commits auf dev/main gedacht; ein manueller Recovery-Push dieser
# Branch (z. B. nach versehentlichem Löschen) würde sonst am eigenen Zweck der
# Branch scheitern. Secret-Scan/.gitignore-PROTECTED/AI-Trailer-Check bleiben aktiv.
for _refline in "${REF_LINES[@]}"; do
  read -r _lr local_sha rref remote_sha <<<"$_refline" || true
  [ "$local_sha" = "$ZERO" ] && continue
  is_appcast_pointer=0
  [ "$rref" = "refs/heads/beta-appcast-pointer" ] && is_appcast_pointer=1

  [ "$remote_sha" != "$ZERO" ] \
    && range="${remote_sha}..${local_sha}" \
    || range="$(git rev-list "$local_sha" --not --branches --remotes 2>/dev/null || echo "$local_sha")"

  [ -z "$range" ] && continue

  for commit in $(git rev-list "$range" 2>/dev/null); do
    files=$(git diff-tree --no-commit-id --name-only --diff-filter=ACMR -r "$commit" 2>/dev/null || true)
    [ -z "$files" ] && continue

    # .gitignore PROTECTED weakening
    if echo "$files" | grep -q "^\.gitignore$"; then
      new_block=$(git show "$commit:.gitignore" 2>/dev/null \
        | tr -d '\r' | sed -n '/PROTECTED-START/,/PROTECTED-END/p')
      old_block=$(git show "${commit}^:.gitignore" 2>/dev/null \
        | tr -d '\r' | sed -n '/PROTECTED-START/,/PROTECTED-END/p' || true)
      if [ -n "$old_block" ]; then
        old_ents=$(echo "$old_block" | grep -v '^#' | grep -v '^$' | grep -v 'PROTECTED' | sort -u)
        new_ents=$(echo "$new_block" | grep -v '^#' | grep -v '^$' | grep -v 'PROTECTED' | sort -u)
        removed=$(comm -23 <(echo "$old_ents") <(echo "$new_ents") 2>/dev/null || true)
        if [ -n "$removed" ]; then
          cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT: .gitignore PROTECTED entries entfernt      ║
║  Commit: ${commit:0:12}
╚══════════════════════════════════════════════════════════════╝
EOF
          echo "$removed" >&2
          exit 1
        fi
      fi
    fi

    # Secret patterns
    smatch=$(git show "$commit" 2>/dev/null \
      | grep -oE "$SECRET_PATTERNS" 2>/dev/null | head -1 || true)
    if [ -n "$smatch" ]; then
      cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT: potentielles Secret in Commit ${commit:0:12}
║  ${smatch:0:60}
╚══════════════════════════════════════════════════════════════╝
EOF
      exit 1
    fi

    # AI/Co-Authored-By Trailer — HARD RULE (global CLAUDE.md)
    trailer=$(git log -1 --format='%B' "$commit" 2>/dev/null \
      | grep -iE "$AI_TRAILER_RE" | head -1 || true)
    if [ -n "$trailer" ]; then
      cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT: KI-Co-Authored-By-Trailer in Commit ${commit:0:12}
║  $(echo "$trailer" | cut -c1-72)
║  Trailer entfernen (rebase -i / commit --amend), dann pushen.
╚══════════════════════════════════════════════════════════════╝
EOF
      exit 1
    fi

    # Bot author/committer -- skip commits already accepted onto some
    # remote-tracking ref (e.g. a CI manifest-bump commit already live on
    # origin/dev, or a github-actions[bot] commit from a past release
    # cycle): those were never new content to review, they only surface
    # here because this local push is the first one to carry that ref's
    # history across into another branch (dev -> main fast-forward etc).
    # Genuinely new bot-authored commits on THIS push are still caught,
    # since they cannot yet be reachable from any remote-tracking ref.
    [ "$is_appcast_pointer" = "1" ] && continue
    if [ -n "$(git branch -r --contains "$commit" 2>/dev/null)" ]; then
      continue
    fi
    ident=$(git log -1 --format='%an <%ae>%n%cn <%ce>' "$commit" 2>/dev/null || true)
    if echo "$ident" | grep -qiE "$BOT_RE"; then
      cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT: Bot-Author/Committer in Commit ${commit:0:12}
║  $(echo "$ident" | head -c80)
╚══════════════════════════════════════════════════════════════╝
EOF
      exit 1
    fi
  done
done

# ── 4. Docs-Attest-Schranke (WhisPaste) ─────────────────────────────────
if [ -f "$ATTESTSH" ]; then
  if ! bash "$ATTESTSH" check >/dev/null 2>&1; then
    cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT: Public-Docs-QS (scripts/docs-attest.sh     ║
║  check) fehlgeschlagen.                                     ║
║  Details: bash scripts/docs-attest.sh check                 ║
╚══════════════════════════════════════════════════════════════╝
EOF
    exit 1
  fi

  attested="$(bash "$ATTESTSH" attested)"
  pushed_any=0
  saw_appcast_pointer=0
  for _refline in "${REF_LINES[@]}"; do
    read -r _lr local_sha _rr _rs <<<"$_refline" || true
    [ -z "${local_sha:-}" ] && continue
    [ "$local_sha" = "$ZERO" ] && continue
    # beta-appcast-pointer trägt nur appcast-beta.xml (kein README/CHANGELOG/
    # Website) -- ihre SHA kann nie mit dem attestierten dev-Stand übereinstimmen,
    # das ist kein Docs-Drift-Signal für diese Branch (siehe Abschnitt 3 oben).
    if [ "$_rr" = "refs/heads/beta-appcast-pointer" ]; then
      saw_appcast_pointer=1
      continue
    fi
    pushed_any=1
    cs="$(git rev-parse --verify --quiet "${local_sha}^{commit}" 2>/dev/null || echo "$local_sha")"
    [ "$cs" = "$attested" ] || {
      cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT: öffentliche Docs nicht für diesen Stand     ║
║  attestiert. Zu pushen: ${cs:0:12} · attestiert: ${attested:0:12}
║  → README/CHANGELOG/Website gegen den aktuellen Repo-Stand
║    PRÜFEN, dann BEWUSST bestätigen:
║    scripts/docs-attest.sh attest
║  (kein --no-verify)
╚══════════════════════════════════════════════════════════════╝
EOF
      exit 1
    }
  done
  if [ "$pushed_any" -eq 0 ] && [ "$saw_appcast_pointer" -eq 1 ]; then
    : # ausschließlich beta-appcast-pointer im Push -- HEAD-Fallback unten übersprungen
  elif [ "$pushed_any" -eq 0 ]; then
    head="$(git rev-parse HEAD)"
    [ "$head" = "$attested" ] || {
      cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT: HEAD ${head:0:12} ist nicht attestiert.
║  → BEWUSST bestätigen: scripts/docs-attest.sh attest
╚══════════════════════════════════════════════════════════════╝
EOF
      exit 1
    }
  fi
fi

# ── 4b. Doc-Gate (Content-Level: Infra-Leaks, Sprache, Security-Werbung) ─
if [ -f "$ROOT/.githooks/check-docs.sh" ]; then
  bash "$ROOT/.githooks/check-docs.sh" head || exit 1
fi

# ── 5. Quality/Security-Gates (sparsam, blockierend) ───────────────────

# Loam ratchet gate (Dart-only)
if command -v dart >/dev/null 2>&1; then
  echo ""; echo "Loam ratchet gate..."
  dart pub global activate loam 0.1.14 >/dev/null
  export PATH="$HOME/.pub-cache/bin:$PATH"
  # Resolve Dart SDK path (must follow Homebrew symlinks on macOS)
  if [ -z "${DART_SDK:-}" ]; then
    if command -v flutter >/dev/null 2>&1; then
      _f=$(command -v flutter)
      while [ -L "$_f" ]; do
        _t=$(readlink "$_f"); case "$_t" in /*) _f="$_t" ;; *) _f="$(dirname "$_f")/$_t" ;; esac
      done
      export DART_SDK="$(dirname "$_f")/cache/dart-sdk"
    elif command -v dart >/dev/null 2>&1; then
      _d=$(command -v dart)
      while [ -L "$_d" ]; do
        _t=$(readlink "$_d"); case "$_t" in /*) _d="$_t" ;; *) _d="$(dirname "$_d")/$_t" ;; esac
      done
      export DART_SDK="$(dirname "$(dirname "$_d")")"
    fi
  fi
  if ! loam gate --no-update-check 2>&1; then
    cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT: Loam ratchet gate fand Findings            ║
╚══════════════════════════════════════════════════════════════╝
EOF
    exit 1
  fi
  echo "  Loam: clean"
fi

# actionlint (GitHub-Actions-Workflow-Syntax/-Semantik, sparsam: nur wenn
# installiert). Fängt genau die Fehlerklasse ab, die sonst erst als roter
# CI-Run sichtbar wird: falsche runs-on/needs/if-Expressions, unbekannte
# Contexts, kaputte Matrix-Syntax, sowie eingebettete run:-Shell-Skripte via
# integriertem shellcheck. Läuft immer über den vollen Workflow-Ordner (nicht
# nur die Push-Range) — dieselbe Prüfung, die `gh workflow` letztlich auch
# über die YAML laufen lässt, nur lokal und ohne Runner-Zeit zu verbrauchen.
if command -v actionlint >/dev/null 2>&1; then
  echo ""; echo "actionlint (GitHub Actions workflow lint)..."
  if ! actionlint "$ROOT"/.github/workflows/*.yml 2>&1; then
    cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT: actionlint fand Workflow-Probleme           ║
╚══════════════════════════════════════════════════════════════╝
EOF
    exit 1
  fi
  echo "  actionlint: clean"
else
  echo "⚠ actionlint nicht installiert — Workflow-Lint übersprungen. Empfohlen: brew install actionlint" >&2
fi

# Semgrep SAST (sparsam: nur wenn installiert)
if command -v semgrep >/dev/null 2>&1; then
  echo ""; echo "Semgrep SAST scan..."
  if ! semgrep --config p/ci --error --quiet \
    --include="*.ts" --include="*.js" --include="*.mjs" \
    --include="*.cpp" --include="*.h" \
    --exclude="node_modules" --exclude="dist" --exclude="build" \
    --exclude=".dart_tool" . 2>&1; then
    cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT: Semgrep fand Security-Issues               ║
╚══════════════════════════════════════════════════════════════╝
EOF
    exit 1
  fi
  echo "  Semgrep: clean"
fi

# gitleaks (voller Verlauf, nicht nur die Push-Range) — fängt auch
# --no-verify-Commits ab, die den Commit-Gate umgangen haben. Community-
# gepflegtes, breiteres Regelwerk als die Handvoll fest verdrahteter Muster
# in Schritt 3 oben. Sparsam: nur wenn installiert, nie deswegen blockieren.
if command -v gitleaks >/dev/null 2>&1; then
  echo ""; echo "gitleaks full-history scan..."
  if ! gitleaks git --no-banner --redact "$ROOT" 2>&1; then
    cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT: gitleaks fand ein mögliches Secret          ║
║  (voller Verlauf — auch --no-verify-Commits werden erfasst) ║
╚══════════════════════════════════════════════════════════════╝

Falscher Alarm? .gitleaks.toml um eine gezielte Ausnahme ergänzen.
EOF
    exit 1
  fi
  echo "  gitleaks: clean"
else
  echo "⚠ gitleaks nicht installiert — Secret-Scan übersprungen. Empfohlen: brew install gitleaks" >&2
fi

# OSV-Scanner (vuln check; sparsam: nur wenn installiert)
# Gemfile.lock ergänzt (2026-07-19): fehlte hier, sodass 3 high + 1 moderate
# CVE (faraday/jwt/json) erst per GitHubs Remote-Dependabot-Scan NACH dem
# Push auffielen statt lokal blockiert zu werden.
if command -v osv-scanner >/dev/null 2>&1; then
  echo ""; echo "OSV vulnerability scan..."
  OSV_ARGS=""
  [ -f "$ROOT/pubspec.lock" ]              && OSV_ARGS="$OSV_ARGS --lockfile=$ROOT/pubspec.lock"
  [ -f "$ROOT/website/package-lock.json" ] && OSV_ARGS="$OSV_ARGS --lockfile=$ROOT/website/package-lock.json"
  [ -f "$ROOT/Gemfile.lock" ]              && OSV_ARGS="$OSV_ARGS --lockfile=$ROOT/Gemfile.lock"
  if [ -n "$OSV_ARGS" ]; then
    if ! osv-scanner scan $OSV_ARGS 2>&1; then
      cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT: OSV fand vulnerable Dependencies           ║
╚══════════════════════════════════════════════════════════════╝
EOF
      exit 1
    fi
    echo "  OSV: clean"
  fi
fi

# Website CI (sparsam: nur wenn module installiert)
if [ -f "$ROOT/website/package.json" ] && command -v npm >/dev/null 2>&1 \
   && [ -d "$ROOT/website/node_modules" ]; then
  echo ""; echo "Website CI check..."
  # CI=true here (not just for the "official" GitHub Actions run) matters for
  # two reasons: playwright.config.ts's webServer only serves the just-built
  # dist/ via `npm run preview` when CI is set — without it, this hook
  # silently reused whatever long-lived `astro dev` server happened to
  # already be running on 4321 (reuseExistingServer: !process.env.CI),
  # meaning it was NEVER actually exercising the same preview/PROD path real
  # CI does. That gap let a real bug through undetected locally (the
  # download-tracking spec's first describe block never blocked the real
  # matomo.js load that only happens in PROD — see its own comment). CI=true
  # also activates the config's one-retry safety net for genuine
  # environment-load flakes, same as the real workflow gets.
  #
  # PLAYWRIGHT_PORT: always ask the OS for a free port instead of hardcoding
  # 4321 — a developer very plausibly has `astro dev` (or a previous run of
  # this exact gate) already sitting on 4321, and this gate must never fail
  # a push just because of that. GitHub Actions runners are always fresh, so
  # the workflow itself keeps relying on playwright.config.ts's 4321 default.
  website_ci_port="$(node "$ROOT/website/scripts/find-free-port.mjs")"
  if ! (cd "$ROOT/website" && npm run build && npx playwright install chromium webkit && CI=true PLAYWRIGHT_PORT="$website_ci_port" npm run test:ci) 2>&1; then
    cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT: website CI gate fehlgeschlagen             ║
╚══════════════════════════════════════════════════════════════╝
EOF
    exit 1
  fi
  echo "  Website CI: OK"
fi

# ── 6. Advisory: docs-drift (weich, NIE blockierend) ────────────────────
run_drift=0
for _refline in "${REF_LINES[@]}"; do
  read -r _lr _ls rref _rs <<<"$_refline" || true
  case "$rref" in refs/heads/main|refs/heads/master|refs/tags/v*) run_drift=1 ;; esac
done
if [ "$run_drift" = 1 ] && [ "${WHISPASTE_SKIP_DRIFT:-}" != 1 ] \
   && [ -f "$DRIFTSH" ] && command -v claude >/dev/null 2>&1; then
  echo "" >&2
  echo "docs-drift (advisory, non-blocking — release push) …" >&2
  bash "$DRIFTSH" --llm 2>&1 | sed 's/^/  /' >&2 || true
fi

exit 0
