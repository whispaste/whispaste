#!/usr/bin/env bash
#
# WhisPaste — pre-push Hook (OSS-Allowlist-Guard, dritte Schicht)
#
# Fängt Commits ab, die den pre-commit-Hook umgangen haben
# (`git commit --no-verify`). Scannt den gesamten Push-Range + HEAD-Baum.
#
# Aktivierung: `git config core.hooksPath .githooks`.
# Bash-3.2-kompatibel (macOS /bin/bash) — kein mapfile/readarray.
#
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
ALLOWLIST="$ROOT/.ossallowlist"
ATTESTSH="$ROOT/scripts/docs-attest.sh"
DRIFTSH="$ROOT/scripts/docs-drift.sh"
REMOTE="${1:-}"
ZERO="0000000000000000000000000000000000000000"

# Git liefert die Ref-Update-Zeilen (<local ref> <local sha1> <remote ref>
# <remote sha1>) EINMALIG über stdin (nicht-seekbare Pipe). Alle Abschnitte
# unten brauchen dieselben Zeilen -- EINMAL vollständig einlesen und danach
# per Array wiederverwenden. Ein zweites `while read` direkt von stdin bekäme
# sofort EOF (0 Zeilen), seine Prüfung liefe seither leise ins Leere, ohne
# Fehlermeldung -- exakt der Bug, der hier bis 2026-08-14 unbemerkt Abschnitt
# 2 (Force-push-auf-main-Schutz), 3 (Secret-/Bot-/AI-Trailer-Scan der
# Push-Range) und 6 (docs-drift) wirkungslos gemacht hat.
REF_LINES=()
while IFS= read -r _refline; do
  [ -z "$_refline" ] && continue
  REF_LINES+=("$_refline")
done

# Git invokes this hook even when there is nothing to push (e.g. `git push`
# on an already up-to-date branch) — stdin is then empty, so REF_LINES stays
# a zero-element array. Nothing below has anything to check in that case, so
# exit early. This also sidesteps a bash-3.2 quirk (fixed in bash 4.4+):
# `"${REF_LINES[@]}"` on a genuinely empty array throws "unbound variable"
# under `set -u`, even though the array itself is assigned — every `for
# _refline in "${REF_LINES[@]}"` loop below would otherwise crash the push
# instead of just doing nothing, on every no-op `git push`.
if [ ${#REF_LINES[@]} -eq 0 ]; then
  exit 0
fi

# Third-party product name guard (and agent instruction guard, see
# instruction-guard.sh): no commit in the push range may carry the
# name of another dictation/transcription product (messages, added lines,
# paths), and the pushed tree must be free of them as well.
for _refline in "${REF_LINES[@]}"; do
  read -r _lr _lsha _rr _rsha <<<"$_refline" || true
  [ "$_lsha" = "$ZERO" ] && continue
  if [ "$_rsha" != "$ZERO" ]; then
    "$ROOT/.githooks/name-guard.sh" range "${_rsha}..${_lsha}"
    "$(dirname "$0")/instruction-guard.sh" range "${_rsha}..${_lsha}"
  else
    "$ROOT/.githooks/name-guard.sh" range "$_lsha --not --remotes"
    "$(dirname "$0")/instruction-guard.sh" range "$_lsha --not --remotes"
  fi
  "$ROOT/.githooks/name-guard.sh" tree "$_lsha"
  "$(dirname "$0")/instruction-guard.sh" tree "$_lsha"
done

# Closed-source guard: the server API (services/api/) lives in its own private
# repository and must never reach this public repo — not in the pushed tree
# and not in any commit of the push range (history counts as published).
for _refline in "${REF_LINES[@]}"; do
  read -r _lr _lsha _rr _rsha <<<"$_refline" || true
  [ "$_lsha" = "$ZERO" ] && continue
  if [ "$_rsha" != "$ZERO" ]; then
    _api_range="${_rsha}..${_lsha}"
  else
    _api_range="$_lsha --not --remotes"
  fi
  # shellcheck disable=SC2086
  if [ -n "$(git log --format=%h $_api_range -- services/api 2>/dev/null | head -1)" ]; then
    echo "pre-push: BLOCKED — push range touches services/api/ (closed-source API, private repo only)." >&2
    exit 1
  fi
done

# Two-Path-Sync Advisory (Lektion aus 1.2.43: Store submitted, Tag vergessen
# → Website/Downloads/Sentry asynchron). Advisory-only, nie blockierend.
# Der Hook sieht nur die git-Seite; die Store-Submission läuft außerhalb und
# ist primär über wp-release-windows.sh (release/github-sync) abgesichert.
advise_two_path_sync() {
  case "$1" in
    refs/tags/v*)
      cat >&2 <<EOF
  note: ${1#refs/tags/} gepusht → release.yml triggert (Website/Sentry/Scoop).
        Two-Path-Sync sicherstellen: Store-Submission erfolgt?
        (wp-release-windows.sh release | github-sync | submit <msix>)
EOF
      ;;
  esac
}

# ── 0. macOS MAS-Plugin-Registrant-Guard (Self-Heal, working-tree only) ─
# Belt-and-suspenders alongside the pre-commit self-heal (which only fixes
# what's actually staged) and the mas-guard clean filter (which git only
# consults for add/diff/commit, never for `git status`'s modified-list —
# see macos/patch_plugin_registrant_guard.py for the full mechanism). This
# guarantees the working-tree file is physically guarded right after every
# push, not just logically clean in git's eyes, so `git status` reads
# clean immediately afterward too, not just "impossible to commit unguarded".
if command -v python3 >/dev/null 2>&1; then
  _registrant="$ROOT/macos/Flutter/GeneratedPluginRegistrant.swift"
  python3 "$ROOT/macos/patch_plugin_registrant_guard.py" "$_registrant" >/dev/null 2>&1 || true
  # If the guarded file now matches HEAD byte-for-byte (the routine case --
  # Flutter regenerated it, we just restored the guard), `git status`'s fast
  # stat-based check can still flag it "modified" purely from the rewritten
  # mtime (git does not consult the mas-guard clean filter for that check --
  # see .gitattributes). `git add` here is safe ONLY because we just proved
  # via `git diff --quiet` that staging it is a true no-op content-wise; it
  # refreshes the index's cached stat so `git status` reads clean right after
  # this push, instead of a phantom "M" lingering until the next `git add`.
  # If real content differs (e.g. an actual new plugin was registered since
  # the last commit), `git diff --quiet` fails and we deliberately leave it
  # alone for a real, reviewed commit.
  if [ -f "$_registrant" ] && git diff --quiet -- "$_registrant" 2>/dev/null; then
    git add -- "$_registrant" 2>/dev/null || true
  fi
fi

# ── 0b. macOS plugin files match pubspec.lock ─────────────────────────
# The committed GeneratedPluginRegistrant.swift and Podfile.lock must name
# the macOS plugins pubspec.lock resolves to (tool/macos_plugins.dart, plugin
# names only, ~0.2 s, no CocoaPods needed). Real drift blocks on the Mac,
# where the fix is one command; elsewhere it warns. A check that cannot tell
# (no pub get yet, uncommitted pubspec changes, a tool error) never blocks.
# .flutter-plugins-dependencies may predate the last checkout: before
# blocking, the Mac runs pub get once and checks again.
if [ -f "$ROOT/tool/macos_plugins.dart" ] && command -v dart >/dev/null 2>&1; then
  [ -f "$ROOT/scripts/install-git-filters.sh" ] && { bash "$ROOT/scripts/install-git-filters.sh" || true; }
  if [ ! -f "$ROOT/.flutter-plugins-dependencies" ]; then
    echo "⚠ macOS-Plugin-Prüfung übersprungen: erst 'flutter pub get'." >&2
  elif ! git -C "$ROOT" diff --quiet HEAD -- pubspec.yaml pubspec.lock; then
    echo "⚠ macOS-Plugin-Prüfung übersprungen: pubspec.yaml/pubspec.lock haben uncommittete Änderungen." >&2
  else
    _mp_rc=0
    _mp_out=$(cd "$ROOT" && dart tool/macos_plugins.dart 2>&1) || _mp_rc=$?
    if [ "$_mp_rc" -eq 1 ] && [ "$(uname -s)" = "Darwin" ]; then
      _mp_rc=0
      (cd "$ROOT" && env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE flutter pub get >/dev/null 2>&1) || true
      _mp_out=$(cd "$ROOT" && dart tool/macos_plugins.dart 2>&1) || _mp_rc=$?
    fi
    if [ "$_mp_rc" -eq 1 ]; then
      echo "" >&2
      echo "macOS-Plugin-Dateien passen nicht zu pubspec.lock:" >&2
      printf '%s\n' "$_mp_out" | sed 's/^/  - /' >&2
      echo "  Fix: bash scripts/sync-macos-plugins.sh --stage && git commit -m 'chore(macos): sync plugin files'" >&2
      if [ "$(uname -s)" = "Darwin" ]; then
        exit 1
      fi
      echo "  (Nicht-Mac: nur Warnung, der nächste Mac-Push holt es nach.)" >&2
    elif [ "$_mp_rc" -ne 0 ]; then
      echo "⚠ macOS-Plugin-Prüfung ohne Ergebnis: $_mp_out" >&2
    fi
  fi
fi

# ── 1. Allowlist-Schranke (Push-Range + HEAD-Baum) ──────────────────────
if [ ! -f "$ALLOWLIST" ]; then
  echo "pre-push: WARN — .ossallowlist nicht gefunden, Guard inaktiv." >&2
else
  ALLOWED=()
  while IFS= read -r line; do
    case "$line" in ''|\#*) continue ;; esac
    ALLOWED+=("$line")
  done < "$ALLOWLIST"

  is_allowed() {
    local p="$1" a
    # Guarded expansion: an empty ALLOWED (e.g. an allowlist with only
    # comments/blank lines) would otherwise throw "unbound variable" under
    # `set -u` on bash 3.2 — see the REF_LINES comment above for why.
    for a in "${ALLOWED[@]+"${ALLOWED[@]}"}"; do
      [ "$p" = "$a" ] && return 0
      case "$a" in */) [[ "$p" == "$a"* ]] && return 0 ;; esac
    done
    return 1
  }

  violations=()
  block() { cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT durch .ossallowlist                         ║
╠══════════════════════════════════════════════════════════════╣
║  $1
╚══════════════════════════════════════════════════════════════╝
EOF
    printf '  - %s\n' "${violations[@]}" >&2
    cat >&2 <<EOF

Nicht-öffentliche Pfade würden auf origin landen.
Datei mit `git rm --cached` aus dem Tracking nehmen oder nach
internal-notes verschieben. Bei bewusster Ausnahme: .ossallowlist
erweitern (nach Review).
EOF
    exit 1
  }

  for _refline in "${REF_LINES[@]}"; do
    read -r local_ref local_sha remote_ref remote_sha <<<"$_refline" || true
    [ "$local_sha" = "$ZERO" ] && continue

    if [ "$remote_sha" != "$ZERO" ]; then
      range="${remote_sha}..${local_sha}"
    else
      range="$(git rev-list "$local_sha" --not --branches --remotes 2>/dev/null \
        || echo "$local_sha")"
    fi

    # (a) Im Range hinzugefügte Dateien
    while IFS= read -r path; do
      [ -z "$path" ] && continue
      ! is_allowed "$path" && violations+=("$path")
    done < <(git log --diff-filter=A --name-only --pretty=format: "$range" 2>/dev/null || true)

    # (b) HEAD-Baum komplett (aktuell getrackte Dateien am Push-Stand)
    while IFS= read -r path; do
      [ -z "$path" ] && continue
      ! is_allowed "$path" && violations+=("$path")
    done < <(git ls-tree -r --name-only "$local_sha" 2>/dev/null || true)

    advise_two_path_sync "$remote_ref"
  done

  if [ ${#violations[@]} -gt 0 ]; then
    unique=()
    while IFS= read -r line; do
      [ -n "$line" ] && unique+=("$line")
    done < <(printf '%s\n' "${violations[@]}" | sort -u)
    violations=("${unique[@]}")
    block "Nicht-öffentliche Pfade im Push:"
  fi
fi

# ── 2. Force-push auf main blockiert ───────────────────────────────────
for _refline in "${REF_LINES[@]}"; do
  read -r _lr local_sha rref remote_sha <<<"$_refline" || true
  [ "$local_sha" = "$ZERO" ] && continue
  branch="${rref#refs/heads/}"
  if [ "$branch" = "main" ] && [ "$remote_sha" != "$ZERO" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      if [ "${WP_ALLOW_FORCE_MAIN:-}" != "1" ]; then
        cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  BLOCKIERT: Force-push auf main
║  main ist ein Release-Branch — seine History muss linear
║  bleiben. Remote-Tip $remote_sha ist kein Ancestor von $local_sha.
║  Override (GEFÄHRLICH): WP_ALLOW_FORCE_MAIN=1 git push
╚══════════════════════════════════════════════════════════════╝
EOF
        exit 1
      fi
      echo "WP_ALLOW_FORCE_MAIN=1 — Force-push auf main erlaubt"
    fi
  fi
done

# ── 2a. Production release approval (main + stable tags) ───────────────
# Pushing main deploys the website (deploy-pages.yml) and a stable vX.Y.Z
# tag ships to every store (release.yml). Both are production releases and
# need the owner's explicit, per-release go: the approval file must contain
# the full SHA of the commit being released. Only the owner writes it, via
# `scripts/approve-release.sh` (agents never create or edit it). Beta tags
# (vX.Y.Z-beta.N) are staging and stay ungated.
APPROVAL_FILE="${WP_RELEASE_APPROVAL_FILE:-$HOME/.config/whispaste/release-approval}"
for _refline in "${REF_LINES[@]}"; do
  read -r _lr local_sha rref remote_sha <<<"$_refline" || true
  [ "$local_sha" = "$ZERO" ] && continue
  case "$rref" in
    refs/heads/main) ;;
    refs/tags/v*-beta.*) continue ;;
    refs/tags/v*) ;;
    *) continue ;;
  esac
  release_sha="$(git rev-parse "$local_sha^{commit}" 2>/dev/null || echo "$local_sha")"
  if ! grep -qx "$release_sha" "$APPROVAL_FILE" 2>/dev/null; then
    cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  BLOCKIERT: Produktions-Release ohne Freigabe
║  ${rref#refs/*/} → $release_sha
║  Push auf main bzw. ein stabiler Tag ist ein Produktions-Release.
║  Freigabe (nur der Owner): bash scripts/approve-release.sh <tag>
╚══════════════════════════════════════════════════════════════╝
EOF
    exit 1
  fi
done

# ── 2a'. Website needs its API live first ─────────────────────────────
# The website calls api.whispaste.de (contact form, star count). The API is
# released first by the private release script; a main push while the API
# is down would ship a site with a broken contact form.
for _refline in "${REF_LINES[@]}"; do
  read -r _lr local_sha rref remote_sha <<<"$_refline" || true
  [ "$local_sha" = "$ZERO" ] && continue
  [ "$rref" = "refs/heads/main" ] || continue
  _api_status="$(curl -s -o /dev/null -m 15 -w '%{http_code}' https://api.whispaste.de/v1/health || true)"
  if [ "$_api_status" != "200" ]; then
    echo "pre-push: BLOCKED — https://api.whispaste.de/v1/health answers '$_api_status'; release the API before the website." >&2
    exit 1
  fi
done

# ── 2b. Branch-/Worktree-Hygiene (nur dev/main dürfen existieren) ──────
# Silvios feste Vorgabe (2026-09-07, nach einem Vorfall mit ~26 liegen
# gebliebenen Bot-Suggestion-/PR-Inspection-Branches): sobald dev oder main
# gepusht wird, müssen lokal UND im Remote ausschließlich dev/main
# existieren, keine weiteren Branches, kein offener Worktree außer dem
# Haupt-Tree. Technisch erzwungen statt nur einmalig manuell aufgeräumt —
# ein Feature-Worktree/-Branch muss vor jedem dev/main-Push fertig
# gemerged UND entfernt sein (Solo-Dev-Workflow, kein PR-Review nötig).
push_touches_devmain=0
push_touches_main=0
for _refline in "${REF_LINES[@]}"; do
  read -r _lr _ls rref _rs <<<"$_refline" || true
  case "$rref" in refs/heads/dev|refs/heads/main) push_touches_devmain=1 ;; esac
  [ "$rref" = "refs/heads/main" ] && push_touches_main=1
done

# Override for long-running integration phases (maintainer decision
# 2026-10-19): with WP_ALLOW_OPEN_BRANCHES=1 a push that only touches dev may
# skip this hygiene check, so dev stays in sync with origin while feature
# branches/worktrees are still open. Every other check below still runs.
# Since 2026-10-28 (maintainer decision) the switch also covers a hotfix push
# to main: pushed from a local hotfix/* branch (git push origin hotfix/x:main)
# as a fast-forward without merge commits. A dev -> main release keeps the full
# hygiene. The production approval in section 2a still applies to that push.
main_push_is_hotfix=1
if [ "$push_touches_main" = 1 ]; then
  for _refline in "${REF_LINES[@]}"; do
    read -r _lr _ls rref _rs <<<"$_refline" || true
    [ "$rref" = "refs/heads/main" ] || continue
    if [[ "$_lr" != refs/heads/hotfix/* ]] || [ "$_rs" = "$ZERO" ] || ! git merge-base --is-ancestor "$_rs" "$_ls" 2>/dev/null \
      || [ -n "$(git rev-list --merges "$_rs..$_ls" 2>/dev/null)" ]; then
      main_push_is_hotfix=0
    fi
  done
fi
if [ "$push_touches_devmain" = 1 ] && [ "${WP_ALLOW_OPEN_BRANCHES:-}" = 1 ]; then
  if [ "$push_touches_main" = 1 ] && [ "$main_push_is_hotfix" = 1 ]; then
    echo "pre-push: WP_ALLOW_OPEN_BRANCHES=1 — branch/worktree hygiene skipped for this hotfix push to main" >&2
    push_touches_devmain=0
  elif [ "$push_touches_main" = 1 ]; then
    echo "pre-push: WP_ALLOW_OPEN_BRANCHES ignored — the main push is not a hotfix/* fast-forward without merges" >&2
  else
    echo "pre-push: WP_ALLOW_OPEN_BRANCHES=1 — branch/worktree hygiene skipped for this dev push" >&2
    push_touches_devmain=0
  fi
fi

if [ "$push_touches_devmain" = 1 ]; then
  # beta-appcast-pointer ist eine dauerhafte, CI-verwaltete Orphan-Branch
  # (force-gepusht von release.yml/publish_beta_fallback.sh, s. Abschnitt 3/4
  # oben) — kein Wildwuchs, sondern Infrastruktur. Von der Hygiene-Prüfung
  # ausgenommen; die Recovery-Variante (ein manueller, einmaliger Wiederher-
  # stellungs-Branch) fällt NICHT unter diese Ausnahme.
  stray_branches=$(git for-each-ref --format='%(refname:short)' refs/heads/ \
    | grep -vE '^(dev|main|beta-appcast-pointer)$' || true)
  if [ -n "$stray_branches" ]; then
    cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT: lokale Branches außer dev/main vorhanden    ║
╚══════════════════════════════════════════════════════════════╝
EOF
    echo "$stray_branches" | sed 's/^/  - /' >&2
    cat >&2 <<EOF

Nur dev und main dürfen dauerhaft existieren. Erst aufräumen:
  git branch -D <branch>    (nach Verifikation: Inhalt bereits in dev?)
oder den echten, fehlenden Inhalt vorher nach dev mergen.
EOF
    exit 1
  fi

  stray_worktrees=$(git worktree list --porcelain \
    | awk -v root="$ROOT" '/^worktree /{ if ($2 != root) print $2 }')
  if [ -n "$stray_worktrees" ]; then
    cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT: offene Worktrees außer dem Haupt-Tree       ║
╚══════════════════════════════════════════════════════════════╝
EOF
    echo "$stray_worktrees" | sed 's/^/  - /' >&2
    echo "" >&2
    echo "Aufräumen: git worktree remove <pfad> (ggf. --force)" >&2
    exit 1
  fi

  if [ -n "${REMOTE:-}" ] && git ls-remote --exit-code "$REMOTE" >/dev/null 2>&1; then
    stray_remote=$(git ls-remote --heads "$REMOTE" 2>/dev/null \
      | awk '{print $2}' | sed 's#refs/heads/##' | grep -vE '^(dev|main|beta-appcast-pointer)$' || true)
    if [ -n "$stray_remote" ]; then
      cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT: Remote-Branches außer dev/main vorhanden    ║
╚══════════════════════════════════════════════════════════════╝
EOF
      echo "$stray_remote" | sed 's/^/  - /' >&2
      echo "" >&2
      echo "Aufräumen: git push $REMOTE --delete <branch>" >&2
      exit 1
    fi
  fi
fi

# ── 3. Full Push-Range Scan (PROTECTED, Secrets, AI-Trailer) ───────────
B1="SUPA"; B2="BASE_SERVICE_ROLE_KEY"; B3="ADMIN_API"; B4="_KEY"
SECRET_PATTERNS="${B1}${B2}=.{20,}|${B3}${B4}=.{20,}|sk-[a-zA-Z0-9]{20,}|ghp_[a-zA-Z0-9]{20,}"
AI_TRAILER_RE='^[Cc]o-[Aa]uthored-[Bb]y:.*(anthropic|copilot|claude|cursor|codeium|opencode)'
# Kein bare `noreply@github\.com` hier: das ist die Committer-Identität, die
# GitHubs eigener "Merge pull request"-Button JEDEM per Web-UI gemergten PR
# gibt (Author bleibt der echte Mensch) -- kein Bot-Signal, sondern die
# normale Signatur für jeden über GitHub gemergten Sprout/Bolt/Palette-PR
# dieses Projekts. Echte Bot-Accounts (dependabot[bot], github-actions[bot])
# nutzen `<id>+name[bot]@users.noreply.github.com`, weiterhin erfasst.
BOT_RE='(co-?pilot|anthropic|claude|opencode|github-actions|dependabot|\[bot\]|users\.noreply\.github\.com)'

# beta-appcast-pointer ist eine reine CI-verwaltete Orphan-Branch (appcast-beta.xml,
# force-gepusht von release.yml/publish_beta_fallback.sh) -- deren Commits sind
# IMMER github-actions[bot]-authored. Der Bot-Author-Check unten ist für
# menschliche/Agent-Commits auf dev/main gedacht; ein manueller Recovery-Push dieser
# Branch (z. B. nach versehentlichem Löschen) würde sonst am eigenen Zweck der
# Branch scheitern. Secret-Scan/.gitignore-PROTECTED/AI-Trailer-Check bleiben aktiv.
for _refline in "${REF_LINES[@]}"; do
  read -r _lr local_sha rref remote_sha <<<"$_refline" || true
  [ "$local_sha" = "$ZERO" ] && continue
  is_appcast_pointer=0
  [ "$rref" = "refs/heads/beta-appcast-pointer" ] && is_appcast_pointer=1

  [ "$remote_sha" != "$ZERO" ] \
    && range="${remote_sha}..${local_sha}" \
    || range="$(git rev-list "$local_sha" --not --branches --remotes 2>/dev/null || echo "$local_sha")"

  [ -z "$range" ] && continue

  for commit in $(git rev-list "$range" 2>/dev/null); do
    files=$(git diff-tree --no-commit-id --name-only --diff-filter=ACMR -r "$commit" 2>/dev/null || true)
    [ -z "$files" ] && continue

    # .gitignore PROTECTED weakening
    if echo "$files" | grep -q "^\.gitignore$"; then
      new_block=$(git show "$commit:.gitignore" 2>/dev/null \
        | tr -d '\r' | sed -n '/PROTECTED-START/,/PROTECTED-END/p')
      old_block=$(git show "${commit}^:.gitignore" 2>/dev/null \
        | tr -d '\r' | sed -n '/PROTECTED-START/,/PROTECTED-END/p' || true)
      if [ -n "$old_block" ]; then
        old_ents=$(echo "$old_block" | grep -v '^#' | grep -v '^$' | grep -v 'PROTECTED' | sort -u)
        new_ents=$(echo "$new_block" | grep -v '^#' | grep -v '^$' | grep -v 'PROTECTED' | sort -u)
        removed=$(comm -23 <(echo "$old_ents") <(echo "$new_ents") 2>/dev/null || true)
        if [ -n "$removed" ]; then
          cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT: .gitignore PROTECTED entries entfernt      ║
║  Commit: ${commit:0:12}
╚══════════════════════════════════════════════════════════════╝
EOF
          echo "$removed" >&2
          exit 1
        fi
      fi
    fi

    # Secret patterns
    smatch=$(git show "$commit" 2>/dev/null \
      | grep -oE "$SECRET_PATTERNS" 2>/dev/null | head -1 || true)
    if [ -n "$smatch" ]; then
      cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT: potentielles Secret in Commit ${commit:0:12}
║  ${smatch:0:60}
╚══════════════════════════════════════════════════════════════╝
EOF
      exit 1
    fi

    # AI/Co-Authored-By Trailer — HARD RULE (global CLAUDE.md)
    trailer=$(git log -1 --format='%B' "$commit" 2>/dev/null \
      | grep -iE "$AI_TRAILER_RE" | head -1 || true)
    if [ -n "$trailer" ]; then
      cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT: KI-Co-Authored-By-Trailer in Commit ${commit:0:12}
║  $(echo "$trailer" | cut -c1-72)
║  Trailer entfernen (rebase -i / commit --amend), dann pushen.
╚══════════════════════════════════════════════════════════════╝
EOF
      exit 1
    fi

    # Bot author/committer -- skip commits already accepted onto some
    # remote-tracking ref (e.g. a CI manifest-bump commit already live on
    # origin/dev, or a github-actions[bot] commit from a past release
    # cycle): those were never new content to review, they only surface
    # here because this local push is the first one to carry that ref's
    # history across into another branch (dev -> main fast-forward etc).
    # Genuinely new bot-authored commits on THIS push are still caught,
    # since they cannot yet be reachable from any remote-tracking ref.
    [ "$is_appcast_pointer" = "1" ] && continue
    if [ -n "$(git branch -r --contains "$commit" 2>/dev/null)" ]; then
      continue
    fi
    ident=$(git log -1 --format='%an <%ae>%n%cn <%ce>' "$commit" 2>/dev/null || true)
    if echo "$ident" | grep -qiE "$BOT_RE"; then
      cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT: Bot-Author/Committer in Commit ${commit:0:12}
║  $(echo "$ident" | head -c80)
╚══════════════════════════════════════════════════════════════╝
EOF
      exit 1
    fi
  done
done

