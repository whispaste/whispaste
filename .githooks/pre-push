    cs="$(git rev-parse --verify --quiet "${local_sha}^{commit}" 2>/dev/null || echo "$local_sha")"
    # Same content attested elsewhere on this host (e.g. the local squash
    # of an attested feature branch) counts: the tree hash is the content.
    [ "$cs" = "$attested" ] || bash "$ATTESTSH" attested-tree "$cs" || {
      cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT: öffentliche Docs nicht für diesen Stand     ║
║  attestiert. Zu pushen: ${cs:0:12} · attestiert: ${attested:0:12}
║  → README/CHANGELOG/Website gegen den aktuellen Repo-Stand
║    PRÜFEN, dann BEWUSST bestätigen:
║    scripts/docs-attest.sh attest
║  (kein --no-verify)
╚══════════════════════════════════════════════════════════════╝
EOF
      exit 1
    }
  done
  if [ "$pushed_any" -eq 0 ] && [ "$saw_appcast_pointer" -eq 1 ]; then
    : # ausschließlich beta-appcast-pointer im Push -- HEAD-Fallback unten übersprungen
  elif [ "$pushed_any" -eq 0 ]; then
    head="$(git rev-parse HEAD)"
    [ "$head" = "$attested" ] || bash "$ATTESTSH" attested-tree "$head" || {
      cat >&2 <<EOF

╔══════════════════════════════════════════════════════════════╗
║  PUSH BLOCKIERT: HEAD ${head:0:12} ist nicht attestiert.
║  → BEWUSST bestätigen: scripts/docs-attest.sh attest
╚══════════════════════════════════════════════════════════════╝
EOF
      exit 1
    }
  fi
fi

