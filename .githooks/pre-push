  attested="$(bash "$ATTESTSH" attested)"
  pushed_any=0
  saw_appcast_pointer=0
  for _refline in "${REF_LINES[@]}"; do
    read -r _lr local_sha _rr _rs <<<"$_refline" || true
    [ -z "${local_sha:-}" ] && continue
    [ "$local_sha" = "$ZERO" ] && continue
