[Desktop Entry]
Type=Application
Name=WhisPaste
GenericName=Voice Input Tool
Comment=Hotkey, speak, paste anywhere — local or cloud transcription
Exec=whispaste %U
Icon=de.whispaste.app
Terminal=false
Categories=Utility;Accessibility;
Keywords=voice;speech;transcription;whisper;paste;hotkey;
MimeType=x-scheme-handler/whispaste;audio/x-wav;audio/wav;audio/vnd.wave;audio/mpeg;audio/flac;audio/x-flac;audio/mp4;audio/x-m4a;audio/aac;audio/x-aac;audio/ogg;audio/x-vorbis+ogg;audio/x-opus+ogg;audio/opus;
StartupWMClass=de.whispaste.app
