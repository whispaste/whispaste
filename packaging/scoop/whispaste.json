{
    "version": "1.5.1",
    "description": "Cross-platform dictation — hotkey, speak, paste anywhere.",
    "homepage": "https://whispaste.de",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/whispaste/whispaste/releases/download/v1.5.1/WhisPaste-1.5.1-windows-x64.zip",
            "hash": "4598e0794b88c5c6020b2adf001dd42aa69202f08194f09308c1a368f4126b81"
        }
    },
    "bin": "whispaste.exe",
    "shortcuts": [
        [
            "whispaste.exe",
            "WhisPaste"
        ]
    ],
    "post_install": [
        "# whispaste:// (newsletter return path); the app keeps it current on every start",
        "$key = 'HKCU:\\Software\\Classes\\whispaste'",
        "New-Item -Path \"$key\\shell\\open\\command\" -Force | Out-Null",
        "Set-Item -Path $key -Value 'URL:WhisPaste'",
        "New-ItemProperty -Path $key -Name 'URL Protocol' -Value '' -Force | Out-Null",
        "Set-Item -Path \"$key\\shell\\open\\command\" -Value \"`\"$(Split-Path $dir)\\current\\whispaste.exe`\" `\"%1`\"\""
    ],
    "uninstaller": {
        "script": [
            "Remove-Item -Path 'HKCU:\\Software\\Classes\\whispaste' -Recurse -Force -ErrorAction SilentlyContinue"
        ]
    },
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/whispaste/whispaste/releases/download/v$version/WhisPaste-$version-windows-x64.zip"
            }
        }
    }
}
