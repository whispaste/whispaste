# Pinned sherpa-onnx source for the TTS-free native build. Read by
# scripts/build-sherpa-onnx.sh, scripts/build-sherpa-onnx.ps1 and
# scripts/check-sherpa-stage.cmake. The tag's version must equal the
# sherpa_onnx version in pubspec.lock; the check fails the build otherwise.
SHERPA_TAG=v2.0.1
SHERPA_COMMIT=af2d8d81dbfa61c4cea4c568da78f3982edca005
# Reference hashes (GS-013) of the native C API library. Reference only, not a
# release gate: the build is reproducible within one checkout path but not across
# checkout paths (ThinLTO bitcode embeds the object path). Measured values are in
# BUILD.md. A mismatch is a warning from check-sherpa-stage.cmake; empty = none.
SHERPA_C_API_SHA256_MACOS=
SHERPA_C_API_SHA256_WINDOWS_X64=
SHERPA_C_API_SHA256_LINUX_X64=
SHERPA_C_API_SHA256_LINUX_AARCH64=
# onnxruntime archives (csukuangfj/onnxruntime-libs release v1.28.2). The build
# fetches each one itself and verifies SHA-256 before cmake runs (GS-008); the
# hashes must equal the ones in sherpa-onnx's cmake/onnxruntime-*.cmake, which
# the build checks. Windows uses the default CRT (MD) and Release.
ORT_VERSION=1.28.2
ORT_OSX_UNIVERSAL=onnxruntime-osx-universal2-1.28.2.zip
ORT_OSX_UNIVERSAL_SHA256=b5033fb68b907fb31b80f9735f4d97270de5a1958f3234f5ffd09ee6ae0d0191
ORT_LINUX_X64=onnxruntime-linux-x64-glibc2_17-Release-1.28.2.zip
ORT_LINUX_X64_SHA256=c4f8994d56191d9d2c92a961b39fe790459f2c5d155f912b239506ea31359534
ORT_LINUX_AARCH64=onnxruntime-linux-aarch64-glibc2_17-Release-1.28.2.zip
ORT_LINUX_AARCH64_SHA256=28083273643f40fa6477ef9d53986fe216304710c4b1c743b217a4effd016339
ORT_WIN_X64_MD_RELEASE=onnxruntime-win-x64-MD-Release-1.28.2.tar.bz2
# Documented hold on an older sherpa-onnx release (values in single quotes:
# build-sherpa-onnx.sh sources this file)
# (scripts/check-upstream-pins.sh): the reason and the check that lifts it.
# Empty = no hold; then a newer stable upstream release fails the
# pre-release check.
UPSTREAM_HOLD_REASON=''
UPSTREAM_HOLD_CHECK=''
ORT_WIN_X64_MD_RELEASE_SHA256=cdb3c68e317db991f85504e0f0ce5959528fba2c240b6c22e93366e80b3d2d58
