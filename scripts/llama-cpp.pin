# Pinned llama.cpp source (ggml-org/llama.cpp) for libllama and the Smart Mode
# shim on every platform. Read by scripts/build-libllama-{linux,macos}.sh,
# scripts/build-libllama-windows.ps1, scripts/build-smartmode-shim-{macos.sh,
# windows.ps1}, scripts/ensure-libllama-macos.sh, scripts/release-macos-local.sh
# and the release workflow. Raising it: BUILD.md "Raising native dependencies".
# b10150 was validated end-to-end in the Smart-Mode-v2 spike test
# (Gemma-4-E2B-it, --reasoning off, 17/18 correct on Metal + CPU-only);
# v0.8.0 gives bit-identical greedy output to b10150 through the shim.
LLAMA_TAG=v0.8.0
LLAMA_COMMIT=8642541b255bfb5dc39cd351a178be09013a55d6
# Documented hold on an older release (scripts/check-upstream-pins.sh): the
# reason and the check that lifts it, each in single quotes (the build
# scripts source this file). Empty = no hold; then a newer stable
# upstream release fails the pre-release check.
UPSTREAM_HOLD_REASON=
UPSTREAM_HOLD_CHECK=
