#!/bin/bash
# ╔═════════════════════════════════════════════════════════════════════╗
# ║  WhisPaste Pre-Push Guard                                          ║
# ║  Final defense before commits leave the local machine.             ║
# ║                                                                    ║
# ║  Layers:                                                           ║
# ║    L1 — Force-push to main blocked (env: WP_ALLOW_FORCE_MAIN=1)    ║
# ║    L2 — Protected paths in any pushed commit                       ║
# ║    L3 — .gitignore PROTECTED section not weakened                  ║
# ║    L4 — Secret patterns in any pushed commit                       ║
# ║                                                                    ║
# ║  Install: bash scripts/install-hooks.sh                            ║
# ║  Bypass:  git push --no-verify  (DANGEROUS)                        ║
# ╚═════════════════════════════════════════════════════════════════════╝

set -e

REMOTE="$1"
URL="$2"

ZERO="0000000000000000000000000000000000000000"

# Protected path patterns — must stay in sync with pre-commit BLOCKED_PATHS
# and the .gitignore PROTECTED-START/END section.
PROTECTED_PATTERNS="
^\.internal/
^docs/
^\.agents/
^\.agent/
^\.skills/
^\.claude/
^\.scratch/
^cmd/
^AGENTS\.md$
^CLAUDE\.md$
^CONTEXT\.md$
^opencode\.json$
^rules/
^skills\.yaml$
^skills-lock\.json$
^\.github/copilot-instructions\.md$
^scripts/security-scan\.ps1$
^scripts/cppcheck\.ps1$
^tools/sentry_release_audit\.py$
"

# Secret patterns — built dynamically so this file does not self-match.
S1="SUPA"
S2="BASE_SERVICE_ROLE_KEY"
S3="ADMIN_API"
S4="_KEY"
SECRET_PATTERNS="${S1}${S2}=.{20,}|${S3}${S4}=.{20,}|sk-[a-zA-Z0-9]{20,}|ghp_[a-zA-Z0-9]{20,}"

violations=0

print_block_header() {
  echo ""
  echo "╔═══════════════════════════════════════════════════════════╗"
  echo "║  ❌ BLOCKED: $1"
  echo "╚═══════════════════════════════════════════════════════════╝"
}

while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip branch deletions (local_sha = 0000…)
  [ "$local_sha" = "$ZERO" ] && continue

  branch="${remote_ref#refs/heads/}"

  # ── L1: Force-push to main ────────────────────────────────────────
  if [ "$branch" = "main" ] && [ "$remote_sha" != "$ZERO" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      if [ "$WP_ALLOW_FORCE_MAIN" != "1" ]; then
        print_block_header "force-push to main"
        echo "  main is a release branch — its history must stay linear."
        echo "  Remote tip $remote_sha is not an ancestor of $local_sha."
        echo ""
        echo "  Override (DANGEROUS):"
        echo "    WP_ALLOW_FORCE_MAIN=1 git push $REMOTE main"
        echo ""
        exit 1
      fi
      echo "  ⚠ WP_ALLOW_FORCE_MAIN=1 set — force-push to main allowed"
    fi
  fi

  # ── Determine range of commits to scan ────────────────────────────
  if [ "$remote_sha" = "$ZERO" ]; then
    # New branch on remote — scan all commits unique to this branch
    commits=$(git rev-list "$local_sha" --not --branches --remotes 2>/dev/null \
      || git rev-list "$local_sha" 2>/dev/null || true)
  else
    commits=$(git rev-list "$remote_sha..$local_sha" 2>/dev/null || true)
  fi

  [ -z "$commits" ] && continue

  for commit in $commits; do
    files=$(git diff-tree --no-commit-id --name-only --diff-filter=ACMR -r "$commit" 2>/dev/null || true)
    [ -z "$files" ] && continue

    # ── L2: Protected paths ────────────────────────────────────────
    for pattern in $PROTECTED_PATTERNS; do
      [ -z "$pattern" ] && continue
      matches=$(echo "$files" | grep -E "$pattern" 2>/dev/null || true)
      if [ -n "$matches" ]; then
        print_block_header "protected path in pushed commit"
        echo "  Commit: $commit"
        echo "  Branch: $branch"
        echo "  Files:"
        echo "$matches" | sed 's/^/    /'
        violations=1
      fi
    done

    # ── L3: .gitignore PROTECTED section weakened ──────────────────
    if echo "$files" | grep -q "^\.gitignore$"; then
      # Strip CR so a CRLF/LF normalisation commit isn't misread as a weakened section.
      new_block=$(git show "$commit:.gitignore" 2>/dev/null \
        | tr -d '\r' | sed -n '/PROTECTED-START/,/PROTECTED-END/p')
      old_block=$(git show "$commit^:.gitignore" 2>/dev/null \
        | tr -d '\r' | sed -n '/PROTECTED-START/,/PROTECTED-END/p')
      if [ -n "$old_block" ]; then
        old_entries=$(echo "$old_block" | grep -v '^#' | grep -v '^$' | grep -v 'PROTECTED' | sort -u)
        new_entries=$(echo "$new_block" | grep -v '^#' | grep -v '^$' | grep -v 'PROTECTED' | sort -u)
        removed=$(comm -23 <(echo "$old_entries") <(echo "$new_entries") 2>/dev/null || true)
        if [ -n "$removed" ]; then
          print_block_header ".gitignore PROTECTED entries removed"
          echo "  Commit: $commit"
          echo "  Removed entries:"
          echo "$removed" | sed 's/^/    /'
          violations=1
        fi
      fi
    fi

    # ── L4: Secret patterns ────────────────────────────────────────
    secret_match=$(git show "$commit" 2>/dev/null \
      | grep -oE "$SECRET_PATTERNS" 2>/dev/null \
      | head -1 || true)
    if [ -n "$secret_match" ]; then
      print_block_header "potential secret in pushed commit"
      echo "  Commit: $commit"
      echo "  Match (truncated): $(echo "$secret_match" | cut -c1-40)"
      violations=1
    fi

    # ── L4.5: Contributor hygiene — no bot author / committer / trailer ──
    # GitHub builds its Contributors list from commit authors AND
    # `Co-authored-by:` trailers. Solo project → only Silvio may appear.
    # This backstops the commit-msg hook (catches rebases / --no-verify).
    BOT_RE='(co-?pilot|anthropic|claude|github-actions|dependabot|\[bot\]|users\.noreply\.github\.com|noreply@github\.com)'
    ident=$(git log -1 --format='%an <%ae>%n%cn <%ce>' "$commit" 2>/dev/null || true)
    if echo "$ident" | grep -qiE "$BOT_RE"; then
      print_block_header "bot author/committer in pushed commit"
      echo "  Commit: $commit"
      echo "$ident" | sed 's/^/    /'
      violations=1
    fi
    trailer=$(git log -1 --format='%B' "$commit" 2>/dev/null \
      | grep -iE '^[[:space:]]*(co-?authored-by:|generated-by:|assisted-by:|helped-by:|🤖[[:space:]]*generated|generated with \[?(claude|copilot)|.*generated with \[?claude code)' \
      | head -1 || true)
    if [ -n "$trailer" ]; then
      print_block_header "AI/co-author trailer in pushed commit"
      echo "  Commit: $commit"
      echo "    $(echo "$trailer" | cut -c1-72)"
      echo "  Strip it: git rebase -i to edit the message, or re-run with the commit-msg hook active."
      violations=1
    fi
  done
done

if [ "$violations" -eq 1 ]; then
  echo ""
  echo "To bypass (DANGEROUS): git push --no-verify"
  echo ""
  exit 1
fi

# ── L5: Semgrep SAST scan ─────────────────────────────────────────────
# Runs the community CI rule pack on all source files.
# Skipped if semgrep is not installed (non-blocking for new machines).

if command -v semgrep >/dev/null 2>&1; then
  echo ""
  echo "◆ Semgrep SAST scan..."
  if ! semgrep \
    --config p/ci \
    --error \
    --quiet \
    --include="*.ts" --include="*.js" --include="*.mjs" \
    --include="*.cpp" --include="*.h" \
    --include="*.go" \
    --exclude="node_modules" \
    --exclude="dist" \
    --exclude="build" \
    --exclude=".dart_tool" \
    . 2>&1; then
    echo ""
    echo "╔═══════════════════════════════════════════════════════════╗"
    echo "║  ❌ BLOCKED: Semgrep found security issues               ║"
    echo "╚═══════════════════════════════════════════════════════════╝"
    echo ""
    echo "Fix all findings above before pushing."
    echo "To bypass (DANGEROUS): git push --no-verify"
    echo ""
    exit 1
  fi
  echo "  ✓ Semgrep: no findings"
else
  echo "  ⚠ Semgrep not available — skipping (install: brew install semgrep)"
fi

# ── L6: OSV-Scanner — dependency vulnerability check ─────────────────
# Scans pubspec.lock (Dart/Flutter) and website/package-lock.json (npm)
# against the OSV database — same source as Dependabot.
# Skipped if osv-scanner is not installed (non-blocking for new machines).

if command -v osv-scanner >/dev/null 2>&1; then
  echo ""
  echo "◆ OSV vulnerability scan (pub + npm)..."
  OSV_ARGS=""
  [ -f pubspec.lock ]                  && OSV_ARGS="$OSV_ARGS --lockfile pubspec.lock"
  [ -f website/package-lock.json ]     && OSV_ARGS="$OSV_ARGS --lockfile website/package-lock.json"

  if [ -n "$OSV_ARGS" ]; then
    if ! osv-scanner scan $OSV_ARGS 2>&1; then
      echo ""
      echo "╔═══════════════════════════════════════════════════════════╗"
      echo "║  ❌ BLOCKED: OSV found vulnerable dependencies           ║"
      echo "╚═══════════════════════════════════════════════════════════╝"
      echo ""
      echo "Update the affected packages before pushing."
      echo "To bypass (DANGEROUS): git push --no-verify"
      echo ""
      exit 1
    fi
    echo "  ✓ OSV scan: no vulnerabilities"
  fi
else
  echo "  ⚠ osv-scanner not available — skipping (install: brew install osv-scanner)"
fi

exit 0
