# WhisPaste local development secrets
# Copy this file to .env and fill in your keys.
# NEVER commit .env — it is gitignored.

OPENAI_API_KEY=sk-your-key-here

# Supabase — für lokales Entwickeln mit echtem Feedback-System.
# Werte: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# New Supabase publishable key (replaces legacy anon key).
# Find at: Supabase Dashboard → Project Settings → API → API Keys (new, not Legacy)
# Format: sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx_xxxxxxxx
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Sentry — error tracking for crash reporting & release monitoring.
# DSN (client-side, safe to embed): https://sentry.io → [Project] → Settings → Client Keys (DSN)
# Format: https://[PUBLIC_KEY]@[ORG_ID].ingest.[REGION].sentry.io/[PROJECT_ID]
SENTRY_DSN=https://1dc761fb2739811a24425fd32518f611@o4511065943441408.ingest.de.sentry.io/4511185948180560

# Auth Token (for CI/CD release creation & source maps). Private, store in GitHub secrets.
# Create at: https://de.sentry.io → Settings → Auth Tokens → New Token
# Required scopes: project:releases, org:read
SENTRY_AUTH_TOKEN=sntrys_your-auth-token-here
