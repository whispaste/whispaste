    "dompurify": "^3.4.3",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^28.0.3",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.3.0",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.6"
