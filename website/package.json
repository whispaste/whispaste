    "@sentry/astro": "^10.54.0",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^7.1.3",
    "dompurify": "^3.4.13",
    "gsap": "^3.15.0",
    "tailwindcss": "^4.2.1",
    "three": "^0.185.1",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/jsdom": "^28.0.3",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.3.0",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^17.6.0",
