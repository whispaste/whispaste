---
/**
 * `/offline-speech-to-text/` — Erklär-Page für Offline-Speech-to-Text
 * (Issue 12, PRD §E).
 *
 * Beantwortet den `docs/zielgruppe.md`-Lackmustest („Hilft das jemandem,
 * der STT lokal will und wissen muss, was Offline-Modus konkret kann und
 * was nicht?") direkt im Hero-Lead. Drei Sections decken die häufigsten
 * Friction-Punkte ab: Modus-Wahl lokal-vs.-Cloud, Capabilities-Grenzen,
 * RAM-/CPU-Profil.
 *
 * Schema-Wahl: FAQPage, weil die typische Such-Intention aus konkreten
 * Fragen besteht („Welche Modellgröße? Wirklich ohne Internet? Wie genau?").
 * Die Q&A-Paare spiegeln 1:1 die sichtbare `<dl>`-Liste — Google Rich-
 * Results-Anforderung.
 *
 * Slug: DE und EN nutzen denselben Slug `offline-speech-to-text`, weil
 * `Speech-to-Text` als Begriff im DE-Tech-Sprachraum gleich verwendet wird.
 */
import LandingPageLayout from "../layouts/LandingPageLayout.astro";
import FAQPageSchema from "../components/schema/FAQPageSchema.astro";
import { t, localePath } from "../scripts/i18n.ts";

const lang = "de" as const;

const breadcrumbs = [
  { name: t(lang, "breadcrumb.home"), item: localePath(lang, "") },
  { name: t(lang, "explainer.offlineStt.breadcrumb"), item: localePath(lang, "offline-speech-to-text") },
];

const seo = {
  title: t(lang, "explainer.offlineStt.seoTitle"),
  description: t(lang, "explainer.offlineStt.seoDescription"),
};

const hero = {
  heading: t(lang, "explainer.offlineStt.heroHeading"),
  lead: t(lang, "explainer.offlineStt.heroLead"),
};

const cta = {
  label: t(lang, "explainer.offlineStt.cta.label"),
  href: localePath(lang, "download"),
};

const faqQuestions = [
  {
    question: t(lang, "explainer.offlineStt.faq.modelSize.q"),
    answer: t(lang, "explainer.offlineStt.faq.modelSize.a"),
  },
  {
    question: t(lang, "explainer.offlineStt.faq.noInternet.q"),
    answer: t(lang, "explainer.offlineStt.faq.noInternet.a"),
  },
  {
    question: t(lang, "explainer.offlineStt.faq.accuracy.q"),
    answer: t(lang, "explainer.offlineStt.faq.accuracy.a"),
  },
];

const alternateSlugs = { de: "offline-speech-to-text", en: "offline-speech-to-text" };

const relatedPages = [
  { label: t(lang, "explainer.whisperDesktop.breadcrumb"), href: localePath(lang, "whisper-desktop") },
  { label: t(lang, "explainer.privacy.breadcrumb"), href: localePath(lang, "privatsphaere-spracherkennung") },
  { label: t(lang, "comparison.dictationAlternatives.breadcrumb"), href: localePath(lang, "vergleich/diktiersoftware-alternativen") },
  { label: t(lang, "comparison.osDictation.breadcrumb"), href: localePath(lang, "vergleich/whispaste-vs-system-spracheingabe") },
  { label: t(lang, "linuxStt.breadcrumb"), href: localePath(lang, "linux-spracherkennung") },
];
---

<LandingPageLayout
  lang={lang}
  seo={seo}
  breadcrumbs={breadcrumbs}
  hero={hero}
  cta={cta}
  alternateSlugs={alternateSlugs}
  relatedPages={relatedPages}
>
  <p class="tldr">{t(lang, "explainer.offlineStt.tldr")}</p>

  <section>
    <h2>{t(lang, "explainer.offlineStt.section.modes.heading")}</h2>
    <p>{t(lang, "explainer.offlineStt.section.modes.body")}</p>
  </section>

  <section>
    <h2>{t(lang, "explainer.offlineStt.section.capabilities.heading")}</h2>
    <p>{t(lang, "explainer.offlineStt.section.capabilities.body")}</p>
  </section>

  <section>
    <h2>{t(lang, "explainer.offlineStt.section.resourceProfile.heading")}</h2>
    <p>{t(lang, "explainer.offlineStt.section.resourceProfile.body")}</p>
    <dl class="faq-list">
      {faqQuestions.map((entry) => (
        <div class="faq-item">
          <dt>{entry.question}</dt>
          <dd>{entry.answer}</dd>
        </div>
      ))}
    </dl>
  </section>

  <FAQPageSchema locale={lang} questions={faqQuestions} />
</LandingPageLayout>

<style>
  .tldr {
    color: #e5e7eb;
    font-size: 1.0625rem;
    line-height: 1.65;
  }
  .faq-list {
    margin-top: 1rem;
  }
  .faq-item + .faq-item {
    margin-top: 1rem;
  }
  .faq-list dt {
    color: #e5e7eb;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .faq-list dd {
    color: #9ca3af;
    line-height: 1.6;
    margin: 0;
  }
</style>
