---
/**
 * `/use-cases/rsi/` — Use-Case-Page für RSI-betroffene Wissensarbeitende
 * (Issue 11).
 *
 * Beantwortet den `docs/zielgruppe.md`-Lackmustest („Hilft das RSI-betroffenen
 * Wissensarbeitenden, die im Verlauf eines Arbeitstages keine Tasten mehr
 * drücken können?") direkt im Hero-Lead. Drei Sections decken die häufigsten
 * Friction-Punkte ab: Flow an schlechten Tipp-Tagen, Ergonomie ohne
 * Kontextwechsel, Umgang mit Tagesschwankungen.
 *
 * Schema-Wahl: FAQPage (statt HowTo), weil RSI-Betroffene typischerweise mit
 * konkreten Fragen zur App ankommen („Hilft das bei Karpaltunnel?",
 * „Funktionieren Sprachpausen?"). FAQ-Rich-Results decken diesen Intent ab.
 * Die Fragen/Antworten spiegeln die i18n-Keys 1:1 — Google verlangt, dass
 * Schema-Inhalt visuell auf der Seite existiert (siehe Builders-Kommentar).
 *
 * Slug: DE/EN beide `rsi` — der Begriff ist als Akronym global verbreitet,
 * eine Lokalisierung würde nur Verwirrung stiften.
 */
import LandingPageLayout from "../../layouts/LandingPageLayout.astro";
import FAQPageSchema from "../../components/schema/FAQPageSchema.astro";
import { t, localePath } from "../../scripts/i18n.ts";

const lang = "de" as const;

const breadcrumbs = [
  { name: t(lang, "breadcrumb.home"), item: localePath(lang, "") },
  { name: t(lang, "breadcrumb.useCases"), item: localePath(lang, "use-cases") },
  { name: t(lang, "useCase.rsi.breadcrumb"), item: localePath(lang, "use-cases/rsi") },
];

const seo = {
  title: t(lang, "useCase.rsi.seoTitle"),
  description: t(lang, "useCase.rsi.seoDescription"),
};

const hero = {
  heading: t(lang, "useCase.rsi.heroHeading"),
  lead: t(lang, "useCase.rsi.heroLead"),
};

const cta = {
  label: t(lang, "useCase.rsi.cta.label"),
  href: localePath(lang, "download"),
};

const faqQuestions = [
  {
    question: t(lang, "useCase.rsi.faq.karpaltunnel.q"),
    answer: t(lang, "useCase.rsi.faq.karpaltunnel.a"),
  },
  {
    question: t(lang, "useCase.rsi.faq.pauses.q"),
    answer: t(lang, "useCase.rsi.faq.pauses.a"),
  },
  {
    question: t(lang, "useCase.rsi.faq.dayVariation.q"),
    answer: t(lang, "useCase.rsi.faq.dayVariation.a"),
  },
];

const alternateSlugs = { de: "use-cases/rsi", en: "use-cases/rsi" };
---

<LandingPageLayout
  lang={lang}
  seo={seo}
  breadcrumbs={breadcrumbs}
  hero={hero}
  cta={cta}
  alternateSlugs={alternateSlugs}
>
  <section>
    <h2>{t(lang, "useCase.rsi.section.flow.heading")}</h2>
    <p>{t(lang, "useCase.rsi.section.flow.body")}</p>
  </section>

  <section>
    <h2>{t(lang, "useCase.rsi.section.ergonomics.heading")}</h2>
    <p>{t(lang, "useCase.rsi.section.ergonomics.body")}</p>
  </section>

  <section>
    <h2>{t(lang, "useCase.rsi.section.dailyVariation.heading")}</h2>
    <p>{t(lang, "useCase.rsi.section.dailyVariation.body")}</p>
    <dl class="faq-list">
      {faqQuestions.map((entry) => (
        <div class="faq-item">
          <dt>{entry.question}</dt>
          <dd>{entry.answer}</dd>
        </div>
      ))}
    </dl>
  </section>

  <FAQPageSchema locale={lang} questions={faqQuestions} />
</LandingPageLayout>

<style>
  .faq-list {
    margin-top: 1rem;
  }
  .faq-item + .faq-item {
    margin-top: 1rem;
  }
  .faq-list dt {
    color: #e5e7eb;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .faq-list dd {
    color: #9ca3af;
    line-height: 1.6;
    margin: 0;
  }
</style>
