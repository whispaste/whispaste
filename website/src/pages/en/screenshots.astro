---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import ScreenshotGallery from "../../components/ScreenshotGallery.astro";
import BreadcrumbListSchema from "../../components/schema/BreadcrumbListSchema.astro";
import { t, localePath } from "../../scripts/i18n.ts";

const lang = (Astro.currentLocale === "en" ? "en" : "de") as "de" | "en";
const downloadHref = lang === "de" ? "/download" : "/en/download";
const breadcrumbItems = [
  { name: t(lang, "breadcrumb.home"), item: localePath(lang, "") },
  { name: t(lang, "breadcrumb.screenshots"), item: localePath(lang, "screenshots") },
];
---

<Layout
  title={t(lang, "meta.title.screenshots")}
  description={t(lang, "meta.description.screenshots")}
>
  <Nav variant="subpage" />
  <main id="main-content" class="pt-20 pb-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <h1
          class="text-3xl sm:text-4xl font-bold text-white mb-3"
          data-i18n="gallery.title"
        >
          {t(lang, "gallery.title")}
        </h1>
        <p
          class="text-gray-400 text-lg max-w-2xl mx-auto"
          data-i18n="gallery.desc"
        >
          {t(lang, "gallery.desc")}
        </p>
      </div>

      <ScreenshotGallery />

      <div class="text-center mt-14">
        <a
          href={downloadHref}
          class="inline-flex items-center gap-2 px-6 py-3 bg-brand-cyan text-brand-darker font-semibold rounded-xl hover:opacity-90 transition-opacity"
          data-i18n="gallery.cta"
        >
          {t(lang, "gallery.cta")}
        </a>
      </div>
    </div>
  </main>
  <Footer variant="subpage" />

  <script>
    import { applyLang } from '../../scripts/i18n';
    import { updateThemeIcon } from '../../scripts/theme';
    applyLang();
    updateThemeIcon();
  </script>

  <BreadcrumbListSchema items={breadcrumbItems} />
</Layout>
