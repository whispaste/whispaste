---
/**
 * `/en/comparison/whispaste-vs-system-speech-to-text/` — English mirror of
 * the WhisPaste-vs-OS-Diktat comparison page (Issue 13). Slug intentionally
 * omits the anti-vocab `dictation` token; the contrastive anti-vocab copy
 * lives inside the `<!-- seo-audit:contrastive -->` marker in the slot.
 */
import LandingPageLayout from "../../../layouts/LandingPageLayout.astro";
import FAQPageSchema from "../../../components/schema/FAQPageSchema.astro";
import { t, localePath } from "../../../scripts/i18n.ts";

const lang = "en" as const;

const breadcrumbs = [
  { name: t(lang, "breadcrumb.home"), item: localePath(lang, "") },
  { name: t(lang, "comparison.breadcrumb"), item: localePath(lang, "comparison") },
  {
    name: t(lang, "comparison.osDictation.breadcrumb"),
    item: localePath(lang, "comparison/whispaste-vs-system-speech-to-text"),
  },
];

const seo = {
  title: t(lang, "comparison.osDictation.seoTitle"),
  description: t(lang, "comparison.osDictation.seoDescription"),
};

const hero = {
  heading: t(lang, "comparison.osDictation.heroHeading"),
  lead: t(lang, "comparison.osDictation.heroLead"),
};

const cta = {
  label: t(lang, "comparison.osDictation.cta.label"),
  href: localePath(lang, "download"),
};

const faqQuestions = [
  {
    question: t(lang, "comparison.osDictation.faq.inAnyApp.q"),
    answer: t(lang, "comparison.osDictation.faq.inAnyApp.a"),
  },
  {
    question: t(lang, "comparison.osDictation.faq.whenSystemDictation.q"),
    answer: t(lang, "comparison.osDictation.faq.whenSystemDictation.a"),
  },
  {
    question: t(lang, "comparison.osDictation.faq.multiLanguage.q"),
    answer: t(lang, "comparison.osDictation.faq.multiLanguage.a"),
  },
];

const alternateSlugs = {
  de: "vergleich/whispaste-vs-system-spracheingabe",
  en: "comparison/whispaste-vs-system-speech-to-text",
};
---

<LandingPageLayout
  lang={lang}
  seo={seo}
  breadcrumbs={breadcrumbs}
  hero={hero}
  cta={cta}
  alternateSlugs={alternateSlugs}
>
  {/*
    Astro strips raw HTML comments from .astro template bodies during build,
    so the contrastive marker is injected via `Fragment set:html` to ensure
    the literal comment survives into the rendered HTML and the
    `stripContrastive` scanner in `check-brand-vocabulary.mjs` can locate
    its open/close pair.
  */}
  <Fragment set:html={"<!-- seo-audit:contrastive -->"} />
  <section>
    <h2>{t(lang, "comparison.osDictation.section.inlineVsPaste.heading")}</h2>
    <p>{t(lang, "comparison.osDictation.section.inlineVsPaste.body")}</p>
  </section>

  <section>
    <h2>{t(lang, "comparison.osDictation.section.providerChoice.heading")}</h2>
    <p>{t(lang, "comparison.osDictation.section.providerChoice.body")}</p>
  </section>

  <section>
    <h2>{t(lang, "comparison.osDictation.section.languageSupport.heading")}</h2>
    <p>{t(lang, "comparison.osDictation.section.languageSupport.body")}</p>
    <dl class="faq-list">
      {faqQuestions.map((entry) => (
        <div class="faq-item">
          <dt>{entry.question}</dt>
          <dd>{entry.answer}</dd>
        </div>
      ))}
    </dl>
  </section>

  <FAQPageSchema locale={lang} questions={faqQuestions} />
  <Fragment set:html={"<!-- /seo-audit:contrastive -->"} />
</LandingPageLayout>

<style>
  .faq-list {
    margin-top: 1rem;
  }
  .faq-item + .faq-item {
    margin-top: 1rem;
  }
  .faq-list dt {
    color: #e5e7eb;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .faq-list dd {
    color: #9ca3af;
    line-height: 1.6;
    margin: 0;
  }
</style>
