---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import StoreButton from "../../components/StoreButton.astro";
import AppleButton from "../../components/AppleButton.astro";
import DownloadSupportModal from "../../components/DownloadSupportModal.astro";
import BreadcrumbListSchema from "../../components/schema/BreadcrumbListSchema.astro";
import { t, localePath } from "../../scripts/i18n.ts";
import {
  WINDOWS_SETUP_URL,
  DIAGNOSE_WINDOWS_URL,
  DIAGNOSE_MACOS_URL,
  GITHUB_REPO_URL,
  getLivePkgManagers,
} from "../../data/platforms.ts";

const livePkgManagers = getLivePkgManagers();

const lang = (Astro.currentLocale === "en" ? "en" : "de") as "de" | "en";
const breadcrumbItems = [
  { name: t(lang, "breadcrumb.home"), item: localePath(lang, "") },
  { name: t(lang, "breadcrumb.download"), item: localePath(lang, "download") },
];
---

<Layout title={t(lang, "meta.title.download")} description={t(lang, "meta.description.download")}>

  <div class="min-h-screen flex flex-col">
    <Nav variant="subpage" />

    <main id="main-content" class="flex-1 pt-24 pb-16 px-6">
      <div class="max-w-3xl mx-auto">

        <!-- Page header -->
        <div class="text-center mb-12">
          <h1 class="text-3xl sm:text-4xl font-bold text-white mb-3" data-i18n="download.title">{t(lang, "download.title")}</h1>
          <p class="text-gray-400 text-lg" data-i18n="download.subtitle">{t(lang, "download.subtitle")}</p>
        </div>

        <!-- Section 1: Microsoft Store (recommended for Windows) -->
        <div class="download-card rounded-2xl border p-6 sm:p-8 mb-6 relative" data-platform-card="windows">
          <div class="absolute -top-3 left-6">
            <span class="items-center gap-1 px-3 py-1 rounded-full recommended-badge ring-1 ring-brand-cyan/30 text-brand-cyan text-xs font-semibold">
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <span data-i18n="download.store.recommended">{t(lang, "download.store.recommended")}</span>
            </span>
          </div>

          <div class="flex items-start gap-3 mb-5 mt-2">
            <div class="shrink-0 w-10 h-10 rounded-xl bg-brand-cyan/10 border border-brand-cyan/20 flex items-center justify-center">
              <svg class="w-5 h-5 text-brand-cyan" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M0 3.5L9.9 2.2v9.4H0zm11.1-1.5L24 0v11.5H11.1zM0 12.6h9.9v9.4L0 20.7zm11.1-.1H24V24l-12.9-1.8z"/></svg>
            </div>
            <div>
              <h2 class="text-xl font-semibold text-white" data-i18n="download.store.title">{t(lang, "download.store.title")}</h2>
              <p class="text-gray-400 text-sm mt-1" data-i18n="download.store.desc">{t(lang, "download.store.desc")}</p>
            </div>
          </div>

          <!-- Benefits grid -->
          <div class="grid grid-cols-2 gap-2 mb-6">
            <div class="flex items-center gap-2 text-sm text-gray-300">
              <svg class="w-4 h-4 text-brand-cyan shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
              <span data-i18n="download.store.benefit1">{t(lang, "download.store.benefit1")}</span>
            </div>
            <div class="flex items-center gap-2 text-sm text-gray-300">
              <svg class="w-4 h-4 text-brand-cyan shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>
              <span data-i18n="download.store.benefit2">{t(lang, "download.store.benefit2")}</span>
            </div>
            <div class="flex items-center gap-2 text-sm text-gray-300">
              <svg class="w-4 h-4 text-brand-cyan shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <span data-i18n="download.store.benefit3">{t(lang, "download.store.benefit3")}</span>
            </div>
            <div class="flex items-center gap-2 text-sm text-gray-300">
              <svg class="w-4 h-4 text-pink-400/80 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              <span data-i18n="download.store.benefit4">{t(lang, "download.store.benefit4")}</span>
            </div>
          </div>

          <!-- Store button -->
          <div class="flex flex-col items-center gap-3">
            <StoreButton size="lg" />
            <p class="text-xs text-gray-500 flex items-center gap-1">
              <svg class="w-3 h-3 text-pink-400/60" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              <span data-i18n="download.store.hint">{t(lang, "download.store.hint")}</span>
            </p>
          </div>
        </div>

        <!-- Section 2: macOS (recommended for macOS) -->
        <div class="download-card rounded-2xl border p-6 sm:p-8 mb-6 relative" data-platform-card="macos">
          <div class="absolute -top-3 left-6">
            <span class="items-center gap-1 px-3 py-1 rounded-full recommended-badge ring-1 ring-brand-cyan/30 text-brand-cyan text-xs font-semibold">
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <span data-i18n="download.store.recommended">{t(lang, "download.store.recommended")}</span>
            </span>
          </div>
          <div class="flex items-start gap-3 mb-5 mt-2">
            <div class="shrink-0 w-10 h-10 rounded-xl bg-white/[0.06] border border-white/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-gray-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
            </div>
            <div>
              <h2 class="text-xl font-semibold text-white" data-i18n="download.macos.title">{t(lang, "download.macos.title")}</h2>
              <p class="text-gray-400 text-sm mt-1" data-i18n="download.macos.desc">{t(lang, "download.macos.desc")}</p>
            </div>
          </div>

          <div class="flex justify-center mb-4">
            <AppleButton size="lg" />
          </div>

          <p class="text-center text-xs text-gray-500 mb-4" data-i18n="download.macos.hint">{t(lang, "download.macos.hint")}</p>

          <!-- Gatekeeper guide — full Apple-style step-by-step -->
          <div class="smartscreen-box rounded-xl border border-amber-500/10 bg-amber-500/[0.03] p-5">
            <div class="flex items-start gap-3 mb-4">
              <svg class="w-5 h-5 text-amber-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>
              <div>
                <h3 class="font-medium text-white text-sm" data-i18n="download.macos.gatekeeper.title">{t(lang, "download.macos.gatekeeper.title")}</h3>
                <p class="text-gray-400 text-xs mt-1 leading-relaxed" data-i18n="download.macos.gatekeeper.step1.desc">{t(lang, "download.macos.gatekeeper.step1.desc")}</p>
              </div>
            </div>

            <div class="space-y-3 ml-8">
              <div class="flex gap-3">
                <div class="shrink-0 w-6 h-6 rounded-full bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 font-semibold text-xs">1</div>
                <div>
                  <h4 class="font-medium text-white text-sm" data-i18n="download.macos.gatekeeper.step2.title">{t(lang, "download.macos.gatekeeper.step2.title")}</h4>
                  <p class="text-gray-400 text-xs mt-0.5 leading-relaxed" data-i18n="download.macos.gatekeeper.step2.desc">{t(lang, "download.macos.gatekeeper.step2.desc")}</p>
                </div>
              </div>
              <div class="flex gap-3">
                <div class="shrink-0 w-6 h-6 rounded-full bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 font-semibold text-xs">2</div>
                <div>
                  <h4 class="font-medium text-white text-sm" data-i18n="download.macos.gatekeeper.step3.title">{t(lang, "download.macos.gatekeeper.step3.title")}</h4>
                  <p class="text-gray-400 text-xs mt-0.5 leading-relaxed" data-i18n="download.macos.gatekeeper.step3.desc">{t(lang, "download.macos.gatekeeper.step3.desc")}</p>
                </div>
              </div>
              <div class="flex gap-3">
                <div class="shrink-0 w-6 h-6 rounded-full bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 font-semibold text-xs">3</div>
                <div>
                  <h4 class="font-medium text-white text-sm" data-i18n="download.macos.gatekeeper.step4.title">{t(lang, "download.macos.gatekeeper.step4.title")}</h4>
                  <p class="text-gray-400 text-xs mt-0.5 leading-relaxed" data-i18n="download.macos.gatekeeper.step4.desc">{t(lang, "download.macos.gatekeeper.step4.desc")}</p>
                </div>
              </div>
            </div>

            <!-- Why section -->
            <div class="mt-4 ml-8 pt-4 border-t border-amber-500/10">
              <h4 class="font-medium text-white/70 text-xs uppercase tracking-wider mb-1" data-i18n="download.macos.gatekeeper.why.title">{t(lang, "download.macos.gatekeeper.why.title")}</h4>
              <p class="text-gray-500 text-xs leading-relaxed" data-i18n="download.macos.gatekeeper.why.desc">{t(lang, "download.macos.gatekeeper.why.desc")}</p>
            </div>
          </div>
        </div>

        <!-- Section 3: Linux — Build from Source -->
        <div class="download-card rounded-2xl border p-6 sm:p-8 mb-6 relative" data-platform-card="linux">
          <div class="flex items-start gap-3 mb-5">
            <div class="shrink-0 w-10 h-10 rounded-xl bg-white/[0.06] border border-white/10 flex items-center justify-center">
              <!-- Linux terminal icon -->
              <svg class="w-5 h-5 text-gray-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/></svg>
            </div>
            <div>
              <h2 class="text-xl font-semibold text-white" data-i18n="download.linux.title">{t(lang, "download.linux.title")}</h2>
              <p class="text-gray-400 text-sm mt-1" data-i18n="download.linux.desc">{t(lang, "download.linux.desc")}</p>
            </div>
          </div>

          <p class="text-gray-400 text-sm mb-5 leading-relaxed" data-i18n="download.linux.build.intro">{t(lang, "download.linux.build.intro")}</p>

          <div class="space-y-3 mb-5">
            <div class="flex gap-3">
              <div class="shrink-0 w-6 h-6 rounded-full bg-brand-cyan/10 border border-brand-cyan/20 flex items-center justify-center text-brand-cyan font-semibold text-xs">1</div>
              <div>
                <h4 class="font-medium text-white text-sm" data-i18n="download.linux.build.step1.title">{t(lang, "download.linux.build.step1.title")}</h4>
                <p class="text-gray-400 text-xs mt-0.5 leading-relaxed" data-i18n="download.linux.build.step1.desc">{t(lang, "download.linux.build.step1.desc")}</p>
              </div>
            </div>
            <div class="flex gap-3">
              <div class="shrink-0 w-6 h-6 rounded-full bg-brand-cyan/10 border border-brand-cyan/20 flex items-center justify-center text-brand-cyan font-semibold text-xs">2</div>
              <div>
                <h4 class="font-medium text-white text-sm" data-i18n="download.linux.build.step2.title">{t(lang, "download.linux.build.step2.title")}</h4>
                <p class="text-gray-400 text-xs mt-0.5 leading-relaxed" data-i18n="download.linux.build.step2.desc">{t(lang, "download.linux.build.step2.desc")}</p>
              </div>
            </div>
            <div class="flex gap-3">
              <div class="shrink-0 w-6 h-6 rounded-full bg-brand-cyan/10 border border-brand-cyan/20 flex items-center justify-center text-brand-cyan font-semibold text-xs">3</div>
              <div>
                <h4 class="font-medium text-white text-sm" data-i18n="download.linux.build.step3.title">{t(lang, "download.linux.build.step3.title")}</h4>
                <p class="text-gray-400 text-xs mt-0.5 leading-relaxed" data-i18n="download.linux.build.step3.desc">{t(lang, "download.linux.build.step3.desc")}</p>
              </div>
            </div>
          </div>

          <div class="flex justify-center">
            <a
              href={GITHUB_REPO_URL}
              class="dl-btn"
              target="_blank"
              rel="noopener noreferrer"
              data-testid="linux-github-button"
            >
              <svg class="dl-btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              <span class="dl-btn__text">
                <span class="dl-btn__platform" data-i18n="download.linux.build.repo">{t(lang, "download.linux.build.repo")}</span>
              </span>
            </a>
          </div>
        </div>

        <!-- Section 4: Free from GitHub (Windows) -->
        <div class="download-card rounded-2xl border border-white/[0.06] bg-white/[0.02] p-6 sm:p-8 mb-6">
          <div class="flex items-start gap-3 mb-5">
            <div class="shrink-0 w-10 h-10 rounded-xl bg-white/[0.06] border border-white/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-gray-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            </div>
            <div>
              <h2 class="text-xl font-semibold text-white" data-i18n="download.github.title">{t(lang, "download.github.title")}</h2>
              <p class="text-gray-400 text-sm mt-1" data-i18n="download.github.desc">{t(lang, "download.github.desc")}</p>
            </div>
          </div>

          <div class="flex justify-center mb-6">
            <a
              href={WINDOWS_SETUP_URL}
              class="dl-btn dl-btn--windows"
              data-testid="github-windows-button"
            >
              <svg class="dl-btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              <span class="dl-btn__text">
                <span class="dl-btn__label" data-i18n="download.github.btnHint">{t(lang, "download.github.btnHint")}</span>
                <span class="dl-btn__platform">Windows (.exe)</span>
              </span>
            </a>
          </div>

          <!-- SmartScreen guide -->
          <div class="smartscreen-box rounded-xl border border-amber-500/10 bg-amber-500/[0.03] p-5">
            <div class="flex items-start gap-3 mb-4">
              <svg class="w-5 h-5 text-amber-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>
              <div>
                <h3 class="font-medium text-white text-sm" data-i18n="download.smartscreen.title">{t(lang, "download.smartscreen.title")}</h3>
                <p class="text-gray-400 text-xs mt-1" data-i18n="download.smartscreen.desc">{t(lang, "download.smartscreen.desc")}</p>
              </div>
            </div>

            <div class="space-y-3 ml-8">
              <div class="flex gap-3">
                <div class="shrink-0 w-6 h-6 rounded-full bg-brand-cyan/10 border border-brand-cyan/20 flex items-center justify-center text-brand-cyan font-semibold text-xs">1</div>
                <div>
                  <h4 class="font-medium text-white text-sm" data-i18n="download.step1.title">{t(lang, "download.step1.title")}</h4>
                  <p class="text-gray-400 text-xs mt-0.5 leading-relaxed" data-i18n="download.step1.desc">{t(lang, "download.step1.desc")}</p>
                </div>
              </div>
              <div class="flex gap-3">
                <div class="shrink-0 w-6 h-6 rounded-full bg-brand-cyan/10 border border-brand-cyan/20 flex items-center justify-center text-brand-cyan font-semibold text-xs">2</div>
                <div>
                  <h4 class="font-medium text-white text-sm" data-i18n="download.step2.title">{t(lang, "download.step2.title")}</h4>
                  <p class="text-gray-400 text-xs mt-0.5 leading-relaxed" data-i18n="download.step2.desc">{t(lang, "download.step2.desc")}</p>
                </div>
              </div>
              <div class="flex gap-3">
                <div class="shrink-0 w-6 h-6 rounded-full bg-brand-cyan/10 border border-brand-cyan/20 flex items-center justify-center text-brand-cyan font-semibold text-xs">3</div>
                <div>
                  <h4 class="font-medium text-white text-sm" data-i18n="download.step3.title">{t(lang, "download.step3.title")}</h4>
                  <p class="text-gray-400 text-xs mt-0.5 leading-relaxed" data-i18n="download.step3.desc">{t(lang, "download.step3.desc")}</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Section 5: Package managers (power users) — data-driven from platforms.ts SSoT -->
