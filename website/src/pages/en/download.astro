  <script>
    import { applyLang } from '../../scripts/i18n';
    import { updateThemeIcon } from '../../scripts/theme';

    applyLang();
    updateThemeIcon();

    // Copy-to-clipboard for package manager command blocks.
    document.querySelectorAll<HTMLButtonElement>('[data-copy-text]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = btn.dataset.copyText ?? '';
        const feedback = btn.dataset.copyFeedback ?? 'Copied!';
        navigator.clipboard.writeText(text).then(() => {
          const orig = btn.textContent ?? '';
          btn.textContent = feedback;
          setTimeout(() => { btn.textContent = orig; }, 2000);
        }).catch(() => { /* clipboard permission denied — silent fail */ });
      });
    });
  </script>

