---
/**
 * `/en/use-cases/everyday/` — English mirror of the everyday-writing
 * use-case page (replaces the former RSI page; deliberately everyday and
 * free of any medical/risk framing).
 *
 * Slug-Divergenz DE/EN: DE `vielschreiber`, EN `everyday`. The
 * `alternateSlugs` mapping emits the correct hreflang pair.
 */
import LandingPageLayout from "../../../layouts/LandingPageLayout.astro";
import FAQPageSchema from "../../../components/schema/FAQPageSchema.astro";
import { t, localePath } from "../../../scripts/i18n.ts";

const lang = "en" as const;

const breadcrumbs = [
  { name: t(lang, "breadcrumb.home"), item: localePath(lang, "") },
  { name: t(lang, "breadcrumb.useCases"), item: localePath(lang, "use-cases") },
  { name: t(lang, "useCase.everyday.breadcrumb"), item: localePath(lang, "use-cases/everyday") },
];

const seo = {
  title: t(lang, "useCase.everyday.seoTitle"),
  description: t(lang, "useCase.everyday.seoDescription"),
};

const hero = {
  heading: t(lang, "useCase.everyday.heroHeading"),
  lead: t(lang, "useCase.everyday.heroLead"),
};

const cta = {
  label: t(lang, "useCase.everyday.cta.label"),
  href: localePath(lang, "download"),
};

const faqQuestions = [
  {
    question: t(lang, "useCase.everyday.faq.noTech.q"),
    answer: t(lang, "useCase.everyday.faq.noTech.a"),
  },
  {
    question: t(lang, "useCase.everyday.faq.apps.q"),
    answer: t(lang, "useCase.everyday.faq.apps.a"),
  },
  {
    question: t(lang, "useCase.everyday.faq.cost.q"),
    answer: t(lang, "useCase.everyday.faq.cost.a"),
  },
];

const alternateSlugs = { de: "use-cases/vielschreiber", en: "use-cases/everyday" };
---

<LandingPageLayout
  lang={lang}
  seo={seo}
  breadcrumbs={breadcrumbs}
  hero={hero}
  heroImage={{ src: "/illustrations/use-case-everyday.webp", alt: t(lang, "useCase.everyday.illustrationAlt") }}
  cta={cta}
  alternateSlugs={alternateSlugs}
>
  <section>
    <h2>{t(lang, "useCase.everyday.section.email.heading")}</h2>
    <p>{t(lang, "useCase.everyday.section.email.body")}</p>
  </section>

  <section>
    <h2>{t(lang, "useCase.everyday.section.notes.heading")}</h2>
    <p>{t(lang, "useCase.everyday.section.notes.body")}</p>
  </section>

  <section>
    <h2>{t(lang, "useCase.everyday.section.anywhere.heading")}</h2>
    <p>{t(lang, "useCase.everyday.section.anywhere.body")}</p>
    <dl class="faq-list">
      {faqQuestions.map((entry) => (
        <div class="faq-item">
          <dt>{entry.question}</dt>
          <dd>{entry.answer}</dd>
        </div>
      ))}
    </dl>
  </section>

  <FAQPageSchema locale={lang} questions={faqQuestions} />
</LandingPageLayout>

<style>
  .faq-list {
    margin-top: 1rem;
  }
  .faq-item + .faq-item {
    margin-top: 1rem;
  }
  .faq-list dt {
    color: #e5e7eb;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .faq-list dd {
    color: #9ca3af;
    line-height: 1.6;
    margin: 0;
  }
</style>
