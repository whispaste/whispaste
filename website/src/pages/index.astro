---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import AppScreenshots from "../components/AppScreenshots.astro";
import Privacy from "../components/Privacy.astro";
import Pricing from "../components/Pricing.astro";
import Languages from "../components/Languages.astro";
import FAQ from "../components/FAQ.astro";
import Support from "../components/Support.astro";
import Testimonials from "../components/Testimonials.astro";
import Footer from "../components/Footer.astro";
import DownloadSupportModal from "../components/DownloadSupportModal.astro";
---

<Layout title="WhisPaste — Desktop dictation, private by default">
  <Nav variant="landing" />
  <main id="main-content">
    <Hero />
    <HowItWorks />
    <AppScreenshots />
    <Privacy />
    <Pricing />
    <Languages />
    <FAQ />
    <Support />
    <Testimonials />
  </main>
  <Footer variant="landing" />
  <DownloadSupportModal />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": "https://whispaste.de/#app",
    "name": "WhisPaste",
    "description": "Desktop dictation app that brings your voice into any app as text — private by default, free & open source.",
    "url": "https://whispaste.de/",
    "applicationCategory": "ProductivityApplication",
    "operatingSystem": "Windows 10, Windows 11, macOS 13+",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "license": "https://opensource.org/licenses/MIT",
    "author": {
      "@type": "Person",
      "name": "Silvio Lindstedt"
    },
    "downloadUrl": "https://github.com/whispaste/whispaste/releases/latest",
    "screenshot": [
      "https://whispaste.de/screenshots/en/dark/01_workspace_overview.png",
      "https://whispaste.de/screenshots/en/light/02_workspace_detail.png",
      "https://whispaste.de/screenshots/en/dark/03_voice_shortcuts.png",
      "https://whispaste.de/screenshots/en/light/04_settings.png",
      "https://whispaste.de/screenshots/en/dark/05_analytics.png"
    ]
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is WhisPaste really free?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. WhisPaste is open source under the MIT license. The app with offline transcription, voice snippets, history and more is free. You can download it from GitHub. The Microsoft Store version includes automatic updates and supports the project financially."
        }
      },
      {
        "@type": "Question",
        "name": "Does it actually work offline?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Fully. WhisPaste includes built-in speech recognition that runs entirely on your computer. No internet needed. You can also connect a cloud provider for even better accuracy, but that is your choice, not a requirement."
        }
      },
      {
        "@type": "Question",
        "name": "How accurate is the transcription?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "That depends on the model you pick. The small model handles everyday dictation well. Larger models are more precise but need more RAM and processing time. You can switch any time to find the right balance."
        }
      },
      {
        "@type": "Question",
        "name": "Which languages are supported?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "WhisPaste supports 99 languages — from English and German to Japanese, Arabic, and Hindi. You can switch languages in settings, or let WhisPaste auto-detect what you're speaking."
        }
      },
      {
        "@type": "Question",
        "name": "Is my voice data safe?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Your audio never leaves your machine in local mode. If you use the cloud path, recordings go directly from your device to the provider you selected. WhisPaste does not proxy or store them. Optional crash reports are transparent and can be turned off any time."
        }
      },
      {
        "@type": "Question",
        "name": "Is WhisPaste available on Mac or Linux?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "WhisPaste is available for Windows and macOS. A Linux version is planned."
        }
      },
      {
        "@type": "Question",
        "name": "Why does Windows show a warning when I download?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Microsoft SmartScreen warns about any new software that hasn't built download reputation yet — it doesn't mean the app is unsafe. WhisPaste is open source, and every release is built transparently through GitHub Actions. Click 'More info' then 'Run anyway' to proceed."
        }
      }
    ]
  }
  </script>

  <style is:global>
    .scroll-reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.7s ease-out, transform 0.7s ease-out;
    }
    .scroll-reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }
    /* Staggered children in grids */
    .scroll-reveal.visible > :nth-child(1) { transition-delay: 0ms; }
    .scroll-reveal.visible > :nth-child(2) { transition-delay: 80ms; }
    .scroll-reveal.visible > :nth-child(3) { transition-delay: 160ms; }
    .scroll-reveal.visible > :nth-child(4) { transition-delay: 240ms; }
    .scroll-reveal.visible > :nth-child(5) { transition-delay: 320ms; }
    .scroll-reveal.visible > :nth-child(6) { transition-delay: 400ms; }
    @media (prefers-reduced-motion: reduce) {
      .scroll-reveal {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
      .scroll-reveal > * { transition-delay: 0ms !important; }
    }
  </style>

  <script>
    import { applyLang } from '../scripts/i18n';
    import { updateThemeIcon } from '../scripts/theme';

    // Scroll reveal observer
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
    );
    document.querySelectorAll(".scroll-reveal").forEach((el) => {
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight + 40) {
        el.classList.add("visible");
      }
      observer.observe(el);
    });
    window.addEventListener('scroll', () => {
      requestAnimationFrame(() => {
        document.querySelectorAll('.scroll-reveal:not(.visible)').forEach(el => {
          if (el.getBoundingClientRect().top < window.innerHeight + 40) {
            el.classList.add('visible');
          }
        });
      });
    }, { passive: true });

    // Fetch GitHub stars (cached in sessionStorage)
    (async () => {
      try {
        const cacheKey = 'wp-gh-stars';
        const cached = sessionStorage.getItem(cacheKey);
        let count: number | null = cached ? parseInt(cached, 10) : null;

        if (count === null || isNaN(count)) {
          const res = await fetch('https://api.github.com/repos/whispaste/whispaste');
          if (res.ok) {
            const data = await res.json();
            count = data.stargazers_count;
            if (typeof count === 'number') sessionStorage.setItem(cacheKey, String(count));
          }
        }

        if (typeof count === 'number' && count > 0) {
          const badge = document.getElementById('github-stars-badge');
          const span = document.getElementById('github-stars-count');
          if (badge && span) {
            const lang = localStorage.getItem('whispaste-lang') || 'en';
            span.textContent = lang === 'de'
              ? `${count} Sterne auf GitHub`
              : `${count} stars on GitHub`;
            badge.style.display = '';
          }
        }
      } catch { /* silent — badge stays hidden */ }
    })();

    applyLang();
    updateThemeIcon();
  </script>
</Layout>
