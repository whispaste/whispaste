---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import AppScreenshots from "../components/AppScreenshots.astro";
import Privacy from "../components/Privacy.astro";
import Pricing from "../components/Pricing.astro";
import Languages from "../components/Languages.astro";
import FAQ from "../components/FAQ.astro";
import Support from "../components/Support.astro";
import Testimonials from "../components/Testimonials.astro";
import Footer from "../components/Footer.astro";
import DownloadSupportModal from "../components/DownloadSupportModal.astro";
import SoftwareApplicationSchema from "../components/schema/SoftwareApplicationSchema.astro";
import FAQPageSchema from "../components/schema/FAQPageSchema.astro";
import HowToSchema from "../components/schema/HowToSchema.astro";
import { t } from "../scripts/i18n.ts";

const lang = (Astro.currentLocale === "en" ? "en" : "de") as "de" | "en";

// Landing-Page-FAQ-Schlüssel — spiegelt die im `FAQ.astro`-Akkordeon
// sichtbaren Fragen (ohne `sysreq` / `gatekeeper`, die nur auf der Detail-
// Page erscheinen). Google Rich Results verlangt, dass die im FAQ-Schema
// gelisteten Fragen 1:1 mit dem sichtbaren Seitentext übereinstimmen.
const faqKeys = [
  "free",
  "offline",
  "accuracy",
  "languages",
  "privacy",
  "windows",
  "smartscreen",
];
---

<Layout
  title={t(lang, "meta.title.home")}
  description={t(lang, "meta.description.home")}
>
  <Nav variant="landing" />
  <main id="main-content">
    <Hero />
    <HowItWorks />
    <AppScreenshots />
    <Privacy />
    <Pricing />
    <Languages />
    <FAQ />
    <Support />
    <Testimonials />
  </main>
  <Footer variant="landing" />
  <DownloadSupportModal />

  {/*
    Schema-Components ersetzen die früheren Inline-`<script type=application/ld+json>`-
    Blöcke. Vorteile: Locale-Korrektheit, keine USD-Fiktion, Brand-Glossar-
    konforme Description, Linux deklariert, HowTo neu für den Setup-Flow.
    Builder-Tests sichern die Schema.org-Form (siehe
    `src/components/schema/__tests__/`).
  */}
  <SoftwareApplicationSchema locale={lang} />
  <FAQPageSchema locale={lang} questionKeys={faqKeys} />
  <HowToSchema locale={lang} />

  <style is:global>
    .scroll-reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.7s ease-out, transform 0.7s ease-out;
    }
    .scroll-reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }
    /* Staggered children in grids */
    .scroll-reveal.visible > :nth-child(1) { transition-delay: 0ms; }
    .scroll-reveal.visible > :nth-child(2) { transition-delay: 80ms; }
    .scroll-reveal.visible > :nth-child(3) { transition-delay: 160ms; }
    .scroll-reveal.visible > :nth-child(4) { transition-delay: 240ms; }
    .scroll-reveal.visible > :nth-child(5) { transition-delay: 320ms; }
    .scroll-reveal.visible > :nth-child(6) { transition-delay: 400ms; }
    @media (prefers-reduced-motion: reduce) {
      .scroll-reveal {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
      .scroll-reveal > * { transition-delay: 0ms !important; }
    }
  </style>

  <script>
    import { applyLang } from '../scripts/i18n';
    import { updateThemeIcon } from '../scripts/theme';

    // Scroll reveal observer
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
    );
    document.querySelectorAll(".scroll-reveal").forEach((el) => {
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight + 40) {
        el.classList.add("visible");
      }
      observer.observe(el);
    });
    window.addEventListener('scroll', () => {
      requestAnimationFrame(() => {
        document.querySelectorAll('.scroll-reveal:not(.visible)').forEach(el => {
          if (el.getBoundingClientRect().top < window.innerHeight + 40) {
            el.classList.add('visible');
          }
        });
      });
    }, { passive: true });

    // Fetch GitHub stars (cached in sessionStorage)
    (async () => {
      try {
        const cacheKey = 'wp-gh-stars';
        const cached = sessionStorage.getItem(cacheKey);
        let count: number | null = cached ? parseInt(cached, 10) : null;

        if (count === null || isNaN(count)) {
          const res = await fetch('https://api.github.com/repos/whispaste/whispaste');
          if (res.ok) {
            const data = await res.json();
            count = data.stargazers_count;
            if (typeof count === 'number') sessionStorage.setItem(cacheKey, String(count));
          }
        }

        if (typeof count === 'number' && count > 0) {
          const badge = document.getElementById('github-stars-badge');
          const span = document.getElementById('github-stars-count');
          if (badge && span) {
            const lang = localStorage.getItem('whispaste-lang') || 'en';
            span.textContent = lang === 'de'
              ? `${count} Sterne auf GitHub`
              : `${count} stars on GitHub`;
            badge.style.display = '';
          }
        }
      } catch { /* silent — badge stays hidden */ }
    })();

    applyLang();
    updateThemeIcon();
  </script>
</Layout>
