---
/**
 * `/engines/` — Erklär-Page für den Whisper-vs.-Parakeet-Vergleich (Kernbeschwerde-
 * Fix: die Website informierte bislang nur verstreut über die zwei lokalen
 * Engines, siehe `Engines.astro`-Homepage-Sektion für den Kontext).
 *
 * Beantwortet den `docs/zielgruppe.md`-Lackmustest („Hilft das jemandem, der
 * zwischen den zwei lokalen Engines entscheiden muss?") direkt im Hero-Lead.
 * Drei Sections spiegeln die Struktur der Homepage-Sektion, aber vertiefen sie:
 * Whisper im Detail, Parakeet im Detail, dann eine Entscheidungshilfe.
 *
 * Schema-Wahl: FAQPage, weil die typische Such-Intention aus konkreten
 * Fragen besteht („Wie viel schneller ist Parakeet? Welche Sprachen? Kann ich
 * wechseln?"). Die Q&A-Paare spiegeln 1:1 die sichtbare `<dl>`-Liste — Google
 * Rich-Results-Anforderung.
 *
 * Alle Zahlen/Fakten stammen aus `CONTEXT.md` §4.2–4.5 (kanonische Quelle),
 * keine erfundenen Benchmarks.
 *
 * Slug: DE und EN nutzen denselben Slug `engines`, weil der Begriff im
 * Tech-Kontext identisch verwendet wird und keine sinnvolle Lokalisierung
 * existiert (analog zu `whisper-desktop`).
 */
import LandingPageLayout from "../layouts/LandingPageLayout.astro";
import FAQPageSchema from "../components/schema/FAQPageSchema.astro";
import { t, localePath } from "../scripts/i18n.ts";

const lang = "de" as const;

const breadcrumbs = [
  { name: t(lang, "breadcrumb.home"), item: localePath(lang, "") },
  { name: t(lang, "explainer.engines.breadcrumb"), item: localePath(lang, "engines") },
];

const seo = {
  title: t(lang, "explainer.engines.seoTitle"),
  description: t(lang, "explainer.engines.seoDescription"),
};

const hero = {
  heading: t(lang, "explainer.engines.heroHeading"),
  lead: t(lang, "explainer.engines.heroLead"),
};

const cta = {
  label: t(lang, "explainer.engines.cta.label"),
  href: localePath(lang, "download"),
};

const faqQuestions = [
  {
    question: t(lang, "explainer.engines.faq.speed.q"),
    answer: t(lang, "explainer.engines.faq.speed.a"),
  },
  {
    question: t(lang, "explainer.engines.faq.languages.q"),
    answer: t(lang, "explainer.engines.faq.languages.a"),
  },
  {
    question: t(lang, "explainer.engines.faq.switch.q"),
    answer: t(lang, "explainer.engines.faq.switch.a"),
  },
];

const alternateSlugs = { de: "engines", en: "engines" };

const relatedPages = [
  { label: t(lang, "explainer.engineBenchmarks.breadcrumb"), href: localePath(lang, "engine-benchmarks") },
  { label: t(lang, "explainer.whisperDesktop.breadcrumb"), href: localePath(lang, "whisper-desktop") },
  { label: t(lang, "explainer.offlineStt.breadcrumb"), href: localePath(lang, "offline-speech-to-text") },
  { label: t(lang, "explainer.privacy.breadcrumb"), href: localePath(lang, "privatsphaere-spracherkennung") },
  { label: t(lang, "comparison.osDictation.breadcrumb"), href: localePath(lang, "vergleich/whispaste-vs-system-spracheingabe") },
];
---

<LandingPageLayout
  lang={lang}
  seo={seo}
  breadcrumbs={breadcrumbs}
  hero={hero}
  cta={cta}
  alternateSlugs={alternateSlugs}
  relatedPages={relatedPages}
>
  <section>
    <h2>{t(lang, "explainer.engines.section.whisper.heading")}</h2>
    <p>{t(lang, "explainer.engines.section.whisper.body")}</p>
  </section>

  <section>
    <h2>{t(lang, "explainer.engines.section.parakeet.heading")}</h2>
    <p>{t(lang, "explainer.engines.section.parakeet.body")}</p>
    <p>
      <a href={localePath(lang, "engine-benchmarks")}>
        {t(lang, "explainer.engines.section.parakeet.benchmarkLink")}
      </a>
    </p>
  </section>

  <section>
    <h2>{t(lang, "explainer.engines.section.choosing.heading")}</h2>
    <p>{t(lang, "explainer.engines.section.choosing.body")}</p>
    <dl class="faq-list">
      {faqQuestions.map((entry) => (
        <div class="faq-item">
          <dt>{entry.question}</dt>
          <dd>{entry.answer}</dd>
        </div>
      ))}
    </dl>
  </section>

  <FAQPageSchema locale={lang} questions={faqQuestions} />
</LandingPageLayout>

<style>
  .faq-list {
    margin-top: 1rem;
  }
  .faq-item + .faq-item {
    margin-top: 1rem;
  }
  .faq-list dt {
    color: #e5e7eb;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .faq-list dd {
    color: #9ca3af;
    line-height: 1.6;
    margin: 0;
  }
</style>
