---
import "../styles/global.css";
import { t, type Locale } from "../scripts/i18n.ts";
import OrganizationSchema from "../components/schema/OrganizationSchema.astro";
import WebVitals from "../components/WebVitals.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /**
   * Optional explicit locale override. Falls back to `Astro.currentLocale`
   * (which reflects the URL prefix once Astro's i18n routing is configured)
   * and, as a last resort, to the project's default locale `de`.
   */
  lang?: Locale;
  /**
   * Optional explicit page slug used to build hreflang and canonical
   * alternates. When omitted, the layout derives the slug from
   * `Astro.url.pathname` by stripping the `/en/` prefix and trailing slashes.
   * Pass an explicit value (e.g. `"datenschutz"` ↔ `"en/privacy"`) when DE
   * and EN slugs diverge.
   */
  slug?: string;
  /**
   * Optional canonical-pair override. When DE and EN slugs diverge (e.g.
   * `/datenschutz/` vs `/en/privacy/`), pass `{ de: 'datenschutz', en: 'privacy' }`.
   * Defaults to using the same slug for both locales.
   */
  alternateSlugs?: { de: string; en: string };
}

const SITE_ORIGIN = "https://whispaste.de";

const rawLocale = Astro.props.lang ?? Astro.currentLocale ?? "de";
const lang: Locale = rawLocale === "en" ? "en" : "de";

const {
  title = t(lang, "meta.title.default"),
  description = t(lang, "meta.description.default"),
  ogImage = lang === "en" ? "/og-image.png" : "/og-image-de.png",
  alternateSlugs,
} = Astro.props;

// Derive a slug from the URL when callers don't pass one explicitly. We strip
// any `/en/` prefix and the trailing slash so the slug is locale-agnostic.
function slugFromPath(pathname: string): string {
  const noTrailing = pathname.replace(/\/+$/, "");
  const noLeading = noTrailing.replace(/^\//, "");
  if (noLeading === "en") return "";
  if (noLeading.startsWith("en/")) return noLeading.slice(3);
  return noLeading;
}

const inferredSlug = Astro.props.slug ?? slugFromPath(Astro.url.pathname);
const deSlug = alternateSlugs?.de ?? inferredSlug;
const enSlug = alternateSlugs?.en ?? inferredSlug;

function buildLocaleUrl(locale: Locale, slug: string): string {
  const cleaned = slug.replace(/^\/+|\/+$/g, "");
  if (locale === "de") {
    return cleaned.length === 0 ? "/" : `/${cleaned}/`;
  }
  return cleaned.length === 0 ? "/en/" : `/en/${cleaned}/`;
}

const dePath = buildLocaleUrl("de", deSlug);
const enPath = buildLocaleUrl("en", enSlug);

const deAbsolute = new URL(dePath, SITE_ORIGIN).href;
const enAbsolute = new URL(enPath, SITE_ORIGIN).href;

const canonicalURL = new URL(lang === "de" ? dePath : enPath, SITE_ORIGIN);
const ogImageURL = new URL(ogImage, SITE_ORIGIN);
const ogLocale = lang === "de" ? "de_DE" : "en_US";
const ogLocaleAlternate = lang === "de" ? "en_US" : "de_DE";
---

<!doctype html>
<html lang={lang} class="bg-brand-darker text-gray-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#131826" />
    <meta name="author" content="Silvio Lindstedt" />
    {/* Preload the primary self-hosted variable fonts (latin subset) to
        avoid a flash of fallback text for the above-the-fold copy. */}
    <link rel="preload" href="/fonts/hanken-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/bricolage-grotesque-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" href="/app-icon.png" />
    <link rel="apple-touch-icon" href="/app-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonicalURL.href} />
    {/*
      hreflang-Annotationen: ein Eintrag pro Locale + `x-default` auf die
      deutsche Variante (Default-Locale). Pflicht für saubere SEO-Indexierung
      (AC3 / PRD §B). Astro Sitemap ergänzt dieselben Alternates im
      `sitemap-0.xml` automatisch via `i18n`-Konfiguration.
    */}
    <link rel="alternate" hreflang="de" href={deAbsolute} />
    <link rel="alternate" hreflang="en" href={enAbsolute} />
    <link rel="alternate" hreflang="x-default" href={deAbsolute} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:site_name" content="WhisPaste" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />

    {/*
      Site-weite Organization-Identität. Jede Page emittiert denselben
      `@id` (siehe `ORGANIZATION_ID` in `schema/builders.ts`), damit
      Knowledge-Graph-Crawler die WhisPaste-Entität konsolidieren können.
      Bewusst im `<head>`, damit das Schema vor jedem Page-spezifischen
      Schema (SoftwareApplication, FAQPage, HowTo, BreadcrumbList) steht.
    */}
    <OrganizationSchema locale={lang} />
    <script is:inline>
      (function(){
        var t = localStorage.getItem('whispaste-theme');
        if (t === 'light') document.documentElement.classList.add('light');
        else if (!t && window.matchMedia('(prefers-color-scheme: light)').matches) document.documentElement.classList.add('light');
      })();
    </script>
    <script is:inline>
      (function(){
        var ua = navigator.userAgent;
        var uad = navigator.userAgentData;
        var os = '';
        // Mobile guard: phones/tablets never get a desktop OS tag.
        if (/iPhone|iPad|iPod|Android/.test(ua)) { return; }
        if (uad && uad.platform) {
          var p = uad.platform.toLowerCase();
          if (p === 'macos') os = 'macos';
          else if (p === 'windows') os = 'windows';
          else if (p === 'linux') os = 'linux';
        } else if (/Macintosh|MacIntel|Mac OS X/.test(ua)) {
          os = 'macos';
        } else if (/Windows/.test(ua)) {
          os = 'windows';
        } else if (/Linux/.test(ua)) {
          os = 'linux';
        }
        if (os) document.documentElement.dataset.os = os;
      })();
    </script>
    {/* Matomo Analytics — prod-only, cookiefrei, DSGVO-konfiguriert. Site 4 = WhisPaste. */}
    {import.meta.env.PROD && (
      <script is:inline set:html={`var _paq = (window._paq = window._paq || []);
_paq.push(["disableCookies"]);
_paq.push(["setDoNotTrack", true]);
_paq.push(["setAnonymizeIp", true]);
_paq.push(["trackPageView"]);
_paq.push(["enableLinkTracking"]);
(function () {
  _paq.push(["setTrackerUrl", "https://matomo.silvio-und-maik.de/matomo.php"]);
  _paq.push(["setSiteId", "4"]);
  var d = document, g = d.createElement("script");
  g.src = "https://matomo.silvio-und-maik.de/matomo.js";
  g.async = true;
  d.head.appendChild(g);
})();`} />
    )}
    {/* Core Web Vitals (RUM) → Matomo custom events. First-party bundled, prod-only. */}
    {import.meta.env.PROD && <WebVitals enabled={true} />}
  </head>
  <body class="antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:bg-brand-cyan focus:text-brand-darker focus:rounded-lg focus:font-semibold focus:shadow-lg" data-i18n="nav.skip">
      {t(lang, "nav.skip")}
    </a>
    <slot />
  </body>
</html>
