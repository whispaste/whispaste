---
/**
 * Shared frame for the blog index and posts. Built on SubpageLayout (nav,
 * full footer, language switch, pointer spotlight) like every other page
 * outside the landing; adds the RSS alternate link and the band surface.
 * Reading measure is set by the pages themselves (the blog renders its own
 * editorial header instead of PageHero).
 */
import SubpageLayout from "./SubpageLayout.astro";
import { feedPath } from "../scripts/blog.ts";
import { t, type Locale } from "../scripts/i18n.ts";

interface Props {
  readonly lang: Locale;
  readonly title: string;
  readonly description: string;
}

const { lang, title, description } = Astro.props;
---

<SubpageLayout lang={lang} title={title} description={description}>
  <link slot="head" rel="alternate" type="application/rss+xml" title={t(lang, "blog.seoTitle")} href={feedPath(lang)} />
  <div class="band band-spotlight pt-28 sm:pt-32 pb-20 sm:pb-28">
    <div class="wp-container">
      <slot />
    </div>
  </div>
</SubpageLayout>
