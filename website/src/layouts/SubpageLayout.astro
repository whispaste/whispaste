---
/**
 * Shared frame for every page outside the landing: global Layout, subpage
 * Nav (anchors point back into the landing) and the full landing footer on
 * the same full-width frame. Pages put a PageHero first, then their body.
 */
import Layout from "./Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import type { Locale } from "../scripts/i18n.ts";

interface Props {
  readonly lang: Locale;
  readonly title: string;
  readonly description: string;
  readonly ogImage?: string;
  /** Secret-bearing address: see Layout `isPrivate`. */
  readonly isPrivate?: boolean;
}

const { lang, title, description, ogImage, isPrivate } = Astro.props;
---

<Layout title={title} description={description} lang={lang} ogImage={ogImage} isPrivate={isPrivate}>
  <slot name="head" slot="head" />
  <div class="min-h-screen flex flex-col">
    <Nav variant="subpage" lang={lang} noLanguageSwitcher={isPrivate} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </div>
  <script>
    import { applyLang } from '../scripts/lang-switch';
    import { closestFromTarget } from '../scripts/event-target';
    applyLang();

    // Same pointer spotlight as the landing cards (global.css `.wp-spot`).
    if (matchMedia('(hover: hover)').matches) {
      document.addEventListener('pointermove', (e) => {
        const card = closestFromTarget<HTMLElement>(e.target, '.wp-spot');
        if (!card) return;
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - r.left}px`);
        card.style.setProperty('--my', `${e.clientY - r.top}px`);
      }, { passive: true });
    }
  </script>
</Layout>
