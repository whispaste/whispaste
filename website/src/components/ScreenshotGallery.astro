---
/**
 * Screenshot gallery — responsive grid with platform/language toggle.
 * Clicking a screenshot opens the shared lightbox (ScreenshotLightbox.astro).
 *
 * Theme per screenshot is fixed by the storyboard (see
 * `test/screenshots/store_screenshots_test.dart`): goldens are only produced
 * in one theme each, so there is nothing to toggle to at runtime. All five are
 * `dark` — the app's light theme was removed, so `store_screenshots_test.dart`
 * no longer produces a `light` variant at all. `GalleryTheme` keeps the
 * `'light'` member for now rather than collapsing the type, since the
 * per-screen `theme` field is still what a reader checks to know what a given
 * screenshot shows.
 */
import ScreenshotLightbox from './ScreenshotLightbox.astro';
import { t } from '../scripts/i18n.ts';

const lang = (Astro.currentLocale === 'en' ? 'en' : 'de') as 'de' | 'en';

type GalleryTheme = 'dark' | 'light';

/**
 * Screens 01–05 are Flutter goldens (1920×1080) with Windows *and* macOS
 * variants. Screens 06–09 are real captures from the Windows test box
 * (storyboard: `.scratch/website-feature-screens/storyboard.md`) — cropped to
 * the app window (1920×1072; 09 keeps the full 1080 desktop because the
 * edge-pulled side panel over the desktop *is* the motif). They have no macOS
 * variant yet (no real Mac captures exist — never faked), so `winOnly` hides
 * them while the macOS platform toggle is active.
 */
const screens: Array<{
  id: string;
  theme: GalleryTheme;
  i18nLabel: string;
  defaultLabel: string;
  deLabel: string;
  height: number;
  winOnly?: boolean;
}> = [
  { id: '01_workspace_overview', theme: 'dark',  i18nLabel: 'gallery.workspace', defaultLabel: 'Your transcripts at a glance', deLabel: 'Alle Transkripte auf einen Blick', height: 1080 },
  { id: '02_workspace_detail',   theme: 'dark',  i18nLabel: 'gallery.detail',    defaultLabel: 'Edit and refine each entry', deLabel: 'Jeden Eintrag bearbeiten und verfeinern', height: 1080 },
  { id: '03_voice_shortcuts',    theme: 'dark',  i18nLabel: 'gallery.shortcuts', defaultLabel: 'Voice Snippets that save keystrokes', deLabel: 'Sprach-Snippets, die Tippen ersparen', height: 1080 },
  { id: '04_settings',           theme: 'dark',  i18nLabel: 'gallery.settings',  defaultLabel: 'Customize to fit your workflow', deLabel: 'Anpassbar an deinen Workflow', height: 1080 },
  { id: '05_analytics',          theme: 'dark',  i18nLabel: 'gallery.analytics', defaultLabel: 'Track how you use your voice', deLabel: 'Verfolge, wie du deine Stimme nutzt', height: 1080 },
  { id: '06_smart_mode',           theme: 'dark', i18nLabel: 'gallery.smartmode',   defaultLabel: 'Clean up, shorten, or translate as you speak', deLabel: 'Bereinigen, kürzen oder übersetzen beim Sprechen', height: 1072, winOnly: true },
  { id: '07_snippet_picker',       theme: 'dark', i18nLabel: 'gallery.picker',      defaultLabel: 'Search and insert snippets right at your cursor', deLabel: 'Snippets direkt am Cursor suchen und einfügen', height: 1072, winOnly: true },
  { id: '08_interactive_snippet',  theme: 'dark', i18nLabel: 'gallery.interactive', defaultLabel: 'Guided snippets fill in every field by voice', deLabel: 'Geführte Snippets füllen jedes Feld per Stimme', height: 1072, winOnly: true },
  { id: '09_side_panel',           theme: 'dark', i18nLabel: 'gallery.sidepanel',   defaultLabel: 'Your clipboard and transcripts, one edge-pull away', deLabel: 'Zwischenablage und Transkripte, nur einen Handgriff entfernt', height: 1080, winOnly: true },
];
---

<div class="gallery-root" id="screenshot-gallery">
  <!-- Controls: platform toggle (theme is fixed per screenshot) -->
  <div class="gallery-controls">
    <div class="gallery-toggles" role="group" aria-label="Platform">
      <button
        class="gallery-toggle gallery-toggle--active"
        data-gallery-platform="windows"
        aria-pressed="true"
        data-i18n="gallery.platformWindows"
      >{t(lang, "gallery.platformWindows")}</button>
      <button
        class="gallery-toggle"
        data-gallery-platform="macos"
        aria-pressed="false"
        data-i18n="gallery.platformMac"
      >{t(lang, "gallery.platformMac")}</button>
    </div>
  </div>

  <!-- Responsive grid -->
  <div class="gallery-grid" id="gallery-grid" role="list">
    {screens.map((screen, idx) => (
      <figure class="gallery-item" role="listitem" data-win-only={screen.winOnly ? '' : undefined}>
        <button
          class="gallery-thumb-btn"
          data-gallery-id={screen.id}
          aria-label={`${screen.defaultLabel}: click to enlarge`}
          data-aria-label-en={`${screen.defaultLabel}: click to enlarge`}
          data-aria-label-de={`${screen.deLabel}: klicken zum Vergrößern`}
          data-alt-en={screen.defaultLabel}
          data-alt-de={screen.deLabel}
        >
          <img
            class="gallery-image"
            src={`/screenshots/${lang}/${screen.theme}/${screen.id}.webp`}
            data-gallery-id={screen.id}
            data-gallery-theme={screen.theme}
            alt={screen.defaultLabel}
            data-alt-en={screen.defaultLabel}
            data-alt-de={screen.deLabel}
            width="1920"
            height={screen.height}
            loading={idx === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
          <span class="gallery-zoom-hint" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </span>
        </button>
        <figcaption class="gallery-caption" data-i18n={screen.i18nLabel}>
          {t(lang, screen.i18nLabel)}
        </figcaption>
      </figure>
    ))}
  </div>
</div>

<ScreenshotLightbox />

<style>
  .gallery-root {
    max-width: 72rem;
    margin: 0 auto;
  }

  /* Platform toggle */
  .gallery-controls {
    display: flex;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .gallery-toggles {
    display: inline-flex;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
  }

  .gallery-toggle {
    padding: 0.375rem 1.125rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.5);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
    min-width: 4rem;
  }

  .gallery-toggle:hover {
    color: rgba(255, 255, 255, 0.7);
  }

  .gallery-toggle--active {
    background: var(--color-brand-cyan);
    color: #0f1219;
  }

  /* Responsive grid: 1 → 2 → 3 columns */
  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .gallery-item {
    margin: 0;
  }

  /* Thumbnail button wrapper */
  .gallery-thumb-btn {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    border-radius: var(--radius-control);
    overflow: hidden;
    outline-offset: 3px;
  }

  .gallery-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-control);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.35s ease;
  }

  .gallery-thumb-btn:hover .gallery-image,
  .gallery-thumb-btn:focus-visible .gallery-image {
    transform: translateY(-3px) scale(1.015);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.35);
  }

  /* Zoom hint icon */
  .gallery-zoom-hint {
    position: absolute;
    bottom: 0.625rem;
    right: 0.625rem;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    color: rgba(255, 255, 255, 0.85);
    opacity: 0;
    transform: scale(0.85);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }

  .gallery-thumb-btn:hover .gallery-zoom-hint,
  .gallery-thumb-btn:focus-visible .gallery-zoom-hint {
    opacity: 1;
    transform: scale(1);
  }

  /* Caption */
  .gallery-caption {
    text-align: center;
    margin-top: 0.625rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.5);
  }
</style>

<script>
  import { detectPlatform } from '../scripts/platform';

  function initGallery() {
    const root = document.getElementById('screenshot-gallery');
    if (!root) return;

    const platformToggles = root.querySelectorAll<HTMLButtonElement>('[data-gallery-platform]');
    const thumbButtons = root.querySelectorAll<HTMLButtonElement>('.gallery-thumb-btn');

    let galleryPlatform: 'windows' | 'macos' =
      detectPlatform() === 'macos' ? 'macos' : 'windows';

    function getLang(): string {
      return document.documentElement.lang === 'de' ? 'de' : 'en';
    }

    function buildSrc(id: string, lang: string, theme: string): string {
      const prefix = galleryPlatform === 'macos' ? 'mac/' : '';
      return `/screenshots/${prefix}${lang}/${theme}/${id}.webp`;
    }

    function syncPlatformToggles() {
      platformToggles.forEach(btn => {
        const active = btn.dataset.galleryPlatform === galleryPlatform;
        btn.classList.toggle('gallery-toggle--active', active);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    }

    function updateImages() {
      const lang = getLang();
      // Screens without a real macOS capture are Windows-only: hide them
      // while the macOS toggle is active instead of faking a Mac variant.
      root.querySelectorAll<HTMLElement>('[data-win-only]').forEach(fig => {
        fig.hidden = galleryPlatform === 'macos';
      });
      root.querySelectorAll<HTMLImageElement>('img[data-gallery-id]').forEach(img => {
        const id = img.dataset.galleryId!;
        const theme = img.dataset.galleryTheme || 'dark';
        const newSrc = buildSrc(id, lang, theme);
        if (img.getAttribute('src') !== newSrc) img.src = newSrc;
        const alt = lang === 'de' ? img.dataset.altDe : img.dataset.altEn;
        if (alt) img.alt = alt;
      });
      root.querySelectorAll<HTMLElement>('[data-aria-label-en]').forEach(el => {
        const label = lang === 'de' ? el.dataset.ariaLabelDe : el.dataset.ariaLabelEn;
        if (label) el.setAttribute('aria-label', label);
      });
    }

    // Only visible screens feed the lightbox — hidden Windows-only items must
    // not appear while browsing the macOS set.
    function visibleImages(): HTMLImageElement[] {
      return Array.from(
        root.querySelectorAll<HTMLImageElement>('.gallery-item:not([hidden]) .gallery-image'),
      );
    }

    function buildLightboxImages(): Array<{ src: string; alt: string }> {
      const lang = getLang();
      return visibleImages().map(img => ({
        src: buildSrc(img.dataset.galleryId!, lang, img.dataset.galleryTheme || 'dark'),
        alt: img.alt,
      }));
    }

    // Initialise platform toggle state
    syncPlatformToggles();

    // Platform toggles
    platformToggles.forEach(btn => {
      btn.addEventListener('click', () => {
        galleryPlatform = (btn.dataset.galleryPlatform as 'windows' | 'macos') || 'windows';
        syncPlatformToggles();
        updateImages();
      });
    });

    // Thumbnail click → open lightbox
    thumbButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        // Index within the *visible* set (Windows-only items may be hidden).
        const ownImg = btn.querySelector<HTMLImageElement>('.gallery-image');
        const idx = Math.max(0, visibleImages().indexOf(ownImg!));
        // Engagement-Event „Screenshots angesehen" (cookieless) — Name = Plattform.
        if ((window as any)._paq) {
          (window as any)._paq.push(['trackEvent', 'Engagement', 'Screenshots angesehen', galleryPlatform]);
        }
        const images = buildLightboxImages();
        if ((window as any).openScreenshotLightbox) {
          (window as any).openScreenshotLightbox(images, idx);
        }
      });
    });

    // Language observer
    const langObs = new MutationObserver(() => updateImages());
    langObs.observe(document.documentElement, { attributes: true, attributeFilter: ['lang'] });

    updateImages();
  }

  initGallery();
</script>
