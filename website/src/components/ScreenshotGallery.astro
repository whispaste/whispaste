---
/**
 * Screenshot gallery — responsive grid with theme/language toggle.
 * Clicking a screenshot opens the shared lightbox (ScreenshotLightbox.astro).
 */
import ScreenshotLightbox from './ScreenshotLightbox.astro';

const screens = [
  { id: '01_workspace_overview', i18nLabel: 'gallery.workspace', defaultLabel: 'Your dictations at a glance', deLabel: 'Alle Diktate auf einen Blick' },
  { id: '02_workspace_detail',  i18nLabel: 'gallery.detail',    defaultLabel: 'Edit and refine each entry', deLabel: 'Jeden Eintrag bearbeiten und verfeinern' },
  { id: '03_voice_shortcuts',   i18nLabel: 'gallery.shortcuts', defaultLabel: 'Voice commands that save keystrokes', deLabel: 'Sprachbefehle, die Tippen ersparen' },
  { id: '04_settings',          i18nLabel: 'gallery.settings',  defaultLabel: 'Customize to fit your workflow', deLabel: 'Anpassbar an deinen Workflow' },
  { id: '05_analytics',         i18nLabel: 'gallery.analytics', defaultLabel: 'Track how you use your voice', deLabel: 'Verfolge, wie du deine Stimme nutzt' },
];
---

<div class="gallery-root" id="screenshot-gallery">
  <!-- Controls: platform + theme toggles -->
  <div class="gallery-controls">
    <div class="gallery-control-row">
      <!-- Platform toggle -->
      <div class="gallery-toggles" role="group" aria-label="Platform">
        <button
          class="gallery-toggle gallery-toggle--active"
          data-gallery-platform="windows"
          aria-pressed="true"
          data-i18n="gallery.platformWindows"
        >Windows</button>
        <button
          class="gallery-toggle"
          data-gallery-platform="macos"
          aria-pressed="false"
          data-i18n="gallery.platformMac"
        >macOS</button>
      </div>

      <div class="gallery-control-divider" aria-hidden="true"></div>

      <!-- Theme toggle -->
      <div class="gallery-toggles" role="group" aria-label="Theme">
        <button
          class="gallery-toggle gallery-toggle--active"
          data-gallery-theme="dark"
          aria-pressed="true"
          data-i18n="gallery.themeDark"
        >Dark</button>
        <button
          class="gallery-toggle"
          data-gallery-theme="light"
          aria-pressed="false"
          data-i18n="gallery.themeLight"
        >Light</button>
      </div>
    </div>
  </div>

  <!-- Responsive grid -->
  <div class="gallery-grid" id="gallery-grid" role="list">
    {screens.map((screen, idx) => (
      <figure class="gallery-item" role="listitem">
        <button
          class="gallery-thumb-btn"
          data-gallery-idx={idx}
          data-gallery-id={screen.id}
          aria-label={`${screen.defaultLabel} — click to enlarge`}
          data-aria-label-en={`${screen.defaultLabel} — click to enlarge`}
          data-aria-label-de={`${screen.deLabel} — klicken zum Vergrößern`}
          data-alt-en={screen.defaultLabel}
          data-alt-de={screen.deLabel}
        >
          <img
            class="gallery-image"
            src={`/screenshots/en/dark/${screen.id}.png`}
            data-gallery-id={screen.id}
            alt={screen.defaultLabel}
            data-alt-en={screen.defaultLabel}
            data-alt-de={screen.deLabel}
            width="1920"
            height="1080"
            loading={idx === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
          <span class="gallery-zoom-hint" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </span>
        </button>
        <figcaption class="gallery-caption" data-i18n={screen.i18nLabel}>
          {screen.defaultLabel}
        </figcaption>
      </figure>
    ))}
  </div>
</div>

<ScreenshotLightbox />

<style>
  .gallery-root {
    max-width: 72rem;
    margin: 0 auto;
  }

  /* Theme toggle */
  .gallery-controls {
    display: flex;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .gallery-control-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .gallery-control-divider {
    width: 1px;
    height: 1.25rem;
    background: rgba(255, 255, 255, 0.12);
    margin: 0 0.25rem;
  }

  html.light .gallery-control-divider {
    background: #e2e8f0;
  }

  .gallery-toggles {
    display: inline-flex;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
  }

  .gallery-toggle {
    padding: 0.375rem 1.125rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.5);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
    min-width: 4rem;
  }

  .gallery-toggle:hover {
    color: rgba(255, 255, 255, 0.7);
  }

  .gallery-toggle--active {
    background: var(--color-brand-cyan);
    color: #0f1219;
  }

  html.light .gallery-toggles {
    border-color: #e2e8f0;
    background: rgba(0, 0, 0, 0.03);
  }

  html.light .gallery-toggle {
    color: #64748b;
  }

  html.light .gallery-toggle:hover {
    color: #1e293b;
  }

  html.light .gallery-toggle--active {
    background: var(--color-brand-cyan);
    color: #fff;
  }

  /* Responsive grid: 1 → 2 → 3 columns */
  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .gallery-item {
    margin: 0;
  }

  /* Thumbnail button wrapper */
  .gallery-thumb-btn {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    border-radius: 10px;
    overflow: hidden;
    outline-offset: 3px;
  }

  .gallery-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.35s ease;
  }

  .gallery-thumb-btn:hover .gallery-image,
  .gallery-thumb-btn:focus-visible .gallery-image {
    transform: translateY(-3px) scale(1.015);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.35);
  }

  html.light .gallery-image {
    box-shadow: 0 6px 24px rgba(15, 23, 42, 0.1);
  }

  html.light .gallery-thumb-btn:hover .gallery-image,
  html.light .gallery-thumb-btn:focus-visible .gallery-image {
    box-shadow: 0 12px 40px rgba(15, 23, 42, 0.16);
  }

  /* Zoom hint icon */
  .gallery-zoom-hint {
    position: absolute;
    bottom: 0.625rem;
    right: 0.625rem;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    color: rgba(255, 255, 255, 0.85);
    opacity: 0;
    transform: scale(0.85);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }

  .gallery-thumb-btn:hover .gallery-zoom-hint,
  .gallery-thumb-btn:focus-visible .gallery-zoom-hint {
    opacity: 1;
    transform: scale(1);
  }

  html.light .gallery-zoom-hint {
    background: rgba(255, 255, 255, 0.85);
    color: #334155;
  }

  /* Caption */
  .gallery-caption {
    text-align: center;
    margin-top: 0.625rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.5);
  }

  html.light .gallery-caption {
    color: #64748b;
  }
</style>

<script>
  import { detectPlatform } from '../scripts/platform';

  function initGallery() {
    const root = document.getElementById('screenshot-gallery');
    if (!root) return;

    const themeToggles = root.querySelectorAll<HTMLButtonElement>('[data-gallery-theme]');
    const platformToggles = root.querySelectorAll<HTMLButtonElement>('[data-gallery-platform]');
    const thumbButtons = root.querySelectorAll<HTMLButtonElement>('.gallery-thumb-btn');

    let galleryTheme = 'dark';
    let galleryPlatform: 'windows' | 'macos' =
      detectPlatform() === 'macos' ? 'macos' : 'windows';

    function getLang(): string {
      return document.documentElement.lang === 'de' ? 'de' : 'en';
    }

    function buildSrc(id: string, lang: string, theme: string): string {
      const prefix = galleryPlatform === 'macos' ? 'mac/' : '';
      return `/screenshots/${prefix}${lang}/${theme}/${id}.png`;
    }

    function syncPlatformToggles() {
      platformToggles.forEach(btn => {
        const active = btn.dataset.galleryPlatform === galleryPlatform;
        btn.classList.toggle('gallery-toggle--active', active);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    }

    function updateImages() {
      const lang = getLang();
      root.querySelectorAll<HTMLImageElement>('img[data-gallery-id]').forEach(img => {
        const id = img.dataset.galleryId!;
        const newSrc = buildSrc(id, lang, galleryTheme);
        if (img.getAttribute('src') !== newSrc) img.src = newSrc;
        const alt = lang === 'de' ? img.dataset.altDe : img.dataset.altEn;
        if (alt) img.alt = alt;
      });
      root.querySelectorAll<HTMLElement>('[data-aria-label-en]').forEach(el => {
        const label = lang === 'de' ? el.dataset.ariaLabelDe : el.dataset.ariaLabelEn;
        if (label) el.setAttribute('aria-label', label);
      });
    }

    function buildLightboxImages(): Array<{ src: string; alt: string }> {
      const lang = getLang();
      return Array.from(root.querySelectorAll<HTMLImageElement>('.gallery-image')).map(img => ({
        src: buildSrc(img.dataset.galleryId!, lang, galleryTheme),
        alt: img.alt,
      }));
    }

    // Initialise platform toggle state
    syncPlatformToggles();

    // Platform toggles
    platformToggles.forEach(btn => {
      btn.addEventListener('click', () => {
        galleryPlatform = (btn.dataset.galleryPlatform as 'windows' | 'macos') || 'windows';
        syncPlatformToggles();
        updateImages();
      });
    });

    // Theme toggles
    themeToggles.forEach(btn => {
      btn.addEventListener('click', () => {
        galleryTheme = btn.dataset.galleryTheme || 'dark';
        themeToggles.forEach(b => {
          b.classList.toggle('gallery-toggle--active', b === btn);
          b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
        });
        updateImages();
      });
    });

    // Thumbnail click → open lightbox
    thumbButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.dataset.galleryIdx || '0', 10);
        const images = buildLightboxImages();
        if ((window as any).openScreenshotLightbox) {
          (window as any).openScreenshotLightbox(images, idx);
        }
      });
    });

    // Language observer
    const langObs = new MutationObserver(() => updateImages());
    langObs.observe(document.documentElement, { attributes: true, attributeFilter: ['lang'] });

    updateImages();
  }

  initGallery();
</script>
