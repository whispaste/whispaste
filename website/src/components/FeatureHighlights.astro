---
import MotionHotkey from './motion/MotionHotkey.astro';
import SectionEyebrow from './SectionEyebrow.astro';
import { t, currentLocale } from '../scripts/i18n.ts';

const lang = currentLocale(Astro.currentLocale);

// Row 2: three everyday features as equal cards. Icon paths are Lucide
// outlines (24×24, stroke), inlined like the site's other SVGs.
const rowCards = [
  { key: 'editSelection', icon: 'M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z' },
  { key: 'history', icon: 'M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8m0-5v5h5m4-1v5l4 2' },
  { key: 'notes', icon: 'M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Zm0 0v5h5M8 13h8m-8 4h5' },
] as const;

// Everything else stays on the page (crawlable, searchable) in one native
// disclosure instead of a wall of equal-rank cards.
const moreKeys = [
  'hotkey',
  'sidepanel',
  'vocabulary',
  'overlay',
  'hardware',
  'privacy',
  'cloud',
  'access',
  'remote',
  'backup',
] as const;

const snippetExamples = ['highlights.snippets.example1', 'highlights.snippets.example2', 'highlights.snippets.example3'] as const;
---

<!-- FeatureHighlights — what WhisPaste does beyond plain dictation. Smart Mode
     and Snippets carry the section as two asymmetric showcase cards with a
     concrete example each; three everyday features follow as a row; the rest
     sits in one "more" disclosure. Details live in the FAQ and the gallery. -->
<section id="features" class="band band-spotlight wp-section relative scroll-mt-20">
  <div class="relative wp-container">
    <div class="wp-section-head">
      <SectionEyebrow key="highlights.label" class="reveal-up" />
      <h2 class="section-title wp-kinetic-line">
        <span data-i18n="highlights.titleLead">{t(lang, 'highlights.titleLead')}</span><!--
        --><span class="text-gradient-brand" data-i18n="highlights.titleAccent">{t(lang, 'highlights.titleAccent')}</span><!--
        --><span data-i18n="highlights.titleTail">{t(lang, 'highlights.titleTail')}</span>
      </h2>
      <div class="wp-head-art" aria-hidden="true"><MotionHotkey /></div>
    </div>

    <div class="fh-showcase">
      <!-- Smart Mode: spoken vs. cleaned-up text -->
      <article class="fh-card fh-card--smart" data-testid="features-smartmode">
        <div class="fh-card-head">
          <h3 class="fh-title" data-i18n="highlights.smartmode.title">{t(lang, 'highlights.smartmode.title')}</h3>
          <span class="fh-badge" data-i18n="highlights.optional">{t(lang, 'highlights.optional')}</span>
        </div>
        <p class="fh-desc" data-i18n="highlights.smartmode.desc">{t(lang, 'highlights.smartmode.desc')}</p>
        <div class="fh-compare" aria-hidden="true">
          <div class="fh-compare-row">
            <span class="fh-compare-label" data-i18n="highlights.smartmode.spokenLabel">{t(lang, 'highlights.smartmode.spokenLabel')}</span>
            <p class="fh-compare-text fh-compare-text--raw" data-i18n="highlights.smartmode.spokenText">{t(lang, 'highlights.smartmode.spokenText')}</p>
          </div>
          <div class="fh-compare-row">
            <span class="fh-compare-label" data-i18n="highlights.smartmode.cleanLabel">{t(lang, 'highlights.smartmode.cleanLabel')}</span>
            <p class="fh-compare-text fh-compare-text--clean" data-i18n="highlights.smartmode.cleanText">{t(lang, 'highlights.smartmode.cleanText')}</p>
          </div>
        </div>
      </article>

      <!-- Snippets: the picker that opens at the cursor -->
      <article class="fh-card" data-testid="features-snippets">
        <h3 class="fh-title" data-i18n="highlights.snippets.title">{t(lang, 'highlights.snippets.title')}</h3>
        <p class="fh-desc" data-i18n="highlights.snippets.desc">{t(lang, 'highlights.snippets.desc')}</p>
        <ul class="fh-picker" aria-hidden="true">
          {snippetExamples.map((key, i) => (
            <li class:list={['fh-picker-item', { 'is-active': i === 0 }]}>
              <span data-i18n={key}>{t(lang, key)}</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
            </li>
          ))}
        </ul>
      </article>
    </div>

    <div class="fh-row">
      {rowCards.map(({ key, icon }) => (
        <article class="fh-card fh-card--small">
          <span class="fh-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={icon} /></svg>
          </span>
          <h3 class="fh-title fh-title--small" data-i18n={`highlights.${key}.title`}>{t(lang, `highlights.${key}.title`)}</h3>
          <p class="fh-desc" data-i18n={`highlights.${key}.desc`}>{t(lang, `highlights.${key}.desc`)}</p>
        </article>
      ))}
    </div>

    <details class="fh-more" data-testid="features-more">
      <summary class="fh-more-summary" data-testid="features-more-toggle">
        <span data-i18n="highlights.more">{t(lang, 'highlights.more')}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
      </summary>
      <dl class="fh-more-list">
        {moreKeys.map((key) => (
          <div class="fh-more-item">
            <dt data-i18n={`highlights.${key}.title`}>{t(lang, `highlights.${key}.title`)}</dt>
            <dd data-i18n={`highlights.${key}.desc`}>{t(lang, `highlights.${key}.desc`)}</dd>
          </div>
        ))}
      </dl>
    </details>

    <p class="fh-gallery">
      <a href="#app-screenshots" class="fh-gallery-link" data-testid="features-gallery-link">
        <span data-i18n="highlights.galleryLink">{t(lang, 'highlights.galleryLink')}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
      </a>
    </p>
  </div>
</section>

<style>
  /* ---- Cards ---- */
  .fh-card {
    display: flex;
    flex-direction: column;
    gap: var(--wp-space-3);
    padding: clamp(var(--wp-space-5), var(--wp-space-4) + 1vw, var(--wp-space-8));
    border-radius: var(--radius-surface);
    border: 1px solid var(--wp-border-default);
    background: color-mix(in srgb, var(--color-brand-card) 80%, transparent);
    box-shadow: var(--shadow-card);
    min-width: 0;
  }
  .fh-card--smart {
    border-color: color-mix(in srgb, var(--color-brand-cyan) 28%, transparent);
    background:
      radial-gradient(ellipse 80% 70% at 0% 0%, color-mix(in srgb, var(--color-brand-cyan) 10%, transparent), transparent 70%),
      color-mix(in srgb, var(--color-brand-card) 88%, transparent);
  }
  .fh-card--small {
    border-radius: var(--radius-card);
  }
  .fh-card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--wp-space-2) var(--wp-space-3);
  }
  .fh-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--wp-font-size-h3);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .fh-title--small {
    font-family: var(--font-sans);
    font-size: var(--type-card-title);
    font-weight: 700;
    letter-spacing: 0;
  }
  .fh-badge {
    padding: var(--wp-space-1) var(--wp-space-3);
    border-radius: var(--radius-pill);
    border: 1px solid var(--wp-border-strong);
    font-size: var(--wp-font-size-sm);
    color: var(--color-ink-muted);
  }
  .fh-desc {
    margin: 0;
    font-size: var(--wp-font-size-md);
    line-height: 1.65;
    color: var(--color-ink-muted);
  }
  .fh-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-control);
    color: var(--color-brand-cyan);
    background: color-mix(in srgb, var(--color-brand-cyan) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-brand-cyan) 25%, transparent);
  }
  .fh-icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* ---- Layout: 8/4 showcase, then a row of three ---- */
  .fh-showcase,
  .fh-row {
    display: grid;
    gap: var(--wp-space-5);
  }
  .fh-row {
    margin-top: var(--wp-space-5);
  }
  @media (min-width: 768px) {
    .fh-row { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .fh-showcase { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); }
  }

  /* ---- Smart Mode before/after ---- */
  .fh-compare {
    margin-top: auto;
    padding-top: var(--wp-space-3);
    display: grid;
    gap: var(--wp-space-4);
  }
  .fh-compare-row {
    display: grid;
    gap: var(--wp-space-2);
  }
  .fh-compare-label {
    font-size: var(--wp-font-size-sm);
    font-weight: 600;
    color: var(--color-ink-subtle);
  }
  .fh-compare-text {
    margin: 0;
    padding: var(--wp-space-4) var(--wp-space-4);
    border-radius: var(--radius-control);
    border: 1px solid var(--wp-border-default);
    background: var(--wp-surface-inset);
    font-size: var(--wp-font-size-lead);
    line-height: 1.5;
  }
  .fh-compare-text--raw {
    color: var(--color-ink-muted);
  }
  .fh-compare-text--clean {
    color: var(--color-ink);
    border-color: color-mix(in srgb, var(--color-brand-cyan) 45%, transparent);
  }

  /* ---- Snippet picker ---- */
  .fh-picker {
    margin: auto 0 0;
    padding: var(--wp-space-3) 0 0;
    list-style: none;
    display: grid;
    gap: var(--wp-space-2);
  }
  .fh-picker-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--wp-space-3);
    padding: var(--wp-space-3) var(--wp-space-4);
    border-radius: var(--radius-control);
    border: 1px solid var(--wp-border-default);
    font-size: var(--wp-font-size-md);
    color: var(--color-ink-muted);
  }
  .fh-picker-item.is-active {
    color: var(--color-ink);
    border-color: color-mix(in srgb, var(--color-brand-cyan) 55%, transparent);
    background: color-mix(in srgb, var(--color-brand-cyan) 8%, transparent);
  }
  .fh-picker-item svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  /* ---- More features (native disclosure) ---- */
  .fh-more {
    margin-top: var(--wp-space-5);
    border-radius: var(--radius-card);
    border: 1px solid var(--wp-border-default);
  }
  .fh-more-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--wp-space-4);
    min-height: 44px;
    padding: var(--wp-space-4) var(--wp-space-5);
    font-weight: 600;
    color: var(--color-ink);
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius-card);
  }
  .fh-more-summary::-webkit-details-marker { display: none; }
  .fh-more-summary:focus-visible {
    outline: 2px solid var(--color-brand-cyan);
    outline-offset: 2px;
  }
  .fh-more-summary svg {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-brand-cyan);
    transition: transform var(--dur-base) var(--ease-flow);
  }
  .fh-more[open] .fh-more-summary svg {
    transform: rotate(180deg);
  }
  .fh-more-list {
    margin: 0;
    padding: 0 var(--wp-space-5) var(--wp-space-5);
    display: grid;
    gap: var(--wp-space-5) var(--wp-space-10);
  }
  @media (min-width: 768px) {
    .fh-more-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .fh-more-item dt {
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: var(--wp-space-1);
  }
  .fh-more-item dd {
    margin: 0;
    font-size: var(--wp-font-size-md);
    line-height: 1.65;
    color: var(--color-ink-muted);
  }

  .fh-gallery {
    margin-top: var(--wp-space-8);
  }
  .fh-gallery-link {
    display: inline-flex;
    align-items: center;
    gap: var(--wp-space-1);
    min-height: 44px;
    font-weight: 600;
    color: var(--color-brand-cyan);
    text-decoration: none;
  }
  .fh-gallery-link svg {
    width: 1rem;
    height: 1rem;
    transition: transform var(--dur-base) var(--ease-flow);
  }
  .fh-gallery-link:hover svg {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .fh-more-summary svg,
    .fh-gallery-link svg {
      transition: none;
    }
  }
</style>
