<style>
  /* ---- Mockup Design Tokens ---- */
  .mockup-collage {
    --mockup-bg: #0F1117;
    --mockup-surface: #1A1D27;
    --mockup-input-bg: #181B24;
    --mockup-text: #F0F6FC;
    --mockup-text-muted: #8899A6;
    --mockup-text-dim: #64748B;
    --mockup-text-dimmer: #475569;
    --mockup-border: rgba(255, 255, 255, 0.08);
    --mockup-cyan: var(--color-brand-cyan);
    --mockup-teal: #0891B2;
  }

  /* ---- Mockup window chrome ---- */
  .mockup-glow {
    background: linear-gradient(135deg, rgba(34,211,238,0.25), rgba(14,116,144,0.12), rgba(34,211,238,0.2));
    box-shadow: 0 8px 40px rgba(0,0,0,0.4), 0 0 80px rgba(34,211,238,0.08);
    border-radius: 16px;
    padding: 1px;
    transition: box-shadow 0.4s ease;
  }
  .mockup-glow:hover {
    box-shadow: 0 12px 50px rgba(0,0,0,0.5), 0 0 100px rgba(34,211,238,0.12);
  }
  .mockup-window {
    background: var(--mockup-bg);
    font-family: 'Segoe UI Variable', 'Segoe UI', system-ui, sans-serif;
  }
  .mockup-titlebar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background: var(--mockup-surface);
    border-bottom: 1px solid var(--mockup-border);
    font-size: 12px;
    user-select: none;
  }
  .mockup-titlebar-text {
    font-size: 12px;
    font-weight: 500;
    color: var(--mockup-text);
  }

  /* ---- Notebook mockup ---- */
  .mockup-nb-body {
    position: relative;
    display: flex;
    flex-direction: row;
    background: linear-gradient(160deg, var(--mockup-bg) 0%, color-mix(in srgb, var(--mockup-cyan) 4%, var(--mockup-bg)) 50%, var(--mockup-bg) 100%);
    min-height: 340px;
  }
  .mockup-nb-topbar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    background: var(--mockup-surface);
    border-bottom: 1px solid color-mix(in srgb, var(--mockup-cyan) 15%, var(--mockup-border));
  }
  .mockup-nb-search-wrap {
    position: relative;
    flex: 1;
    max-width: 400px;
    margin: 0 auto;
    width: 100%;
  }
  .mockup-nb-search-icon {
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    width: 14px;
    height: 14px;
    color: var(--mockup-text-dim);
  }
  .mockup-nb-search {
    width: 100%;
    padding: 6px 10px 6px 30px;
    border: 1px solid var(--mockup-border);
    border-radius: 999px;
    background: var(--mockup-input-bg);
    color: var(--mockup-text-dim);
    font-size: 12px;
    outline: none;
  }
  .mockup-nb-count {
    font-size: 10px;
    color: var(--mockup-cyan);
    padding: 3px 8px;
    background: rgba(34, 211, 238, 0.08);
    border: 1px solid rgba(34, 211, 238, 0.3);
    border-radius: 12px;
    white-space: nowrap;
  }
  /* Unified sidebar — icon-only */
  .mockup-sidebar {
    width: 55px;
    flex-shrink: 0;
    background: var(--mockup-surface);
    border-right: 1px solid var(--mockup-border);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .mockup-sidebar-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px 0 10px;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    position: relative;
    z-index: 1;
  }
  .mockup-sidebar-nav {
    padding: 8px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    position: relative;
    z-index: 1;
  }
  .mockup-sidebar-item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    color: var(--mockup-text-muted);
    position: relative;
  }
  .mockup-sidebar-item svg { width: 15px; height: 15px; flex-shrink: 0; }
  .mockup-sidebar-item-active {
    background: linear-gradient(135deg, var(--mockup-cyan), var(--mockup-teal));
    color: #FFFFFF;
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(34, 211, 238, 0.25), 0 0 16px rgba(34, 211, 238, 0.15);
  }
  .mockup-sidebar-spacer { flex: 1; }
  .mockup-sidebar-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 10px 0;
    border-top: 1px solid rgba(255,255,255,0.04);
    position: relative;
    z-index: 1;
  }
  .mockup-sidebar-bottom-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    color: var(--mockup-text-muted);
    font-size: 9px;
    font-weight: 700;
  }
  .mockup-sidebar-lang-label {
    width: auto;
    padding: 0;
    font-size: 9px;
  }
  /* Notebook content area */
  .mockup-nb-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    position: relative;
    min-width: 0;
  }
  /* Entries */
  .mockup-nb-entries {
    flex: 1;
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    overflow: hidden;
  }
  .mockup-nb-card {
    position: relative;
    background: linear-gradient(180deg, var(--mockup-surface), color-mix(in srgb, var(--mockup-cyan) 2%, var(--mockup-surface)));
    border: 1px solid var(--mockup-border);
    border-radius: 10px;
    padding: 10px 14px;
    box-shadow: 0 1px 3px rgba(0,0,0,.3);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .mockup-nb-card-pinned {
    padding-left: 18px;
    border-left-color: rgba(34,211,238,0.3);
  }
  .mockup-nb-pin-bar {
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 3px;
    background: var(--mockup-cyan);
    border-radius: 0 2px 2px 0;
  }
  .mockup-nb-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .mockup-nb-card-title {
    font-size: 12px;
    font-weight: 500;
    color: var(--mockup-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
  }
  .mockup-nb-card-actions {
    display: flex;
    gap: 2px;
    flex-shrink: 0;
  }
  .mockup-nb-action-btn-sm {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 5px;
    color: var(--mockup-text-muted);
  }
  .mockup-nb-card-meta {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 10px;
    color: var(--mockup-text-dim);
    margin-top: 3px;
  }
  .mockup-nb-meta-dot {
    color: var(--mockup-text-dimmer);
  }
  .mockup-nb-card-preview {
    font-size: 11px;
    color: var(--mockup-text-muted);
    line-height: 1.5;
    margin-top: 4px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* History layout (filter sidebar + entries) */
  .mockup-nb-history-layout {
    display: flex;
    flex: 1;
    overflow: hidden;
  }
  /* Filter sidebar */
  .mockup-filter-sidebar {
    width: 140px;
    flex-shrink: 0;
    padding: 10px;
    overflow-y: auto;
    border-right: 1px solid var(--mockup-border);
    background: var(--mockup-surface);
  }
  .mockup-sort-section { margin-bottom: 10px; }
  .mockup-sort-trigger {
    display: flex;
    align-items: center;
    gap: 5px;
    background: none;
    border: none;
    color: var(--mockup-text-muted);
    font-size: 11px;
    cursor: default;
    padding: 5px 8px;
    border-radius: 6px;
    font-family: inherit;
  }
  .mockup-sort-trigger svg { width: 12px; height: 12px; flex-shrink: 0; }
  .mockup-filter-items {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .mockup-filter-item {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 6px 8px;
    border-radius: 8px;
    color: var(--mockup-text-muted);
    font-size: 11px;
    font-weight: 500;
    border: 1px solid transparent;
  }
  .mockup-filter-item svg { width: 13px; height: 13px; flex-shrink: 0; }
  .mockup-filter-item-active {
    background: rgba(34,211,238,0.08);
    color: var(--mockup-cyan);
    font-weight: 600;
    border-color: rgba(34,211,238,0.3);
  }
  .mockup-filter-count {
    margin-left: auto;
    font-size: 10px;
    font-weight: 600;
    color: var(--mockup-text-dimmer);
  }
  .mockup-filter-item-active .mockup-filter-count { color: rgba(34,211,238,0.6); }
  /* Selection bar */
  .mockup-nb-selection-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 16px;
    background: rgba(34,211,238,0.06);
    border-bottom: 1px solid rgba(34,211,238,0.3);
  }
  .mockup-nb-selection-info {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    color: var(--mockup-cyan);
  }
  .mockup-nb-selection-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 4px;
    color: var(--mockup-text-muted);
  }
  .mockup-nb-selection-close svg { width: 12px; height: 12px; }
  .mockup-nb-selection-actions { display: flex; gap: 6px; }
  .mockup-nb-sel-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    font-size: 10px;
    font-weight: 500;
    border-radius: 6px;
    background: rgba(255,255,255,0.06);
    border: 1px solid var(--mockup-border);
