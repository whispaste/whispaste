---
import AppPreviewMockup from './AppPreviewMockup.astro';
---
<!-- App Preview Section -->
<section id="app-preview" class="py-24 sm:py-32 relative scroll-mt-20">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_rgba(14,116,144,0.06)_0%,_transparent_65%)]"></div>
  <div class="relative max-w-7xl mx-auto px-6">
    <div class="text-center mb-16 scroll-reveal">
      <p class="text-brand-cyan text-sm font-semibold tracking-wider uppercase mb-3" data-i18n="preview.label">App Preview</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-white" data-i18n="preview.title">Designed to get out of your way</h2>
      <p class="mt-4 text-gray-400 text-lg max-w-2xl mx-auto" data-i18n="preview.desc">A clean, modern interface that keeps everything organized — search, filter, and manage all your transcriptions in one place.</p>
    </div>

    <AppPreviewMockup />
  </div>
</section>