---
// Testimonials.astro — Fetches approved testimonials at BUILD TIME (SSG).
// Zero runtime Edge Function calls — data is baked into static HTML.
// Testimonials update automatically on each site redeploy.

const API_URL = 'https://cnyniyflnefxrwafuqig.supabase.co/functions/v1/testimonials';

interface Testimonial {
  rating: number;
  text: string;
}

let testimonials: Testimonial[] = [];

try {
  const res = await fetch(API_URL + '?limit=6');
  if (res.ok) {
    const data = await res.json();
    testimonials = (data.testimonials || []).filter(
      (t: Testimonial) => t.text && t.rating >= 1
    );
  }
} catch {
  // Build continues without testimonials — section stays hidden
}

function escapeHtml(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}
---

{testimonials.length > 0 && (
  <section id="testimonials" class="py-24 sm:py-32 relative scroll-mt-20">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-12 scroll-reveal">
        <p class="text-brand-cyan text-sm font-semibold tracking-wider uppercase mb-3" data-i18n="testimonials.label">Testimonials</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white" data-i18n="testimonials.title">What our users say</h2>
        <p class="mt-4 text-gray-400 max-w-xl mx-auto" data-i18n="testimonials.subtitle">Real feedback from real people — no names, no tracking, just honest opinions.</p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 scroll-reveal">
        {testimonials.map((t) => {
          const r = Math.max(0, Math.min(5, Math.round(t.rating) || 0));
          return (
            <div class="testimonial-card">
              <div class="testimonial-stars">{'★'.repeat(r)}{'☆'.repeat(5 - r)}</div>
              <p class="testimonial-text" set:html={`"${escapeHtml(t.text)}"`} />
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}

<style>
  .testimonial-card {
    background: linear-gradient(135deg, rgba(29, 37, 56, 0.6) 0%, rgba(23, 29, 44, 0.3) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    padding: 1.5rem;
    transition: border-color 0.2s, transform 0.2s;
  }
  .testimonial-card:hover {
    border-color: rgba(56, 217, 240, 0.2);
    transform: translateY(-2px);
  }
  .testimonial-stars {
    color: #FBBF24;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
  }
  .testimonial-text {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-top: 0.75rem;
  }

  /* Light theme overrides */
  :root.light .testimonial-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.8) 0%, rgba(248, 250, 252, 0.5) 100%);
    border-color: rgba(0, 0, 0, 0.08);
  }
  :root.light .testimonial-card:hover {
    border-color: rgba(8, 145, 178, 0.3);
  }
  :root.light .testimonial-text {
    color: rgba(0, 0, 0, 0.6);
  }
</style>
