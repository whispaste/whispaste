---
import SectionEyebrow from './SectionEyebrow.astro';
import { t, currentLocale } from '../scripts/i18n.ts';

const lang = currentLocale(Astro.currentLocale);

// Testimonials.astro — Fetches approved testimonials at BUILD TIME (SSG).
// Uses PostgREST directly (no Edge Function) — zero invocations against the
// Supabase free-tier limit. Data is baked into static HTML at deploy time.

// Supabase anon key: safe to embed in SSG source (public by design — security
// enforced by the public_testimonials view + RLS, not by key secrecy).
const SUPABASE_URL = 'https://cnyniyflnefxrwafuqig.supabase.co';
const SUPABASE_ANON_KEY =
  'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNueW5peWZsbmVmeHJ3YWZ1cWlnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzQ5Njc0OTIsImV4cCI6MjA5MDU0MzQ5Mn0.f3xBLIwq1a4LMwV9cmpebzLoYzNJfxxiOTWBl7Pxl3w';

// PostgREST endpoint for the public_testimonials view (rating, text only — no PII).
const API_URL =
  `${SUPABASE_URL}/rest/v1/public_testimonials` +
  `?select=rating,text&order=received_at.desc&limit=6`;

interface Testimonial {
  rating: number;
  text: string;
}

let testimonials: Testimonial[] = [];

try {
  const res = await fetch(API_URL, {
    headers: {
      apikey: SUPABASE_ANON_KEY,
      Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
    },
  });
  if (res.ok) {
    const data = await res.json();
    // PostgREST returns an array directly (no wrapper object). The rating
    // gate (uncurated text needs rating >= 4; curated text bypasses it) is
    // already enforced server-side by the public_testimonials view — no
    // need to re-check it here, and doing so would silently re-exclude
    // curated low-rating testimonials the view now deliberately allows.
    testimonials = (Array.isArray(data) ? data : []).filter(
      (t: Testimonial) => !!t.text
    );
  }
} catch {
  // Build continues without testimonials — section stays hidden
}

// Abstract, friendly avatar per testimonial: a tilted rounded shape with a
// simple face on a colour field (no photo, no person). Shape details come
// deterministically from the text; the colour pair is offset by the card index
// so neighbouring cards never share a tone. No names exist (no PII by design).
// Colours are derived from the semantic tokens (no primitives, no new tokens),
// so the avatars follow the dark/light surface like the rest of the card.
const AVATAR_PAIRS: [string, string][] = [
  ['var(--wp-accent-strong)', 'var(--wp-accent-fill)'],
  ['var(--wp-highlight-text)', 'var(--wp-highlight-default)'],
  ['var(--wp-status-warning)', 'color-mix(in srgb, var(--wp-status-warning) 55%, var(--wp-text-primary))'],
  ['var(--wp-accent-default)', 'var(--wp-text-primary)'],
  ['var(--wp-status-success)', 'color-mix(in srgb, var(--wp-status-success) 50%, var(--wp-text-primary))'],
  ['color-mix(in srgb, var(--wp-accent-strong) 60%, var(--wp-text-primary))', 'var(--wp-accent-fill)'],
];

function hashText(s: string): number {
  let h = 2166136261;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

function avatarFor(text: string, index: number) {
  const h = hashText(text);
  const [bg, face] = AVATAR_PAIRS[index % AVATAR_PAIRS.length];
  return {
    bg,
    face,
    rot: -14 + ((h >>> 3) % 29),
    dx: -3 + ((h >>> 9) % 7),
    dy: -2 + ((h >>> 13) % 5),
    round: (h >>> 17) % 2 === 0,
    open: (h >>> 19) % 3 === 0,
  };
}

// Pangram principle (tone, not motif): a few big quote tiles in different
// tones instead of a uniform card wall. The longest quote leads as a dark
// panel spanning two columns and rows; every third other tile is tinted.
const featured = testimonials.reduce(
  (best, item, i) => (item.text.length > testimonials[best].text.length ? i : best),
  0,
);
const tone = (i: number) =>
  i === featured ? 'feature' : (i - (i > featured ? 1 : 0)) % 3 === 1 ? 'tint' : 'plain';

function escapeHtml(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}
---

{testimonials.length > 0 && (
  <section id="testimonials" class="wp-band relative wp-section scroll-mt-20" data-surface="light" data-testid="testimonials">
    <div class="wp-container">
      <div class="wp-section-head">
        <SectionEyebrow key="testimonials.label" />
        <h2 class="section-title"><span data-i18n="testimonials.titleLead">{t(lang, "testimonials.titleLead")}</span><span class="wp-marker" data-i18n="testimonials.titleAccent">{t(lang, "testimonials.titleAccent")}</span><span data-i18n="testimonials.titleTail">{t(lang, "testimonials.titleTail")}</span></h2>
        <p class="wp-lead mt-4" data-i18n="testimonials.subtitle">{t(lang, "testimonials.subtitle")}</p>
      </div>

      <div class="testimonial-grid" data-testid="testimonials-grid">
        {testimonials.map((item, i) => {
          const r = Math.max(0, Math.min(5, Math.round(item.rating) || 0));
          const av = avatarFor(item.text, i);
          const id = `tm-av-${i}`;
          return (
            <figure
              class={`testimonial-card testimonial-card--${tone(i)}`}
              data-surface={i === featured ? 'dark' : undefined}
              data-testid={`testimonials-card-${i}`}
            >
              <div class="testimonial-head" aria-hidden="true">
              <svg class="testimonial-avatar" viewBox="0 0 48 48" style={`--tm-tone: ${av.face}`}>
                <defs>
                  <clipPath id={`${id}-c`}><circle cx="24" cy="24" r="24" /></clipPath>
                </defs>
                <g clip-path={`url(#${id}-c)`}>
                  <rect width="48" height="48" style={`fill: ${av.bg}`} />
                  <g transform={`translate(${av.dx} ${av.dy + 6}) rotate(${av.rot} 24 24)`}>
                    <rect x="7" y="7" width="34" height="38" rx={av.round ? 17 : 10} style={`fill: ${av.face}`} />
                    <circle cx="18" cy="22" r="2.4" style={`fill: ${av.bg}`} />
                    <circle cx="30" cy="22" r="2.4" style={`fill: ${av.bg}`} />
                    {av.open
                      ? <path d="M18 29q6 7 12 0z" style={`fill: ${av.bg}`} />
                      : <path d="M18.5 29.5q5.5 4.5 11 0" style={`stroke: ${av.bg}`} stroke-width="2.2" stroke-linecap="round" fill="none" />}
                  </g>
                </g>
              </svg>
              <svg class="testimonial-glyph" viewBox="0 0 24 24"><path d="M3 21c3 0 7-1 7-8V5H3v8h4c0 3-1 5-4 5zm11 0c3 0 7-1 7-8V5h-7v8h4c0 3-1 5-4 5z" fill="currentColor" /></svg>
              </div>
              <blockquote class="testimonial-text" set:html={escapeHtml(item.text)} />
              <div class="testimonial-stars" role="img" aria-label={`${r}/5`}>
                <span aria-hidden="true">{'★'.repeat(r)}<span class="testimonial-stars__off">{'★'.repeat(5 - r)}</span></span>
              </div>
            </figure>
          );
        })}
      </div>
    </div>
  </section>
)}

<style>
  /* Bento: the featured quote spans 2 × 2 cells, `dense` fills the rest, so
     six quotes close a 3 × 3 grid with no gaps. */
  .testimonial-grid {
    display: grid;
    gap: var(--wp-space-4);
  }
  @media (min-width: 640px) {
    .testimonial-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-flow: dense;
      gap: var(--wp-space-5);
    }
    .testimonial-card--feature { grid-column: span 2; }
  }
  @media (min-width: 1024px) {
    .testimonial-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .testimonial-card--feature { grid-row: span 2; }
  }

  .testimonial-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--wp-space-4);
    padding: var(--wp-card-pad);
    border-radius: var(--wp-card-radius);
    border: 1px solid var(--wp-card-border);
    background: var(--wp-card-fill);
    box-shadow: var(--wp-card-shadow);
    color: var(--wp-card-title);
  }
  .testimonial-card--tint {
    border-color: transparent;
    background: var(--wp-accent-soft);
    box-shadow: none;
  }
  /* The dark panel rises from the light band (data-surface="dark" swaps the
     semantic tokens); one large corner marks it as the lead quote. */
  .testimonial-card--feature {
    justify-content: space-between;
    border-radius: var(--wp-card-radius-lg);
    border-top-right-radius: calc(var(--wp-card-radius-lg) * 3);
    background: var(--wp-surface-band);
  }

  .testimonial-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .testimonial-avatar {
    width: var(--wp-space-10);
    height: var(--wp-space-10);
    border-radius: var(--wp-radius-pill);
    box-shadow: 0 0 0 2px var(--wp-card-fill), 0 0 0 3px var(--tm-tone);
  }
  .testimonial-glyph {
    width: var(--wp-space-6);
    height: var(--wp-space-6);
    color: var(--wp-accent-default);
  }
  .testimonial-text {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--wp-font-size-xl);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--wp-text-primary);
    text-wrap: pretty;
  }
  .testimonial-card--feature .testimonial-text {
    font-size: var(--wp-font-size-title);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .testimonial-stars {
    margin-top: auto;
    color: var(--wp-highlight-text);
    font-size: var(--wp-font-size-sm);
    letter-spacing: 0.12em;
    line-height: 1.2;
  }
  .testimonial-stars__off {
    color: var(--wp-border-strong);
  }
</style>
