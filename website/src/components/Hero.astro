---
import HeroCarousel from './HeroCarousel.astro';
import StoreButton from './StoreButton.astro';
import MacStoreButton from './MacStoreButton.astro';
import LinuxButton from './LinuxButton.astro';
import { t, localePath } from '../scripts/i18n.ts';
// Inline-tintable OS glyphs for the platform-badge row (Issue 09). Raw-imported
// so `fill="currentColor"` inherits the pill's `color` — an <img>-embedded SVG
// cannot do this. See website/public/os-icons/ATTRIBUTION.txt for provenance.
import appleIconRaw from '../../public/os-icons/apple.svg?raw';
import windowsIconRaw from '../../public/os-icons/windows.svg?raw';
import ubuntuIconRaw from '../../public/os-icons/ubuntu.svg?raw';

const lang = (Astro.currentLocale === 'en' ? 'en' : 'de') as 'de' | 'en';
---

<!-- Hero Section -->
<section
  class="wp-parallax-scope relative sm:min-h-[100svh] flex items-center justify-center overflow-hidden pt-28 sm:pt-32 pb-16 sm:pb-24"
>
  <!-- W-wave background (exact brand logo: wave + audio bars). Depth raised to
       48px (default is 32px) and masked so it visibly recedes behind the text
       column instead of running flat underneath it -- the actual source of
       the figure/ground read, the parallax drift alone wasn't enough. -->
  <div
    class="wp-parallax-layer hero-wave-mask absolute inset-0 flex items-center justify-center pointer-events-none"
    aria-hidden="true"
    style="--wp-parallax-depth: 48px;"
  >
    <svg class="hero-wave hero-sign shrink-0 w-[160vw] h-auto opacity-[0.10] -translate-y-[8%]" viewBox="0 0 1024 1024" fill="none" preserveAspectRatio="xMidYMid meet">
      <defs>
        <linearGradient id="wave-grad" x1="0.14" y1="0.79" x2="0.88" y2="0.38">
          <stop offset="0%" stop-color="#155e75"/>
          <stop offset="35%" stop-color="#0891b2"/>
          <stop offset="70%" stop-color="#38D9F0"/>
          <stop offset="100%" stop-color="#67e8f9"/>
        </linearGradient>
      </defs>
      <!-- Audio bars (4 rounded bars, upper-left — theme-aware fill via CSS) -->
      <path class="hero-bar" d="M195.298,326.37c0,-13.777 -11.185,-24.963 -24.963,-24.963c-13.777,0 -24.963,11.186 -24.963,24.963l0,106.969c0,13.778 11.186,24.963 24.963,24.963c13.778,0 24.963,-11.185 24.963,-24.963l0,-106.969Z"/>
      <path class="hero-bar" d="M277.786,240.929c-0,-13.777 -11.186,-24.963 -24.964,-24.963c-13.777,-0 -24.963,11.186 -24.963,24.963l0,277.852c0,13.777 11.186,24.963 24.963,24.963c13.778,-0 24.964,-11.186 24.964,-24.963l-0,-277.852Z"/>
      <path class="hero-bar" d="M360.273,303.88c-0,-13.778 -11.186,-24.963 -24.963,-24.963c-13.778,-0 -24.964,11.185 -24.964,24.963l0,151.95c0,13.777 11.186,24.963 24.964,24.963c13.777,0 24.963,-11.186 24.963,-24.963l-0,-151.95Z"/>
      <path class="hero-bar" d="M442.76,364.358c-0,-13.778 -11.186,-24.963 -24.963,-24.963c-13.778,-0 -24.964,11.185 -24.964,24.963l0,30.994c0,13.777 11.186,24.963 24.964,24.963c13.777,-0 24.963,-11.186 24.963,-24.963l-0,-30.994Z"/>
      <!-- Wave ribbon with arrow tip -->
      <path class="hero-ribbon" d="M146.212,719.902c-4.132,0.29 6.44,-33.608 43.916,-64.584c20.132,-16.64 60.123,-9.232 68.877,-4.246c8.755,4.986 87.274,47.06 101.106,48.82c13.832,1.761 35.239,15.204 67.761,-20.191c26.084,-28.388 41.853,-164.146 47.759,-185.163c9.127,-32.481 24.944,-73.876 63.259,-88.423c21.063,-7.996 59.88,-1.585 85.684,17.554c25.804,19.139 98.554,82.556 152.256,85.654c33.909,1.957 53.679,-9.322 88.027,-50.342c31.87,-38.059 38.129,-82.06 39.455,-71.794c5.143,39.819 10.088,210.11 -156.164,365.44c-22.045,20.597 37.157,-107.81 29.301,-115.515c-4.005,-3.927 -69.86,25.691 -126.834,-28.472c-65.774,-62.531 -117.571,-86.552 -138.331,-1.705c-15.245,62.309 -30.941,146.424 -66.41,175.983c-33.242,27.703 -80.659,31.246 -112.757,16.712c-27.303,-12.363 -84.89,-45.739 -96.26,-53.668c-47.365,-33.027 -77.969,-26.951 -90.645,-26.06Z" fill="url(#wave-grad)"/>
    </svg>
  </div>

  <!-- Mid-depth console glow: a second parallax layer with negative depth so
       it drifts opposite to the wave above -- two layers moving apart, not
       one layer sliding under static text, is what makes the parallax read
       as depth instead of a single background nudge. 6% cyan is deliberately
       below "visible element" -- it should read as stage light, not a shape. -->
  <div
    class="wp-parallax-layer hero-console-glow absolute inset-0 pointer-events-none"
    aria-hidden="true"
    style="--wp-parallax-depth: -14px;"
  ></div>

  <div class="wp-recede relative z-10 text-center w-full px-8 sm:px-6 max-w-4xl mx-auto">
    <div class="mb-4 sm:mb-6 mt-4">
      <img
        id="heroLogo"
        src="/app-icon-dark.png"
        alt="WhisPaste"
        width="80"
        height="80"
        class="hero-logo-in w-14 h-14 sm:w-20 sm:h-20 mx-auto rounded-xl sm:rounded-2xl"
      />
    </div>

    <h1
      class="hero-title text-5xl sm:text-7xl lg:text-[8.5rem] tracking-tight text-ink leading-[0.98]"
    >
      <span
        class="wp-rise-in hero-title-line"
        data-i18n="hero.title1"
        style="--wp-rise-delay: 160ms"
        >{t(lang, "hero.title1")}</span
      ><br />
      <span
        class="wp-rise-in hero-title-line"
        style="--wp-rise-delay: 280ms"
        ><span
          class="hero-gradient"
          data-i18n="hero.title2"
          >{t(lang, "hero.title2")}</span
        ></span
      >
    </h1>
    <p
      class="hero-fade-rise mt-4 sm:mt-6 text-base sm:text-xl text-ink-muted max-w-2xl mx-auto leading-relaxed"
      data-i18n="hero.desc"
      style="--wp-rise-delay: 480ms"
    >
      {t(lang, "hero.desc")}
    </p>

    <!-- CTA buttons -->
<div
  class="hero-fade-rise mt-6 sm:mt-8 flex flex-col items-center gap-4"
  style="--wp-rise-delay: 560ms"
>
  <!-- Primary row: all three desktop platforms as equal-rank CTAs
       (Plattform-Parität, PRODUCT.md). The existing data-os/data-platform-btn
       mechanism (global.css) reduces this to the visitor's own platform once
       detected; unknown OS (bots, crawlers, privacy tools) sees all three
       equally weighted. -->
  <div class="flex flex-wrap items-stretch justify-center gap-3">
    <div data-platform-btn="windows"><StoreButton size="lg" /></div>
    <div data-platform-btn="macos"><MacStoreButton size="lg" /></div>
    <div data-platform-btn="linux"><LinuxButton size="lg" /></div>
  </div>

  <!-- Store-Hint gilt nur für die Store-Wege (Microsoft Store / Mac App
       Store) — auf Linux gibt es keinen Store-Download, den es zu bewerten
       gäbe. Gegatet über data-requires-os (global.css, gleiche data-os-
       Konvention wie die Plattform-Buttons): sichtbar NUR bei positiv
       erkanntem Windows/macOS, im ungegateten Fallback (alle drei CTAs
       sichtbar) bewusst versteckt. -->
  <div data-requires-os="windows macos">
    <p class="text-xs text-ink-subtle flex items-center gap-1" data-testid="hero-store-hint">
      <svg class="w-3 h-3 text-pink-400/60" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
      <span data-i18n="hero.store.hint">{t(lang, "hero.store.hint")}</span>
    </p>
  </div>

  <!-- Privacy hook (Nordstern differentiator): honest, non-absolute claim —
       mirrors the app's own "aboutPrivacyFirstDesc" wording (on-device by
       default, cloud only if the user opts in). No dark pattern. Now the
       single supporting statement under the CTAs (the former "Privacy-first"
       trust chip is folded into this line — one message, one place). -->
  <p class="mt-1 inline-flex items-start sm:items-center justify-center gap-2 text-sm sm:text-base text-ink-muted max-w-xl mx-auto">
    <svg class="w-4 h-4 mt-0.5 sm:mt-0 shrink-0 text-brand-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"></path><path d="m9 12 2 2 4-4"></path></svg>
    <span data-i18n="hero.privacy.line">{t(lang, "hero.privacy.line")}</span>
  </p>
</div>

    <!-- Plattform-Kommunikation (Issue 09): macOS · Windows · Ubuntu Linux —
         drei gleichrangige Desktops, kein Mobile. Now the ONLY pill row in the
         hero (the former trust-chip row was redundant with the hero.desc copy
         and is gone), so the badges own the pill shape. The OS detected by the
         existing data-os head-script (see Layout.astro) is highlighted via CSS
         attribute selectors only, so there is no reflow and it degrades
         gracefully (unknown OS → all three shown equally, see global.css
         `[data-os=...]` convention).

         Task #10: badges are links to the matching download-page anchor
         (`#macos`/`#windows`/`#linux`, added in download.astro), not just
         informational pills. `platform-badge` class + `data-platform-badge`
         are kept exactly as-is so the highlight CSS above keeps matching. -->
    <div class="platform-row hero-fade-rise mt-7 sm:mt-9 flex flex-col items-center gap-2.5" style="--wp-rise-delay: 640ms">
      <p class="text-[11px] sm:text-xs font-medium uppercase tracking-[0.14em] text-ink-subtle" data-i18n="hero.platforms.claim">
        {t(lang, "hero.platforms.claim")}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-2.5">
        <a
          href={`${localePath(lang, "download")}#macos`}
          data-testid="hero-platform-badge-macos"
          aria-label={`${t(lang, "hero.platforms.macos")}: ${t(lang, "nav.download")}`}
          class="platform-badge inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-brand-card/60 px-3 py-1.5 sm:px-3.5 sm:py-1.5 text-xs sm:text-sm text-ink-muted backdrop-blur-sm hover:border-brand-cyan/30 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-cyan"
          data-platform-badge="macos"
        >
          <span class="platform-badge__icon inline-flex w-3.5 h-3.5 sm:w-4 sm:h-4 shrink-0" aria-hidden="true" set:html={appleIconRaw} />
          <span data-i18n="hero.platforms.macos">{t(lang, "hero.platforms.macos")}</span>
          <span class="platform-badge__current">(<span data-i18n="hero.platforms.current">{t(lang, "hero.platforms.current")}</span>)</span>
        </a>
        <a
          href={`${localePath(lang, "download")}#windows`}
          data-testid="hero-platform-badge-windows"
          aria-label={`${t(lang, "hero.platforms.windows")}: ${t(lang, "nav.download")}`}
          class="platform-badge inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-brand-card/60 px-3 py-1.5 sm:px-3.5 sm:py-1.5 text-xs sm:text-sm text-ink-muted backdrop-blur-sm hover:border-brand-cyan/30 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-cyan"
          data-platform-badge="windows"
        >
          <span class="platform-badge__icon inline-flex w-3.5 h-3.5 sm:w-4 sm:h-4 shrink-0" aria-hidden="true" set:html={windowsIconRaw} />
          <span data-i18n="hero.platforms.windows">{t(lang, "hero.platforms.windows")}</span>
          <span class="platform-badge__current">(<span data-i18n="hero.platforms.current">{t(lang, "hero.platforms.current")}</span>)</span>
        </a>
        <a
          href={`${localePath(lang, "download")}#linux`}
          data-testid="hero-platform-badge-linux"
          aria-label={`${t(lang, "hero.platforms.linux")}: ${t(lang, "nav.download")}`}
          class="platform-badge inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-brand-card/60 px-3 py-1.5 sm:px-3.5 sm:py-1.5 text-xs sm:text-sm text-ink-muted backdrop-blur-sm hover:border-brand-cyan/30 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-cyan"
          data-platform-badge="linux"
        >
          <span class="platform-badge__icon inline-flex w-3.5 h-3.5 sm:w-4 sm:h-4 shrink-0" aria-hidden="true" set:html={ubuntuIconRaw} />
          <span data-i18n="hero.platforms.linux">{t(lang, "hero.platforms.linux")}</span>
          <span class="platform-badge__current">(<span data-i18n="hero.platforms.current">{t(lang, "hero.platforms.current")}</span>)</span>
        </a>
      </div>
    </div>

    <!-- GitHub stars — hidden until fetched (index.astro script fills
         #github-stars-count and clears display:none). Quiet text link instead
         of another pill so social proof doesn't compete with the platform
         badges; the amber star is a deliberate semantic signal (convention),
         not a brand accent. -->
    <a
      id="github-stars-badge"
      href="https://github.com/whispaste/whispaste"
      target="_blank"
      rel="noopener"
      class="hero-fade-rise mt-4 inline-flex items-center gap-1.5 text-xs sm:text-sm text-ink-muted hover:text-ink transition-colors"
      style="display:none; --wp-rise-delay: 720ms"
      aria-label="Star WhisPaste on GitHub"
    >
      <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-amber-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      <span id="github-stars-count"></span>
    </a>

    <!-- Carousel -->
    <HeroCarousel />
  </div>
</section>

<style>
  /* ---- Display headline: crank Bricolage to its characterful heavy weight ---- */
  .hero-title {
    font-family: var(--font-display);
    font-variation-settings: "wght" 800;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  /* ---- Platform-badge row (Issue 09): macOS / Windows / Ubuntu Linux ----
     The base pill look matches the trust chips below (same Tailwind utility
     classes) for visual consistency; only the highlight state below needs
     custom CSS, since it must react to the `data-os` attribute set on <html>
     by the inline head script (Layout.astro) before first paint. */
  .platform-badge__icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .platform-badge__current {
    display: none;
    color: var(--color-brand-cyan);
    font-weight: 600;
  }
  /* Detected OS gets a quiet accent — border/background/icon tint from the
     brand-cyan token, plus the "(your system)" qualifier. Everything else
     (including the unknown/bot fallback) keeps the neutral pill look, so all
     three platforms read as equally supported by default. */
  :global([data-os="macos"]) .platform-badge[data-platform-badge="macos"],
  :global([data-os="windows"]) .platform-badge[data-platform-badge="windows"],
  :global([data-os="linux"]) .platform-badge[data-platform-badge="linux"] {
    border-color: color-mix(in srgb, var(--color-brand-cyan) 45%, transparent);
    background: color-mix(in srgb, var(--color-brand-cyan) 14%, var(--color-brand-card) 86%);
    color: var(--color-ink);
  }
  :global([data-os="macos"]) .platform-badge[data-platform-badge="macos"] .platform-badge__icon,
  :global([data-os="windows"]) .platform-badge[data-platform-badge="windows"] .platform-badge__icon,
  :global([data-os="linux"]) .platform-badge[data-platform-badge="linux"] .platform-badge__icon {
    color: var(--color-brand-cyan);
  }
  :global([data-os="macos"]) .platform-badge[data-platform-badge="macos"] .platform-badge__current,
  :global([data-os="windows"]) .platform-badge[data-platform-badge="windows"] .platform-badge__current,
  :global([data-os="linux"]) .platform-badge[data-platform-badge="linux"] .platform-badge__current {
    display: inline;
  }

  /* Hero-specific animations */
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  /* Load partiture ("Der Hotkey-Moment"): logo -> eyebrow (bracket-lock,
     global.css) -> H1 lines (wp-rise-in, global.css) -> desc/CTA/badges/
     GitHub link (this fade-rise), each on its own --wp-rise-delay instead of
     the old two-tier animate-fade-in/-delay split. Everything lands by
     ~800ms; the H1 (likely LCP) gets <=200ms and no opacity:0 start. */
  .hero-fade-rise {
    animation: fade-in 0.6s var(--ease-flow) var(--wp-rise-delay, 0ms) both;
  }
  @keyframes hero-logo-in {
    from { opacity: 0; scale: 0.92; }
    to { opacity: 1; scale: 1; }
  }
  .hero-logo-in {
    animation: hero-logo-in 0.5s var(--ease-flow) var(--wp-rise-delay, 0ms) both;
  }
  /* inline-block so .wp-rise-in's translate/clip-path apply cleanly (both
     spans wrap normally inside it -- title1 wraps across two visual lines by
     width alone, no <br> inside the span, so the reveal still plays as one
     sweep per span, never per wrapped line). Title2's .hero-gradient (own
     `animation` shorthand, gradient-shift) sits on a NESTED inner span rather
     than this element -- two `animation` shorthands on the same element
     silently clobber each other (confirmed: without the split, only
     gradient-shift ran and wp-rise-in never played). data-i18n stays on that
     inner span too, since applyLang() replaces textContent on exactly the
     element it's attached to -- keeping it there is what makes the split safe
     for the language-switch fallback path. */
  .hero-title-line {
    display: inline-block;
  }
  .hero-gradient {
    /* Mirrors the app's WpColorsDark.accentWarmGradient (cyan → teal). */
    background: linear-gradient(135deg, #38D9F0 0%, #14B8D4 50%, #38D9F0 100%);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: gradient-shift 5s ease-in-out infinite;
  }
  @keyframes gradient-shift {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }
  /* Audio bars: white in dark mode (like original logo), dark navy in light mode */
  .hero-bar {
    fill: #ebebeb;
    fill-opacity: 0.35;
    /* Pivot each bar at its base so the signature scaleY grows upward. */
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  :global(.light) .hero-bar {
    fill: #052235;
    fill-opacity: 0.4;
  }

  /* Signature burst — gated behind `.hero-sign`, which is (re)applied by JS on
     load and on an interval. Bars grow from their base, staggered. */
  .hero-wave.hero-sign .hero-bar {
    animation: hero-bar-rise 0.85s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .hero-wave.hero-sign .hero-bar:nth-of-type(1) { animation-delay: 0.05s; }
  .hero-wave.hero-sign .hero-bar:nth-of-type(2) { animation-delay: 0.16s; }
  .hero-wave.hero-sign .hero-bar:nth-of-type(3) { animation-delay: 0.27s; }
  .hero-wave.hero-sign .hero-bar:nth-of-type(4) { animation-delay: 0.38s; }
  @keyframes hero-bar-rise {
    from { transform: scaleY(0); }
    to   { transform: scaleY(1); }
  }

  /* Signature burst — the wave ribbon wipes in left-to-right after the bars. */
  .hero-wave.hero-sign .hero-ribbon {
    animation: hero-ribbon-draw 1.15s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both;
  }
  @keyframes hero-ribbon-draw {
    from { clip-path: inset(0 100% 0 0); }
    to   { clip-path: inset(0 0 0 0); }
  }

  /* Baseline: the glyph breathes calmly. During a signature burst the
     `.hero-sign` class overrides this with a one-shot surface-and-settle surge,
     then JS removes the class so breathing resumes between bursts. */
  .hero-wave {
    animation: wave-breathe 8s ease-in-out infinite;
  }
  .hero-wave.hero-sign {
    animation: hero-wave-intro 1.9s ease-out;
  }
  @keyframes hero-wave-intro {
    0%   { opacity: 0; }
    55%  { opacity: 0.28; }
    100% { opacity: 0.10; }
  }
  @keyframes wave-breathe {
    0%, 100% { opacity: 0.10; }
    50% { opacity: 0.14; }
  }
  /* Depth separation for the watermark layer (M10 §3): the wave fades out
     behind the text column instead of running flat underneath it -- this is
     what actually produces the figure/ground read, the parallax drift alone
     only moved one flat layer. Both prefixed and unprefixed since Safari
     still wants -webkit-mask-image; harmless no-op elsewhere. */
  .hero-wave-mask {
    mask-image: radial-gradient(ellipse 75% 55% at 50% 42%, transparent 22%, black 68%);
    -webkit-mask-image: radial-gradient(ellipse 75% 55% at 50% 42%, transparent 22%, black 68%);
  }
  /* Mid-depth glow, see markup comment above -- deliberately below the
     "visible element" threshold (6% cyan): stage light, not a shape. */
  .hero-console-glow {
    background: radial-gradient(closest-side, color-mix(in srgb, var(--color-brand-cyan) 6%, transparent) 0%, transparent 70%);
    background-repeat: no-repeat;
    background-position: center 38%;
    background-size: min(60vw, 900px) min(60vw, 900px);
  }
  :global(.light) .hero-wave {
    animation: wave-breathe-light 8s ease-in-out infinite;
  }
  :global(.light) .hero-wave.hero-sign {
    animation: hero-wave-intro-light 1.9s ease-out;
  }
  /* Light-Watermark leicht angehoben (0.09/0.13 statt 0.07/0.10): auf den
     kühleren Light-Flächen war die W-Wave kaum noch präsent. */
  @keyframes hero-wave-intro-light {
    0%   { opacity: 0; }
    55%  { opacity: 0.2; }
    100% { opacity: 0.09; }
  }
  @keyframes wave-breathe-light {
    0%, 100% { opacity: 0.09; }
    50% { opacity: 0.13; }
  }

  /* CTA-Affirm: a one-shot soft glow on the platform button matching the
     visitor's detected OS (`data-os` on <html>, set before first paint --
     see Layout.astro), ~1.1s after load. Confirms "your system is
     recognized" without changing the button's shape (Fidelity-Zone: no
     bracket/HUD chrome on functional surfaces). No pulse on unknown OS
     (bots, privacy tools) -- there's nothing true to confirm, so nothing
     fires. `.wp-store-btn`/`.wp-mac-store-btn`/`.wp-linux-btn` are rendered
     by child components (StoreButton/MacStoreButton/LinuxButton), so the
     whole selector needs :global() -- Astro's scoping would otherwise add a
     data-astro-cid attribute these child-rendered elements never carry, and
     the rule would silently never match. */
  @keyframes wp-cta-affirm {
    50% {
      box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-brand-cyan) 22%, transparent);
    }
  }
  :global([data-os="macos"] .wp-mac-store-btn),
  :global([data-os="windows"] .wp-store-btn),
  :global([data-os="linux"] .wp-linux-btn) {
    animation: wp-cta-affirm 900ms var(--ease-flow) 1100ms 1;
  }

  /* Reduced motion for hero animations (incl. the gated signature burst) */
  @media (prefers-reduced-motion: reduce) {
    .hero-gradient,
    .hero-wave,
    .hero-bar,
    .hero-ribbon,
    .hero-fade-rise,
    .hero-logo-in {
      animation: none !important;
    }
    :global([data-os="macos"] .wp-mac-store-btn),
    :global([data-os="windows"] .wp-store-btn),
    :global([data-os="linux"] .wp-linux-btn) {
      animation: none !important;
    }
    /* show the assembled glyph immediately */
    .hero-bar { transform: none !important; }
    .hero-ribbon { clip-path: none !important; }
  }
</style>

<script>
  // Replay the hero signature burst on an interval. The first burst is
  // server-rendered (`.hero-sign` is in the markup); JS settles it back to the
  // calm breathing watermark, then re-triggers every few seconds via a reflow
  // restart. Skipped entirely under reduced-motion; paused while the tab is
  // hidden so it never animates off-screen.
  const wave = document.querySelector<HTMLElement>('.hero-wave');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (wave && !reduce) {
    const BURST_MS = 1900; // matches the longest signature animation
    const PERIOD_MS = 6000; // burst-to-burst cadence
    let settleTimer: ReturnType<typeof setTimeout>;

    const settle = () => {
      settleTimer = setTimeout(() => wave.classList.remove('hero-sign'), BURST_MS);
    };
    const burst = () => {
      if (document.hidden) return;
      clearTimeout(settleTimer);
      wave.classList.remove('hero-sign');
      void wave.offsetWidth; // force reflow so the keyframes restart
      wave.classList.add('hero-sign');
      settle();
    };

    settle(); // settle the initial (markup-rendered) burst
    setInterval(burst, PERIOD_MS);
  }
</script>
