---
import HeroCarousel from './HeroCarousel.astro';
---
<!-- Hero Section -->
<section
  class="relative min-h-[100svh] flex items-center justify-center overflow-hidden pt-14"
>
  <!-- W-wave background (exact brand logo: wave + audio bars) -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none" aria-hidden="true">
    <svg class="hero-wave shrink-0 w-[160vw] h-auto opacity-[0.10] -translate-y-[8%]" viewBox="0 0 1024 1024" fill="none" preserveAspectRatio="xMidYMid meet">
      <defs>
        <linearGradient id="wave-grad" x1="0.14" y1="0.79" x2="0.88" y2="0.38">
          <stop offset="0%" stop-color="#155e75"/>
          <stop offset="35%" stop-color="#0891b2"/>
          <stop offset="70%" stop-color="#22d3ee"/>
          <stop offset="100%" stop-color="#67e8f9"/>
        </linearGradient>
      </defs>
      <!-- Audio bars (4 rounded bars, upper-left — theme-aware fill via CSS) -->
      <path class="hero-bar" d="M195.298,326.37c0,-13.777 -11.185,-24.963 -24.963,-24.963c-13.777,0 -24.963,11.186 -24.963,24.963l0,106.969c0,13.778 11.186,24.963 24.963,24.963c13.778,0 24.963,-11.185 24.963,-24.963l0,-106.969Z"/>
      <path class="hero-bar" d="M277.786,240.929c-0,-13.777 -11.186,-24.963 -24.964,-24.963c-13.777,-0 -24.963,11.186 -24.963,24.963l0,277.852c0,13.777 11.186,24.963 24.963,24.963c13.778,-0 24.964,-11.186 24.964,-24.963l-0,-277.852Z"/>
      <path class="hero-bar" d="M360.273,303.88c-0,-13.778 -11.186,-24.963 -24.963,-24.963c-13.778,-0 -24.964,11.185 -24.964,24.963l0,151.95c0,13.777 11.186,24.963 24.964,24.963c13.777,0 24.963,-11.186 24.963,-24.963l-0,-151.95Z"/>
      <path class="hero-bar" d="M442.76,364.358c-0,-13.778 -11.186,-24.963 -24.963,-24.963c-13.778,-0 -24.964,11.185 -24.964,24.963l0,30.994c0,13.777 11.186,24.963 24.964,24.963c13.777,-0 24.963,-11.186 24.963,-24.963l-0,-30.994Z"/>
      <!-- Wave ribbon with arrow tip -->
      <path d="M146.212,719.902c-4.132,0.29 6.44,-33.608 43.916,-64.584c20.132,-16.64 60.123,-9.232 68.877,-4.246c8.755,4.986 87.274,47.06 101.106,48.82c13.832,1.761 35.239,15.204 67.761,-20.191c26.084,-28.388 41.853,-164.146 47.759,-185.163c9.127,-32.481 24.944,-73.876 63.259,-88.423c21.063,-7.996 59.88,-1.585 85.684,17.554c25.804,19.139 98.554,82.556 152.256,85.654c33.909,1.957 53.679,-9.322 88.027,-50.342c31.87,-38.059 38.129,-82.06 39.455,-71.794c5.143,39.819 10.088,210.11 -156.164,365.44c-22.045,20.597 37.157,-107.81 29.301,-115.515c-4.005,-3.927 -69.86,25.691 -126.834,-28.472c-65.774,-62.531 -117.571,-86.552 -138.331,-1.705c-15.245,62.309 -30.941,146.424 -66.41,175.983c-33.242,27.703 -80.659,31.246 -112.757,16.712c-27.303,-12.363 -84.89,-45.739 -96.26,-53.668c-47.365,-33.027 -77.969,-26.951 -90.645,-26.06Z" fill="url(#wave-grad)"/>
    </svg>
  </div>

  <!-- Radial glow -->
  <div
    class="hero-glow absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-brand-cyan/[0.06] rounded-full blur-[120px]"
  ></div>

  <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
    <div class="animate-fade-in">
      <div class="mb-6 mt-4">
        <img
          id="heroLogo"
          src="/app-icon-dark.png"
          alt="WhisPaste"
          class="w-20 h-20 mx-auto rounded-2xl"
        />
      </div>
      <h1
        class="text-5xl sm:text-7xl lg:text-8xl font-bold tracking-tight text-white leading-[1.05]"
      >
        <span data-i18n="hero.title1">Press. Speak.</span><br />
        <span class="hero-gradient" data-i18n="hero.title2"
          >Done.</span
        >
      </h1>
      <p
        class="mt-6 text-lg sm:text-xl text-gray-400 max-w-2xl mx-auto leading-relaxed"
        data-i18n="hero.desc"
      >
        WhisPaste turns your voice into text — right where your cursor is. In any Windows app, offline or online, without a subscription.
      </p>
    </div>

    <!-- CTA buttons -->
    <div
      class="mt-8 flex flex-col sm:flex-row gap-4 justify-center animate-fade-in-delay"
    >
      <a
        href="https://github.com/whispaste/whispaste/releases/latest/download/WhisPaste-Setup.exe"
        data-testid="hero-cta-store"
        class="group relative inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-brand-cyan text-brand-darker font-semibold rounded-xl transition-all hover:scale-[1.02] active:scale-[0.98] shadow-[0_0_30px_rgba(34,211,238,0.3)] hover:shadow-[0_0_40px_rgba(34,211,238,0.5)]"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
        <span data-i18n="hero.download">Download for Windows</span>
      </a>
      <a
        href="https://github.com/whispaste/whispaste/releases/latest"
        target="_blank"
        rel="noopener"
        data-testid="hero-cta-github"
        class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-white/[0.04] text-white font-semibold rounded-xl border border-white/10 hover:bg-white/[0.08] hover:border-white/20 transition-all hover:scale-[1.02] active:scale-[0.98] backdrop-blur-sm"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path
            d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
          ></path></svg
        >
        <span data-i18n="hero.installer">Installer & more options</span>
      </a>
    </div>
    <p
      class="mt-4 text-sm text-gray-500 animate-fade-in-delay"
      data-i18n="hero.meta"
    >
      Windows 10/11 · Just download and run · Free & open source
    </p>

    <div
      class="mt-6 flex flex-wrap items-center justify-center gap-3 animate-fade-in-delay"
    >
      <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-sm text-gray-200 backdrop-blur-sm">
        <svg class="w-4 h-4 text-brand-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
        <span data-i18n="hero.trust.anywhere">Open source</span>
      </div>
      <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-sm text-gray-200 backdrop-blur-sm">
        <svg class="w-4 h-4 text-brand-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"></path><path d="m9 12 2 2 4-4"></path></svg>
        <span data-i18n="hero.trust.private">Privacy-first</span>
      </div>
      <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-sm text-gray-200 backdrop-blur-sm">
        <svg class="w-4 h-4 text-brand-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 1v22"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
        <span data-i18n="hero.trust.nosub">No subscription</span>
      </div>
    </div>

    <!-- Carousel -->
    <HeroCarousel />
  </div>
</section>

<style>
  /* Hero-specific animations */
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes glow-pulse {
    0%,
    100% {
      opacity: 0.6;
    }
    50% {
      opacity: 1;
    }
  }
  .animate-fade-in {
    animation: fade-in 0.8s ease-out both;
  }
  .animate-fade-in-delay {
    animation: fade-in 0.8s ease-out 0.3s both;
  }
  .hero-glow {
    animation: glow-pulse 6s ease-in-out infinite;
  }
  .hero-gradient {
    background: linear-gradient(135deg, #22d3ee 0%, #0e7490 50%, #22d3ee 100%);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: gradient-shift 5s ease-in-out infinite;
  }
  @keyframes gradient-shift {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }
  /* Audio bars: white in dark mode (like original logo), dark navy in light mode */
  .hero-bar {
    fill: #ebebeb;
    fill-opacity: 0.35;
  }
  :global(.light) .hero-bar {
    fill: #052235;
    fill-opacity: 0.4;
  }
  .hero-wave {
    animation: wave-breathe 8s ease-in-out infinite;
  }
  @keyframes wave-breathe {
    0%, 100% { opacity: 0.10; }
    50% { opacity: 0.14; }
  }
  :global(.light) .hero-wave {
    animation: wave-breathe-light 8s ease-in-out infinite;
  }
  @keyframes wave-breathe-light {
    0%, 100% { opacity: 0.07; }
    50% { opacity: 0.10; }
  }

  /* Reduced motion for hero animations */
  @media (prefers-reduced-motion: reduce) {
    .hero-glow,
    .hero-gradient,
    .hero-wave,
    .animate-fade-in,
    .animate-fade-in-delay {
      animation: none !important;
    }
  }
</style>
