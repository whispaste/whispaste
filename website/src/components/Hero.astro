---
import HeroCarousel from './HeroCarousel.astro';
---
<!-- Hero Section -->
<section
  class="relative min-h-[100svh] flex items-center justify-center overflow-hidden pt-14"
>
  <!-- Animated gradient background -->
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_center,_rgba(34,211,238,0.12)_0%,_transparent_50%)]"
  >
  </div>
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,_rgba(14,116,144,0.08)_0%,_transparent_50%)]"
  >
  </div>
  <div
    class="hero-glow absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[500px] bg-brand-cyan/[0.07] rounded-full blur-[120px]"
  >
  </div>

  <!-- Floating grid lines for depth -->
  <div
    class="absolute inset-0 opacity-[0.03]"
    style="background-image: linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px); background-size: 60px 60px;"
  >
  </div>

  <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
    <div class="animate-fade-in">
      <div class="mb-8 mt-4">
        <img
          id="heroLogo"
          src="/app-icon-dark.png"
          alt="WhisPaste"
          class="w-24 h-24 mx-auto rounded-2xl"
        />
      </div>
      <h1
        class="text-5xl sm:text-7xl lg:text-8xl font-bold tracking-tight text-white leading-[1.05]"
      >
        <span data-i18n="hero.title1">Voice to text,</span><br />
        <span class="hero-gradient" data-i18n="hero.title2"
          >pasted anywhere.</span
        >
      </h1>
      <p
        class="mt-6 text-lg sm:text-xl text-gray-400 max-w-xl mx-auto leading-relaxed"
        data-i18n="hero.desc"
      >
        A lightweight desktop tool that transcribes your speech — locally or via
        OpenAI Whisper — and pastes the result into any focused input field.
      </p>
    </div>

    <!-- Beta badge -->
    <div class="mt-6 animate-fade-in-delay">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold rounded-full bg-brand-cyan/10 text-brand-cyan border border-brand-cyan/20 uppercase tracking-wider">
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
        <span data-i18n="hero.beta">Beta</span>
      </span>
    </div>
    <!-- CTA buttons -->
    <div
      class="mt-4 flex flex-col sm:flex-row gap-4 justify-center animate-fade-in-delay"
    >
      <a
        href="https://github.com/whispaste/whispaste/releases/latest"
        data-testid="hero-cta-store"
        class="group relative inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-brand-cyan text-brand-darker font-semibold rounded-xl transition-all hover:scale-[1.02] active:scale-[0.98] shadow-[0_0_30px_rgba(34,211,238,0.3)] hover:shadow-[0_0_40px_rgba(34,211,238,0.5)]"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
        <span data-i18n="hero.download">Download for Windows</span>
      </a>
      <a
        href="https://github.com/whispaste/whispaste"
        target="_blank"
        rel="noopener"
        data-testid="hero-cta-github"
        class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-white/[0.04] text-white font-semibold rounded-xl border border-white/10 hover:bg-white/[0.08] hover:border-white/20 transition-all hover:scale-[1.02] active:scale-[0.98] backdrop-blur-sm"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path
            d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
          ></path></svg
        >
        <span data-i18n="hero.github">View on GitHub</span>
      </a>
    </div>
    <div class="mt-3 animate-fade-in-delay">
      <a
        href="https://github.com/whispaste/whispaste/releases/latest"
        data-testid="hero-cta-portable"
        class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-400 transition-colors"
      >
        <svg
          class="w-3.5 h-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline
            points="7 10 12 15 17 10"></polyline><line
            x1="12"
            x2="12"
            y1="15"
            y2="3"></line></svg
        >
        <span data-i18n="hero.portable">Or download portable .exe</span>
      </a>
    </div>
    <p
      class="mt-4 text-sm text-gray-500 animate-fade-in-delay"
      data-i18n="hero.meta"
    >
      Installer or portable .exe · Free & open source · ~8 MB
    </p>

    <!-- Carousel -->
    <HeroCarousel />
  </div>
</section>

<style>
  /* Hero-specific animations */
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes glow-pulse {
    0%,
    100% {
      opacity: 0.6;
    }
    50% {
      opacity: 1;
    }
  }
  .animate-fade-in {
    animation: fade-in 0.8s ease-out both;
  }
  .animate-fade-in-delay {
    animation: fade-in 0.8s ease-out 0.3s both;
  }
  .hero-glow {
    animation: glow-pulse 6s ease-in-out infinite;
  }
  .hero-gradient {
    background: linear-gradient(135deg, #22d3ee 0%, #0e7490 50%, #22d3ee 100%);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: gradient-shift 5s ease-in-out infinite;
  }
  @keyframes gradient-shift {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  /* Reduced motion for hero animations */
  @media (prefers-reduced-motion: reduce) {
    .hero-glow,
    .hero-gradient,
    .animate-fade-in,
    .animate-fade-in-delay {
      animation: none !important;
    }
  }
</style>