---
import HeroCarousel from './HeroCarousel.astro';
import StoreButton from './StoreButton.astro';
---

<!-- Hero Section -->
<section
  class="relative sm:min-h-[100svh] flex items-center justify-center overflow-hidden pt-14"
>
  <!-- W-wave background (exact brand logo: wave + audio bars) -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none" aria-hidden="true">
    <svg class="hero-wave shrink-0 w-[160vw] h-auto opacity-[0.10] -translate-y-[8%]" viewBox="0 0 1024 1024" fill="none" preserveAspectRatio="xMidYMid meet">
      <defs>
        <linearGradient id="wave-grad" x1="0.14" y1="0.79" x2="0.88" y2="0.38">
          <stop offset="0%" stop-color="#155e75"/>
          <stop offset="35%" stop-color="#0891b2"/>
          <stop offset="70%" stop-color="#38D9F0"/>
          <stop offset="100%" stop-color="#67e8f9"/>
        </linearGradient>
      </defs>
      <!-- Audio bars (4 rounded bars, upper-left — theme-aware fill via CSS) -->
      <path class="hero-bar" d="M195.298,326.37c0,-13.777 -11.185,-24.963 -24.963,-24.963c-13.777,0 -24.963,11.186 -24.963,24.963l0,106.969c0,13.778 11.186,24.963 24.963,24.963c13.778,0 24.963,-11.185 24.963,-24.963l0,-106.969Z"/>
      <path class="hero-bar" d="M277.786,240.929c-0,-13.777 -11.186,-24.963 -24.964,-24.963c-13.777,-0 -24.963,11.186 -24.963,24.963l0,277.852c0,13.777 11.186,24.963 24.963,24.963c13.778,-0 24.964,-11.186 24.964,-24.963l-0,-277.852Z"/>
      <path class="hero-bar" d="M360.273,303.88c-0,-13.778 -11.186,-24.963 -24.963,-24.963c-13.778,-0 -24.964,11.185 -24.964,24.963l0,151.95c0,13.777 11.186,24.963 24.964,24.963c13.777,0 24.963,-11.186 24.963,-24.963l-0,-151.95Z"/>
      <path class="hero-bar" d="M442.76,364.358c-0,-13.778 -11.186,-24.963 -24.963,-24.963c-13.778,-0 -24.964,11.185 -24.964,24.963l0,30.994c0,13.777 11.186,24.963 24.964,24.963c13.777,-0 24.963,-11.186 24.963,-24.963l-0,-30.994Z"/>
      <!-- Wave ribbon with arrow tip -->
      <path d="M146.212,719.902c-4.132,0.29 6.44,-33.608 43.916,-64.584c20.132,-16.64 60.123,-9.232 68.877,-4.246c8.755,4.986 87.274,47.06 101.106,48.82c13.832,1.761 35.239,15.204 67.761,-20.191c26.084,-28.388 41.853,-164.146 47.759,-185.163c9.127,-32.481 24.944,-73.876 63.259,-88.423c21.063,-7.996 59.88,-1.585 85.684,17.554c25.804,19.139 98.554,82.556 152.256,85.654c33.909,1.957 53.679,-9.322 88.027,-50.342c31.87,-38.059 38.129,-82.06 39.455,-71.794c5.143,39.819 10.088,210.11 -156.164,365.44c-22.045,20.597 37.157,-107.81 29.301,-115.515c-4.005,-3.927 -69.86,25.691 -126.834,-28.472c-65.774,-62.531 -117.571,-86.552 -138.331,-1.705c-15.245,62.309 -30.941,146.424 -66.41,175.983c-33.242,27.703 -80.659,31.246 -112.757,16.712c-27.303,-12.363 -84.89,-45.739 -96.26,-53.668c-47.365,-33.027 -77.969,-26.951 -90.645,-26.06Z" fill="url(#wave-grad)"/>
    </svg>
  </div>

  <div class="relative z-10 text-center w-full px-8 sm:px-6 max-w-4xl mx-auto">
    <div class="animate-fade-in">
      <div class="mb-4 sm:mb-6 mt-4">
        <img
          id="heroLogo"
          src="/app-icon-dark.png"
          alt="WhisPaste"
          width="80"
          height="80"
          class="w-14 h-14 sm:w-20 sm:h-20 mx-auto rounded-xl sm:rounded-2xl"
        />
      </div>
      <h1
        class="text-4xl sm:text-7xl lg:text-8xl font-bold tracking-tight text-white leading-[1.05]"
      >
        <span data-i18n="hero.title1">Press. Speak.</span><br />
        <span class="hero-gradient" data-i18n="hero.title2"
          >Done.</span
        >
      </h1>
      <p
        class="mt-4 sm:mt-6 text-base sm:text-xl text-gray-400 max-w-2xl mx-auto leading-relaxed"
        data-i18n="hero.desc"
      >
        WhisPaste turns your voice into text right where your cursor is — fully offline or with the cloud provider you choose. Free and open source.
      </p>
    </div>

    <!-- CTA buttons -->
    <div
      class="mt-6 sm:mt-8 flex flex-col items-center gap-4 animate-fade-in-delay"
    >
      <!-- Primary: Microsoft Store -->
      <div class="flex flex-col items-center gap-2" data-testid="hero-cta-store">
        <StoreButton size="lg" />
        <p class="text-xs text-gray-500 flex items-center gap-1">
          <svg class="w-3 h-3 text-pink-400/60" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
          <span data-i18n="hero.store.hint">Supports the project – thank you!</span>
        </p>
      </div>

      <!-- Secondary: free GitHub download -->
      <a
        href="https://github.com/whispaste/whispaste/releases/latest"
        target="_blank"
        rel="noopener"
        data-testid="hero-cta-github"
        class="text-sm text-gray-500 hover:text-gray-300 transition-colors underline underline-offset-2 decoration-gray-600 hover:decoration-gray-400"
      >
        <span data-i18n="hero.free.link">or download free from GitHub</span>
      </a>
    </div>
    <p
      class="mt-3 sm:mt-4 text-xs sm:text-sm text-gray-500 animate-fade-in-delay"
      data-i18n="hero.meta"
    >
      Windows · macOS & Linux coming soon · Free & open source
    </p>

    <div
      class="mt-4 sm:mt-6 flex flex-wrap items-center justify-center gap-2 sm:gap-3 animate-fade-in-delay"
    >
      <div class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-brand-card/60 px-3 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm text-gray-200 backdrop-blur-sm">
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-brand-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
        <span data-i18n="hero.trust.anywhere">Open source</span>
      </div>
      <div class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-brand-card/60 px-3 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm text-gray-200 backdrop-blur-sm">
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-brand-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"></path><path d="m9 12 2 2 4-4"></path></svg>
        <span data-i18n="hero.trust.private">Privacy-first</span>
      </div>
      <div class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-brand-card/60 px-3 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm text-gray-200 backdrop-blur-sm">
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-brand-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 1v22"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
        <span data-i18n="hero.trust.nosub">Free to use</span>
      </div>
      <!-- GitHub stars — hidden until fetched -->
      <a
        id="github-stars-badge"
        href="https://github.com/whispaste/whispaste"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-brand-card/60 px-3 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm text-gray-200 backdrop-blur-sm hover:border-white/20 transition-colors"
        style="display:none"
        aria-label="Star WhisPaste on GitHub"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-amber-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <span id="github-stars-count"></span>
      </a>
    </div>

    <!-- Carousel -->
    <HeroCarousel />
  </div>
</section>

<style>
  /* Hero-specific animations */
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in {
    animation: fade-in 0.8s ease-out both;
  }
  .animate-fade-in-delay {
    animation: fade-in 0.8s ease-out 0.3s both;
  }
  .hero-gradient {
    background: linear-gradient(135deg, #38D9F0 0%, #0e7490 50%, #38D9F0 100%);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: gradient-shift 5s ease-in-out infinite;
  }
  @keyframes gradient-shift {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }
  /* Audio bars: white in dark mode (like original logo), dark navy in light mode */
  .hero-bar {
    fill: #ebebeb;
    fill-opacity: 0.35;
  }
  :global(.light) .hero-bar {
    fill: #052235;
    fill-opacity: 0.4;
  }
  .hero-wave {
    animation: wave-breathe 8s ease-in-out infinite;
  }
  @keyframes wave-breathe {
    0%, 100% { opacity: 0.10; }
    50% { opacity: 0.14; }
  }
  :global(.light) .hero-wave {
    animation: wave-breathe-light 8s ease-in-out infinite;
  }
  @keyframes wave-breathe-light {
    0%, 100% { opacity: 0.07; }
    50% { opacity: 0.10; }
  }

  /* Reduced motion for hero animations */
  @media (prefers-reduced-motion: reduce) {
    .hero-gradient,
    .hero-wave,
    .animate-fade-in,
    .animate-fade-in-delay {
      animation: none !important;
    }
  }
</style>
