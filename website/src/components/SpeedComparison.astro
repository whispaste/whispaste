---
/**
 * `SpeedComparison.astro` — der „warum sprechen statt tippen?"-Beweis als
 * konkrete Zahl: Tippen (~40 WPM) gegen Sprechen (~150 WPM), als zwei
 * proportionale Balken. Reine eigene Gestaltung (keine fremden Marken/Assets),
 * Balken-Fill animiert beim Scroll-Reveal (reduced-motion-sicher).
 *
 * Zahlen sind ehrliche, breit belegte Durchschnittswerte (Tippen ~40 WpM,
 * flüssiges Sprechen ~150 WpM) und als „~" + Caption als Durchschnitt markiert.
 */
import SectionEyebrow from './SectionEyebrow.astro';
import { t } from '../scripts/i18n.ts';

const lang = (Astro.currentLocale === 'en' ? 'en' : 'de') as 'de' | 'en';

// Balken-Muster der Wellenform-Textur — einmal definiert, zweimal gerendert
// (nahtlose Marquee-Schleife braucht zwei identische Kacheln nebeneinander).
const waveBars = `
  <rect x="2"   y="9"  width="3" height="6"  rx="1.5"/>
  <rect x="9"   y="6"  width="3" height="12" rx="1.5"/>
  <rect x="16"  y="2"  width="3" height="20" rx="1.5"/>
  <rect x="23"  y="7"  width="3" height="10" rx="1.5"/>
  <rect x="30"  y="4"  width="3" height="16" rx="1.5"/>
  <rect x="37"  y="9"  width="3" height="6"  rx="1.5"/>
  <rect x="44"  y="5"  width="3" height="14" rx="1.5"/>
  <rect x="51"  y="2"  width="3" height="20" rx="1.5"/>
  <rect x="58"  y="8"  width="3" height="8"  rx="1.5"/>
  <rect x="65"  y="4"  width="3" height="16" rx="1.5"/>
  <rect x="72"  y="7"  width="3" height="10" rx="1.5"/>
  <rect x="79"  y="3"  width="3" height="18" rx="1.5"/>
  <rect x="86"  y="9"  width="3" height="6"  rx="1.5"/>
  <rect x="93"  y="5"  width="3" height="14" rx="1.5"/>
  <rect x="100" y="2"  width="3" height="20" rx="1.5"/>
  <rect x="107" y="7"  width="3" height="10" rx="1.5"/>
  <rect x="114" y="6"  width="3" height="12" rx="1.5"/>
`;
---

<section id="speed" class="band band-raised py-24 sm:py-32 relative scroll-mt-20 scroll-reveal">
  <div class="relative max-w-3xl mx-auto px-6">
    <div class="text-center mb-12">
      <SectionEyebrow key="speed.label" />
      <h2 class="section-title">
        <span data-i18n="speed.titleLead">{t(lang, 'speed.titleLead')}</span><!--
        --><span class="text-gradient-brand" data-i18n="speed.titleAccent">{t(lang, 'speed.titleAccent')}</span><!--
        --><span data-i18n="speed.titleTail">{t(lang, 'speed.titleTail')}</span>
      </h2>
      <p class="speed-sub" data-i18n="speed.sub">{t(lang, 'speed.sub')}</p>
    </div>

    <div class="speed-bars">
      <div class="speed-row">
        <div class="speed-row__head">
          <span class="speed-row__label" data-i18n="speed.typingLabel">{t(lang, 'speed.typingLabel')}</span>
          <span class="speed-row__value wp-nums">~40 <span class="speed-row__unit">WPM</span></span>
        </div>
        <div class="speed-track">
          <div class="speed-fill speed-fill--typing" style="--target: 27%"></div>
        </div>
      </div>

      <div class="speed-row">
        <div class="speed-row__head">
          <span class="speed-row__label speed-row__label--brand"
                data-i18n="speed.speakingLabel">{t(lang, 'speed.speakingLabel')}</span>
          <span class="speed-row__value speed-row__value--brand wp-nums">~150 <span class="speed-row__unit">WPM</span></span>
        </div>
        <div class="speed-track">
          <div class="speed-fill speed-fill--speaking" style="--target: 100%">
            <!-- Zwei identische Kacheln in einer 200%-Spur: die Wellenform
                 driftet als kontinuierlicher Strom nach links — Sprache fließt,
                 Tippen steht (der Balken darüber bleibt bewusst statisch). -->
            <div class="speed-wave-track" aria-hidden="true">
              <svg class="speed-wave" viewBox="0 0 120 24" preserveAspectRatio="none">
                <g fill="currentColor" set:html={waveBars} />
              </svg>
              <svg class="speed-wave" viewBox="0 0 120 24" preserveAspectRatio="none">
                <g fill="currentColor" set:html={waveBars} />
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>

    <p class="speed-caption" data-i18n="speed.caption">{t(lang, 'speed.caption')}</p>
  </div>
</section>

<style>
  .speed-sub {
    margin: 1.25rem auto 0;
    max-width: 46ch;
    color: var(--color-ink-muted);
    font-size: clamp(1rem, 1.6vw, 1.1875rem);
    line-height: 1.65;
  }

  .speed-bars {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .speed-row__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.625rem;
    gap: 1rem;
  }
  .speed-row__label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink-muted);
  }
  .speed-row__label--brand {
    color: var(--color-ink);
  }
  .speed-row__value {
    font-family: var(--font-display, inherit);
    font-weight: 800;
    font-size: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    line-height: 1;
    color: var(--color-ink-muted);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .speed-row__value--brand {
    color: var(--color-brand-cyan);
  }
  .speed-row__unit {
    /* Body grotesk (token), deliberately NOT the display font of the number —
       the unit steps back while the figure carries the display voice. */
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    opacity: 0.7;
  }

  .speed-track {
    position: relative;
    height: 1.5rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-ink-subtle) 18%, transparent);
    overflow: hidden;
  }
  .speed-fill {
    position: relative;
    height: 100%;
    width: var(--target);
    border-radius: var(--radius-pill);
    overflow: hidden;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 1s var(--ease-flow);
  }
  .speed-fill--typing {
    background: color-mix(in srgb, var(--color-ink-subtle) 55%, transparent);
    transition-delay: 0.05s;
  }
  .speed-fill--speaking {
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--color-brand-cyan) 75%, #0b7fa0) 0%,
      var(--color-brand-cyan) 100%
    );
    box-shadow: 0 0 24px color-mix(in srgb, var(--color-brand-cyan) 35%, transparent);
    transition-delay: 0.18s;
  }

  /* Waveform texture inside the speaking bar — our own brand motif, faint.
     Die 200%-Spur mit zwei Kacheln loopt nahtlos nach links: der Strom läuft
     nur, solange die Sektion sichtbar wurde (play-state-Gate unten). */
  .speed-wave-track {
    position: absolute;
    inset: 0;
    display: flex;
    width: 200%;
    animation: speed-wave-flow 7s linear infinite paused;
  }
  .speed-wave {
    width: 50%;
    height: 100%;
    flex: none;
    color: #fff;
    opacity: 0.28;
    mix-blend-mode: soft-light;
  }
  @keyframes speed-wave-flow {
    to { transform: translateX(-50%); }
  }

  /* Animate the fills in once the section reveals. */
  #speed.scroll-reveal.visible .speed-fill {
    transform: scaleX(1);
  }
  #speed.scroll-reveal.visible .speed-wave-track {
    animation-play-state: running;
  }

  .speed-caption {
    margin: 1.5rem 0 0;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--color-ink-subtle);
  }

  /* ===========================================================================
     Set-Piece: Scroll-Scrubbing "Das Rennen" (M10) — der User scrollt die
     Balken nicht vorbei, er scrollt sie auf. Beide starten gleichzeitig, der
     Tipp-Balken plateaut früh und steht, der Sprech-Balken zieht weiter — die
     Asymmetrie der Ranges IST die Botschaft (~40 vs. ~150 WPM), nicht nur die
     Endbreite. Timeline auf .speed-bars (nicht anonym auf .speed-fill): die
     Fills sitzen in .speed-track mit overflow:hidden, das würde eine anonyme
     view() als Scroll-Container einfangen und für immer bei Progress 0
     hängen — derselbe Fehlermodus wie bei .wp-recede (global.css). .band/
     .band-raised sind overflow-frei, .speed-bars bindet damit sauber an den
     echten Seiten-Scroller.
     =========================================================================== */
  .speed-bars {
    view-timeline-name: --speed-bars;
    view-timeline-axis: block;
  }

  /* Aufdecken statt Strecken: die Welle darunter bleibt unverzerrt, ein
     scrub-gehaltenes scaleX(0.4) wäre eine sichtbar gestauchte Textur.
     round 999px = Pillen-Vorderkante während des Scrubs. */
  @keyframes speed-scrub-fill {
    from { clip-path: inset(0 100% 0 0 round 999px); }
    to   { clip-path: inset(0 0 0 0 round 999px); }
  }

  /* Zahlen-Landung: Rise + Deblur (Motiv von wp-kinetic-rise, M10). */
  @keyframes speed-value-land {
    from {
      opacity: 0;
      translate: 0 0.35em;
      filter: blur(4px);
    }
    70% { filter: blur(0); }
    to {
      opacity: 1;
      translate: 0 0;
      filter: blur(0);
    }
  }

  /* Sprech-Zahl: gleiche Landung + Glow-Rastung in den letzten 15% — der
     grafische "Klick" der Vollendung, reversibel beim Zurückscrollen. */
  @keyframes speed-value-land-glow {
    from {
      opacity: 0;
      translate: 0 0.35em;
      filter: blur(4px);
      text-shadow: none;
    }
    70% { filter: blur(0); }
    85% {
      opacity: 1;
      translate: 0 0;
      text-shadow: none;
    }
    to {
      opacity: 1;
      translate: 0 0;
      filter: blur(0);
      text-shadow: 0 0 18px color-mix(in srgb, var(--color-brand-cyan) 55%, transparent);
    }
  }

  /* Gleiches Feature-Gate wie alle M10-Primitive. Ohne Support bleibt der
     komplette bestehende .scroll-reveal/.visible-Einmal-Reveal unangetastet. */
  @supports (animation-timeline: view()) {
    .speed-fill {
      /* Scrub übernimmt: den transition-basierten Einmal-Reveal stilllegen.
         transform:none neutralisiert das scaleX(0)-Versteck des Fallbacks
         (die .visible-Regel oben setzt scaleX(1) — Identität, harmlos). */
      transform: none;
      transition: none;
      /* animation-timeline/-range NACH dem animation-Shorthand deklarieren —
         der Shorthand resettet timeline auf auto. */
      animation: speed-scrub-fill linear both;
      animation-timeline: --speed-bars;
    }
    .speed-fill--typing {
      animation-range: entry 0% cover 35%;
    }
    .speed-fill--speaking {
      animation-range: entry 0% cover 55%;
    }

    /* Zahlen-Landung auf derselben Timeline, Endpunkte synchron zum
       jeweiligen Balken-Plateau. linear, weil scroll-gescrubbt — der
       Scrollfinger ist das Easing (gleiche Regel wie bei .wp-recede). */
    .speed-row__value {
      animation: speed-value-land linear both;
      animation-timeline: --speed-bars;
      animation-range: entry 0% cover 30%;
    }
    .speed-row__value--brand {
      animation-name: speed-value-land-glow;
      animation-range: entry 10% cover 55%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .speed-fill {
      transition: none;
      transform: scaleX(1);
      /* Scrub stilllegen, Endzustand sofort. */
      animation: none !important;
      clip-path: none !important;
    }
    .speed-wave-track {
      animation: none;
    }
    /* Zahlen sofort voll sichtbar, keine Bewegung, kein Glow-Verlauf. */
    .speed-row__value {
      animation: none !important;
      opacity: 1 !important;
      translate: none !important;
      filter: none !important;
      text-shadow: none !important;
    }
  }
</style>
