---
import { t } from '../scripts/i18n.ts';

const lang = (Astro.currentLocale === 'en' ? 'en' : 'de') as 'de' | 'en';
---
<!-- Hero Carousel — 3-scene demo: hotkey → recording → auto-paste -->
<div class="mt-10 sm:mt-16 animate-fade-in-up">
  <div class="hero-device-stage relative mx-auto max-w-3xl">
    <!-- Device window: the carousel scenes sit inside one persistent frame
         instead of floating loose, so the demo reads as "the app", not three
         disconnected illustrations. HUD corner brackets on the frame only
         (Fidelity-Zone: functional surfaces like the buttons above stay
         chrome-free) — same treatment as the direction canvas that set this.
         Slight rotateX gives the window a staged, on-a-lectern feel instead
         of a flat screenshot facing the viewer head-on — matches the
         Cinematic Stage mockup's perspective tilt. -->
    <div class="hero-device-window relative rounded-[var(--radius-surface)] border border-white/10 bg-brand-dark shadow-[0_50px_100px_-30px_rgba(0,0,0,0.6)]">
      <svg class="hero-hud-bracket absolute -left-px -top-px" width="28" height="28" viewBox="0 0 28 28" aria-hidden="true"><path d="M1,20 L1,1 L20,1" stroke="var(--color-brand-cyan)" stroke-width="1.5" fill="none" /></svg>
      <svg class="hero-hud-bracket absolute -right-px -bottom-px" width="28" height="28" viewBox="0 0 28 28" aria-hidden="true"><path d="M27,8 L27,27 L8,27" stroke="var(--color-brand-cyan)" stroke-width="1.5" fill="none" /></svg>
      <div class="flex items-center gap-1.5 h-9 px-4 border-b border-white/10">
        <span class="w-2.5 h-2.5 rounded-full bg-white/15"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-white/15"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-white/15"></span>
      </div>
    <!-- Carousel viewport -->
    <div class="overflow-hidden">
      <div
        id="carousel-track"
        class="flex transition-transform duration-700 ease-in-out"
        style="transform: translateX(0%);"
      >
        <!-- Scene 1: Hotkey Press -->
        <div class="w-full shrink-0">
          <div
            class="p-8 sm:p-12 flex flex-col items-center justify-center min-h-[220px]"
          >
            <div class="carousel-keys-scene relative mb-6">
              <div class="carousel-keys-group">
                <div class="carousel-key carousel-key--modifier">
                  <svg
                    class="w-5 h-5 text-white/80"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    ><path
                      d="M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z"
                    ></path></svg
                  >
                </div>
                <div class="carousel-key carousel-key--modifier">
                  <svg
                    class="w-5 h-5 text-white/80"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    ><polygon
                      points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"
                    ></polygon></svg
                  >
                </div>
                <div class="carousel-key carousel-key--action">
                  <svg
                    class="w-5 h-5 text-white/80"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    ><circle cx="12" cy="12" r="10"></circle></svg
                  >
                </div>
              </div>
              <svg
                class="carousel-cursor"
                viewBox="0 0 448 512"
                width="56"
                height="64"
                aria-hidden="true"
              >
                <path
                  d="M160 64c0-8.8 7.2-16 16-16s16 7.2 16 16v136c0 10.3 6.6 19.5 16.4 22.8s20.6-.1 26.8-8.3c3-3.9 7.6-6.4 12.8-6.4c8.8 0 16 7.2 16 16c0 10.3 6.6 19.5 16.4 22.8s20.6-.1 26.8-8.3c3-3.9 7.6-6.4 12.8-6.4c7.8 0 14.3 5.6 15.7 13c1.6 8.2 7.3 15.1 15.1 18s16.7 1.6 23.3-3.6c2.7-2.1 6.1-3.4 9.9-3.4c8.8 0 16 7.2 16 16v120c0 39.8-32.2 72-72 72H211.3c-37.4 0-72.4-18.7-93.2-49.9L50.7 312.9c-4.9-7.4-2.9-17.3 4.4-22.2s17.3-2.9 22.2 4.4l38.7 58.1c5.9 8.8 16.8 12.7 26.9 9.7s17-12.4 17-23V64z"
                  fill="white"
                  fill-opacity="0.7"
                  stroke="rgba(0,0,0,0.3)"
                  stroke-width="8"
                  stroke-linejoin="round"></path>
              </svg>
            </div>
            <span
              class="text-sm text-ink-muted"
              data-i18n="carousel.press_hotkey">{t(lang, "carousel.press_hotkey")}</span
            >
          </div>
        </div>
        <!-- Scene 2: Recording Overlay -->
        <div class="w-full shrink-0">
          <div
            class="p-8 sm:p-12 flex flex-col items-center justify-center min-h-[220px]"
          >
            <!-- Speaking head + microphone icon -->
            <div class="speaking-head mb-4 flex items-center gap-3">
              <!-- Lucide speech head -->
              <svg
                class="speaking-head-icon"
                viewBox="0 0 24 24"
                width="36"
                height="36"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path
                  d="M8.8 20v-4.1l1.9.2a2.3 2.3 0 0 0 2.164-2.1V8.3A5.37 5.37 0 0 0 2 8.25c0 2.8.656 3.054 1 4.55a5.8 5.8 0 0 1 .029 2.758L2 20"
                ></path>
                <path
                  class="sound-arc arc-1"
                  d="M17 15a3.5 3.5 0 0 0-.025-4.975"></path>
                <path
                  class="sound-arc arc-2"
                  d="M19.8 17.8a7.5 7.5 0 0 0 .003-10.603"></path>
              </svg>
              <!-- FA microphone-lines -->
              <svg
                class="microphone-icon"
                viewBox="0 0 384 512"
                width="22"
                height="30"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M96 96v160c0 53 43 96 96 96s96-43 96-96h-80c-8.8 0-16-7.2-16-16s7.2-16 16-16h80v-32h-80c-8.8 0-16-7.2-16-16s7.2-16 16-16h80v-32h-80c-8.8 0-16-7.2-16-16s7.2-16 16-16h80c0-53-43-96-96-96S96 43 96 96m224 144v16c0 70.7-57.3 128-128 128S64 326.7 64 256v-40c0-13.3-10.7-24-24-24s-24 10.7-24 24v40c0 89.1 66.2 162.7 152 174.4V464h-48c-13.3 0-24 10.7-24 24s10.7 24 24 24h144c13.3 0 24-10.7 24-24s-10.7-24-24-24h-48v-33.6c85.8-11.7 152-85.3 152-174.4v-40c0-13.3-10.7-24-24-24s-24 10.7-24 24z"
                ></path>
              </svg>
            </div>
            <!--
              Recording overlay, drawn on a canvas by the shared `overlay-mockup`
              renderer (1:1 with the in-app OverlayPainter / SSOT design spec:
              liquid-glass capsule incl. Fresnel rim, drifting specular streak
              and silhouette wobble) and driven through the real recording arc
              (appear spring → recording → transcribing → done/error) by the
              shared `overlay-demo` driver. Canvas guarantees Safari/WebKit and
              Chrome/Chromium render the capsule, shadow, gradient, waveform
              and progress timeline identically (ADR 0002). No privacy badge —
              that concept is anti-vocabulary (PRD §D4, CONTEXT.md) and is
              absent from the final design.
            -->
            <canvas
              id="overlay-canvas"
              class="overlay-canvas"
              width="692"
              height="160"
              role="img"
              aria-label={t(lang, "carousel.overlayAria")}
              data-i18n-aria="carousel.overlayAria"></canvas>
            <span
              class="text-sm text-ink-muted mt-4"
              data-i18n="carousel.speak_now">{t(lang, "carousel.speak_now")}</span
            >
          </div>
        </div>
        <!-- Scene 3: Text Insertion — the traffic-light/title chrome used to
             live here as its own nested window; it's now the outer
             hero-device-window's header (all three scenes share one frame),
             so this stays the plain editor body. -->
        <div class="w-full shrink-0">
          <div class="p-6 min-h-[220px] flex flex-col">
            <span
              class="mb-2 text-xs text-ink-subtle font-mono"
              data-i18n="carousel.editor_title">{t(lang, "carousel.editor_title")}</span
            >
            <div class="p-4 min-h-[140px]">
              <div class="flex items-start gap-3">
                <div
                  class="text-xs text-ink-subtle/60 font-mono select-none leading-relaxed pt-0.5"
                >
                  1<br />2<br />3
                </div>
                <div
                  id="typed-text"
                  class="text-sm text-white/90 font-mono leading-relaxed whitespace-pre-wrap"
                >
                  <span class="typing-cursor"></span>
                </div>
              </div>
            </div>
            <span
              class="text-sm text-ink-muted mt-3 text-center"
              data-i18n="carousel.auto_pasted">{t(lang, "carousel.auto_pasted")}</span
            >
          </div>
        </div>
      </div>
    </div>
    </div>
    <!-- Dot indicators — plain button group (not a full ARIA tabs widget, so
         no role=tab/tabpanel pairing is required). Each button is a ≥24×24px
         hit target (WCAG 2.5.8) wrapping the small visible dot, so the tap
         area stays comfortable without growing the dot itself. -->
    <div class="flex justify-center gap-2 pt-4" role="group" aria-label={t(lang, "carousel.tablistAria")} data-i18n-aria="carousel.tablistAria">
      <button
        class="carousel-dot-hit group"
        data-slide="0"
        aria-current="true"
        aria-label={t(lang, "carousel.slide1Aria")}
        data-i18n-aria="carousel.slide1Aria"
      ><span class="carousel-dot active w-2 h-2 rounded-full bg-brand-cyan transition-all" style="width:16px;"></span></button>
      <button
        class="carousel-dot-hit group"
        data-slide="1"
        aria-label={t(lang, "carousel.slide2Aria")}
        data-i18n-aria="carousel.slide2Aria"
      ><span class="carousel-dot w-2 h-2 rounded-full bg-white/20 group-hover:bg-white/40 transition-all"></span></button>
      <button
        class="carousel-dot-hit group"
        data-slide="2"
        aria-label={t(lang, "carousel.slide3Aria")}
        data-i18n-aria="carousel.slide3Aria"
      ><span class="carousel-dot w-2 h-2 rounded-full bg-white/20 group-hover:bg-white/40 transition-all"></span></button>
    </div>
  </div>
</div>

<style>
  /* HUD corner brackets — deliberately faint (0.55) and confined to the
     frame's own corners, so they read as instrumentation on the device
     window rather than a shape competing with the demo inside it. */
  .hero-hud-bracket {
    opacity: 0.55;
    pointer-events: none;
  }

  /* Perspective stage for the tilt below — the 3D transform on the window
     needs a perspective ancestor or rotateX just skews it in place. */
  .hero-device-stage {
    perspective: 1600px;
  }
  .hero-device-window {
    transform: rotateX(4deg);
    transform-origin: center top;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-device-window {
      transform: none;
    }
  }

  /* Dot hit-box — 24×24px minimum tap target (WCAG 2.5.8) around the small
     visible dot rendered by the nested .carousel-dot span. */
  .carousel-dot-hit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    min-height: 24px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
  }

  /* Carousel keys group */
  .carousel-keys-group {
    display: flex;
    align-items: end;
    gap: 6px;
    transform: rotate(-6deg);
  }
  .carousel-keys-group .carousel-key--action {
    margin-left: 10px;
  }

  /* Cursor pointer animation */
  .carousel-cursor {
    position: absolute;
    right: -24px;
    top: -8px;
    pointer-events: none;
    animation: cursor-press 3s ease-in-out infinite;
    filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.35));
    transform-origin: 60% 30%;
  }
  @keyframes cursor-press {
    0%,
    6% {
      opacity: 0;
      transform: rotate(-15deg) translate(28px, 40px);
    }
    20% {
      opacity: 0.8;
      transform: rotate(-15deg) translate(0, 4px);
    }
    26%,
    50% {
      opacity: 0.8;
      transform: rotate(-15deg) translate(0, 10px);
    }
    58% {
      opacity: 0;
      transform: rotate(-15deg) translate(0, 10px);
    }
    100% {
      opacity: 0;
      transform: rotate(-15deg) translate(28px, 40px);
    }
  }

  /* Carousel key animation */
  .carousel-key {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.08) 0%,
      rgba(255, 255, 255, 0.03) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow:
      0 4px 0 rgba(0, 0, 0, 0.4),
      0 6px 12px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    transition:
      transform 0.1s,
      box-shadow 0.1s;
  }
  .carousel-key--modifier {
    animation: key-press-mod 3s ease-in-out infinite;
  }
  .carousel-key--action {
    animation: key-press-act 3s ease-in-out infinite;
  }
  @keyframes key-press-mod {
    0%,
    10% {
      transform: translateY(0);
      box-shadow:
        0 4px 0 rgba(0, 0, 0, 0.4),
        0 6px 12px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
    14%,
    52% {
      transform: translateY(4px);
      box-shadow:
        0 0px 0 rgba(0, 0, 0, 0.4),
        0 2px 4px rgba(0, 0, 0, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
    58%,
    100% {
      transform: translateY(0);
      box-shadow:
        0 4px 0 rgba(0, 0, 0, 0.4),
        0 6px 12px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
  }
  @keyframes key-press-act {
    0%,
    22% {
      transform: translateY(0);
      box-shadow:
        0 4px 0 rgba(0, 0, 0, 0.4),
        0 6px 12px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
    26%,
    52% {
      transform: translateY(4px);
      box-shadow:
        0 0px 0 rgba(0, 0, 0, 0.4),
        0 2px 4px rgba(0, 0, 0, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
    58%,
    100% {
      transform: translateY(0);
      box-shadow:
        0 4px 0 rgba(0, 0, 0, 0.4),
        0 6px 12px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
  }

  /* Overlay mockup (Scene 2) — canvas drawn by the shared overlay-mockup
     renderer (1:1 with the in-app OverlayPainter). CSS only sizes the element;
     the design lives in the canvas so it is byte-for-byte equivalent across
     Safari/WebKit and Chrome/Chromium. Intrinsic 692×160 ratio = (330+16)×(64+16)
     so height:auto keeps the aspect when max-width clamps it on narrow screens. */
  .overlay-canvas {
    display: block;
    width: 346px;
    max-width: 100%;
    height: auto;
  }

  /* Speaking head + microphone icon (Scene 2) */
  .speaking-head {
    color: rgba(255, 255, 255, 0.5);
  }
  .microphone-icon {
    color: rgba(255, 255, 255, 0.4);
    animation: mic-pulse 1.8s ease-in-out infinite;
  }
  @keyframes mic-pulse {
    0%,
    100% {
      color: rgba(255, 255, 255, 0.4);
    }
    50% {
      color: var(--color-brand-cyan);
    }
  }
  .speaking-head-icon .sound-arc {
    opacity: 0;
    stroke: var(--color-brand-cyan);
  }
  .sound-arc.arc-1 {
    animation: sound-pulse 1.8s ease-in-out infinite;
  }
  .sound-arc.arc-2 {
    animation: sound-pulse 1.8s ease-in-out 0.3s infinite;
  }
  @keyframes sound-pulse {
    0%,
    100% {
      opacity: 0;
    }
    30%,
    70% {
      opacity: 0.7;
    }
  }

  /* Container entrance animation */
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(40px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  .animate-fade-in-up {
    animation: fade-in-up 1s ease-out 0.5s both;
  }

  /* Reduced motion for carousel animations */
  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in-up,
    .carousel-key,
    .carousel-cursor,
    .sound-arc,
    .microphone-icon {
      animation: none !important;
    }
    #carousel-track {
      transition: none !important;
    }
  }
</style>

<script>
  import "../scripts/hero-carousel";
</script>
