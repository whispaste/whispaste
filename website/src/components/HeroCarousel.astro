<!-- Hero Carousel — 3-scene demo: hotkey → recording → auto-paste -->
<div class="mt-10 sm:mt-16 animate-fade-in-up">
  <div class="relative mx-auto max-w-2xl">
    <!-- Carousel viewport -->
    <div class="overflow-hidden">
      <div
        id="carousel-track"
        class="flex transition-transform duration-700 ease-in-out"
        style="transform: translateX(0%);"
      >
        <!-- Scene 1: Hotkey Press -->
        <div class="w-full shrink-0">
          <div
            class="p-8 sm:p-12 flex flex-col items-center justify-center min-h-[220px]"
          >
            <div class="carousel-keys-scene relative mb-6">
              <div class="carousel-keys-group">
                <div class="carousel-key carousel-key--modifier">
                  <svg
                    class="w-5 h-5 text-white/80"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    ><path
                      d="M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z"
                    ></path></svg
                  >
                </div>
                <div class="carousel-key carousel-key--modifier">
                  <svg
                    class="w-5 h-5 text-white/80"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    ><polygon
                      points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"
                    ></polygon></svg
                  >
                </div>
                <div class="carousel-key carousel-key--action">
                  <svg
                    class="w-5 h-5 text-white/80"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    ><circle cx="12" cy="12" r="10"></circle></svg
                  >
                </div>
              </div>
              <svg
                class="carousel-cursor"
                viewBox="0 0 448 512"
                width="56"
                height="64"
                aria-hidden="true"
              >
                <path
                  d="M160 64c0-8.8 7.2-16 16-16s16 7.2 16 16v136c0 10.3 6.6 19.5 16.4 22.8s20.6-.1 26.8-8.3c3-3.9 7.6-6.4 12.8-6.4c8.8 0 16 7.2 16 16c0 10.3 6.6 19.5 16.4 22.8s20.6-.1 26.8-8.3c3-3.9 7.6-6.4 12.8-6.4c7.8 0 14.3 5.6 15.7 13c1.6 8.2 7.3 15.1 15.1 18s16.7 1.6 23.3-3.6c2.7-2.1 6.1-3.4 9.9-3.4c8.8 0 16 7.2 16 16v120c0 39.8-32.2 72-72 72H211.3c-37.4 0-72.4-18.7-93.2-49.9L50.7 312.9c-4.9-7.4-2.9-17.3 4.4-22.2s17.3-2.9 22.2 4.4l38.7 58.1c5.9 8.8 16.8 12.7 26.9 9.7s17-12.4 17-23V64z"
                  fill="white"
                  fill-opacity="0.7"
                  stroke="rgba(0,0,0,0.3)"
                  stroke-width="8"
                  stroke-linejoin="round"></path>
              </svg>
            </div>
            <span
              class="text-sm text-gray-400"
              data-i18n="carousel.press_hotkey">Press your hotkey</span
            >
          </div>
        </div>
        <!-- Scene 2: Recording Overlay -->
        <div class="w-full shrink-0">
          <div
            class="p-8 sm:p-12 flex flex-col items-center justify-center min-h-[220px]"
          >
            <!-- Speaking head + microphone icon -->
            <div class="speaking-head mb-4 flex items-center gap-3">
              <!-- Lucide speech head -->
              <svg
                class="speaking-head-icon"
                viewBox="0 0 24 24"
                width="36"
                height="36"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path
                  d="M8.8 20v-4.1l1.9.2a2.3 2.3 0 0 0 2.164-2.1V8.3A5.37 5.37 0 0 0 2 8.25c0 2.8.656 3.054 1 4.55a5.8 5.8 0 0 1 .029 2.758L2 20"
                ></path>
                <path
                  class="sound-arc arc-1"
                  d="M17 15a3.5 3.5 0 0 0-.025-4.975"></path>
                <path
                  class="sound-arc arc-2"
                  d="M19.8 17.8a7.5 7.5 0 0 0 .003-10.603"></path>
              </svg>
              <!-- FA microphone-lines -->
              <svg
                class="microphone-icon"
                viewBox="0 0 384 512"
                width="22"
                height="30"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M96 96v160c0 53 43 96 96 96s96-43 96-96h-80c-8.8 0-16-7.2-16-16s7.2-16 16-16h80v-32h-80c-8.8 0-16-7.2-16-16s7.2-16 16-16h80v-32h-80c-8.8 0-16-7.2-16-16s7.2-16 16-16h80c0-53-43-96-96-96S96 43 96 96m224 144v16c0 70.7-57.3 128-128 128S64 326.7 64 256v-40c0-13.3-10.7-24-24-24s-24 10.7-24 24v40c0 89.1 66.2 162.7 152 174.4V464h-48c-13.3 0-24 10.7-24 24s10.7 24 24 24h144c13.3 0 24-10.7 24-24s-10.7-24-24-24h-48v-33.6c85.8-11.7 152-85.3 152-174.4v-40c0-13.3-10.7-24-24-24s-24 10.7-24 24z"
                ></path>
              </svg>
            </div>
            <div class="overlay-pill">
              <div class="overlay-btn-dashboard">
                <svg viewBox="0 0 40 40" width="40" height="40" fill="rgba(170,187,204,0.8)" aria-hidden="true">
                  <rect x="12" y="12" width="5" height="5"></rect>
                  <rect x="23" y="12" width="5" height="5"></rect>
                  <rect x="12" y="23" width="5" height="5"></rect>
                  <rect x="23" y="23" width="5" height="5"></rect>
                </svg>
              </div>
              <div class="overlay-btn-cancel">
                <svg
                  viewBox="0 0 40 40"
                  width="40"
                  height="40"
                  fill="none"
                  stroke="rgba(170,170,187,0.8)"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  ><line x1="13" y1="13" x2="27" y2="27"></line><line
                    x1="27"
                    y1="13"
                    x2="13"
                    y2="27"></line></svg
                >
              </div>
              <div class="overlay-content">
                <div class="overlay-rec-dot"></div>
                <span class="overlay-text-timer" id="overlay-timer"
                  >0:00</span
                >
              </div>
              <div class="overlay-waveform" id="overlay-waveform"></div>
              <div class="overlay-buttons">
                <div class="overlay-btn-pause">
                  <svg
                    viewBox="0 0 40 40"
                    width="40"
                    height="40"
                    fill="white"
                    ><rect x="12" y="11" width="5" height="18" rx="1"
                    ></rect><rect x="23" y="11" width="5" height="18" rx="1"
                    ></rect></svg
                  >
                </div>
                <div class="overlay-btn-confirm">
                  <svg
                    viewBox="0 0 40 40"
                    width="40"
                    height="40"
                    fill="white"
                    ><rect x="12" y="12" width="16" height="16" rx="2"
                    ></rect></svg
                  >
                </div>
              </div>
            </div>
            <span
              class="text-sm text-gray-400 mt-4"
              data-i18n="carousel.speak_now">Speak now</span
            >
          </div>
        </div>
        <!-- Scene 3: Text Insertion -->
        <div class="w-full shrink-0">
          <div class="p-6 min-h-[220px] flex flex-col">
            <div
              class="flex items-center gap-2 px-4 py-2.5 bg-brand-card/60 border-b border-white/5 rounded-t-lg"
            >
              <div class="flex gap-1.5">
                <div class="w-3 h-3 rounded-full bg-red-500/60"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500/60"></div>
                <div class="w-3 h-3 rounded-full bg-green-500/60"></div>
              </div>
              <span
                class="ml-2 text-xs text-gray-500 font-mono"
                data-i18n="carousel.editor_title">Text Editor</span
              >
            </div>
            <div
              class="bg-brand-darker/80 border border-white/5 border-t-0 rounded-b-lg p-4 min-h-[140px]"
            >
              <div class="flex items-start gap-3">
                <div
                  class="text-xs text-gray-600 font-mono select-none leading-relaxed pt-0.5"
                >
                  1<br />2<br />3
                </div>
                <div
                  id="typed-text"
                  class="text-sm text-white/90 font-mono leading-relaxed whitespace-pre-wrap"
                >
                  <span class="typing-cursor"></span>
                </div>
              </div>
            </div>
            <span
              class="text-sm text-gray-400 mt-3 text-center"
              data-i18n="carousel.auto_pasted">Auto-pasted!</span
            >
          </div>
        </div>
      </div>
    </div>
    <!-- Dot indicators -->
    <div class="flex justify-center gap-2 pt-4" role="tablist" aria-label="Carousel slides" data-i18n-aria="carousel.tablistAria">
      <button
        class="carousel-dot active w-2 h-2 rounded-full bg-brand-cyan transition-all"
        data-slide="0"
        role="tab"
        aria-selected="true"
        aria-label="Slide 1: Press hotkey"
        data-i18n-aria="carousel.slide1Aria"
        style="width:16px;"></button>
      <button
        class="carousel-dot w-2 h-2 rounded-full bg-white/20 hover:bg-white/40 transition-all"
        data-slide="1"
        role="tab"
        aria-selected="false"
        aria-label="Slide 2: Speak now"
        data-i18n-aria="carousel.slide2Aria"></button>
      <button
        class="carousel-dot w-2 h-2 rounded-full bg-white/20 hover:bg-white/40 transition-all"
        data-slide="2"
        role="tab"
        aria-selected="false"
        aria-label="Slide 3: Auto-pasted"
        data-i18n-aria="carousel.slide3Aria"></button>
    </div>
  </div>
</div>

<style>
  /* Carousel keys group */
  .carousel-keys-group {
    display: flex;
    align-items: end;
    gap: 6px;
    transform: rotate(-6deg);
  }
  .carousel-keys-group .carousel-key--action {
    margin-left: 10px;
  }

  /* Cursor pointer animation */
  .carousel-cursor {
    position: absolute;
    right: -24px;
    top: -8px;
    pointer-events: none;
    animation: cursor-press 3s ease-in-out infinite;
    filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.35));
    transform-origin: 60% 30%;
  }
  @keyframes cursor-press {
    0%,
    6% {
      opacity: 0;
      transform: rotate(-15deg) translate(28px, 40px);
    }
    20% {
      opacity: 0.8;
      transform: rotate(-15deg) translate(0, 4px);
    }
    26%,
    50% {
      opacity: 0.8;
      transform: rotate(-15deg) translate(0, 10px);
    }
    58% {
      opacity: 0;
      transform: rotate(-15deg) translate(0, 10px);
    }
    100% {
      opacity: 0;
      transform: rotate(-15deg) translate(28px, 40px);
    }
  }

  /* Carousel key animation */
  .carousel-key {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.08) 0%,
      rgba(255, 255, 255, 0.03) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow:
      0 4px 0 rgba(0, 0, 0, 0.4),
      0 6px 12px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    transition:
      transform 0.1s,
      box-shadow 0.1s;
  }
  .carousel-key--modifier {
    animation: key-press-mod 3s ease-in-out infinite;
  }
  .carousel-key--action {
    animation: key-press-act 3s ease-in-out infinite;
  }
  @keyframes key-press-mod {
    0%,
    10% {
      transform: translateY(0);
      box-shadow:
        0 4px 0 rgba(0, 0, 0, 0.4),
        0 6px 12px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
    14%,
    52% {
      transform: translateY(4px);
      box-shadow:
        0 0px 0 rgba(0, 0, 0, 0.4),
        0 2px 4px rgba(0, 0, 0, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
    58%,
    100% {
      transform: translateY(0);
      box-shadow:
        0 4px 0 rgba(0, 0, 0, 0.4),
        0 6px 12px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
  }
  @keyframes key-press-act {
    0%,
    22% {
      transform: translateY(0);
      box-shadow:
        0 4px 0 rgba(0, 0, 0, 0.4),
        0 6px 12px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
    26%,
    52% {
      transform: translateY(4px);
      box-shadow:
        0 0px 0 rgba(0, 0, 0, 0.4),
        0 2px 4px rgba(0, 0, 0, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
    58%,
    100% {
      transform: translateY(0);
      box-shadow:
        0 4px 0 rgba(0, 0, 0, 0.4),
        0 6px 12px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
  }

  /* Overlay pill (Scene 2) — 1:1 match with real app overlay */
  .overlay-pill {
    position: relative;
    width: clamp(280px, 85vw, 490px);
    height: 80px;
    border-radius: 40px;
    background: linear-gradient(180deg, rgba(18, 36, 53, 0.8) 0%, rgba(7, 15, 25, 0.8) 100%);
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.19);
    display: flex;
    align-items: center;
    font-family: "Segoe UI", system-ui, sans-serif;
    transform: scale(0.85);
    transform-origin: center;
  }
  @media (min-width: 640px) {
    .overlay-pill {
      transform: scale(1);
    }
  }
  .overlay-btn-dashboard {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #1e2a36;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 14px;
    flex-shrink: 0;
  }
  .overlay-btn-cancel {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #1e2a36;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 8px;
    flex-shrink: 0;
  }
  .overlay-content {
    margin-left: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .overlay-rec-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ff3c3c;
    animation: rec-pulse 1.2s ease-in-out infinite;
  }
  @keyframes rec-pulse {
    0%,
    100% {
      opacity: 0.7;
    }
    50% {
      opacity: 1;
    }
  }
  .overlay-text-timer {
    font-size: 15px;
    font-weight: 600;
    color: #ffffff;
    line-height: 1;
  }
  .overlay-waveform {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    flex: 1 1 0%;
    height: 44px;
    min-width: 0;
  }
  .overlay-buttons {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-right: 14px;
  }
  .overlay-btn-pause,
  .overlay-btn-confirm {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .overlay-btn-pause svg,
  .overlay-btn-confirm svg {
    width: 40px;
    height: 40px;
  }
  .overlay-btn-pause {
    background: #0e3d4f;
  }
  .overlay-btn-confirm {
    background: #e53935;
  }

  /* Speaking head + microphone icon (Scene 2) */
  .speaking-head {
    color: rgba(255, 255, 255, 0.5);
  }
  .microphone-icon {
    color: rgba(255, 255, 255, 0.4);
    animation: mic-glow 1.8s ease-in-out infinite;
  }
  @keyframes mic-glow {
    0%,
    100% {
      color: rgba(255, 255, 255, 0.4);
    }
    50% {
      color: #22d3ee;
    }
  }
  .speaking-head-icon .sound-arc {
    opacity: 0;
    stroke: #22d3ee;
  }
  .sound-arc.arc-1 {
    animation: sound-pulse 1.8s ease-in-out infinite;
  }
  .sound-arc.arc-2 {
    animation: sound-pulse 1.8s ease-in-out 0.3s infinite;
  }
  @keyframes sound-pulse {
    0%,
    100% {
      opacity: 0;
    }
    30%,
    70% {
      opacity: 0.7;
    }
  }

  /* Container entrance animation */
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(40px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  .animate-fade-in-up {
    animation: fade-in-up 1s ease-out 0.5s both;
  }

  /* Reduced motion for carousel animations */
  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in-up,
    .carousel-key,
    .carousel-cursor,
    .overlay-rec-dot,
    .sound-arc,
    .microphone-icon {
      animation: none !important;
    }
    #carousel-track {
      transition: none !important;
    }
  }
</style>

<script>
  import "../scripts/hero-carousel";
</script>
