---
const coreFeatures = [
  { key: 'hotkey', icon: `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m9 8 3 3-3 3"/><path d="M14 16h4"/></svg>`, title: "Global Hotkey", desc: "Trigger dictation from anywhere with push-to-talk or toggle mode." },
  { key: 'autopaste', icon: `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/></svg>`, title: "Auto-Paste", desc: "Final text lands at your cursor automatically, with clipboard sync included." },
  { key: 'snippets', icon: `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3L21 7L17 11"/><path d="M21 7H3"/><path d="M7 21L3 17L7 13"/><path d="M3 17H21"/></svg>`, title: "Voice Snippets", desc: "Turn short trigger phrases into links, signatures, templates, and reusable replies." },
  { key: 'privacy', icon: `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>`, title: "Privacy First", desc: "Stay local with built-in speech recognition or choose cloud on purpose. No tracking — optional crash reports can be turned off." },
];

const powerFeatures = [
  { key: 'dashboard', icon: `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>`, title: "Dashboard", desc: "Search, tag, pin, archive, and organize transcriptions without losing the simple core flow." },
  { key: 'overlay', icon: `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>`, title: "Recording Overlay", desc: "A slim overlay shows status, a live waveform, and timing while you speak — stays out of your way." },
  { key: 'export', icon: `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>`, title: "Export", desc: "Export single entries or selections as TXT, Markdown, CSV, JSON, or Word." },
];
---

<!-- Features Section -->
<section id="features" class="py-24 sm:py-32 relative scroll-mt-20">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_rgba(14,116,144,0.05)_0%,_transparent_70%)]"></div>
  <div class="relative max-w-6xl mx-auto px-6">
    <div class="text-center mb-16 scroll-reveal">
      <p class="text-brand-cyan text-sm font-semibold tracking-wider uppercase mb-3" data-i18n="features.label">Why WhisPaste</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-white" data-i18n="features.title">One clean core workflow, then real depth.</h2>
      <p class="mt-4 text-gray-400 text-lg max-w-3xl mx-auto" data-i18n="features.desc">Start with fast dictation and snippets. Go deeper only when you want cleanup, history, and power-user tools.</p>
    </div>
    <div class="mb-6 flex items-center gap-3 scroll-reveal">
      <div class="h-px flex-1 bg-white/8"></div>
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-gray-400" data-i18n="features.core">Start here</p>
      <div class="h-px flex-1 bg-white/8"></div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5">
      {coreFeatures.map(({ key, icon, title, desc }) => (
        <div class="feature-card feature-card-primary group p-6 rounded-2xl border border-white/[0.06] hover:border-brand-cyan/30 transition-all duration-300 scroll-reveal">
          <div class="w-10 h-10 rounded-xl bg-brand-cyan/10 text-brand-cyan flex items-center justify-center mb-4 group-hover:scale-110 group-hover:bg-brand-cyan/15 transition-all duration-300" set:html={icon} />
          <h3 class="text-white font-semibold mb-1.5" data-i18n={`features.${key}.title`}>{title}</h3>
          <p class="text-gray-400 text-sm leading-relaxed" data-i18n={`features.${key}.desc`}>{desc}</p>
        </div>
      ))}
    </div>
    <div class="mt-12 mb-6 flex items-center gap-3 scroll-reveal">
      <div class="h-px flex-1 bg-white/8"></div>
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-gray-400" data-i18n="features.power">Go deeper when you need more</p>
      <div class="h-px flex-1 bg-white/8"></div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {powerFeatures.map(({ key, icon, title, desc }) => (
        <div class="feature-card group p-6 rounded-2xl border border-white/[0.06] hover:border-brand-cyan/20 transition-all duration-300 scroll-reveal">
          <div class="w-10 h-10 rounded-xl bg-white/[0.04] text-brand-cyan flex items-center justify-center mb-4 group-hover:scale-110 group-hover:bg-brand-cyan/10 transition-all duration-300" set:html={icon} />
          <h3 class="text-white font-semibold mb-1.5" data-i18n={`features.${key}.title`}>{title}</h3>
          <p class="text-gray-400 text-sm leading-relaxed" data-i18n={`features.${key}.desc`}>{desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Glassmorphism feature cards */
  .feature-card {
    background: linear-gradient(135deg, rgba(29, 37, 56, 0.5) 0%, rgba(23, 29, 44, 0.3) 100%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .feature-card:hover {
    background: linear-gradient(135deg, rgba(29, 37, 56, 0.7) 0%, rgba(56, 217, 240, 0.03) 100%);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }
  .feature-card-primary {
    background: linear-gradient(135deg, rgba(29, 37, 56, 0.72) 0%, rgba(19, 24, 38, 0.55) 100%);
  }
</style>

