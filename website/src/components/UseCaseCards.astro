---
import SectionEyebrow from './SectionEyebrow.astro';
import { t, currentLocale, pathForSlug } from '../scripts/i18n.ts';

const lang = currentLocale(Astro.currentLocale);

const workflows = [
  {
    key: 'developer',
    href: pathForSlug(lang, 'use-cases/programmer'),
    illustration: '/illustrations/use-case-developer.svg',
    illustrationAltKey: 'useCase.programmer.illustrationAlt',
  },
  {
    key: 'students',
    href: pathForSlug(lang, 'use-cases/students'),
    illustration: '/illustrations/use-case-students.svg',
    illustrationAltKey: 'useCase.students.illustrationAlt',
  },
  {
    key: 'everyday',
    href: pathForSlug(lang, 'use-cases/everyday'),
    illustration: '/illustrations/use-case-everyday.svg',
    illustrationAltKey: 'useCase.everyday.illustrationAlt',
  },
] as const;
---

<!-- Use cases: three compact entries into the existing use-case pages. Rows
     with a small illustration on phones/tablets, three equal cards from lg. -->
<section id="use-cases" class="band band-raised relative wp-section scroll-mt-20">
  <div class="relative wp-container">
    <div class="wp-section-head">
      <SectionEyebrow key="useCaseCards.label" />
      <h2 class="section-title">
        <span data-i18n="useCaseCards.titleLead">{t(lang, 'useCaseCards.titleLead')}</span><!--
        --><span class="text-gradient-brand" data-i18n="useCaseCards.titleAccent">{t(lang, 'useCaseCards.titleAccent')}</span><!--
        --><span data-i18n="useCaseCards.titleTail">{t(lang, 'useCaseCards.titleTail')}</span>
      </h2>
    </div>

    <div class="use-case-grid">
      {workflows.map(({ key, href, illustration, illustrationAltKey }) => (
        <a
          href={href}
          class="use-case-card"
          aria-label={t(lang, `useCaseCards.${key}.ariaLabel`)}
          data-i18n-aria={`useCaseCards.${key}.ariaLabel`}
          data-testid={`use-cases-${key}`}
        >
          <img
            src={illustration}
            alt={t(lang, illustrationAltKey)}
            width="1024"
            height="1024"
            loading="lazy"
            decoding="async"
            class="use-case-card__illustration"
          />
          <div class="use-case-card__body">
            <h3 class="use-case-card__title"
                data-i18n={`useCaseCards.${key}.title`}>{t(lang, `useCaseCards.${key}.title`)}</h3>
            <p class="use-case-card__desc"
               data-i18n={`useCaseCards.${key}.desc`}>{t(lang, `useCaseCards.${key}.desc`)}</p>
            <span class="use-case-card__cta">
              <span data-i18n="useCaseCards.more">{t(lang, 'useCaseCards.more')}</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .use-case-grid {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 1024px) {
    .use-case-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  /* Row layout by default: small illustration left, text right. */
  .use-case-card {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    align-items: start;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: var(--radius-card);
    /* 12% like every structural edge on the page (Flutter borderSubtle) */
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: var(--color-brand-card);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--dur-base) ease;
  }
  @media (min-width: 1024px) {
    .use-case-card {
      grid-template-columns: 1fr;
      padding: 1.75rem;
    }
  }

  .use-case-card__illustration {
    width: 3rem;
    height: 3rem;
    object-fit: contain;
  }
  @media (min-width: 1024px) {
    .use-case-card__illustration {
      width: 3.5rem;
      height: 3.5rem;
    }
  }

  .use-case-card__body {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .use-case-card__title {
    font-size: var(--type-card-title);
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 0.375rem;
    line-height: 1.3;
  }

  .use-case-card__desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
    flex: 1;
  }

  .use-case-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.875rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-brand-cyan);
  }
  .use-case-card__cta svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    transition: transform var(--dur-base) ease;
  }

  /* Hover feedback only for real pointers; no lift on touch. */
  @media (hover: hover) {
    .use-case-card:hover {
      border-color: color-mix(in srgb, var(--color-brand-cyan) 35%, transparent);
    }
    .use-case-card:hover .use-case-card__cta svg {
      transform: translateX(3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .use-case-card,
    .use-case-card__cta svg {
      transition: none;
    }
  }
</style>
