---
import { getCollection } from "astro:content";
import BlogLayout from "../layouts/BlogLayout.astro";
import BlogCard from "./BlogCard.astro";
import BlogCrumbs from "./BlogCrumbs.astro";
import BreadcrumbListSchema from "./schema/BreadcrumbListSchema.astro";
import { t, localePath, type Locale } from "../scripts/i18n.ts";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const posts = (await getCollection("blog"))
  .filter((post) => post.id.startsWith(`${lang}/`))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [latest, ...rest] = posts;

const breadcrumbs = [
  { name: t(lang, "breadcrumb.home"), item: localePath(lang, "") },
  { name: t(lang, "nav.blog"), item: localePath(lang, "blog") },
];
---

<BlogLayout lang={lang} title={t(lang, "blog.seoTitle")} description={t(lang, "blog.seoDescription")}>
  <Fragment slot="hero">
    <BlogCrumbs items={breadcrumbs} />
    <div class="wp-section-head blog-index-head">
      <p class="wp-eyebrow">{t(lang, "blog.label")}</p>
      <h1 class="section-title">{t(lang, "blog.heading")}</h1>
      <p class="wp-lead">{t(lang, "blog.lead")}</p>
    </div>
  </Fragment>

  {latest === undefined ? (
    <p class="text-ink-muted" data-testid="blog-empty">{t(lang, "blog.empty")}</p>
  ) : (
    <ul class="blog-grid" data-testid="blog-list" style={`--cols-md:${Math.min(Math.max(rest.length, 1), 2)};--cols-xl:${Math.min(Math.max(rest.length, 1), 3)}`}>
      <li class="blog-grid-lead"><BlogCard lang={lang} post={latest} featured /></li>
      {rest.map((post) => (
        <li><BlogCard lang={lang} post={post} /></li>
      ))}
    </ul>
  )}

  <BreadcrumbListSchema items={breadcrumbs} />
</BlogLayout>

<style>
  /* Column count follows the number of posts below the lead card (max. 3),
     so a short list fills the frame instead of leaving empty tracks. */
  .blog-grid {
    display: grid;
    gap: clamp(var(--wp-space-4), var(--wp-space-2) + 1.25vw, var(--wp-space-8));
  }
  @media (min-width: 768px) {
    .blog-grid {
      grid-template-columns: repeat(var(--cols-md), minmax(0, 1fr));
    }
  }
  @media (min-width: 1280px) {
    .blog-grid {
      grid-template-columns: repeat(var(--cols-xl), minmax(0, 1fr));
    }
  }
  .blog-grid-lead {
    grid-column: 1 / -1;
  }
  /* The head sits alone on the stage; the sheet below takes the gap. */
  .blog-index-head {
    margin-bottom: 0;
  }
</style>
