---
/**
 * Hero visual: an e-mail draft in its finished state, with the real
 * WhisPaste recording overlay (canvas) running its record → paste arc on top. It replaces the promo film —
 * the result is readable on the first frame, needs no media download and is
 * the LCP element as plain text. Purely illustrative: no form controls, no
 * tab stops on decorative window chrome.
 */
import { t, currentLocale } from '../scripts/i18n.ts';

const lang = currentLocale(Astro.currentLocale);
---

<figure class="hx" data-testid="hero-example">
  <div class="hx-window" role="img" aria-labelledby="hero-example-caption">
    <div class="hx-titlebar" aria-hidden="true">
      <span class="hx-title" data-i18n="hero.example.label">{t(lang, 'hero.example.label')}</span>
      <span class="hx-dots"><i></i><i></i><i></i></span>
    </div>
    <div class="hx-body" aria-hidden="true">
      <div class="hx-field">
        <span class="hx-field-label" data-i18n="hero.example.to">{t(lang, 'hero.example.to')}</span>
        <span class="hx-field-value" data-i18n="hero.example.toValue">{t(lang, 'hero.example.toValue')}</span>
      </div>
      <div class="hx-field">
        <span class="hx-field-label" data-i18n="hero.example.subject">{t(lang, 'hero.example.subject')}</span>
        <span class="hx-field-value" data-i18n="hero.example.subjectValue">{t(lang, 'hero.example.subjectValue')}</span>
      </div>
      <div class="hx-editor">
        <p class="hx-text"><span data-i18n="hero.example.body">{t(lang, 'hero.example.body')}</span><span class="hx-caret"></span></p>

      </div>
    </div>
  </div>
  <!-- The real recording pill (shared canvas renderer, 1:1 with the app's
       overlay), floating bottom-centre over the window like the app places it.
       Decorative here: the caption carries the meaning. -->
  <div class="hx-overlay" aria-hidden="true">
    <canvas class="hx-overlay-canvas" width="692" height="160"></canvas>
  </div>
  <figcaption class="hx-caption">
    <span id="hero-example-caption" data-i18n="hero.example.caption">{t(lang, 'hero.example.caption')}</span>
    <a href="#app-paste-demo" class="hx-demo-link" data-testid="hero-demo-link">
      <span data-i18n="hero.example.demoLink">{t(lang, 'hero.example.demoLink')}</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14" /><path d="m19 12-7 7-7-7" /></svg>
    </a>
  </figcaption>
</figure>

<style>
  .hx {
    margin: 0;
    width: 100%;
  }
  .hx-window {
    border-radius: var(--radius-surface);
    border: 1px solid color-mix(in srgb, var(--color-brand-cyan) 22%, transparent);
    background: color-mix(in srgb, var(--color-brand-card) 88%, transparent);
    box-shadow:
      var(--shadow-overlay),
      0 0 80px -20px color-mix(in srgb, var(--color-brand-cyan) 30%, transparent);
    overflow: hidden;
    text-align: left;
  }
  .hx-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    background: rgb(255 255 255 / 0.03);
  }
  .hx-title {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-ink);
  }
  .hx-dots {
    display: inline-flex;
    gap: 0.4rem;
  }
  .hx-dots i {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.18);
  }
  .hx-body {
    display: grid;
    gap: 0.625rem;
    padding: 1.25rem;
  }
  .hx-field {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9375rem;
  }
  .hx-field-label {
    color: var(--color-ink-muted);
  }
  .hx-field-value {
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-control);
    border: 1px solid rgb(255 255 255 / 0.1);
    color: var(--color-ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .hx-editor {
    margin-top: 0.375rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 13rem;
    padding: 1rem 1.125rem;
    border-radius: var(--radius-card);
    border: 1px solid rgb(255 255 255 / 0.1);
    background: rgb(11 18 42 / 0.45);
  }
  .hx-text {
    margin: 0;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.1875rem);
    line-height: 1.6;
    color: var(--color-ink);
  }
  .hx-caret {
    display: inline-block;
    width: 2px;
    height: 1.15em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: var(--color-brand-cyan);
    animation: hx-blink 1.1s steps(1) infinite;
  }
  @keyframes hx-blink {
    50% { opacity: 0; }
  }
  .hx-overlay {
    position: relative;
    display: flex;
    justify-content: center;
    margin-top: -5.25rem;
    margin-bottom: 2rem;
    pointer-events: none;
  }
  /* Fixed 346×80 logical canvas (scaled by dpr in JS); the renderer paints
     the pill's own shadow. */
  .hx-overlay-canvas {
    display: block;
    width: 300px;
    max-width: 90%;
    height: auto;
  }
  .hx-caption {
    margin-top: 0.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
    font-size: 0.875rem;
    color: var(--color-ink-subtle);
  }
  .hx-demo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    font-weight: 600;
    color: var(--color-brand-cyan);
    text-decoration: none;
    border-radius: var(--radius-chip);
    transition: color var(--dur-fast, 0.15s) ease;
  }
  .hx-demo-link:hover {
    color: var(--color-ink);
  }
  .hx-demo-link:focus-visible {
    outline: 2px solid var(--color-brand-cyan);
    outline-offset: 2px;
  }
  .hx-demo-link svg {
    width: 1rem;
    height: 1rem;
  }
  @media (max-width: 479px) {
    .hx-field {
      grid-template-columns: 4.25rem minmax(0, 1fr);
    }
    .hx-body {
      padding: 1rem;
    }
    /* Reserve the bottom strip for the overlay pill so it never covers text. */
    .hx-editor {
      min-height: 12rem;
      padding-bottom: 4.5rem;
    }
    .hx-overlay {
      margin-top: -5.5rem;
      margin-bottom: 1.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hx-caret {
      animation: none;
    }
  }
</style>

<script>
  import { OverlayDemo, type OverlayDemoLang } from '../scripts/overlay-demo';
  import type { OverlayTheme } from '../scripts/overlay-mockup';

  // Same driver as the demo section: animates only while the hero is on
  // screen, follows theme + language, frozen frame under reduced motion.
  const figure = document.querySelector<HTMLElement>('[data-testid="hero-example"]');
  const canvas = figure?.querySelector<HTMLCanvasElement>('.hx-overlay-canvas');
  if (figure && canvas) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const getTheme = (): OverlayTheme =>
      document.documentElement.classList.contains('light') ? 'light' : 'dark';
    const getLang = (): OverlayDemoLang => {
      const htmlLang = document.documentElement.lang;
      return htmlLang === 'de' || htmlLang === 'ru' ? htmlLang : 'en';
    };
    const demo = new OverlayDemo({ canvas, reducedMotion, getTheme, getLang });
    demo.resize();
    demo.drawFrozen();
    window.addEventListener('resize', () => {
      demo.resize();
      if (!demo.running) demo.drawFrozen();
    });
    new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) demo.start();
          else demo.stop();
        }
      },
      { threshold: 0.2 },
    ).observe(figure);
  }
</script>
