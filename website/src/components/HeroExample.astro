---
/**
 * Hero visual and the page's one "how it works": an e-mail window that plays
 * the three steps in a loop — 01 the hotkey (the keycap sticker is pressed,
 * the field waits), 02 speaking (the app's real recording overlay, canvas),
 * 03 the text lands in the field. The finished text is the first frame (and
 * the no-JS / reduced-motion state), so it is readable at once and stays the
 * LCP element. The step bar under the window shows the progress and lets the
 * visitor pick a step. The window itself is decorative: no form controls.
 */
import { t, currentLocale } from '../scripts/i18n.ts';

const lang = currentLocale(Astro.currentLocale);

// Step length (ms): one loop takes ~6.5 s, short enough to watch in full.
// Step 2 matches the overlay's recording + transcribing phases and step 3
// its "inserted" phase (HERO_PHASE_MS in the script below).
const steps = [
  { n: 1, label: 'appdemo.step1.caption', ms: 1200 },
  { n: 2, label: 'appdemo.step2.caption', ms: 2900 },
  { n: 3, label: 'appdemo.step3.caption', ms: 2400 },
] as const;
---

<figure class="hx" data-testid="hero-example" data-step="3">
  <div class="hx-frame">
  <div class="hx-window" role="img" aria-labelledby="hero-example-caption">
    <div class="hx-titlebar" aria-hidden="true">
      <span class="hx-title" data-i18n="hero.example.label">{t(lang, 'hero.example.label')}</span>
      <span class="hx-dots"><i></i><i></i><i></i></span>
    </div>
    <div class="hx-body" aria-hidden="true">
      <div class="hx-field">
        <span class="hx-field-label" data-i18n="hero.example.to">{t(lang, 'hero.example.to')}</span>
        <span class="hx-field-value" data-i18n="hero.example.toValue">{t(lang, 'hero.example.toValue')}</span>
      </div>
      <div class="hx-field">
        <span class="hx-field-label" data-i18n="hero.example.subject">{t(lang, 'hero.example.subject')}</span>
        <span class="hx-field-value" data-i18n="hero.example.subjectValue">{t(lang, 'hero.example.subjectValue')}</span>
      </div>
      <div class="hx-editor">
        <p class="hx-text"><span class="hx-body-text" data-i18n="hero.example.body">{t(lang, 'hero.example.body')}</span><span class="hx-caret"></span></p>

      </div>
    </div>
  </div>
  <!-- The real recording pill (shared canvas renderer, the overlay the app
       shows), breaking out of the window's bottom-left corner towards the
       speaker in the photo: voice in, text out. Decorative here: the caption
       carries the meaning. -->
  <div class="hx-overlay" aria-hidden="true" data-testid="hero-recording-pill">
    <canvas class="hx-overlay-canvas" width="692" height="160"></canvas>
  </div>
  </div>
  <figcaption class="hx-caption">
    <span id="hero-example-caption" data-i18n="hero.example.caption">{t(lang, 'hero.example.caption')}</span>
    <ol class="hx-steps" aria-label={t(lang, 'appdemo.flowAria')} data-i18n-aria="appdemo.flowAria">
      {steps.map((s) => (
        <li style={`--hx-step-ms: ${s.ms}ms`}>
          <button
            type="button"
            class="hx-step"
            data-step-btn={s.n}
            aria-pressed={s.n === 3 ? 'true' : 'false'}
            data-testid={`hero-step-${s.n}`}
          >
            <span class="hx-num" aria-hidden="true">{`0${s.n}`}</span>
            <span class="hx-step-label" data-i18n={s.label}>{t(lang, s.label)}</span>
            <span class="hx-progress" aria-hidden="true"><i></i></span>
          </button>
        </li>
      ))}
    </ol>
  </figcaption>
</figure>

<style>
  .hx {
    margin: 0;
    width: 100%;
  }
  /* mockup-colours:start: the mail window imitates the depicted app */
  .hx-window {
    border-radius: var(--radius-surface);
    border: 1px solid color-mix(in srgb, var(--color-brand-cyan) 22%, transparent);
    background: color-mix(in srgb, var(--color-brand-card) 88%, transparent);
    box-shadow:
      var(--shadow-overlay),
      0 0 80px -20px color-mix(in srgb, var(--color-brand-cyan) 30%, transparent);
    overflow: hidden;
    text-align: left;
  }
  .hx-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--wp-space-4);
    padding: var(--wp-space-4) var(--wp-space-5);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    background: rgb(255 255 255 / 0.03);
  }
  .hx-title {
    font-weight: 600;
    font-size: var(--wp-font-size-md);
    color: var(--color-ink);
  }
  .hx-dots {
    display: inline-flex;
    gap: var(--wp-space-2);
  }
  .hx-dots i {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.18);
  }
  .hx-body {
    display: grid;
    gap: var(--wp-space-3);
    padding: var(--wp-space-5);
  }
  .hx-field {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    align-items: center;
    gap: var(--wp-space-3);
    font-size: var(--wp-font-size-md);
  }
  .hx-field-label {
    color: var(--color-ink-muted);
  }
  .hx-field-value {
    padding: var(--wp-space-2) var(--wp-space-3);
    border-radius: var(--radius-control);
    border: 1px solid rgb(255 255 255 / 0.1);
    color: var(--color-ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .hx-editor {
    margin-top: var(--wp-space-2);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--wp-space-6);
    min-height: 13rem;
    padding: var(--wp-space-4) var(--wp-space-5) var(--wp-space-12);
    border-radius: var(--radius-card);
    border: 1px solid rgb(255 255 255 / 0.1);
    background: rgb(11 18 42 / 0.45);
  }
  /* Steps 1 and 2: the field is empty and the caret blinks at its start
     (the text keeps its room, so the window never changes height). Step 3:
     auto-paste drops the whole reply in at once, like the app does, with a
     short paste highlight that fades out. */
  .hx-editor {
    position: relative;
  }
  .hx:is([data-step="1"], [data-step="2"]) .hx-body-text {
    visibility: hidden;
  }
  .hx:is([data-step="1"], [data-step="2"]) .hx-caret {
    position: absolute;
    top: calc(var(--wp-space-4) + 0.2em);
    left: var(--wp-space-5);
    margin: 0;
  }
  .hx[data-step="3"][data-js] .hx-body-text {
    border-radius: var(--wp-radius-chip);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    animation: hx-paste 1400ms var(--ease-flow) both;
  }
  @keyframes hx-paste {
    0% { background-color: color-mix(in srgb, var(--wp-accent-default) 32%, transparent); }
    100% { background-color: transparent; }
  }
  .hx-text {
    margin: 0;
    font-size: var(--wp-font-size-lead);
    line-height: 1.6;
    color: var(--color-ink);
  }
  /* mockup-colours:end */
  .hx-caret {
    display: inline-block;
    width: 2px;
    height: 1.15em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: var(--wp-accent-fill);
    animation: hx-blink 1.1s steps(1) infinite;
  }
  @keyframes hx-blink {
    50% { opacity: 0; }
  }
  .hx-frame {
    position: relative;
  }
  /* The pill hangs off the bottom-left corner, tilted like a sticker, and
     slides in from the left (from the speaker) whenever recording starts.
     Transform/opacity only. */
  .hx-overlay {
    position: absolute;
    left: calc(-1 * var(--wp-space-4));
    bottom: calc(-1 * var(--wp-space-8));
    rotate: -4deg;
    transform-origin: left center;
    pointer-events: none;
    transition:
      opacity var(--dur-slow) var(--ease-flow),
      translate var(--dur-slow) var(--ease-flow),
      rotate var(--dur-slow) var(--ease-flow);
  }
  .hx[data-pill="off"] .hx-overlay {
    opacity: 0;
    translate: calc(-1 * var(--wp-space-12)) 0;
    rotate: -10deg;
  }
  /* Fixed 346×80 logical canvas (scaled by dpr in JS); the renderer paints
     the pill's own shadow. */
  .hx-overlay-canvas {
    display: block;
    width: 300px;
    max-width: 82vw;
    height: auto;
  }
  @media (min-width: 1024px) {
    /* Next to the photo: reach across the gap into the speaker's half. */
    .hx-overlay {
      left: calc(-1 * var(--wp-space-24));
    }
    .hx-overlay-canvas {
      width: 340px;
    }
  }
  /* Clears the pill hanging below the window. */
  .hx-caption {
    margin-top: var(--wp-space-16);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--wp-space-2) var(--wp-space-5);
    font-size: var(--wp-font-size-sm);
    color: var(--color-ink-subtle);
  }
  /* ---- Step bar: amber numeral on the open step, cyan progress ---- */
  .hx-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--wp-space-2);
  }
  .hx-step {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--wp-space-2);
    width: 100%;
    min-height: 44px;
    padding: var(--wp-space-2) 0 var(--wp-space-3);
    border: 0;
    background: none;
    color: var(--wp-text-muted);
    font-size: var(--wp-font-size-sm);
    font-weight: 600;
    text-align: left;
    cursor: pointer;
    transition: color var(--dur-fast) ease;
  }
  .hx-step:hover,
  .hx-step[aria-pressed="true"] {
    color: var(--wp-text-primary);
  }
  .hx-step:focus-visible {
    outline: 2px solid var(--wp-focus-ring);
    outline-offset: 2px;
    border-radius: var(--wp-radius-chip);
  }
  .hx-num {
    flex-shrink: 0;
    padding: 0 var(--wp-space-1);
    border-radius: var(--wp-radius-chip);
    font-family: var(--font-mono);
    font-size: var(--wp-font-size-xs);
    font-weight: 700;
    border: 1px solid var(--wp-border-default);
    transition: color var(--dur-fast) ease, background-color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .hx-step[aria-pressed="true"] .hx-num {
    color: var(--wp-marker-text);
    background: var(--wp-marker-stroke);
    border-color: var(--wp-marker-stroke);
  }
  .hx-step-label {
    min-width: 0;
    line-height: 1.25;
  }
  .hx-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: var(--wp-radius-pill);
    background: var(--wp-border-default);
    overflow: hidden;
  }
  .hx-progress i {
    display: block;
    height: 100%;
    background: var(--wp-accent-default);
    transform: scaleX(0);
    transform-origin: left;
  }
  .hx-step[aria-pressed="true"] .hx-progress i {
    transform: scaleX(1);
  }
  .hx[data-autoplay] .hx-step[aria-pressed="true"] .hx-progress i {
    animation: hx-progress var(--hx-step-ms) linear both;
  }
  /* Off screen the story waits, so nobody misses the start. */
  .hx[data-autoplay][data-paused] .hx-step[aria-pressed="true"] .hx-progress i {
    animation-play-state: paused;
  }
  @keyframes hx-progress {
    from { transform: scaleX(0); }
  }
  @media (max-width: 479px) {
    .hx-field {
      grid-template-columns: 4.25rem minmax(0, 1fr);
    }
    .hx-body {
      padding: var(--wp-space-4);
    }
    .hx-editor {
      min-height: 11rem;
    }
  }
  @media (max-width: 479px) {
    .hx-step-label {
      font-size: var(--wp-font-size-xs);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hx-caret,
    .hx-body-text {
      animation: none !important;
    }
    .hx-overlay {
      transition: none;
    }
  }
</style>

<script>
  import { OverlayDemo, type OverlayDemoLang } from '../scripts/overlay-demo';
  import type { OverlayTheme } from '../scripts/overlay-mockup';

  // Step player: 3 (the finished text) → 1 → 2 → 3 … while on screen. The
  // open step's progress bar times it; its end opens the next step. A click
  // hands control to the visitor. The overlay only runs during speaking.
  const figure = document.querySelector<HTMLElement>('[data-testid="hero-example"]');
  const canvas = figure?.querySelector<HTMLCanvasElement>('.hx-overlay-canvas');
  if (figure && canvas) {
    const stage = figure.closest<HTMLElement>('[data-testid="hero-stage"]');
    const buttons = [...figure.querySelectorAll<HTMLButtonElement>('[data-step-btn]')];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const getTheme = (): OverlayTheme =>
      document.documentElement.classList.contains('light') ? 'light' : 'dark';
    const getLang = (): OverlayDemoLang => {
      const htmlLang = document.documentElement.lang;
      return htmlLang === 'de' || htmlLang === 'ru' ? htmlLang : 'en';
    };
    // Quick pace for the hero loop: speak 2 s, transcribe 0.9 s, then the
    // pill says "inserted" for the whole of step 3.
    const HERO_PHASE_MS = { recording: 2000, transcribing: 900, end: 2400 };
    const demo = new OverlayDemo({ canvas, reducedMotion, getTheme, getLang, phaseMs: HERO_PHASE_MS });
    demo.resize();
    demo.drawFrozen();
    window.addEventListener('resize', () => {
      demo.resize();
      if (!demo.running) demo.drawFrozen();
    });

    let step = 3;
    let inView = false;
    const autoplay = (): boolean => figure.dataset.autoplay !== undefined;

    const syncPill = (): void => {
      // Reduced motion keeps the still pill next to the finished text.
      const show = reducedMotion || (inView && (step === 2 || (step === 3 && autoplay() && demo.running)));
      if (show && step === 2 && !demo.running) demo.start();
      if (!show && demo.running) demo.stop();
      figure.dataset.pill = show ? 'on' : 'off';
    };

    const activate = (n: number): void => {
      step = n;
      figure.dataset.step = String(n);
      if (stage) stage.dataset.step = String(n);
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.stepBtn) === n)));
      // Every entry into speaking starts a fresh recording episode; step 3
      // keeps the running episode so the pill can say "inserted".
      if (n !== 3 && demo.running) demo.stop();
      syncPill();
    };

    figure.dataset.js = '';
    if (!reducedMotion) figure.dataset.autoplay = '';
    activate(3);

    figure.addEventListener('animationend', (e) => {
      if (!autoplay() || !(e.target instanceof HTMLElement) || !e.target.closest('.hx-progress')) return;
      activate((step % 3) + 1);
    });
    for (const b of buttons) {
      b.addEventListener('click', () => {
        delete figure.dataset.autoplay;
        activate(Number(b.dataset.stepBtn));
      });
    }

    new IntersectionObserver(
      (entries) => {
        for (const e of entries) inView = e.isIntersecting;
        if (inView) delete figure.dataset.paused;
        else figure.dataset.paused = '';
        syncPill();
      },
      { threshold: 0.2 },
    ).observe(figure);
  }
</script>
