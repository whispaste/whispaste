---
/**
 * "Read in your language" for blog posts: a plain form that opens Google
 * Translate's website view in a new tab. Nothing loads from Google until the
 * visitor submits it, so the page itself stays free of third-party requests.
 */
import { t, type Locale } from "../scripts/i18n.ts";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

// Language codes follow Google Translate; labels are endonyms.
const languages = [
  ["es", "Español"],
  ["pt", "Português"],
  ["fr", "Français"],
  ["it", "Italiano"],
  ["ru", "Русский"],
  ["zh-CN", "简体中文"],
  ["ja", "日本語"],
  ["ko", "한국어"],
  ["ar", "العربية"],
  ["hi", "हिन्दी"],
  ["tr", "Türkçe"],
  ["pl", "Polski"],
  ["nl", "Nederlands"],
  ["uk", "Українська"],
];
const pageUrl = new URL(Astro.url.pathname, "https://whispaste.de").href;
---

<form
  action="https://translate.google.com/translate"
  method="get"
  target="_blank"
  rel="noopener noreferrer"
  class="translate-form mt-8 rounded-2xl border border-white/[0.08] bg-white/[0.02] p-5"
  data-testid="blog-translate"
>
  <input type="hidden" name="sl" value={lang} />
  <input type="hidden" name="u" value={pageUrl} />
  <label for="blog-translate-lang" class="block text-sm font-semibold text-ink">{t(lang, "blog.translate.label")}</label>
  <div class="mt-3 flex flex-wrap items-center gap-3">
    <select id="blog-translate-lang" name="tl" class="rounded-lg border border-white/10 bg-brand-darker px-3 py-2 text-sm text-ink" data-testid="blog-translate-select">
      {languages.map(([code, name]) => <option value={code}>{name}</option>)}
    </select>
    <button type="submit" class="rounded-lg bg-brand-cyan px-4 py-2 text-sm font-semibold text-brand-darker transition-transform hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-cyan" data-testid="blog-translate-submit">{t(lang, "blog.translate.button")}</button>
  </div>
  <p class="mt-3 text-xs leading-relaxed text-ink-subtle">{t(lang, "blog.translate.note")}</p>
</form>
