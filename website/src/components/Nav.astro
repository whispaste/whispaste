---
import { t } from '../scripts/i18n.ts';
// Inline-tintable OS glyphs for the platform-adaptive Download CTA. Raw-imported
// so `fill="currentColor"` inherits the button's text color — an <img>-embedded
// SVG cannot do this. Same source/provenance as the hero badges
// (see website/public/os-icons/ATTRIBUTION.txt).
import appleIconRaw from '../../public/os-icons/apple.svg?raw';
import windowsIconRaw from '../../public/os-icons/windows.svg?raw';
import ubuntuIconRaw from '../../public/os-icons/ubuntu.svg?raw';

interface Props {
  variant?: "landing" | "subpage";
}
const { variant = "landing" } = Astro.props;

const lang = (Astro.currentLocale === 'en' ? 'en' : 'de') as 'de' | 'en';

// Locale-correct toggle target: clicking the language switch jumps the user
// from the DE-default URL to the matching `/en/...` URL (and vice versa).
// The toggle label also flips so the button reads the OTHER language.
const langToggleLabel = lang === 'de' ? 'EN' : 'DE';

// Top-nav anchors point at the canonical (in-page) IDs which exist on both
// the DE landing page (`/`) and the EN landing page (`/en/`). They're
// rendered identically server-side; no locale prefix needed here.

// Download link must match the active locale so the user stays
// on the same language without a stale-locale flip.
// The sponsor link was intentionally removed from the top nav (Issue #09 of
// the seo-overhaul sprint): Google was promoting `/sponsor/` as the most
// prominent brand sitelink even though only a tiny fraction of brand
// searchers actually intend to sponsor. The link is kept in the footer.
const downloadHref = lang === 'de' ? '/download/' : '/en/download/';
const backHref = lang === 'de' ? '/' : '/en/';
---

<nav
  id="site-nav"
  aria-label={t(lang, "nav.mainAria")}
  data-i18n-aria="nav.mainAria"
  class="fixed top-0 inset-x-0 z-50 px-4 pt-3 sm:pt-4 pointer-events-none"
>
  <div
    class={`nav-pill pointer-events-auto mx-auto px-5 sm:px-6 h-14 flex items-center justify-between rounded-2xl border border-white/[0.08] ${variant === "subpage" ? "max-w-4xl" : "max-w-6xl"}`}
  >
    <a
      href={variant === "subpage" ? backHref : "#"}
      class="flex shrink-0 items-center gap-2 text-white font-semibold tracking-tight"
    >
      <img
        src="/wordmark-dark.png"
        alt="WhisPaste"
        width="199"
        height="64"
        class="h-7 w-auto"
        fetchpriority="high"
      />
    </a>
    {/* Desktop-Link-Zeile erst ab lg (1024px): die volle Zeile braucht mit den
        deutschen Labels ~880px Min-Breite — ab sm (640px) eingeblendet quetschte
        sie sich zwischen 640–879px kaputt (zweizeiliges "Wie funktioniert's",
        kollabierte Lücken, CTA-Überlauf aus der Pill). 640–1023px nutzt jetzt
        das Kompakt-Muster: Hamburger + sichtbarer Download-CTA. */}
    {variant === "landing" && (
      <div class="hidden lg:flex flex-1 items-center justify-center gap-7 xl:gap-8 text-sm text-ink-muted">
        <a href="#app-paste-demo" class="hover:text-white transition-colors" data-i18n="nav.howitworks">{t(lang, "nav.howitworks")}</a>
        <a href="#engines" class="hover:text-white transition-colors" data-i18n="nav.engines">{t(lang, "nav.engines")}</a>
        <a href="#languages" class="hover:text-white transition-colors" data-i18n="nav.languages">{t(lang, "nav.languages")}</a>
        <a href="#faq" class="hover:text-white transition-colors" data-i18n="nav.faq">{t(lang, "nav.faq")}</a>
        <a href="#support" class="hover:text-white transition-colors" data-i18n="nav.support">{t(lang, "nav.support")}</a>
      </div>
    )}
    {/* Rechte Aktionsgruppe: Utilities (Sprache/Theme/GitHub) nur ab lg,
        der Download-CTA schon ab sm (640–1023px behält so die eine primäre
        Aktion sichtbar in der Pill), Hamburger bis unter lg. */}
    {variant === "landing" && (
      <div class="flex shrink-0 items-center gap-3 lg:gap-5 text-sm text-ink-muted">
      <div class="hidden lg:flex shrink-0 items-center gap-5 text-sm text-ink-muted">
        <button
          id="langToggle"
          data-testid="lang-toggle"
          aria-label={t(lang, "nav.switchLanguageAria")}
          data-i18n-aria="nav.switchLanguageAria"
          class="lang-toggle-btn text-ink-muted hover:text-white transition-colors text-sm font-medium"
        >{langToggleLabel}</button>
        <a href="https://github.com/whispaste/whispaste" target="_blank" rel="noopener" class="text-ink-muted hover:text-white transition-colors" aria-label="GitHub" title="GitHub">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6.02 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3"/></svg>
        </a>
        <span class="nav-divider" aria-hidden="true"></span>
      </div>
        <a href={downloadHref} class="nav-download-btn hidden sm:inline-flex items-center gap-1.5 px-4 py-1.5 text-sm font-semibold hover:scale-[1.02] active:scale-[0.98] transition-all">
          {/* Platform-adaptive label + icon. The detected OS (data-os on <html>,
              set before first paint in Layout.astro) picks the visible variant via
              CSS attribute selectors — no JS DOM manipulation, no flicker. Unknown
              OS falls back to the generic "Download" variant. Each variant's TEXT
              lives in its own <span data-i18n>, kept separate from the icon so
              applyLang()'s textContent writes never wipe the icon. */}
          <span class="nav-dl-variant items-center gap-1.5" data-dl-variant="generic">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            <span data-i18n="nav.download">{t(lang, "nav.download")}</span>
          </span>
          <span class="nav-dl-variant items-center gap-1.5" data-dl-variant="macos">
            <span class="nav-dl-icon inline-flex w-4 h-4 shrink-0" aria-hidden="true" set:html={appleIconRaw} />
            <span class="sr-only" data-i18n="nav.download">{t(lang, "nav.download")}</span>
            <span data-i18n="nav.download.macos">{t(lang, "nav.download.macos")}</span>
          </span>
          <span class="nav-dl-variant items-center gap-1.5" data-dl-variant="windows">
            <span class="nav-dl-icon inline-flex w-4 h-4 shrink-0" aria-hidden="true" set:html={windowsIconRaw} />
            <span class="sr-only" data-i18n="nav.download">{t(lang, "nav.download")}</span>
            <span data-i18n="nav.download.windows">{t(lang, "nav.download.windows")}</span>
          </span>
          <span class="nav-dl-variant items-center gap-1.5" data-dl-variant="linux">
            <span class="nav-dl-icon inline-flex w-4 h-4 shrink-0" aria-hidden="true" set:html={ubuntuIconRaw} />
            <span class="sr-only" data-i18n="nav.download">{t(lang, "nav.download")}</span>
            <span data-i18n="nav.download.linux">{t(lang, "nav.download.linux")}</span>
          </span>
        </a>
      {/* Statischer, lokalisierter Accessible Name ("Menü") + aria-expanded
          als Zustandsträger — vorher hartkodiert englisches "Open menu"/
          "Close menu" per JS-Swap, das auf der DE-Seite englisch blieb. */}
      <button
        id="mobileMenuBtn"
        class="lg:hidden text-ink-muted hover:text-white transition-colors p-1"
        aria-label={t(lang, "nav.menuAria")}
        data-i18n-aria="nav.menuAria"
        aria-expanded="false"
        aria-controls="mobileMenu"
      >
        <svg id="menuBtnIcon" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
      </button>
      </div>
    )}
    {variant === "subpage" && (
      <div class="flex items-center gap-4 text-sm text-ink-muted">
        <a href={backHref} class="hover:text-white transition-colors" data-i18n="nav.back">{t(lang, "nav.back")}</a>
        <button
          id="langToggle"
          data-testid="lang-toggle"
          aria-label={t(lang, "nav.switchLanguageAria")}
          data-i18n-aria="nav.switchLanguageAria"
          class="lang-toggle-btn text-ink-muted hover:text-white transition-colors font-medium"
        >{langToggleLabel}</button>
      </div>
    )}
  </div>
  {variant === "landing" && (
    <div id="mobileMenu" class="lg:hidden hidden pointer-events-auto mx-auto mt-2 max-w-6xl rounded-2xl border border-white/[0.08] overflow-hidden">
      <div class="px-5 py-3 flex flex-col">
        <a href="#app-paste-demo" class="mobile-nav-link block py-3 text-ink-muted hover:text-white transition-colors text-[15px]" data-i18n="nav.howitworks">{t(lang, "nav.howitworks")}</a>
        <a href="#engines" class="mobile-nav-link block py-3 text-ink-muted hover:text-white transition-colors text-[15px] border-t border-white/[0.04]" data-i18n="nav.engines">{t(lang, "nav.engines")}</a>
        <a href="#languages" class="mobile-nav-link block py-3 text-ink-muted hover:text-white transition-colors text-[15px] border-t border-white/[0.04]" data-i18n="nav.languages">{t(lang, "nav.languages")}</a>
        <a href="#faq" class="mobile-nav-link block py-3 text-ink-muted hover:text-white transition-colors text-[15px] border-t border-white/[0.04]" data-i18n="nav.faq">{t(lang, "nav.faq")}</a>
        <a href="#support" class="mobile-nav-link block py-3 text-ink-muted hover:text-white transition-colors text-[15px] border-t border-white/[0.04]" data-i18n="nav.support">{t(lang, "nav.support")}</a>
        <div class="flex items-center gap-5 py-3 border-t border-white/[0.04]">
          <button id="mobileLangToggle" class="lang-toggle-btn text-ink-muted hover:text-white transition-colors text-sm font-medium" aria-label={t(lang, "nav.switchLanguageAria")} data-i18n-aria="nav.switchLanguageAria">{langToggleLabel}</button>
          <a href="https://github.com/whispaste/whispaste" target="_blank" rel="noopener" class="text-ink-muted hover:text-white transition-colors" aria-label="GitHub">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6.02 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3"/></svg>
          </a>
        </div>
        <a href={downloadHref} class="nav-download-btn mobile-nav-link flex items-center justify-center gap-2 mt-1 mb-1 px-6 py-3 font-semibold transition-all active:scale-[0.98]">
          {/* Platform-adaptive label + icon — mirrors the desktop CTA above. */}
          <span class="nav-dl-variant items-center justify-center gap-2" data-dl-variant="generic">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            <span data-i18n="nav.download">{t(lang, "nav.download")}</span>
          </span>
          <span class="nav-dl-variant items-center justify-center gap-2" data-dl-variant="macos">
            <span class="nav-dl-icon inline-flex w-4 h-4 shrink-0" aria-hidden="true" set:html={appleIconRaw} />
            <span class="sr-only" data-i18n="nav.download">{t(lang, "nav.download")}</span>
            <span data-i18n="nav.download.macos">{t(lang, "nav.download.macos")}</span>
          </span>
          <span class="nav-dl-variant items-center justify-center gap-2" data-dl-variant="windows">
            <span class="nav-dl-icon inline-flex w-4 h-4 shrink-0" aria-hidden="true" set:html={windowsIconRaw} />
            <span class="sr-only" data-i18n="nav.download">{t(lang, "nav.download")}</span>
            <span data-i18n="nav.download.windows">{t(lang, "nav.download.windows")}</span>
          </span>
          <span class="nav-dl-variant items-center justify-center gap-2" data-dl-variant="linux">
            <span class="nav-dl-icon inline-flex w-4 h-4 shrink-0" aria-hidden="true" set:html={ubuntuIconRaw} />
            <span class="sr-only" data-i18n="nav.download">{t(lang, "nav.download")}</span>
            <span data-i18n="nav.download.linux">{t(lang, "nav.download.linux")}</span>
          </span>
        </a>
      </div>
    </div>
  )}
</nav>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var siteNav = document.getElementById('site-nav');
    if (siteNav) {
      var onNavScroll = function () {
        siteNav.setAttribute('data-scrolled', window.scrollY > 8 ? 'true' : 'false');
      };
      onNavScroll();
      window.addEventListener('scroll', function () {
        requestAnimationFrame(onNavScroll);
      }, { passive: true });
    }
    document.getElementById('langToggle')?.addEventListener('click', function () {
      if (typeof toggleLang === 'function') toggleLang();
    });
    document.getElementById('mobileLangToggle')?.addEventListener('click', function () {
      if (typeof toggleLang === 'function') toggleLang();
    });
    var menuBtn = document.getElementById('mobileMenuBtn');
    var mobileMenu = document.getElementById('mobileMenu');
    var menuIcon = document.getElementById('menuBtnIcon');
    var hamburgerSVG = '<line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/>';
    var closeSVG = '<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>';
    if (menuBtn && mobileMenu) {
      menuBtn.addEventListener('click', function () {
        var isOpen = !mobileMenu.classList.contains('hidden');
        mobileMenu.classList.toggle('hidden');
        menuBtn.setAttribute('aria-expanded', String(!isOpen));
        if (menuIcon) menuIcon.innerHTML = isOpen ? hamburgerSVG : closeSVG;
      });
      mobileMenu.querySelectorAll('.mobile-nav-link').forEach(function (link) {
        link.addEventListener('click', function () {
          mobileMenu.classList.add('hidden');
          menuBtn.setAttribute('aria-expanded', 'false');
          if (menuIcon) menuIcon.innerHTML = hamburgerSVG;
        });
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
          mobileMenu.classList.add('hidden');
          menuBtn.setAttribute('aria-expanded', 'false');
          if (menuIcon) menuIcon.innerHTML = hamburgerSVG;
          menuBtn.focus();
        }
      });
    }
  });
</script>

<style>
  /* Flat opaque pill: the app's own floating-chrome material
     (WpColorsDark.floatingSurface — dialogs/toasts/popups, not the page's
     own card fill), no glass. On scroll the pill condenses + darkens
     slightly (same shrink-on-scroll behaviour as before, without relying on
     blur for legibility). */
  #site-nav .nav-pill {
    position: relative;
    background-color: var(--color-brand-floating);
    box-shadow: var(--shadow-overlay);
    transition: background-color 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease,
      height 0.3s var(--ease-flow);
  }
  #site-nav[data-scrolled="true"] .nav-pill {
    background-color: color-mix(in srgb, var(--color-brand-floating) 80%, var(--color-brand-darker));
    border-color: rgba(255, 255, 255, 0.12);
    height: 3rem;
  }
  @media (prefers-reduced-motion: reduce) {
    #site-nav .nav-pill {
      transition: none;
    }
  }

  /* Thin vertical divider that separates the utility icons from the primary
     Download CTA — mirrors the competitor's nav grouping. */
  #site-nav .nav-divider {
    width: 1px;
    height: 1.25rem;
    background-color: rgba(255, 255, 255, 0.12);
    flex: 0 0 auto;
  }

  /* Primary Download CTA — same opaque accent gradient as AppleButton/
     StoreButton/LinuxButton/MobileCta, not a separate dark "glass"
     treatment. Nav's CTA is the same download action as those. Pill radius
     and dark text: see StoreButton.astro — a fixed 14px corner reads as a
     rectangle at this compact height while looking pill-like on the taller
     --lg hero buttons, and white text measures under WCAG AA against the
     gradient's light-cyan stop. */
  .nav-download-btn {
    border-radius: var(--radius-pill);
    background: var(--gradient-accent-cta);
    color: var(--color-brand-darker);
  }
  .nav-download-btn:hover {
    box-shadow: var(--shadow-pill);
  }

  #mobileMenu {
    position: relative;
    background: var(--color-brand-floating);
    box-shadow: var(--shadow-overlay);
  }
</style>
