---
interface Props {
  variant?: "landing" | "subpage";
}
const { variant = "landing" } = Astro.props;
---

<nav
  aria-label="Main navigation"
  data-i18n-aria="nav.mainAria"
  class="fixed top-0 w-full z-50 bg-brand-darker/40 backdrop-blur-2xl backdrop-saturate-150 border-b border-white/[0.06]"
>
  <div
    class={`mx-auto px-6 h-14 flex items-center justify-between ${variant === "subpage" ? "max-w-4xl" : "max-w-6xl"}`}
  >
    <a
      href={variant === "subpage" ? "/" : "#"}
      class="flex items-center gap-2 text-white font-semibold tracking-tight"
    >
      <img
        id="navLogo"
        src="/app-icon-dark.png"
        alt="WhisPaste"
        class="w-8 h-8"
      />
      <span class="text-lg font-semibold tracking-tight">WhisPaste</span>
    </a>
    {
      variant === "landing" ? (
        <div class="hidden sm:flex items-center gap-6 text-sm text-gray-400">
          <a
            href="#how-it-works"
            class="hover:text-white transition-colors"
            data-i18n="nav.howitworks"
          >
            How It Works
          </a>
          <a
            href="#pricing"
            class="hover:text-white transition-colors"
            data-i18n="nav.pricing"
          >
            Pricing
          </a>
          <a
            href="#faq"
            class="hover:text-white transition-colors"
            data-i18n="nav.faq"
          >
            FAQ
          </a>
          <button
            id="langToggle"
            data-testid="lang-toggle"
            aria-label="Switch language"
            data-i18n-aria="nav.switchLanguageAria"
            class="text-gray-400 hover:text-white transition-colors text-sm font-medium"
          >
            DE
          </button>
          <button
            id="themeToggle"
            aria-label="Toggle theme"
            data-i18n-aria="nav.toggleThemeAria"
            class="text-gray-400 hover:text-white transition-colors"
            title="Toggle theme"
            data-i18n-title="nav.toggleThemeTitle"
          >
            <svg
              id="themeIcon"
              class="w-5 h-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
          </button>
          <a
            href="/download/"
            class="inline-flex items-center gap-1.5 px-4 py-1.5 bg-brand-cyan text-brand-darker text-sm font-semibold rounded-lg hover:scale-[1.02] active:scale-[0.98] transition-all shadow-[0_0_16px_rgba(34,211,238,0.2)]"
            data-i18n="nav.download"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            Download
          </a>
        </div>
      ) : (
        <div class="flex items-center gap-4 text-sm text-gray-400">
          <a href="/" class="hover:text-white transition-colors" data-i18n="nav.back">
            &larr; Back
          </a>
          <button
            id="langToggle"
            data-testid="lang-toggle"
            aria-label="Switch language"
            data-i18n-aria="nav.switchLanguageAria"
            class="text-gray-400 hover:text-white transition-colors font-medium"
          >
            DE
          </button>
          <button
            id="themeToggle"
            aria-label="Toggle theme"
            data-i18n-aria="nav.toggleThemeAria"
            class="text-gray-400 hover:text-white transition-colors"
            title="Toggle theme"
            data-i18n-title="nav.toggleThemeTitle"
          >
            <svg
              id="themeIcon"
              class="w-5 h-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
          </button>
        </div>
      )
    }
  </div>
</nav>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    document.getElementById('langToggle')?.addEventListener('click', function () {
      if (typeof toggleLang === 'function') toggleLang();
    });
    document.getElementById('themeToggle')?.addEventListener('click', function () {
      if (typeof toggleTheme === 'function') toggleTheme();
    });
  });
</script>

<style>
  /* Apple-style frosted glass gradient glare */
  nav::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255,255,255,0.04) 0%, transparent 60%);
    pointer-events: none;
  }
  :global(.light) nav::before {
    background: linear-gradient(180deg, rgba(255,255,255,0.5) 0%, transparent 60%);
  }
</style>
