---
// AppleButton.astro — Brand-consistent macOS DMG download button.
// Mirrors StoreButton layout/sizing for visual parity in the Hero row.
// URL sourced exclusively from the central platform config.
import { t } from '../scripts/i18n.ts';
import { MACOS_DMG_URL, STORES } from '../data/platforms.ts';

interface Props {
  size?: 'default' | 'lg';
  class?: string;
}

const DMG_URL = MACOS_DMG_URL;

const { size = 'default', class: className = '' } = Astro.props;
const isLarge = size === 'lg';

const lang = (Astro.currentLocale === 'en' ? 'en' : 'de') as 'de' | 'en';

// Architecture label — single source of truth. The config
// (`STORES.macos.archLabel`) is the "is there an arch label?" fact; the
// visible, translated text comes from the i18n key `platform.macos.archLabel`.
// Rendered only when the config declares a non-empty label, so Windows/Linux
// (empty archLabel) never get an empty badge.
const archLabel = STORES.macos.archLabel ? t(lang, 'platform.macos.archLabel') : '';
---

<a
  href={DMG_URL}
  onclick="document.dispatchEvent(new CustomEvent('download:triggered', { bubbles: true }));"
  class:list={[
    'wp-apple-btn',
    { 'wp-apple-btn--lg': isLarge },
    className,
  ]}
  data-testid="apple-button"
>
  <!-- Apple logo -->
  <svg class="wp-apple-btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
  </svg>

  {isLarge ? (
    <span class="wp-apple-btn__text">
      <span class="wp-apple-btn__label" data-i18n="hero.download.macos.hint">{t(lang, "hero.download.macos.hint")}</span>
      <span class="wp-apple-btn__platform-row">
        <span class="wp-apple-btn__platform" data-i18n="hero.download.macos.platform">{t(lang, "hero.download.macos.platform")}</span>
        {archLabel && (
          <span class="wp-apple-btn__arch" data-i18n="platform.macos.archLabel">{archLabel}</span>
        )}
      </span>
    </span>
  ) : (
    <span class="wp-apple-btn__text">
      <span data-i18n="hero.download.macos">{t(lang, "hero.download.macos")}</span>
      {archLabel && (
        <span class="wp-apple-btn__arch" data-i18n="platform.macos.archLabel">{archLabel}</span>
      )}
    </span>
  )}
</a>

<style>
  .wp-apple-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 1.5rem;
    min-height: 44px;
    border-radius: var(--radius-pill);
    background: var(--gradient-accent-cta);
    /* Dark, not white: white text measures ~1.6:1 against the gradient's
       light-cyan stop (#6FDDF0) — well under WCAG AA's 4.5:1. Dark navy
       clears >6:1 across the whole gradient, matching the __label span
       below which already uses dark text for the same reason. */
    color: var(--color-brand-darker);
    text-decoration: none;
    transition: transform var(--dur-base) var(--ease-flow),
      box-shadow var(--dur-base) var(--ease-flow);
    cursor: pointer;
  }

  .wp-apple-btn:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-pill);
  }

  .wp-apple-btn:active {
    transform: translateY(0);
    box-shadow: var(--shadow-pill-active);
  }

  .wp-apple-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  /* Large variant — same accent-gradient CTA as StoreButton's `--lg`, just
     bigger, so the three primary Hero/Download CTAs read as one family. */
  .wp-apple-btn--lg {
    padding: 0.75rem 2rem;
    min-height: 52px;
    gap: 0.875rem;
  }

  .wp-apple-btn--lg:hover {
    transform: translateY(-2px);
  }

  /* Icon sizes mirror StoreButton/LinuxButton exactly (1.25rem default,
     1.5rem in --lg) so the three equal-rank platform CTAs carry identically
     sized glyphs — the former 1.875rem Apple icon read 25% larger than its
     Windows/Linux siblings. */
  .wp-apple-btn__icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    color: var(--color-brand-darker);
  }

  .wp-apple-btn--lg .wp-apple-btn__icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  .wp-apple-btn__text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  /* Default: single line */
  .wp-apple-btn:not(.wp-apple-btn--lg) .wp-apple-btn__text {
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  /* Large: two lines */
  .wp-apple-btn--lg .wp-apple-btn__label {
    font-size: 0.75rem;
    font-weight: 400;
    color: color-mix(in srgb, var(--color-brand-darker) 68%, transparent);
    letter-spacing: 0.01em;
  }

  .wp-apple-btn__platform-row {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .wp-apple-btn--lg .wp-apple-btn__platform {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-brand-darker);
  }

  /* Architecture badge — subtle, clearly separate from the platform name */
  .wp-apple-btn__arch {
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-chip);
    color: color-mix(in srgb, var(--color-brand-darker) 85%, transparent);
    background: color-mix(in srgb, var(--color-brand-darker) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-brand-darker) 18%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .wp-apple-btn {
      transition: none;
    }
    .wp-apple-btn:hover {
      transform: none;
    }
  }
</style>
