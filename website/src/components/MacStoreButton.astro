---
// MacStoreButton.astro — Brand-consistent Mac App Store download button.
// Mirrors StoreButton.astro (Microsoft Store) layout/sizing/behaviour exactly
// — same two-tier pattern: this is the primary/recommended CTA for macOS,
// AppleButton.astro (direct DMG) is the secondary/free path.
// Astro scopes <style> per component, so the CSS below is a deliberate
// duplicate of StoreButton's — reusing its class names would not apply here.
// URL sourced exclusively from the central platform config.
import { t } from '../scripts/i18n.ts';
import { MAC_APP_STORE_URL } from '../data/platforms.ts';

interface Props {
  size?: 'default' | 'lg';
  class?: string;
}

const STORE_URL = MAC_APP_STORE_URL;

const { size = 'default', class: className = '' } = Astro.props;
const isLarge = size === 'lg';

const lang = (Astro.currentLocale === 'en' ? 'en' : 'de') as 'de' | 'en';
---

<a
  href={STORE_URL}
  target="_blank"
  rel="noopener"
  onclick="document.dispatchEvent(new CustomEvent('download:triggered', { bubbles: true }));"
  class:list={[
    'wp-mac-store-btn',
    { 'wp-mac-store-btn--lg': isLarge },
    className,
  ]}
  data-testid="mac-store-button"
>
  <!-- Apple logo -->
  <svg class="wp-mac-store-btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
  </svg>

  {isLarge ? (
    <span class="wp-mac-store-btn__text">
      <span class="wp-mac-store-btn__label" data-i18n="store.btn.getfrom">{t(lang, "store.btn.getfrom")}</span>
      <span class="wp-mac-store-btn__store" data-i18n="store.btn.appstore">{t(lang, "store.btn.appstore")}</span>
    </span>
  ) : (
    <span class="wp-mac-store-btn__text">
      <span data-i18n="store.btn.singleMac">{t(lang, "store.btn.singleMac")}</span>
    </span>
  )}
  <span class="sr-only" data-i18n="common.opensNewTab">{t(lang, "common.opensNewTab")}</span>
</a>

<style>
  .wp-mac-store-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 1.5rem;
    min-height: 44px;
    border-radius: var(--radius-pill);
    background: var(--gradient-accent-cta);
    /* Dark, not white: white text measures ~1.6:1 against the gradient's
       light-cyan stop (#6FDDF0) — well under WCAG AA's 4.5:1. Dark navy
       clears >6:1 across the whole gradient, matching the __label span
       below which already uses dark text for the same reason. */
    color: var(--color-brand-darker);
    text-decoration: none;
    transition: transform var(--dur-base) var(--ease-flow),
      box-shadow var(--dur-base) var(--ease-flow);
    cursor: pointer;
  }

  .wp-mac-store-btn:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-pill);
  }

  .wp-mac-store-btn:active {
    transform: translateY(0);
    box-shadow: var(--shadow-pill-active);
  }

  .wp-mac-store-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  /* Large variant (Hero, Download page) — same accent-gradient CTA as
     StoreButton's --lg, just bigger. */
  .wp-mac-store-btn--lg {
    padding: 0.75rem 2rem;
    min-height: 52px;
    gap: 0.875rem;
  }

  .wp-mac-store-btn--lg:hover {
    transform: translateY(-2px);
  }

  .wp-mac-store-btn__icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    color: var(--color-brand-darker);
  }

  .wp-mac-store-btn--lg .wp-mac-store-btn__icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  .wp-mac-store-btn__text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  /* Default: single line */
  .wp-mac-store-btn:not(.wp-mac-store-btn--lg) .wp-mac-store-btn__text {
    flex-direction: row;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  /* Large: two lines */
  .wp-mac-store-btn--lg .wp-mac-store-btn__label {
    font-size: 0.75rem;
    font-weight: 400;
    color: color-mix(in srgb, var(--color-brand-darker) 68%, transparent);
    letter-spacing: 0.01em;
  }

  .wp-mac-store-btn--lg .wp-mac-store-btn__store {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-brand-darker);
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .wp-mac-store-btn {
      transition: none;
    }
    .wp-mac-store-btn:hover {
      transform: none;
    }
  }
</style>
