---
import StoreButton from './StoreButton.astro';
import MacStoreButton from './MacStoreButton.astro';
import LinuxButton from './LinuxButton.astro';
import SectionEyebrow from './SectionEyebrow.astro';
import StorePerks from './StorePerks.astro';
import { t, localePath, currentLocale } from '../scripts/i18n.ts';

const lang = currentLocale(Astro.currentLocale);

const features = ['offline', 'snippets', 'smartmode', 'sidepanel', 'gpu', 'history', 'updates', 'opensource'] as const;

---

<!-- Pricing: what you get (one product, free on GitHub, MIT) next to how to
     get it. The OS store button stays the primary action (maintainer
     decision); the free GitHub route and all other downloads are the
     secondary link. No extra CTA band. -->
<section id="pricing" class="band band-raised relative wp-section scroll-mt-20" data-testid="pricing">
  <div class="relative wp-container">
    <div class="wp-section-head">
      <SectionEyebrow key="pricing.label" />
      <h2 class="section-title"><span data-i18n="pricing.titleLead">{t(lang, "pricing.titleLead")}</span><span class="text-gradient-brand" data-i18n="pricing.titleAccent">{t(lang, "pricing.titleAccent")}</span><span data-i18n="pricing.titleTail">{t(lang, "pricing.titleTail")}</span></h2>
      <p class="wp-lead mt-4" data-i18n="pricing.desc">{t(lang, "pricing.desc")}</p>
    </div>

    <div class="price-grid">
      <div class="price-core">
        <p class="price-core__price text-gradient-brand wp-nums" data-i18n="pricing.price">{t(lang, "pricing.price")}</p>
        <p class="price-core__license" data-i18n="pricing.forever">{t(lang, "pricing.forever")}</p>
        <ul class="price-chips">
          {(["noSub", "noAccount", "noTrial"] as const).map((k) => (
            <li><span data-i18n={`pricing.${k}`}>{t(lang, `pricing.${k}`)}</span></li>
          ))}
        </ul>
        <ul class="price-features">
          {features.map((key) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>
              <span data-i18n={`pricing.feature.${key}`}>{t(lang, `pricing.feature.${key}`)}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="price-get">
        <h3 class="price-get__title" data-i18n="pricing.get.title">{t(lang, "pricing.get.title")}</h3>
        <!-- Platform-adaptive store button, same gate as the hero. -->
        <div class="price-get__buttons">
          <div data-platform-btn="windows" data-testid="pricing-microsoft-store"><StoreButton /></div>
          <div data-platform-btn="macos" data-testid="pricing-mac-store"><MacStoreButton /></div>
          <div data-platform-btn="linux"><LinuxButton /></div>
        </div>
        <div data-requires-os="windows macos" class="price-get__perks">
          <StorePerks testid="pricing-store-hint" />
        </div>
        <a href={localePath(lang, "download")} class="price-get__free" data-testid="pricing-free">
          <span data-i18n="hero.cta.secondary">{t(lang, "hero.cta.secondary")}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .price-grid {
    display: grid;
    gap: var(--wp-space-4);
  }
  @media (min-width: 1024px) {
    .price-grid {
      grid-template-columns: 7fr 5fr;
      gap: var(--wp-space-6);
    }
  }
  .price-core,
  .price-get {
    padding: var(--wp-space-6);
    border-radius: var(--radius-surface);
    border: 1px solid var(--wp-border-default);
    background: var(--color-brand-card);
    box-shadow: var(--shadow-card);
  }
  @media (min-width: 1024px) {
    .price-core,
    .price-get { padding: 2.5rem; }
  }
  .price-core {
    border-color: color-mix(in srgb, var(--color-brand-cyan) 30%, transparent);
  }
  .price-core__price {
    font-size: var(--wp-font-size-title);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .price-core__license {
    margin-top: var(--wp-space-2);
    font-size: var(--wp-font-size-md);
    color: var(--color-ink-muted);
  }
  .price-chips {
    list-style: none;
    margin: var(--wp-space-5) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--wp-space-2);
  }
  .price-chips li {
    padding: var(--wp-space-1) var(--wp-space-3);
    border-radius: var(--radius-pill);
    border: 1px solid var(--wp-border-default);
    background: var(--wp-surface-control);
    font-size: var(--wp-font-size-sm);
    font-weight: 500;
    color: var(--color-ink-muted);
  }
  .price-features {
    list-style: none;
    margin: var(--wp-space-6) 0 0;
    padding: var(--wp-space-6) 0 0;
    border-top: 1px solid var(--wp-border-default);
    display: grid;
    gap: var(--wp-space-3) var(--wp-space-8);
  }
  @media (min-width: 640px) {
    .price-features { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .price-features li {
    display: flex;
    align-items: flex-start;
    gap: var(--wp-space-3);
    font-size: var(--wp-font-size-md);
    color: var(--color-ink-muted);
  }
  .price-features svg {
    width: 1rem;
    height: 1rem;
    margin-top: var(--wp-space-1);
    flex-shrink: 0;
    color: var(--color-brand-cyan);
  }

  .price-get {
    display: flex;
    flex-direction: column;
    gap: var(--wp-space-4);
  }
  .price-get__title {
    font-size: var(--type-card-title);
    font-weight: 600;
    color: var(--color-ink);
  }
  .price-get__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--wp-space-3);
  }
  .price-get__perks {
    padding-top: var(--wp-space-5);
    border-top: 1px solid var(--wp-border-default);
  }
  .price-get__free {
    display: inline-flex;
    align-items: center;
    gap: var(--wp-space-1);
    min-height: 44px;
    margin-top: auto;
    padding-top: var(--wp-space-4);
    border-top: 1px solid var(--wp-border-default);
    font-size: var(--wp-font-size-md);
    font-weight: 600;
    color: var(--color-brand-cyan);
    text-decoration: none;
  }
  .price-get__free svg { width: 1rem; height: 1rem; flex-shrink: 0; }
  .price-get__free:hover span { text-decoration: underline; }
</style>
