---
import StoreButton from './StoreButton.astro';
import MacStoreButton from './MacStoreButton.astro';
import LinuxButton from './LinuxButton.astro';
import SectionEyebrow from './SectionEyebrow.astro';
import { t } from '../scripts/i18n.ts';

const lang = (Astro.currentLocale === 'en' ? 'en' : 'de') as 'de' | 'en';

const FEATURE_ICON = `<svg class="w-4 h-4 text-brand-cyan shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>`;

const features = [
  { key: 'offline' },
  { key: 'snippets' },
  { key: 'gpu' },
  { key: 'history' },
  { key: 'updates' },
  { key: 'opensource' },
];
---

<!-- Pricing Section -->
<section id="pricing" class="band band-raised py-24 sm:py-32 relative scroll-mt-20">
  <!-- Decorative context motif: a heart — "free, given freely / open source".
       Theme-adaptive (brand token), faint, non-interactive.
       Eigener overflow:hidden-Wrapper statt auf der Section: .pricing-card
       trägt weiter unten eine eigene view-timeline-name (Preis-Aufzug +
       HUD-Latch) — ein overflow:hidden auf der Section wäre deren nächster
       Scroll-Container und würde die Timeline für immer auf einem
       Fix-Progress einfrieren (derselbe Fehlermodus wie .wp-recede,
       s. SpeedComparison.astro). Der Wrapper hier ist ein Geschwister der
       Karte, nicht ihr Vorfahre, und bleibt damit außen vor. -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div
      class="absolute left-1/2 top-10 -translate-x-1/2 text-brand-cyan opacity-[0.11]"
    >
      <svg width="260" height="240" viewBox="0 0 240 220" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M190 130c14.9-14.6 30-32.1 30-55A55 55 0 0 0 165 20c-17.6 0-30 5-45 20-15-15-27.4-20-45-20A55 55 0 0 0 20 75c0 22.9 15.1 40.4 30 55l70 70Z" />
      </svg>
    </div>
  </div>
  <div class="relative max-w-3xl mx-auto px-6">
    <div class="text-center mb-12 scroll-reveal">
      <SectionEyebrow key="pricing.label" />
      <h2 class="section-title"><span data-i18n="pricing.titleLead">{t(lang, "pricing.titleLead")}</span><span class="text-gradient-brand" data-i18n="pricing.titleAccent">{t(lang, "pricing.titleAccent")}</span><span data-i18n="pricing.titleTail">{t(lang, "pricing.titleTail")}</span></h2>
      <p class="mt-4 text-ink-muted text-lg max-w-2xl mx-auto" data-i18n="pricing.desc">{t(lang, "pricing.desc")}</p>
    </div>

    <!-- Radius NICHT per rounded-*-Utility: der unlayered .pricing-card-Block
         in global.css schlägt jede Utility (unlayered > @layer), die Karte lief
         damit auf 14px, während das Gradient-Overlay auf rounded-3xl (24px)
         stand — das Overlay erreichte die echten Kartenecken nie. Die Karte
         nimmt jetzt den Token-Radius aus global.css, das Overlay erbt ihn. -->
    <!-- `hud-frame`: HUD-Eckwinkel (global.css) — die Preis-Karte ist die
         primäre Handlungsfläche der Startseite und trägt deshalb dort als
         einzige Karte die Klammer-Signatur. Zweiter und letzter Einsatzort
         site-weit sind die drei OS-Karten auf /download/. -->
    <div class="pricing-card hud-frame wp-mask-reveal wp-mask-reveal--up relative p-8 sm:p-10 border border-brand-cyan/20">
      <div class="absolute inset-0 rounded-[inherit] bg-gradient-to-br from-brand-cyan/[0.04] to-transparent pointer-events-none"></div>
      <div class="relative">
        <div class="text-center mb-8">
          <div class="pricing-price-in text-gradient-brand wp-nums text-4xl sm:text-5xl font-bold tracking-tight" data-i18n="pricing.price">{t(lang, "pricing.price")}</div>
          <div class="mt-2 text-ink-subtle text-sm" data-i18n="pricing.forever">{t(lang, "pricing.forever")}</div>
          <div class="mt-5 flex flex-wrap items-center justify-center gap-2">
            {(["noSub", "noAccount", "noTrial"] as const).map((k) => (
              <span class="inline-flex items-center gap-1.5 rounded-full border border-white/[0.08] bg-white/[0.03] px-3 py-1 text-xs font-medium text-ink-muted">
                <svg class="w-3.5 h-3.5 text-brand-cyan shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>
                <span data-i18n={`pricing.${k}`}>{t(lang, `pricing.${k}`)}</span>
              </span>
            ))}
          </div>
        </div>

        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3 mb-8 list-none p-0 m-0">
          {features.map(({ key }) => (
            <li class="flex items-center gap-2.5">
              <Fragment set:html={FEATURE_ICON} />
              <span class="text-ink-muted text-sm" data-i18n={`pricing.feature.${key}`}>{t(lang, `pricing.feature.${key}`)}</span>
            </li>
          ))}
        </ul>

        <div class="flex flex-col items-center gap-4">
          <!-- Platform-adaptive download buttons: mirrors Hero CTA pattern -->
          <div class="flex flex-wrap items-stretch justify-center gap-3">
            <div data-platform-btn="windows"><StoreButton /></div>
            <div data-platform-btn="macos"><MacStoreButton /></div>
            <div data-platform-btn="linux"><LinuxButton /></div>
          </div>
          <!-- Store-Hint unter den Store-CTAs (Windows/macOS, siehe Hero.astro)
               — gleiches data-requires-os-Gate: nur bei positiv erkanntem
               Windows/macOS sichtbar, nie im ungegateten Fallback. -->
          <div data-requires-os="windows macos">
            <p class="text-ink-subtle text-xs" data-testid="pricing-store-hint" data-i18n="hero.store.hint">{t(lang, "hero.store.hint")}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing-card {
    background: var(--color-brand-card);
  }
</style>
