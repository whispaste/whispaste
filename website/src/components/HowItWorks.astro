---
import { t } from '../scripts/i18n.ts';

const lang = (Astro.currentLocale === 'en' ? 'en' : 'de') as 'de' | 'en';

const steps = [
  {
    key: 'step1',
    illustration: '/illustrations/howitworks-step1.svg',
  },
  {
    key: 'step2',
    illustration: '/illustrations/howitworks-step2.svg',
  },
  {
    key: 'step3',
    illustration: '/illustrations/howitworks-step3.svg',
  },
];
---

<!-- How It Works Section -->
<section id="how-it-works" class="band band-raised py-16 sm:py-20 relative scroll-mt-20">
  <div class="relative max-w-4xl mx-auto px-6">
    <div class="text-center mb-10 scroll-reveal">
      <p class="text-brand-cyan text-sm font-semibold tracking-wider uppercase mb-3" data-i18n="howitworks.label">{t(lang, "howitworks.label")}</p>
      <h2 class="section-title"><span data-i18n="howitworks.titleLead">{t(lang, "howitworks.titleLead")}</span><span class="text-gradient-brand" data-i18n="howitworks.titleAccent">{t(lang, "howitworks.titleAccent")}</span><span data-i18n="howitworks.titleTail">{t(lang, "howitworks.titleTail")}</span></h2>
      <p class="mt-4 text-ink-muted text-lg max-w-3xl mx-auto" data-i18n="howitworks.desc">{t(lang, "howitworks.desc")}</p>
    </div>
    <div class="relative">
      <!-- Connecting line (desktop only) -->
      <div class="hidden lg:block absolute top-12 left-[16.67%] right-[16.67%] h-px bg-gradient-to-r from-brand-cyan/0 via-brand-cyan/30 to-brand-cyan/0"></div>
      <!-- Flow pulse travelling step 1 → 3 along the connector (reduced-motion-safe) -->
      <div class="hiw-flow hidden lg:block absolute top-12 left-[16.67%] right-[16.67%] h-px" aria-hidden="true"></div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 stagger-children">
        {steps.map(({ key, illustration }) => (
          <div class="text-center stagger-item">
            <div class="relative inline-flex items-center justify-center w-20 sm:w-24 h-20 sm:h-24 illo-halo mb-3">
              <img
                src={illustration}
                alt={t(lang, `howitworks.${key}.alt`)}
                width="1024"
                height="1024"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-contain"
              />
            </div>
            <div class="text-xs font-mono text-brand-cyan tracking-wider mb-1" data-i18n={`howitworks.${key}.label`}>{t(lang, `howitworks.${key}.label`)}</div>
            <h3 class="text-white font-semibold mb-1" data-i18n={`howitworks.${key}.title`}>{t(lang, `howitworks.${key}.title`)}</h3>
            <p class="text-ink-muted text-sm" data-i18n={`howitworks.${key}.desc`}>{t(lang, `howitworks.${key}.desc`)}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Gentle "flow" pulse travelling from step 1 to step 3 along the connector. */
  .hiw-flow::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 60px;
    height: 3px;
    transform: translate(-50%, -50%);
    border-radius: 3px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-brand-cyan),
      transparent
    );
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--color-brand-cyan) 55%, transparent));
    animation: hiw-flow-move 4.8s ease-in-out infinite;
  }
  @keyframes hiw-flow-move {
    0% { left: 0; opacity: 0; }
    12% { opacity: 1; }
    88% { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hiw-flow::after {
      animation: none;
      display: none;
    }
  }
</style>
