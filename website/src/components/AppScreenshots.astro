---
import ScreenshotLightbox from './ScreenshotLightbox.astro';
import SectionEyebrow from './SectionEyebrow.astro';
import { t, localePath, currentLocale } from '../scripts/i18n.ts';

const lang = currentLocale(Astro.currentLocale);
const shotLang = lang === 'de' || lang === 'ru' ? lang : 'en';

// Two real app views (dark, the app's only theme). Both stay in the DOM so the
// lightbox can page through them; the switcher only changes which is shown.
const views = [
  { id: 'history', file: '01_workspace_overview', label: 'screenshots.view.history', caption: 'screenshots.workspace', aria: 'screenshots.teaser.overview.aria', alt: 'screenshots.teaser.overview.alt' },
  { id: 'detail', file: '02_workspace_detail', label: 'screenshots.view.detail', caption: 'screenshots.detail', aria: 'screenshots.teaser.detail.aria', alt: 'screenshots.teaser.detail.alt' },
] as const;
---
<!-- Screenshot teaser: one large real screenshot, no device frame, with a
     switch between history and detail editor. Full view opens the shared
     lightbox; the full gallery lives on /screenshots/. -->
<section id="app-screenshots" class="wp-band--ink relative wp-section scroll-mt-20" data-surface="dark">
  <div class="relative wp-container">
    <div class="shots-head">
      <div class="wp-section-head">
        <SectionEyebrow key="screenshots.label" />
        <h2 class="section-title"><span data-i18n="screenshots.titleLead">{t(lang, "screenshots.titleLead")}</span><span class="text-gradient-brand" data-i18n="screenshots.titleAccent">{t(lang, "screenshots.titleAccent")}</span><span data-i18n="screenshots.titleTail">{t(lang, "screenshots.titleTail")}</span></h2>
        <p class="wp-lead mt-4" data-i18n="screenshots.desc">{t(lang, "screenshots.desc")}</p>
      </div>
    </div>

    <div class="shots-stage" data-view="history" data-testid="screenshots">
      <div class="shots-controls">
        <div class="shots-switch" role="group" aria-label={t(lang, "screenshots.viewsAria")} data-i18n-aria="screenshots.viewsAria">
          {views.map((v, i) => (
            <button
              type="button"
              class="shots-switch-btn"
              data-view-btn={v.id}
              aria-pressed={i === 0 ? 'true' : 'false'}
              data-testid={`screenshots-view-${v.id}`}
            ><span data-i18n={v.label}>{t(lang, v.label)}</span></button>
          ))}
        </div>
        <button type="button" class="shots-open" data-testid="screenshots-open">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg>
          <span data-i18n="screenshots.openFull">{t(lang, "screenshots.openFull")}</span>
        </button>
      </div>

      {/* Pure-CSS MacBook Pro: aluminium lid, black bezel with notch, a macOS
          desktop (wallpaper + menu bar) and the app as a window on it. The
          frame is decoration; the screenshot buttons inside keep the
          lightbox wiring and the lang/os sync. */}
      <div class="mbp">
        <div class="mbp-lid">
          <div class="mbp-screen">
            <div class="mbp-display">
              <div class="mbp-wallpaper" aria-hidden="true"></div>
              <div class="mbp-notch" aria-hidden="true"></div>
              <div class="mbp-menubar" aria-hidden="true">
                <div class="mbp-mb-left">
                  <svg class="mbp-apple" viewBox="0 0 24 24" fill="currentColor"><path d="M16.365 1.43c0 1.14-.493 2.27-1.177 3.08-.744.9-1.99 1.57-2.987 1.57-.12 0-.23-.02-.3-.03-.01-.06-.04-.22-.04-.39 0-1.15.572-2.27 1.206-2.98.804-.94 2.142-1.64 3.248-1.68.03.13.05.28.05.43zm4.565 15.71c-.03.07-.463 1.58-1.518 3.12-.945 1.34-1.94 2.71-3.43 2.71-1.517 0-1.9-.88-3.63-.88-1.698 0-2.302.91-3.67.91-1.377 0-2.332-1.26-3.428-2.8-1.287-1.82-2.323-4.63-2.323-7.28 0-4.28 2.797-6.55 5.552-6.55 1.448 0 2.675.95 3.6.95.865 0 2.222-1.01 3.902-1.01.613 0 2.886.06 4.374 2.19-.13.09-2.383 1.37-2.383 4.19 0 3.26 2.854 4.42 2.955 4.45z"/></svg>
                  <span class="mbp-mb-app">WhisPaste</span>
                  <span class="mbp-mb-menus mbp-lang-de">Ablage&nbsp;&nbsp;Bearbeiten&nbsp;&nbsp;Darstellung&nbsp;&nbsp;Fenster&nbsp;&nbsp;Hilfe</span>
                  <span class="mbp-mb-menus mbp-lang-en">File&nbsp;&nbsp;Edit&nbsp;&nbsp;View&nbsp;&nbsp;Window&nbsp;&nbsp;Help</span>
                </div>
                <div class="mbp-mb-right">
                  <svg class="mbp-mb-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11.5a11 11 0 0 1 16 0"/><path d="M7.5 15a6 6 0 0 1 9 0"/><circle cx="12" cy="18.5" r="1" fill="currentColor" stroke="none"/></svg>
                  <svg class="mbp-mb-glyph mbp-mb-battery" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="8" width="17" height="8" rx="2.5"/><rect x="4" y="10" width="11" height="4" rx="1" fill="currentColor" stroke="none"/><path d="M21.5 11.5v3"/></svg>
                  <span class="mbp-clock">9:41</span>
                </div>
              </div>
              {views.map((v, i) => (
                <div class="mbp-window" data-view-only={v.id}>
                  <button
                    type="button"
                    class="teaser-thumb-btn"
                    data-teaser-idx={i}
                    aria-label={t(lang, v.aria)}
                    data-i18n-aria={v.aria}
                  >
                    <img
                      class="teaser-img"
                      src={`/screenshots/${shotLang}/dark/${v.file}.webp`}
                      data-screenshot-en={`/screenshots/en/dark/${v.file}.webp`}
                      data-screenshot-de={`/screenshots/de/dark/${v.file}.webp`}
                      data-screenshot-ru={`/screenshots/ru/dark/${v.file}.webp`}
                      data-screenshot-mac-en={`/screenshots/mac/en/dark/${v.file}.webp`}
                      data-screenshot-mac-de={`/screenshots/mac/de/dark/${v.file}.webp`}
                      data-screenshot-mac-ru={`/screenshots/mac/ru/dark/${v.file}.webp`}
                      alt={t(lang, v.alt)}
                      width="1920"
                      height="1080"
                      loading={i === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  </button>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div class="mbp-base" aria-hidden="true"><span class="mbp-groove"></span></div>
      </div>

      {views.map((v) => (
        <p class="shots-caption" data-view-only={v.id} data-i18n={v.caption}>{t(lang, v.caption)}</p>
      ))}
    </div>

    <p class="shots-more">
      <a href={localePath(lang, "screenshots")} class="shots-more-link" data-testid="screenshots-gallery-link">
        <span data-i18n="screenshots.seeAll">{t(lang, "screenshots.seeAll")}</span>
      </a>
    </p>
  </div>
</section>

<ScreenshotLightbox />

<style>
  .shots-stage {
    display: grid;
    gap: 1rem;
    max-width: 70rem;
    margin-inline: auto;
  }
  .shots-stage:not([data-view="history"]) [data-view-only="history"],
  .shots-stage:not([data-view="detail"]) [data-view-only="detail"] {
    display: none;
  }
  .shots-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }
  .shots-switch {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .shots-switch-btn,
  .shots-open {
    min-height: 44px;
    padding: 0.5rem 1.125rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(255 255 255 / 0.12);
    background: transparent;
    color: var(--color-ink-muted);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: color var(--dur-fast) ease, background-color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .shots-switch-btn:hover,
  .shots-open:hover { color: var(--color-ink); }
  .shots-switch-btn[aria-pressed="true"] {
    color: var(--color-brand-darker);
    background: var(--color-brand-cyan);
    border-color: var(--color-brand-cyan);
  }
  .shots-open {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .shots-open svg {
    width: 1rem;
    height: 1rem;
  }
  .shots-switch-btn:focus-visible,
  .shots-open:focus-visible,
  .teaser-thumb-btn:focus-visible,
  .shots-more-link:focus-visible {
    outline: 2px solid var(--color-brand-cyan);
    outline-offset: 3px;
  }
  /* ---- MacBook Pro frame (pure CSS, space-gray aluminium) ---- */
  .mbp {
    width: 100%;
    max-width: 66rem;
    margin: 1rem auto 0;
    filter: drop-shadow(0 40px 60px rgb(0 0 0 / 0.45)) drop-shadow(0 0 80px color-mix(in srgb, var(--color-brand-cyan) 14%, transparent));
  }
  .mbp-lid {
    width: 88%;
    margin-inline: auto;
    padding: 0.6%;
    border-radius: 2.2% 2.2% 0.6% 0.6% / 3.4% 3.4% 0.9% 0.9%;
    background: linear-gradient(180deg, #5a5e66 0%, #33363c 6%, #2a2c31 100%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.22),
      inset 0 0 0 1px rgb(255 255 255 / 0.06);
  }
  .mbp-screen {
    position: relative;
    padding: 1.6%;
    border-radius: 1.8% 1.8% 0.4% 0.4% / 2.8% 2.8% 0.6% 0.6%;
    background: #060607;
    container-type: inline-size;
    overflow: hidden;
  }
  /* Glass reflection across the panel */
  .mbp-screen::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 6;
    pointer-events: none;
    background: linear-gradient(115deg, rgb(255 255 255 / 0.07) 0%, rgb(255 255 255 / 0.02) 28%, transparent 42%);
  }
  .mbp-display {
    position: relative;
    aspect-ratio: 16 / 10.4;
    border-radius: 0.6cqw;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: #0c1a33;
  }
  .mbp-wallpaper {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(90% 80% at 80% 0%, rgb(34 211 238 / 0.55) 0%, transparent 55%),
      radial-gradient(80% 90% at 0% 100%, rgb(99 102 241 / 0.55) 0%, transparent 60%),
      radial-gradient(60% 60% at 55% 60%, rgb(14 165 233 / 0.35) 0%, transparent 70%),
      linear-gradient(160deg, #0b1d3a 0%, #13305a 45%, #0e2347 100%);
  }
  .mbp-notch {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% 0;
    width: 13cqw;
    height: 2.9cqw;
    background: #060607;
    border-radius: 0 0 1.1cqw 1.1cqw;
    z-index: 5;
  }
  .mbp-menubar {
    position: relative;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 2.9cqw;
    padding: 0 1.8cqw;
    background: rgb(0 0 0 / 0.22);
    color: rgb(255 255 255 / 0.92);
    font-size: 1.25cqw;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
  }
  .mbp-mb-left {
    display: flex;
    align-items: center;
    gap: 1.5cqw;
    min-width: 0;
    max-width: 40%;
    overflow: hidden;
  }
  .mbp-apple { width: 1.6cqw; height: 1.6cqw; flex-shrink: 0; }
  .mbp-mb-app { font-weight: 700; color: #fff; }
  .mbp-mb-menus { color: rgb(255 255 255 / 0.82); overflow: hidden; text-overflow: ellipsis; }
  .mbp-mb-right { display: flex; align-items: center; gap: 1.3cqw; }
  .mbp-mb-glyph { width: 1.7cqw; height: 1.7cqw; }
  .mbp-mb-battery { width: 2.2cqw; height: 2.2cqw; }
  .mbp-clock { font-variant-numeric: tabular-nums; }
  .mbp-lang-de { display: none; }
  :global(html[lang="de"]) .mbp-lang-de { display: inline; }
  :global(html[lang="de"]) .mbp-lang-en { display: none; }
  @container (max-width: 420px) {
    .mbp-mb-menus { display: none; }
    :global(html[lang]) .mbp-mb-menus { display: none; }
  }
  /* App window floating on the desktop */
  .mbp-window {
    position: relative;
    z-index: 2;
    margin: auto 3.2cqw;
    border-radius: 1cqw;
    overflow: hidden;
    box-shadow:
      0 2.4cqw 5cqw rgb(0 0 0 / 0.5),
      0 0 0 1px rgb(255 255 255 / 0.1);
  }
  .mbp-window:last-child { margin-bottom: auto; }
  .teaser-thumb-btn {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--color-brand-darker);
    cursor: zoom-in;
  }
  .teaser-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top center;
  }
  /* Base: wider than the lid, bevelled front edge and the thumb groove. */
  .mbp-base {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: 2.6%;
    border-radius: 0 0 46% 46% / 0 0 100% 100%;
    background: linear-gradient(180deg, #6b6f77 0%, #3b3e44 38%, #1f2125 100%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.28);
  }
  .mbp-groove {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% 0;
    width: 14%;
    height: 38%;
    border-radius: 0 0 0.6rem 0.6rem;
    background: linear-gradient(180deg, #24262a, #44474e);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .mbp { transition: transform 0.5s var(--ease-flow); }
    .mbp:hover { transform: translateY(-4px); }
  }
  .shots-caption {
    margin-top: 0.5rem;
    text-align: center;
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
  }
  .shots-more {
    margin-top: 1.5rem;
    text-align: center;
  }
  .shots-more-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--color-brand-cyan);
    text-decoration: none;
    border-radius: var(--radius-chip);
  }
  .shots-more-link:hover { text-decoration: underline; }
  @media (prefers-reduced-motion: reduce) {
    .shots-switch-btn,
    .shots-open { transition: none; }
  }
</style>

<script>
  function syncScreenshots() {
    const docLang = document.documentElement.lang;
    const os = document.documentElement.dataset.os ?? '';
    document.querySelectorAll<HTMLImageElement>('img[data-screenshot-en]').forEach(img => {
      const d = img.dataset;
      let nextSrc: string | undefined;
      if (os === 'macos') {
        nextSrc = docLang === 'de' ? d.screenshotMacDe : docLang === 'ru' ? d.screenshotMacRu : d.screenshotMacEn;
      }
      nextSrc ??= docLang === 'de' ? d.screenshotDe : docLang === 'ru' ? d.screenshotRu : d.screenshotEn;
      nextSrc ??= d.screenshotEn;
      if (nextSrc && img.getAttribute('src') !== nextSrc) img.setAttribute('src', nextSrc);
    });
  }

  syncScreenshots();
  const observer = new MutationObserver(syncScreenshots);
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['lang', 'data-os'] });
  window.addEventListener('pageshow', syncScreenshots);

  // Wire the screenshots to the shared lightbox (ScreenshotLightbox.astro).
  const openLightbox = (idx: number) => {
    const teaserImgs = Array.from(
      document.querySelectorAll<HTMLImageElement>('.teaser-img')
    ).map(i => ({ src: i.getAttribute('src') || '', alt: i.getAttribute('alt') || '' }));
    if ((window as any).openScreenshotLightbox) {
      (window as any).openScreenshotLightbox(teaserImgs, idx);
    }
  };
  document.querySelectorAll<HTMLButtonElement>('.teaser-thumb-btn').forEach(btn => {
    btn.addEventListener('click', () => openLightbox(parseInt(btn.dataset.teaserIdx || '0', 10)));
  });

  // View switcher: aria-pressed buttons swap the visible screenshot.
  const stage = document.querySelector<HTMLElement>('.shots-stage');
  const viewBtns = stage?.querySelectorAll<HTMLButtonElement>('[data-view-btn]') ?? [];
  for (const btn of viewBtns) {
    btn.addEventListener('click', () => {
      if (!stage) return;
      stage.dataset.view = btn.dataset.viewBtn;
      for (const b of viewBtns) b.setAttribute('aria-pressed', String(b === btn));
    });
  }
  stage?.querySelector('.shots-open')?.addEventListener('click', () => {
    openLightbox(stage.dataset.view === 'detail' ? 1 : 0);
  });
</script>
