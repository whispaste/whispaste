---
import ScreenshotLightbox from './ScreenshotLightbox.astro';
import { t } from '../scripts/i18n.ts';

const lang = (Astro.currentLocale === 'en' ? 'en' : 'de') as 'de' | 'en';
---
<!-- Compact screenshot teaser — links to /screenshots for the full gallery -->
<section id="app-screenshots" class="band band-deep relative py-20 sm:py-28 scroll-mt-20">
  <div class="relative max-w-6xl mx-auto px-6">
    <div class="max-w-2xl mx-auto text-center mb-10 scroll-reveal">
      <p
        class="text-brand-cyan text-sm font-semibold tracking-wider uppercase mb-3"
        data-i18n="screenshots.label"
      >
        {t(lang, "screenshots.label")}
      </p>
      <h2 class="section-title"><span data-i18n="screenshots.titleLead">{t(lang, "screenshots.titleLead")}</span><span class="text-gradient-brand" data-i18n="screenshots.titleAccent">{t(lang, "screenshots.titleAccent")}</span><span data-i18n="screenshots.titleTail">{t(lang, "screenshots.titleTail")}</span></h2>
      <p class="mt-3 text-ink-muted text-base" data-i18n="screenshots.desc">
        {t(lang, "screenshots.desc")}
      </p>
    </div>

    <!-- Two hero screenshots: workspace (dark) + detail (light) -->
    <div class="teaser-pair scroll-reveal">
      <figure class="teaser-card teaser-card--primary">
        <button
          class="teaser-thumb-btn"
          data-teaser-idx="0"
          aria-label="Your transcripts at a glance — click to enlarge"
          data-aria-label-en="Your transcripts at a glance — click to enlarge"
          data-aria-label-de="Alle Transkripte auf einen Blick — klicken zum Vergrößern"
        >
          <img
            class="teaser-img"
            src="/screenshots/en/dark/01_workspace_overview.png"
            data-screenshot-en="/screenshots/en/dark/01_workspace_overview.png"
            data-screenshot-de="/screenshots/de/dark/01_workspace_overview.png"
            data-screenshot-mac-en="/screenshots/mac/en/dark/01_workspace_overview.png"
            data-screenshot-mac-de="/screenshots/mac/de/dark/01_workspace_overview.png"
            data-alt-en="WhisPaste workspace — dark theme"
            data-alt-de="WhisPaste Workspace — dunkles Design"
            alt="WhisPaste workspace — dark theme"
            width="1920"
            height="1080"
            loading="eager"
            decoding="async"
          />
        </button>
      </figure>

      <figure class="teaser-card teaser-card--secondary">
        <button
          class="teaser-thumb-btn"
          data-teaser-idx="1"
          aria-label="Edit and refine each entry — click to enlarge"
          data-aria-label-en="Edit and refine each entry — click to enlarge"
          data-aria-label-de="Jeden Eintrag bearbeiten und verfeinern — klicken zum Vergrößern"
        >
          <img
            class="teaser-img"
            src="/screenshots/en/light/02_workspace_detail.png"
            data-screenshot-en="/screenshots/en/light/02_workspace_detail.png"
            data-screenshot-de="/screenshots/de/light/02_workspace_detail.png"
            data-screenshot-mac-en="/screenshots/mac/en/light/02_workspace_detail.png"
            data-screenshot-mac-de="/screenshots/mac/de/light/02_workspace_detail.png"
            data-alt-en="WhisPaste detail editor — light theme"
            data-alt-de="WhisPaste Detail-Editor — helles Design"
            alt="WhisPaste detail editor — light theme"
            width="1920"
            height="1080"
            loading="lazy"
            decoding="async"
          />
        </button>
      </figure>
    </div>

    <div class="text-center mt-8 scroll-reveal">
      <a
        href="/screenshots"
        class="inline-flex items-center gap-2 text-brand-cyan hover:underline font-medium text-sm transition-colors"
        data-i18n="screenshots.seeAll"
      >
        {t(lang, "screenshots.seeAll")}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </a>
    </div>
  </div>
</section>

<ScreenshotLightbox />

<style>
  .teaser-pair {
    position: relative;
    display: grid;
    gap: 1.75rem;
    max-width: 64rem;
    margin: 0 auto;
  }
  /* Soft cyan pedestal so the screenshots read as a deliberate showcase rather
     than a flat pair sitting on the band. Sits behind the figures, inside the
     band's stacking context (theme-aware via color-mix). */
  .teaser-pair::before {
    content: "";
    position: absolute;
    inset: -10% -6% -14%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse 68% 60% at 50% 42%,
      color-mix(in srgb, var(--color-brand-cyan) 15%, transparent) 0%,
      transparent 70%
    );
    filter: blur(10px);
  }

  @media (min-width: 768px) {
    .teaser-pair {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .teaser-card--secondary {
      margin-top: 3rem;
    }
  }

  .teaser-card {
    margin: 0;
    border-radius: 14px;
    overflow: hidden;
  }

  .teaser-thumb-btn {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    border-radius: 14px;
    overflow: hidden;
    outline-offset: 3px;
  }

  .teaser-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow:
      0 28px 70px rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(56, 217, 240, 0.08);
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .teaser-thumb-btn:hover .teaser-img,
  .teaser-thumb-btn:focus-visible .teaser-img {
    transform: translateY(-6px);
    box-shadow:
      0 36px 84px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(56, 217, 240, 0.2);
  }

  html.light .teaser-img {
    border-color: rgba(15, 23, 42, 0.08);
    box-shadow:
      0 18px 48px rgba(15, 23, 42, 0.14),
      0 0 0 1px rgba(8, 145, 178, 0.08);
  }
  html.light .teaser-thumb-btn:hover .teaser-img,
  html.light .teaser-thumb-btn:focus-visible .teaser-img {
    box-shadow:
      0 26px 60px rgba(15, 23, 42, 0.18),
      0 0 0 1px rgba(8, 145, 178, 0.2);
  }

</style>

<script>
  function syncScreenshots() {
    const lang = document.documentElement.lang === 'de' ? 'de' : 'en';
    const os = document.documentElement.dataset.os ?? '';
    document.querySelectorAll<HTMLImageElement>('img[data-screenshot-en]').forEach(img => {
      let nextSrc: string | undefined;
      if (os === 'macos') {
        nextSrc = lang === 'de' ? img.dataset.screenshotMacDe : img.dataset.screenshotMacEn;
      }
      nextSrc ??= lang === 'de' ? img.dataset.screenshotDe : img.dataset.screenshotEn;
      const nextAlt = lang === 'de' ? img.dataset.altDe : img.dataset.altEn;
      if (nextSrc && img.getAttribute('src') !== nextSrc) img.setAttribute('src', nextSrc);
      if (nextAlt) img.setAttribute('alt', nextAlt);
    });
    // Sync aria-labels on buttons
    document.querySelectorAll<HTMLElement>('[data-aria-label-en]').forEach(el => {
      const label = lang === 'de' ? el.dataset.ariaLabelDe : el.dataset.ariaLabelEn;
      if (label) el.setAttribute('aria-label', label);
    });
  }

  syncScreenshots();
  const observer = new MutationObserver(syncScreenshots);
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['lang', 'data-os'] });
  window.addEventListener('pageshow', syncScreenshots);

  // Wire teaser thumbnails to shared lightbox (ScreenshotLightbox.astro)
  document.querySelectorAll<HTMLButtonElement>('.teaser-thumb-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const idx = parseInt(btn.dataset.teaserIdx || '0', 10);
      const teaserImgs = Array.from(
        document.querySelectorAll<HTMLImageElement>('.teaser-img')
      ).map(i => ({ src: i.getAttribute('src') || '', alt: i.getAttribute('alt') || '' }));
      if ((window as any).openScreenshotLightbox) {
        (window as any).openScreenshotLightbox(teaserImgs, idx);
      }
    });
  });
</script>
