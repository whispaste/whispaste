---
import SectionEyebrow from './SectionEyebrow.astro';
import { t } from '../scripts/i18n.ts';

const lang = (Astro.currentLocale === 'en' ? 'en' : 'de') as 'de' | 'en';

/**
 * TextExpansion — the two stored-text features: Replacements and Voice
 * Snippets.
 *
 * Job of this section: both features answer the same need ("text I paste
 * every day should not need to be spoken word for word"), and they differ in
 * exactly one dimension — WHO triggers the insert. Replacements fire
 * automatically during transcription; the snippet picker waits for a click.
 * One section, two cards, the mode chip on each card carries that contrast.
 *
 * Media honesty follows the ProofShowcase rules:
 * - The Replacements card shows the REAL app screenshot
 *   (`/screenshots/{lang}/dark/03_voice_shortcuts.webp` — despite the
 *   legacy "voice_shortcuts" filename it captures the Replacements page).
 * - No capture of the snippet picker panel exists (it is a small transient
 *   panel near the text cursor), so that card gets a deliberately stylised
 *   HTML/CSS illustration of the mechanism (caret → panel → pick), the same
 *   move as AppPasteDemo's synthetic storyboard. It is visually abstract
 *   (skeleton text bars, no fake window chrome) so it cannot be mistaken
 *   for a screenshot.
 *
 * Both media panes sit in the same theme-independent dark bezel as the
 * ProofShowcase stage: the app is dark-only, the site has light+dark.
 */
const shots = {
  de: '/screenshots/de/dark/03_voice_shortcuts.webp',
  en: '/screenshots/en/dark/03_voice_shortcuts.webp',
};
const shotAlt = {
  en: 'Screenshot: the Replacements page in WhisPaste, four short triggers with their stored texts',
  de: 'Screenshot: die Ersetzungen-Seite in WhisPaste, vier Kurzformen mit ihren hinterlegten Texten',
};
---

<section id="text-expansion" class="band band-raised relative py-20 sm:py-28 scroll-mt-20">
  <div class="relative max-w-6xl mx-auto px-6">
    <div class="max-w-2xl mx-auto text-center mb-12 scroll-reveal">
      <SectionEyebrow key="expand.label" />
      <h2 class="section-title headline-serif">
        <span data-i18n="expand.titleLead">{t(lang, 'expand.titleLead')}</span><span
          class="text-gradient-brand"
          data-i18n="expand.titleAccent"
        >{t(lang, 'expand.titleAccent')}</span><span data-i18n="expand.titleTail">{t(lang, 'expand.titleTail')}</span>
      </h2>
      <p class="mt-4 text-ink-muted text-lg" data-i18n="expand.subtitle">
        {t(lang, 'expand.subtitle')}
      </p>
    </div>

    <div class="tx-grid scroll-reveal stagger-children">
      {/* ---- Card 1: Replacements — real app screenshot ---- */}
      <article class="tx-card stagger-item">
        <figure class="tx-media wp-clip-reveal">
          <div class="tx-frame">
            <img
              src={shots[lang]}
              data-shot-de={shots.de}
              data-shot-en={shots.en}
              alt={shotAlt[lang]}
              data-alt-de={shotAlt.de}
              data-alt-en={shotAlt.en}
              width="1920"
              height="1080"
              loading="lazy"
              decoding="async"
            />
          </div>
        </figure>
        <div class="tx-copy">
          <h3 class="tx-name" data-i18n="expand.repl.name">{t(lang, 'expand.repl.name')}</h3>
          <p class="tx-mode">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 3h5v5"/><path d="M8 21H3v-5"/><path d="M21 3 3 21"/>
            </svg>
            <span data-i18n="expand.repl.mode">{t(lang, 'expand.repl.mode')}</span>
          </p>
          <p class="tx-body" data-i18n="expand.repl.body">{t(lang, 'expand.repl.body')}</p>
        </div>
      </article>

      {/* ---- Card 2: Voice Snippets — stylised picker illustration ---- */}
      <article class="tx-card stagger-item">
        <figure
          class="tx-media wp-clip-reveal"
          role="img"
          aria-label={t(lang, 'expand.snip.mockAria')}
          data-i18n-aria="expand.snip.mockAria"
        >
          <div class="tx-frame tx-frame--mock" aria-hidden="true">
            {/* Skeleton text line with a caret — the writing context the
                panel appears next to. Bars, not words: this must read as an
                abstract illustration, never as a screenshot. */}
            <div class="tx-doc">
              <span class="tx-bar" style="width: 34%"></span>
              <span class="tx-bar" style="width: 22%"></span>
              <span class="tx-caret"></span>
            </div>
            <div class="tx-panel">
              <div class="tx-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="6"/><path d="m20 20-3.2-3.2"/>
                </svg>
                <span data-i18n="expand.snip.mock.search">{t(lang, 'expand.snip.mock.search')}</span>
              </div>
              <ul class="tx-rows">
                <li class="tx-row tx-row--active">
                  <span class="tx-row-title" data-i18n="expand.snip.mock.item1">{t(lang, 'expand.snip.mock.item1')}</span>
                  <svg class="tx-row-enter" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 10 4 15l5 5"/><path d="M20 4v7a4 4 0 0 1-4 4H4"/>
                  </svg>
                </li>
                <li class="tx-row">
                  <span class="tx-row-title" data-i18n="expand.snip.mock.item2">{t(lang, 'expand.snip.mock.item2')}</span>
                </li>
                <li class="tx-row">
                  <span class="tx-row-title" data-i18n="expand.snip.mock.item3">{t(lang, 'expand.snip.mock.item3')}</span>
                </li>
              </ul>
            </div>
          </div>
        </figure>
        <div class="tx-copy">
          <h3 class="tx-name" data-i18n="expand.snip.name">{t(lang, 'expand.snip.name')}</h3>
          <p class="tx-mode">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 9 5 12 1.8-5.2L21 14Z"/><path d="M7.2 2.2 8 5.1"/><path d="m5.1 8-2.9-.8"/><path d="M14 4.1 12 6"/><path d="m6 12-1.9 2"/>
            </svg>
            <span data-i18n="expand.snip.mode">{t(lang, 'expand.snip.mode')}</span>
          </p>
          <p class="tx-body" data-i18n="expand.snip.body">{t(lang, 'expand.snip.body')}</p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .tx-grid {
    display: grid;
    gap: 3rem;
    max-width: 64rem;
    margin: 0 auto;
  }
  @media (min-width: 1024px) {
    .tx-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
      align-items: start;
    }
  }

  /* ---- Media pane: same theme-independent dark bezel as ProofShowcase ---- */
  .tx-media {
    position: relative;
    margin: 0;
    --wp-clip-end: 140%;
  }
  .tx-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 14px;
    background: #05070d;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow:
      0 22px 56px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(56, 217, 240, 0.08);
  }
  html.light .tx-frame {
    border-color: rgba(15, 23, 42, 0.16);
    box-shadow:
      0 16px 42px rgba(15, 23, 42, 0.15),
      0 0 0 1px rgba(8, 145, 178, 0.08);
  }
  .tx-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---- Snippet-picker illustration (fixed dark palette — the app is
          dark-only, and this pane must match the screenshot pane) ---- */
  .tx-frame--mock {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    padding: 1.5rem;
    background:
      radial-gradient(ellipse 80% 70% at 50% 30%,
        rgba(56, 217, 240, 0.08) 0%,
        transparent 70%),
      #05070d;
  }
  .tx-doc {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: min(78%, 21rem);
  }
  .tx-bar {
    height: 0.55rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
  }
  .tx-caret {
    width: 2px;
    height: 1.05rem;
    border-radius: 1px;
    background: #38d9f0;
    animation: tx-blink 1s step-end infinite;
  }
  .tx-panel {
    width: min(78%, 21rem);
    border-radius: 12px;
    background: #0b1020;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.5);
    overflow: hidden;
  }
  .tx-search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.78rem;
  }
  .tx-search svg {
    width: 0.85rem;
    height: 0.85rem;
    flex-shrink: 0;
  }
  .tx-rows {
    list-style: none;
    margin: 0;
    padding: 0.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .tx-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.42rem 0.6rem;
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.8rem;
    font-weight: 500;
  }
  .tx-row--active {
    background: rgba(56, 217, 240, 0.14);
    border: 1px solid rgba(56, 217, 240, 0.32);
    color: #fff;
  }
  .tx-row-enter {
    width: 0.85rem;
    height: 0.85rem;
    color: #38d9f0;
    flex-shrink: 0;
  }

  /* ---- Copy under each media pane ---- */
  .tx-copy {
    margin-top: 1.25rem;
  }
  .tx-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .tx-mode {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    padding: 0.28rem 0.65rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-brand-cyan);
    background: color-mix(in srgb, var(--color-brand-cyan) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-brand-cyan) 30%, transparent);
  }
  html.light .tx-mode {
    color: #0e7490;
    background: color-mix(in srgb, #0891b2 10%, transparent);
    border-color: color-mix(in srgb, #0891b2 30%, transparent);
  }
  .tx-mode svg {
    width: 0.85rem;
    height: 0.85rem;
    flex-shrink: 0;
  }
  .tx-body {
    margin-top: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  @keyframes tx-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tx-caret {
      animation: none;
    }
  }
</style>

<script>
  // Keep the locale-specific screenshot and its alt text in the visitor's
  // language. Own scoped sync (same pattern as ProofShowcase.syncAlts) instead
  // of piggybacking on AppScreenshots' document-wide `data-screenshot-*`
  // handler, so this section works on any page regardless of neighbours.
  const root = document.getElementById('text-expansion');
  if (root) {
    const sync = () => {
      const lang = document.documentElement.lang === 'de' ? 'de' : 'en';
      root.querySelectorAll<HTMLImageElement>('img[data-shot-en]').forEach((img) => {
        const src = lang === 'de' ? img.dataset.shotDe : img.dataset.shotEn;
        const alt = lang === 'de' ? img.dataset.altDe : img.dataset.altEn;
        if (src && img.getAttribute('src') !== src) img.setAttribute('src', src);
        if (alt) img.setAttribute('alt', alt);
      });
    };
    sync();
    new MutationObserver(sync).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['lang'],
    });
  }
</script>
