---
import { t } from '../scripts/i18n.ts';

const lang = (Astro.currentLocale === 'en' ? 'en' : 'de') as 'de' | 'en';

// Each language shows a representative country flag (a language is not a
// country — the flag is chosen pragmatically for visual recognition). Flag
// SVGs are self-hosted from flag-icons (MIT) — see public/flags/ATTRIBUTION.txt.
const languages = [
  { name: "English", flag: "gb" }, { name: "Deutsch", flag: "de" },
  { name: "Español", flag: "es" }, { name: "Français", flag: "fr" },
  { name: "Italiano", flag: "it" }, { name: "Português", flag: "pt" },
  { name: "日本語", flag: "jp" }, { name: "中文", flag: "cn" },
  { name: "한국어", flag: "kr" }, { name: "Русский", flag: "ru" },
  { name: "العربية", flag: "sa" }, { name: "हिन्दी", flag: "in" },
  { name: "Polski", flag: "pl" }, { name: "Nederlands", flag: "nl" },
  { name: "Türkçe", flag: "tr" }, { name: "Svenska", flag: "se" },
  { name: "Čeština", flag: "cz" }, { name: "Українська", flag: "ua" },
  { name: "Bahasa", flag: "id" }, { name: "Tiếng Việt", flag: "vn" },
  { name: "ไทย", flag: "th" }, { name: "Ελληνικά", flag: "gr" },
  { name: "Română", flag: "ro" }, { name: "Magyar", flag: "hu" },
];
---

<!-- Languages Section -->
<section id="languages" class="band band-deep py-24 sm:py-32 relative scroll-mt-20 overflow-hidden">
  <!-- Decorative context motif: a globe — "speak in many languages". Theme-
       adaptive (brand token), faint, non-interactive. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-10 -translate-x-1/2 text-brand-cyan opacity-[0.11]"
  >
    <svg width="250" height="250" viewBox="0 0 220 220" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="110" cy="110" r="90" />
      <ellipse cx="110" cy="110" rx="40" ry="90" />
      <path d="M22 110h176M38 68h144M38 152h144" />
    </svg>
  </div>
  <div class="relative max-w-4xl mx-auto px-6">
    <div class="text-center mb-12 scroll-reveal">
      <p class="text-brand-cyan text-sm font-semibold tracking-wider uppercase mb-3" data-i18n="languages.label">{t(lang, "languages.label")}</p>
      <h2 class="section-title"><span data-i18n="languages.titleLead">{t(lang, "languages.titleLead")}</span><span class="text-gradient-brand" data-i18n="languages.titleAccent">{t(lang, "languages.titleAccent")}</span><span data-i18n="languages.titleTail">{t(lang, "languages.titleTail")}</span></h2>
      <p class="mt-4 text-ink-muted text-lg max-w-2xl mx-auto" data-i18n="languages.desc">{t(lang, "languages.desc")}</p>
    </div>

    <div class="flex flex-wrap justify-center gap-2.5 scroll-reveal">
      {languages.map(({ name, flag }) => (
        <span class="lang-pill group inline-flex items-center gap-2 pl-2.5 pr-4 py-2 rounded-full text-sm font-medium border border-white/[0.08] text-gray-300 bg-white/[0.03] hover:border-brand-cyan/30 hover:text-white hover:-translate-y-0.5 transition-all cursor-default">
          <img
            src={`/flags/${flag}.svg`}
            alt=""
            aria-hidden="true"
            width="20"
            height="15"
            loading="lazy"
            decoding="async"
            class="h-3.5 w-5 rounded-[3px] object-cover ring-1 ring-black/10 shadow-sm motion-safe:transition-transform motion-safe:duration-200 motion-safe:group-hover:scale-110"
          />
          {name}
        </span>
      ))}
      <span class="lang-pill px-4 py-2 rounded-full text-sm font-medium border border-brand-cyan/20 text-brand-cyan bg-brand-cyan/[0.06] hover:-translate-y-0.5 transition-all cursor-default" data-i18n="languages.more">
        {t(lang, "languages.more")}
      </span>
    </div>
  </div>
</section>

<style>
  .lang-pill {
    position: relative;
    /* smooth grow/shrink for the ambient highlight (in addition to hover) */
    transition: transform 0.35s ease, border-color 0.35s ease, color 0.2s ease, background-color 0.2s ease;
  }
  .lang-pop {
    transform: translateY(-2px) scale(1.14);
    z-index: 2;
    border-color: color-mix(in srgb, var(--color-brand-cyan) 45%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    .lang-pop {
      transform: none;
    }
  }
</style>

<script>
  // Ambient "twinkle": randomly enlarge one language pill briefly, then the next,
  // giving a gentle sense of many living languages. Respects reduced-motion and
  // pauses while the tab is hidden.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const section = document.getElementById('languages');
  const pills = section
    ? Array.from(section.querySelectorAll<HTMLElement>('.lang-pill')).filter((p) => p.querySelector('img'))
    : [];

  if (!reduce.matches && pills.length > 1) {
    let last = -1;
    let timer: ReturnType<typeof setTimeout> | undefined;

    const tick = () => {
      let i = last;
      while (i === last) i = Math.floor(Math.random() * pills.length);
      last = i;
      const el = pills[i];
      el.classList.add('lang-pop');
      setTimeout(() => el.classList.remove('lang-pop'), 650);
      timer = setTimeout(tick, 850 + Math.random() * 950);
    };

    const start = () => {
      if (!timer) timer = setTimeout(tick, 300);
    };
    const stop = () => {
      if (timer) clearTimeout(timer);
      timer = undefined;
    };

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });
    setTimeout(start, 1200);
  }
</script>
