---
/**
 * Motion illustration: release timeline (changelog). A spine with release
 * nodes; a light pulse climbs the spine and each node and its release card
 * light up in turn. Inline SVG + CSS, transform/opacity only; static under
 * prefers-reduced-motion. Decorative.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const nodes = [256, 196, 136, 76];
// Unique gradient id per instance, so the graphic can render twice on a page.
const accentId = `tl-accent-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['motion-tl', className]}
  viewBox="0 0 480 320"
  fill="none"
  aria-hidden="true"
  focusable="false"
  data-testid="motion-timeline"
>
  <defs>
    <linearGradient id={accentId} x1="0" y1="1" x2="0" y2="0">
      <stop offset="0" style="stop-color: var(--wp-illustration-accent-strong)" />
      <stop offset="1" style="stop-color: var(--wp-illustration-accent-fill)" />
    </linearGradient>
  </defs>

  <rect class="tl-spine" x="118" y="40" width="4" height="250" rx="2" />
  <rect class="pulse" x="116" y="250" width="8" height="40" rx="4" fill={`url(#${accentId})`} />

  {nodes.map((y, i) => (
    <g style={`--i:${i}`}>
      <circle class="tl-ring" cx="120" cy={y} r="11" stroke-width="2" />
      <circle class="node tl-dot" cx="120" cy={y} r="6" />
      <g class="card">
        <rect
          class="tl-card"
          x="150"
          y={y - 22}
          width={i === nodes.length - 1 ? 250 : 210}
          height="44"
          rx="12"
          style={i === nodes.length - 1 ? `stroke: url(#${accentId})` : undefined}
        />
        <rect class="tl-dot" x="168" y={y - 9} width="44" height="8" rx="4" />
        <rect class="tl-muted" x="222" y={y - 9} width={i === nodes.length - 1 ? 150 : 110} height="8" rx="4" opacity=".6" />
        <rect class="tl-muted" x="168" y={y + 5} width="90" height="6" rx="3" opacity=".5" />
      </g>
    </g>
  ))}
</svg>

<style>
  .motion-tl { display: block; width: 100%; height: auto; }
  .motion-tl .node,
  .motion-tl .card,
  .motion-tl .pulse { transform-box: fill-box; transform-origin: center; }
  .motion-tl .card { transform-origin: left center; }

  /* Solid token colours: the graphic must read on dark and light bands. */
  .motion-tl .tl-spine { fill: var(--wp-illustration-stroke-soft); }
  .motion-tl .tl-ring { fill: var(--wp-illustration-node); stroke: var(--wp-illustration-line); }
  .motion-tl .tl-dot { fill: var(--wp-illustration-accent-fill); }
  .motion-tl .tl-card { fill: var(--wp-illustration-node); stroke: var(--wp-illustration-node-border); }
  .motion-tl .tl-muted { fill: var(--wp-illustration-muted); }

  @media (prefers-reduced-motion: no-preference) {
    .motion-tl .pulse { animation: tl-climb 8s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
    .motion-tl .node { animation: tl-node 8s ease-out infinite; animation-delay: calc(var(--i) * 1.4s); }
    .motion-tl .card { animation: tl-card 8s cubic-bezier(0.22, 1, 0.36, 1) infinite; animation-delay: calc(var(--i) * 1.4s); }
  }
  @keyframes tl-climb {
    0% { transform: translateY(0); opacity: 0; }
    5% { opacity: 1; }
    70% { transform: translateY(-200px); opacity: 1; }
    80%, 100% { transform: translateY(-200px); opacity: 0; }
  }
  @keyframes tl-node { 0% { transform: scale(0.4); opacity: 0.4; } 6% { transform: scale(1.3); opacity: 1; } 14%, 100% { transform: scale(1); opacity: 1; } }
  @keyframes tl-card { 0% { transform: translateX(-10px); opacity: 0.25; } 8%, 100% { transform: translateX(0); opacity: 1; } }
</style>
