---
/**
 * Motion illustration: hotkey to text. Two keycaps press together, the
 * recording pill pops up, then a pasted text line lands in the target
 * field. Platform-neutral glyphs. Inline SVG + CSS, transform/opacity only;
 * static under prefers-reduced-motion. Decorative.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  class:list={['motion-hk', className]}
  viewBox="0 0 480 320"
  fill="none"
  aria-hidden="true"
  focusable="false"
  data-testid="motion-hotkey"
>
  <defs>
    <linearGradient id="hk-accent" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#6FDDF0" />
      <stop offset="1" stop-color="#0BAACC" />
    </linearGradient>
  </defs>

  <!-- keycaps: the app's default main hotkey, Ctrl+Shift+D (CONTEXT.md §2.5) -->
  <g class="key k1">
    <rect x="40" y="196" width="80" height="80" rx="16" fill="#0B122A" />
    <rect x="40" y="186" width="80" height="80" rx="16" fill="#171D53" stroke="rgba(171,184,204,.3)" />
    <text x="80" y="236" text-anchor="middle" fill="#F0F4FA" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="22">Ctrl</text>
  </g>
  <g class="key k2">
    <rect x="130" y="196" width="88" height="80" rx="16" fill="#0B122A" />
    <rect x="130" y="186" width="88" height="80" rx="16" fill="#171D53" stroke="rgba(171,184,204,.3)" />
    <text x="174" y="236" text-anchor="middle" fill="#F0F4FA" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="22">Shift</text>
  </g>
  <g class="key k3">
    <rect x="228" y="196" width="76" height="80" rx="16" fill="#0B122A" />
    <rect x="228" y="186" width="76" height="80" rx="16" fill="#171D53" stroke="url(#hk-accent)" stroke-width="2" />
    <text x="266" y="236" text-anchor="middle" fill="#6FDDF0" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="22">D</text>
  </g>

  <!-- recording pill -->
  <g class="pill">
    <rect x="96" y="104" width="140" height="44" rx="22" fill="#171D53" stroke="rgba(111,221,240,.4)" />
    <circle cx="122" cy="126" r="7" fill="#6FDDF0" />
    {[0, 1, 2, 3, 4, 5].map((i) => (
      <rect class="bar" x={142 + i * 12} y="114" width="6" height="24" rx="3" fill="url(#hk-accent)" style={`--i:${i}`} />
    ))}
  </g>

  <!-- target field -->
  <rect x="316" y="72" width="136" height="200" rx="16" fill="#0D1936" stroke="rgba(171,184,204,.22)" />
  <rect x="334" y="96" width="100" height="8" rx="4" fill="rgba(171,184,204,.35)" />
  <rect x="334" y="116" width="78" height="8" rx="4" fill="rgba(171,184,204,.35)" />
  <rect class="paste" x="334" y="140" width="100" height="36" rx="8" fill="rgba(111,221,240,.14)" stroke="rgba(111,221,240,.5)" />
  <rect class="paste" x="344" y="154" width="72" height="8" rx="4" fill="#F0F4FA" />
</svg>

<style>
  .motion-hk { display: block; width: 100%; height: auto; }
  .motion-hk .key,
  .motion-hk .pill,
  .motion-hk .bar,
  .motion-hk .paste { transform-box: fill-box; transform-origin: center; }
  .motion-hk .paste { transform-origin: left center; }

  @media (prefers-reduced-motion: no-preference) {
    .motion-hk .key { animation: hk-press 6s cubic-bezier(0.22, 1, 0.36, 1) infinite; }
    .motion-hk .k2 { animation-delay: 0.08s; }
    .motion-hk .k3 { animation-delay: 0.16s; }
    .motion-hk .pill { animation: hk-pill 6s cubic-bezier(0.22, 1, 0.36, 1) infinite; }
    .motion-hk .bar { animation: hk-bar 0.9s ease-in-out infinite alternate; animation-delay: calc(var(--i) * -0.15s); }
    .motion-hk .paste { animation: hk-paste 6s cubic-bezier(0.22, 1, 0.36, 1) infinite; }
  }
  @keyframes hk-press { 0%, 6% { transform: translateY(0); } 10%, 14% { transform: translateY(8px); } 20%, 100% { transform: translateY(0); } }
  @keyframes hk-pill {
    0%, 12% { transform: translateY(12px) scale(0.8); opacity: 0; }
    20%, 58% { transform: translateY(0) scale(1); opacity: 1; }
    66%, 100% { transform: translateY(-6px) scale(0.9); opacity: 0; }
  }
  @keyframes hk-bar { from { transform: scaleY(0.3); } to { transform: scaleY(1); } }
  @keyframes hk-paste {
    0%, 60% { transform: scaleX(0); opacity: 0; }
    70%, 92% { transform: scaleX(1); opacity: 1; }
    100% { transform: scaleX(1); opacity: 0; }
  }
</style>
