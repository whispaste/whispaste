---
/**
 * Motion illustration: one app, three desktops. Three abstract windows
 * (traffic lights, caption buttons, a tiling-style bar) float in a
 * staggered rhythm; the same waveform runs in each. Generic shapes, no
 * vendor logos. Inline SVG + CSS, transform/opacity only; static under
 * prefers-reduced-motion. Decorative.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const wins = [
  { x: 24, y: 84, kind: 'mac' },
  { x: 172, y: 52, kind: 'win' },
  { x: 320, y: 84, kind: 'linux' },
];
const bars = [0.4, 0.8, 1, 0.6, 0.9, 0.5];
// Unique gradient id per instance, so the graphic can render twice on a page.
const accentId = `pf-accent-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['motion-pf', className]}
  viewBox="0 0 480 320"
  fill="none"
  aria-hidden="true"
  focusable="false"
  data-testid="motion-platforms"
>
  <defs>
    <linearGradient id={accentId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" style="stop-color: var(--wp-illustration-accent-fill)" />
      <stop offset="1" style="stop-color: var(--wp-illustration-accent-strong)" />
    </linearGradient>
  </defs>

  {wins.map((w, i) => (
    <g class="win" style={`--i:${i}`}>
      <rect
        class="pf-win"
        x={w.x}
        y={w.y}
        width="136"
        height="160"
        rx="14"
        stroke-width={i === 1 ? 2 : 1}
        style={i === 1 ? `stroke: url(#${accentId})` : undefined}
      />
      {w.kind === 'mac' && (
        <>
          <circle class="pf-muted" cx={w.x + 16} cy={w.y + 16} r="4" />
          <circle class="pf-muted" cx={w.x + 28} cy={w.y + 16} r="4" />
          <circle class="pf-muted" cx={w.x + 40} cy={w.y + 16} r="4" />
        </>
      )}
      {w.kind === 'win' && (
        <>
          <rect class="pf-muted" x={w.x + 88} y={w.y + 15} width="8" height="2" />
          <rect class="pf-muted-stroke" x={w.x + 104} y={w.y + 11} width="8" height="8" />
          <path class="pf-muted-stroke" d={`M${w.x + 120} ${w.y + 11} l8 8 m0 -8 l-8 8`} />
        </>
      )}
      {w.kind === 'linux' && (
        <rect class="pf-bar" x={w.x} y={w.y} width="136" height="28" rx="14" />
      )}
      {bars.map((h, j) => (
        <rect
          class="bar"
          x={w.x + 34 + j * 12}
          y={w.y + 80 - 22 * h}
          width="6"
          height={44 * h}
          rx="3"
          fill={`url(#${accentId})`}
          style={`--j:${j}`}
        />
      ))}
      <rect class="pf-muted" x={w.x + 22} y={w.y + 120} width="92" height="8" rx="4" opacity=".55" />
      <rect class="pf-muted" x={w.x + 22} y={w.y + 136} width="60" height="8" rx="4" opacity=".35" />
    </g>
  ))}
</svg>

<style>
  .motion-pf { display: block; width: 100%; height: auto; }
  .motion-pf .bar { transform-box: fill-box; transform-origin: center; }

  /* Solid token colours: the graphic must read on dark and light bands. */
  .motion-pf .pf-win { fill: var(--wp-illustration-node); stroke: var(--wp-illustration-node-border); }
  .motion-pf .pf-muted { fill: var(--wp-illustration-muted); }
  .motion-pf .pf-muted-stroke { stroke: var(--wp-illustration-muted); }
  .motion-pf .pf-bar { fill: var(--wp-illustration-node-border); }

  @media (prefers-reduced-motion: no-preference) {
    .motion-pf .win { animation: pf-float 7s ease-in-out infinite; animation-delay: calc(var(--i) * -2.3s); }
    .motion-pf .bar { animation: pf-bar 1.2s ease-in-out infinite alternate; animation-delay: calc(var(--j) * -0.2s); }
  }
  @keyframes pf-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
  @keyframes pf-bar { from { transform: scaleY(0.35); } to { transform: scaleY(1); } }
</style>
