---
import SectionEyebrow from './SectionEyebrow.astro';
import { t, currentLocale, pathForSlug } from '../scripts/i18n.ts';

const lang = currentLocale(Astro.currentLocale);
const detailsHref = pathForSlug(lang, 'privacy-speech-recognition');

// Two honest audio paths: local is the default, cloud only when the user picks
// a provider. Each path is one ordered list drawn inside a "your computer"
// boundary; on the cloud path the provider step sits outside it. The list
// order stays mic → engine/provider → text for screen readers.
const paths = [
  {
    key: 'local',
    titleKey: 'privacy.offline.title',
    descKey: 'privacy.offline.desc',
    badgeKey: 'privacy.badge.default',
    steps: ['privacy.flow.mic', 'privacy.flow.localEngine', 'privacy.flow.localResult'],
  },
  {
    key: 'cloud',
    titleKey: 'privacy.directapi.title',
    descKey: 'privacy.directapi.desc',
    badgeKey: 'privacy.badge.optional',
    steps: ['privacy.flow.mic', 'privacy.flow.cloudProvider', 'privacy.flow.cloudResult'],
  },
] as const;
---

<!-- Privacy: where the audio goes (local default vs. optional cloud), plus
     one line on telemetry. No blanket "no network" claim: model downloads,
     updates and opt-out telemetry exist. -->
<section id="privacy" class="band band-spotlight relative wp-section scroll-mt-20" data-testid="privacy">
  <div class="relative wp-container privacy-layout">
    <div class="wp-section-head privacy-head">
      <SectionEyebrow key="privacy.label" />
      <h2 class="section-title"><span data-i18n="privacy.titleLead">{t(lang, "privacy.titleLead")}</span><span class="wp-marker" data-i18n="privacy.titleAccent">{t(lang, "privacy.titleAccent")}</span><span data-i18n="privacy.titleTail">{t(lang, "privacy.titleTail")}</span></h2>
      <p class="wp-lead mt-4" data-i18n="privacy.desc">{t(lang, "privacy.desc")}</p>
    </div>

    <div class="privacy-paths">
      {paths.map((p) => (
        <article class={`privacy-path privacy-path--${p.key}`} data-testid={`privacy-path-${p.key}`}>
          <span class="privacy-badge" data-i18n={p.badgeKey}>{t(lang, p.badgeKey)}</span>
          <h3 class="privacy-path__title" data-i18n={p.titleKey}>{t(lang, p.titleKey)}</h3>
          <ol class="privacy-flow" data-device-label={t(lang, 'privacy.flow.device')}>
            {p.steps.map((s, i) => (
              <li class={i === 1 ? 'privacy-step privacy-step--engine' : 'privacy-step'}><span data-i18n={s}>{t(lang, s)}</span></li>
            ))}
          </ol>
          <p class="privacy-path__desc" data-i18n={p.descKey}>{t(lang, p.descKey)}</p>
        </article>
      ))}
    </div>

    <div class="privacy-telemetry">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"/><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"/><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"/><path d="m2 2 20 20"/></svg>
      <div>
        <h3 class="privacy-telemetry__title" data-i18n="privacy.telemetry.title">{t(lang, "privacy.telemetry.title")}</h3>
        <p class="privacy-telemetry__desc" data-i18n="privacy.telemetry.desc">{t(lang, "privacy.telemetry.desc")}</p>
        <a href={detailsHref} class="privacy-details" data-testid="privacy-details">
          <span data-i18n="privacy.details">{t(lang, "privacy.details")}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .privacy-layout {
    display: grid;
    gap: var(--wp-space-8);
  }
  .privacy-head {
    margin-bottom: 0;
  }

  .privacy-paths {
    display: grid;
    gap: var(--wp-space-5);
  }
  @media (min-width: 768px) {
    .privacy-paths {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .privacy-path {
    display: flex;
    flex-direction: column;
    gap: var(--wp-space-4);
    padding: var(--wp-card-pad);
    border-radius: var(--wp-card-radius-lg);
    border: 1px solid var(--wp-card-border);
    background: var(--wp-card-fill);
    box-shadow: var(--wp-card-shadow);
  }
  /* Evidence-card kicker: mono, small; the default route is the amber one. */
  .privacy-badge {
    align-self: flex-start;
    padding: var(--wp-space-1) var(--wp-space-3);
    border-radius: var(--wp-radius-pill);
    font-family: var(--font-mono);
    font-size: var(--wp-font-size-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--wp-card-meta);
    border: 1px solid var(--wp-border-strong);
  }
  .privacy-path--local .privacy-badge {
    color: var(--wp-marker-text);
    background: var(--wp-marker-stroke);
    border-color: var(--wp-marker-stroke);
  }
  .privacy-path__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--wp-font-size-h3);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--wp-card-title);
    text-wrap: balance;
  }
  .privacy-path__desc {
    margin: 0;
    font-size: var(--wp-font-size-md);
    line-height: 1.6;
    color: var(--wp-card-text);
  }

  /* ---- Route: steps inside the dashed "your computer" boundary ---- */
  .privacy-flow {
    list-style: none;
    margin: var(--wp-space-8) var(--wp-space-3) var(--wp-space-3);
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    /* Explicit rows, so the boundary's `1 / -1` spans every step. */
    grid-template-rows: repeat(3, auto);
    gap: var(--wp-space-5);
  }
  /* The boundary is the list's own grid item, spanning the device column,
     so it needs no extra markup and the list order stays untouched. */
  .privacy-flow::before {
    content: attr(data-device-label);
    grid-column: 1;
    grid-row: 1 / -1;
    align-self: stretch;
    margin: calc(-1 * var(--wp-space-8)) calc(-1 * var(--wp-space-3)) calc(-1 * var(--wp-space-3));
    padding: var(--wp-space-2) var(--wp-space-3);
    border: 2px dashed color-mix(in srgb, var(--wp-accent-default) 55%, transparent);
    border-radius: var(--wp-radius-control);
    font-family: var(--font-mono);
    font-size: var(--wp-font-size-2xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--wp-text-link);
    pointer-events: none;
  }
  .privacy-step {
    position: relative;
    grid-column: 1;
    padding: var(--wp-space-2) var(--wp-space-3);
    border-radius: var(--wp-radius-control);
    background: var(--wp-surface-control);
    border: 1px solid var(--wp-border-default);
    font-size: var(--wp-font-size-md);
    color: var(--wp-card-title);
  }
  .privacy-step:nth-child(1) { grid-row: 1; }
  .privacy-step:nth-child(2) { grid-row: 2; }
  .privacy-step:nth-child(3) { grid-row: 3; }
  .privacy-path--local .privacy-step + .privacy-step::before {
    content: "↓";
    position: absolute;
    left: var(--wp-space-4);
    top: calc(-1 * var(--wp-space-5));
    line-height: var(--wp-space-5);
    font-size: var(--wp-font-size-sm);
    color: var(--wp-text-link);
  }
  /* Cloud: mic and text stay inside the boundary, the provider sits outside
     to the right — audio leaves the computer and the text comes back. */
  .privacy-path--cloud .privacy-flow {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: repeat(2, auto);
    column-gap: var(--wp-space-10);
    align-items: center;
  }
  .privacy-path--cloud .privacy-step:nth-child(3) { grid-row: 2; }
  .privacy-path--cloud .privacy-step--engine {
    grid-column: 2;
    grid-row: 1 / span 2;
    border-style: dashed;
    border-color: var(--wp-border-strong);
    background: transparent;
  }
  .privacy-path--cloud .privacy-step--engine::before {
    content: "⇄";
    position: absolute;
    right: 100%;
    top: 50%;
    width: var(--wp-space-10);
    translate: 0 -50%;
    text-align: center;
    font-size: var(--wp-font-size-md);
    color: var(--wp-card-meta);
  }

  /* ---- Telemetry row ---- */
  .privacy-telemetry {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: var(--wp-space-4);
    padding-top: var(--wp-space-6);
    border-top: 1px solid var(--wp-border-default);
  }
  .privacy-telemetry > svg {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--wp-text-link);
    margin-top: var(--wp-space-1);
  }
  /* Wide screens: copy left, details link anchored right, so the row spans
     the frame like the two path cards above it. */
  @media (min-width: 1280px) {
    .privacy-telemetry > div {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--wp-space-12);
      align-items: center;
    }
    .privacy-telemetry > div > .privacy-details {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
  .privacy-telemetry__title {
    font-weight: 600;
    color: var(--wp-text-primary);
    margin-bottom: var(--wp-space-1);
  }
  .privacy-telemetry__desc {
    font-size: var(--wp-font-size-md);
    line-height: 1.6;
    color: var(--wp-text-secondary);
    max-width: var(--measure-lead);
  }
  .privacy-details {
    display: inline-flex;
    align-items: center;
    gap: var(--wp-space-1);
    min-height: 44px;
    font-size: var(--wp-font-size-md);
    font-weight: 600;
    color: var(--wp-text-link);
    text-decoration: none;
  }
  .privacy-details svg {
    width: 1rem;
    height: 1rem;
  }
  .privacy-details:hover span {
    text-decoration: underline;
  }
</style>
