---
import SectionEyebrow from './SectionEyebrow.astro';
import { t, currentLocale, pathForSlug } from '../scripts/i18n.ts';

const lang = currentLocale(Astro.currentLocale);
const detailsHref = pathForSlug(lang, 'privacy-speech-recognition');

// Two honest audio paths: local is the default, cloud only when the user picks
// a provider. Each path is a plain ordered list, so the "graphic" reads the
// same for screen readers.
const paths = [
  {
    key: 'local',
    titleKey: 'privacy.offline.title',
    descKey: 'privacy.offline.desc',
    badgeKey: 'privacy.badge.default',
    steps: ['privacy.flow.mic', 'privacy.flow.localEngine', 'privacy.flow.localResult'],
  },
  {
    key: 'cloud',
    titleKey: 'privacy.directapi.title',
    descKey: 'privacy.directapi.desc',
    badgeKey: 'privacy.badge.optional',
    steps: ['privacy.flow.mic', 'privacy.flow.cloudProvider', 'privacy.flow.cloudResult'],
  },
] as const;
---

<!-- Privacy: where the audio goes (local default vs. optional cloud), plus
     one line on telemetry. No blanket "no network" claim: model downloads,
     updates and opt-out telemetry exist. -->
<section id="privacy" class="band band-spotlight relative wp-section scroll-mt-20" data-testid="privacy">
  <div class="relative wp-container privacy-layout">
    <div class="wp-section-head privacy-head">
      <svg class="privacy-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="M9 12h1M12 9v6M15 11v2"/></svg>
      <SectionEyebrow key="privacy.label" />
      <h2 class="section-title"><span data-i18n="privacy.titleLead">{t(lang, "privacy.titleLead")}</span><span class="text-gradient-brand" data-i18n="privacy.titleAccent">{t(lang, "privacy.titleAccent")}</span><span data-i18n="privacy.titleTail">{t(lang, "privacy.titleTail")}</span></h2>
      <p class="wp-lead mt-4" data-i18n="privacy.desc">{t(lang, "privacy.desc")}</p>
    </div>

    <div class="privacy-paths">
      {paths.map((p) => (
        <article class={`privacy-path privacy-path--${p.key}`} data-testid={`privacy-path-${p.key}`}>
          <span class="privacy-badge" data-i18n={p.badgeKey}>{t(lang, p.badgeKey)}</span>
          <h3 class="privacy-path__title" data-i18n={p.titleKey}>{t(lang, p.titleKey)}</h3>
          <ol class="privacy-flow">
            {p.steps.map((s) => (
              <li><span data-i18n={s}>{t(lang, s)}</span></li>
            ))}
          </ol>
          <p class="privacy-path__desc" data-i18n={p.descKey}>{t(lang, p.descKey)}</p>
        </article>
      ))}
    </div>

    <div class="privacy-telemetry">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"/><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"/><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"/><path d="m2 2 20 20"/></svg>
      <div>
        <h3 class="privacy-telemetry__title" data-i18n="privacy.telemetry.title">{t(lang, "privacy.telemetry.title")}</h3>
        <p class="privacy-telemetry__desc" data-i18n="privacy.telemetry.desc">{t(lang, "privacy.telemetry.desc")}</p>
        <a href={detailsHref} class="privacy-details" data-testid="privacy-details">
          <span data-i18n="privacy.details">{t(lang, "privacy.details")}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .privacy-layout {
    display: grid;
    gap: 2rem;
  }
  .privacy-head {
    margin-bottom: 0;
  }
  .privacy-mark {
    width: 2rem;
    height: 2rem;
    color: var(--color-brand-cyan);
    margin-bottom: 0.75rem;
  }

  .privacy-paths {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .privacy-paths {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .privacy-path {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    border-radius: var(--radius-card);
    border: 1px solid rgb(255 255 255 / 0.12);
    background: var(--color-brand-card);
    box-shadow: var(--shadow-card);
  }
  /* The default route gets a subtle cyan edge; cloud stays neutral. */
  .privacy-path--local {
    border-color: color-mix(in srgb, var(--color-brand-cyan) 45%, transparent);
  }
  .privacy-badge {
    align-self: flex-start;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-ink-muted);
    border: 1px solid rgb(255 255 255 / 0.16);
  }
  .privacy-path--local .privacy-badge {
    color: var(--color-brand-darker);
    background: var(--color-brand-cyan);
    border-color: var(--color-brand-cyan);
  }
  .privacy-path__title {
    font-size: var(--type-card-title);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink);
  }
  .privacy-path__desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  /* Flow: vertical with down arrows; each step is a small chip. */
  .privacy-flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  .privacy-flow li {
    position: relative;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-control);
    background: rgb(255 255 255 / 0.04);
    border: 1px solid rgb(255 255 255 / 0.08);
    font-size: 1rem;
    color: var(--color-ink);
  }
  .privacy-flow li + li::before {
    content: "↓";
    position: absolute;
    left: 0.875rem;
    top: -1.25rem;
    line-height: 1.25rem;
    font-size: 0.875rem;
    color: var(--color-brand-cyan);
  }
  .privacy-path--cloud .privacy-flow li + li::before {
    color: var(--color-ink-subtle);
  }

  .privacy-telemetry {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
  }
  .privacy-telemetry > svg {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-brand-cyan);
    margin-top: 0.125rem;
  }
  /* Wide screens: copy left, details link anchored right, so the row spans
     the frame like the two path cards above it. */
  @media (min-width: 1280px) {
    .privacy-telemetry > div {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 3rem;
      align-items: center;
    }
    .privacy-telemetry > div > .privacy-details {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
  .privacy-telemetry__title {
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 0.25rem;
  }
  .privacy-telemetry__desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
    max-width: var(--measure-lead);
  }
  .privacy-details {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-brand-cyan);
    text-decoration: none;
  }
  .privacy-details svg {
    width: 1rem;
    height: 1rem;
  }
  .privacy-details:hover span {
    text-decoration: underline;
  }
</style>
