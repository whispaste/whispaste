---
import { t } from '../scripts/i18n.ts';

interface Props {
  variant?: 'landing' | 'subpage';
}
const { variant = 'landing' } = Astro.props;

const lang = (Astro.currentLocale === 'en' ? 'en' : 'de') as 'de' | 'en';

const impressumHref = lang === 'de' ? '/impressum/' : '/en/impressum/';
const privacyHref = lang === 'de' ? '/datenschutz/' : '/en/privacy/';
const changelogHref = lang === 'de' ? '/changelog/' : '/en/changelog/';
const downloadHref = lang === 'de' ? '/download/' : '/en/download/';
const sponsorHref = lang === 'de' ? '/sponsor/' : '/en/sponsor/';
const screenshotsHref = lang === 'de' ? '/screenshots/' : '/en/screenshots/';
const year = new Date().getFullYear();

// Ressourcen-Spalte: verlinkt die Long-Tail-Erklär-/Vergleichsseiten von der
// Startseite aus. Ohne diese Links waren die Seiten reine Sitemap-Einträge
// ohne ein einziges internes <a href> — siehe seo-audit vom 2026-07-02.
const whisperDesktopHref = lang === 'de' ? '/whisper-desktop/' : '/en/whisper-desktop/';
const enginesHref = lang === 'de' ? '/engines/' : '/en/engines/';
const engineBenchmarksHref = lang === 'de' ? '/engine-benchmarks/' : '/en/engine-benchmarks/';
const offlineSttHref = lang === 'de' ? '/offline-speech-to-text/' : '/en/offline-speech-to-text/';
const privacyExplainerHref = lang === 'de' ? '/privatsphaere-spracherkennung/' : '/en/privacy-speech-recognition/';
const dictationAlternativesHref = lang === 'de' ? '/vergleich/diktiersoftware-alternativen/' : '/en/comparison/voice-input-tool-alternatives/';
const osDictationHref = lang === 'de' ? '/vergleich/whispaste-vs-system-spracheingabe/' : '/en/comparison/whispaste-vs-system-speech-to-text/';
const gpuCheckHref = lang === 'de' ? '/gpu-kompatibilitaet/' : '/en/gpu-compatibility/';
const modelSizeHref = lang === 'de' ? '/whisper-modellgroesse/' : '/en/whisper-model-size/';
const linuxSttHref = lang === 'de' ? '/linux-spracherkennung/' : '/en/linux-speech-to-text/';
---

{/* pb-28 unter 640px: die fixe MobileCta-Leiste (~75px hoch) verdeckte sonst
    am Seitenende dauerhaft die letzte Footer-Zeile. */}
{variant === 'landing' ? (
  <footer class="footer-flow pt-14 pb-28 sm:pb-8 border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1fr_1fr]">
        <!-- Brand + tagline -->
        <div class="max-w-xs">
          <div class="flex items-center gap-2 mb-3">
            <img src="/wordmark-dark.png" alt="WhisPaste" width="199" height="64" loading="lazy" decoding="async" class="h-6 w-auto nav-logo-dark" />
            <img src="/wordmark-light.png" alt="WhisPaste" width="199" height="64" loading="lazy" decoding="async" class="h-6 w-auto nav-logo-light hidden" />
          </div>
          <p class="text-ink-muted text-sm leading-relaxed" data-i18n="footer.tagline">{t(lang, "footer.tagline")}</p>
        </div>

        <!-- Produkt -->
        <nav aria-label={t(lang, "nav.footerAria")} data-i18n-aria="nav.footerAria" class="flex flex-col gap-2.5 text-sm">
          <p class="text-ink-subtle text-xs font-semibold uppercase tracking-wider mb-1" data-i18n="footer.col.product">{t(lang, "footer.col.product")}</p>
          <a href={downloadHref} class="text-ink-muted hover:text-white transition-colors" data-i18n="footer.download">{t(lang, "footer.download")}</a>
          <a href={screenshotsHref} class="text-ink-muted hover:text-white transition-colors" data-i18n="footer.screenshots">{t(lang, "footer.screenshots")}</a>
          <a href={changelogHref} class="text-ink-muted hover:text-white transition-colors" data-i18n="footer.changelog">{t(lang, "footer.changelog")}</a>
        </nav>

        <!-- Ressourcen -->
        <nav class="flex flex-col gap-2.5 text-sm">
          <p class="text-ink-subtle text-xs font-semibold uppercase tracking-wider mb-1" data-i18n="footer.col.resources">{t(lang, "footer.col.resources")}</p>
          <a href={enginesHref} class="text-ink-muted hover:text-white transition-colors" data-i18n="explainer.engines.breadcrumb">{t(lang, "explainer.engines.breadcrumb")}</a>
          <a href={engineBenchmarksHref} class="text-ink-muted hover:text-white transition-colors" data-i18n="explainer.engineBenchmarks.breadcrumb">{t(lang, "explainer.engineBenchmarks.breadcrumb")}</a>
          <a href={offlineSttHref} class="text-ink-muted hover:text-white transition-colors" data-i18n="explainer.offlineStt.breadcrumb">{t(lang, "explainer.offlineStt.breadcrumb")}</a>
          <a href={whisperDesktopHref} class="text-ink-muted hover:text-white transition-colors" data-i18n="explainer.whisperDesktop.breadcrumb">{t(lang, "explainer.whisperDesktop.breadcrumb")}</a>
          <a href={gpuCheckHref} class="text-ink-muted hover:text-white transition-colors" data-i18n="gpuCheck.breadcrumb">{t(lang, "gpuCheck.breadcrumb")}</a>
          <a href={modelSizeHref} class="text-ink-muted hover:text-white transition-colors" data-i18n="modelSize.breadcrumb">{t(lang, "modelSize.breadcrumb")}</a>
          <a href={linuxSttHref} class="text-ink-muted hover:text-white transition-colors" data-i18n="linuxStt.breadcrumb">{t(lang, "linuxStt.breadcrumb")}</a>
          <a href={privacyExplainerHref} class="text-ink-muted hover:text-white transition-colors" data-i18n="explainer.privacy.breadcrumb">{t(lang, "explainer.privacy.breadcrumb")}</a>
          <a href={dictationAlternativesHref} class="text-ink-muted hover:text-white transition-colors" data-i18n="comparison.dictationAlternatives.breadcrumb">{t(lang, "comparison.dictationAlternatives.breadcrumb")}</a>
          <a href={osDictationHref} class="text-ink-muted hover:text-white transition-colors" data-i18n="comparison.osDictation.breadcrumb">{t(lang, "comparison.osDictation.breadcrumb")}</a>
        </nav>

        <!-- Rechtliches -->
        <nav class="flex flex-col gap-2.5 text-sm">
          <p class="text-ink-subtle text-xs font-semibold uppercase tracking-wider mb-1" data-i18n="footer.col.legal">{t(lang, "footer.col.legal")}</p>
          <a href={impressumHref} class="text-ink-muted hover:text-white transition-colors" data-i18n="footer.impressum">{t(lang, "footer.impressum")}</a>
          <a href={privacyHref} class="text-ink-muted hover:text-white transition-colors" data-i18n="footer.privacy" data-i18n-href="footer.privacy.href">{t(lang, "footer.privacy")}</a>
          <a href="https://github.com/whispaste/whispaste/blob/main/LICENSE" target="_blank" rel="noopener" class="text-ink-muted hover:text-white transition-colors" data-i18n="footer.license">{t(lang, "footer.license")}</a>
        </nav>

        <!-- Projekt -->
        <nav class="flex flex-col gap-2.5 text-sm">
          <p class="text-ink-subtle text-xs font-semibold uppercase tracking-wider mb-1" data-i18n="footer.col.project">{t(lang, "footer.col.project")}</p>
          <a href="https://github.com/whispaste/whispaste" target="_blank" rel="noopener" aria-label={t(lang, "nav.githubAria")} data-i18n-aria="nav.githubAria" class="inline-flex items-center gap-1.5 text-ink-muted hover:text-white transition-colors group">
            <svg class="w-4 h-4 opacity-70 group-hover:opacity-100 transition-opacity" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.11.82-.26.82-.58v-2.16c-3.34.73-4.04-1.61-4.04-1.61a3.18 3.18 0 0 0-1.33-1.76c-1.09-.74.08-.73.08-.73a2.52 2.52 0 0 1 1.84 1.24 2.56 2.56 0 0 0 3.5 1 2.56 2.56 0 0 1 .76-1.6c-2.67-.3-5.47-1.33-5.47-5.93a4.64 4.64 0 0 1 1.24-3.22 4.3 4.3 0 0 1 .12-3.18s1-.33 3.3 1.23a11.38 11.38 0 0 1 6 0c2.28-1.56 3.29-1.23 3.29-1.23a4.3 4.3 0 0 1 .12 3.18 4.64 4.64 0 0 1 1.23 3.22c0 4.61-2.81 5.63-5.48 5.93a2.86 2.86 0 0 1 .82 2.22v3.29c0 .32.22.7.82.58A12 12 0 0 0 12 .3"/></svg>
            GitHub
          </a>
          <a href={sponsorHref} class="inline-flex items-center gap-1.5 text-pink-400/80 hover:text-pink-400 transition-colors font-medium" data-i18n="footer.sponsor">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
            {t(lang, "footer.sponsor")}
          </a>
          <a href="https://silvio-lindstedt.de" target="_blank" rel="noopener me" class="text-ink-muted hover:text-white transition-colors" data-i18n="footer.author">{t(lang, "footer.author")}</a>
        </nav>
      </div>

      <!-- Bottom bar -->
      <div class="mt-10 pt-6 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-ink-subtle">
        <p>© {year} Silvio Lindstedt</p>
        <p data-i18n="footer.rights">{t(lang, "footer.rights")}</p>
      </div>
    </div>
  </footer>
) : (
  <footer class="py-6 border-t border-white/5" role="contentinfo">
    <div class="max-w-4xl mx-auto px-6 text-center text-sm text-gray-500 flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
      <a href={downloadHref} class="hover:text-white transition-colors" data-i18n="footer.download">{t(lang, "footer.download")}</a>
      <a href="https://github.com/whispaste/whispaste/blob/main/LICENSE" target="_blank" rel="noopener" class="hover:text-white transition-colors" data-i18n="footer.license">{t(lang, "footer.license")}</a>
      <a href="https://silvio-lindstedt.de" target="_blank" rel="noopener me" class="hover:text-white transition-colors" data-i18n="footer.author">{t(lang, "footer.author")}</a>
    </div>
  </footer>
)}

<style>
  /* Flow-Glint — ein leiser Cyan-Schimmer wandert langsam über die obere
     Haarlinie des Landing-Footers, wie Licht auf einer Wasserkante: das
     Fluss-Motiv klingt am Seitenende aus statt hart abzureißen. Nur
     background-position, 16s-Tide, kein Layout-Einfluss. Theme-adaptiv über
     das brand-cyan-Token. */
  .footer-flow {
    position: relative;
  }
  .footer-flow::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--color-brand-cyan) 45%, transparent),
      transparent
    );
    background-size: 34% 100%;
    background-repeat: no-repeat;
    background-position: 0% 0;
    animation: footer-glint 16s ease-in-out infinite;
  }
  @keyframes footer-glint {
    0%, 100% { background-position: 0% 0; }
    50% { background-position: 100% 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-flow::before {
      animation: none;
      opacity: 0;
    }
  }
</style>
