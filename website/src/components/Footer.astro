---
interface Props {
  variant?: 'landing' | 'subpage';
}
const { variant = 'landing' } = Astro.props;
---

{variant === 'landing' ? (
  <footer class="py-8 border-t border-white/5" role="contentinfo">
    <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-500">
      <div class="flex items-center gap-2">
        <img id="footerLogo" src="/app-icon-dark.png" alt="" class="w-6 h-6 opacity-60" />
        <span>&copy; 2025 <a href="https://github.com/silvio-l" class="hover:text-white transition-colors">Silvio Lindstedt</a></span>
      </div>
      <nav aria-label="Footer navigation" data-i18n-aria="nav.footerAria" class="flex items-center gap-4">
        <a href="/impressum/" class="hover:text-white transition-colors" data-i18n="footer.impressum">Legal Notice</a>
        <a href="/privacy/" class="hover:text-white transition-colors" data-i18n="footer.privacy" data-i18n-href="footer.privacy.href">Privacy Policy</a>
        <span data-i18n="footer.license">MIT License</span>
        <a href="https://github.com/whispaste/whispaste" target="_blank" rel="noopener" aria-label="WhisPaste on GitHub" data-i18n-aria="nav.githubAria" class="hover:text-white transition-colors">GitHub</a>
        <a href="https://github.com/sponsors/silvio-l" target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-pink-400 transition-colors" data-i18n="footer.sponsor">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
          Sponsor
        </a>
      </nav>
    </div>
  </footer>
) : (
  <footer class="py-6 border-t border-white/5" role="contentinfo">
    <div class="max-w-4xl mx-auto px-6 text-center text-sm text-gray-500">
      &copy; 2025 <a href="https://github.com/silvio-l" class="hover:text-white transition-colors">Silvio Lindstedt</a>
    </div>
  </footer>
)}
