---
import SectionEyebrow from './SectionEyebrow.astro';
import { t, currentLocale } from '../scripts/i18n.ts';

const lang = currentLocale(Astro.currentLocale);

// Locale-correct typographic quotes for the spoken line in step 2.
const QUOTES: Record<typeof lang, { open: string; close: string }> = {
  de: { open: '„', close: '“' },
  en: { open: '“', close: '”' },
  es: { open: '«', close: '»' },
  pt: { open: '“', close: '”' },
  it: { open: '«', close: '»' },
  ru: { open: '«', close: '»' },
  zh: { open: '“', close: '”' },
  fr: { open: '«', close: '»' },
};
const quote = QUOTES[lang];

// One scene per everyday context. The chat scene is the no-JS default; the
// switcher only swaps which finished example is shown, it never fakes input.
const scenes = [
  { id: 'chat', tab: 'appdemo.scene.appName', reply: 'appdemo.scene.reply', caption: 'appdemo.scene.chat.caption' },
  { id: 'mail', tab: 'appdemo.scene.mail.tab', reply: 'appdemo.scene.mail.reply', caption: 'appdemo.scene.mail.caption' },
  { id: 'editor', tab: 'appdemo.scene.editor.tab', reply: 'appdemo.scene.editor.reply', caption: 'appdemo.scene.editor.caption' },
] as const;
---

<!-- How it works — the one explanation arc for hotkey → speak → text. A
     single stage: the three steps on the left, one finished example on the
     right (chat, mail or editor) with the real recording overlay rendered on
     a canvas, 1:1 with the in-app OverlayPainter. Own generic app chrome only,
     no third-party brand marks. -->
<section
  id="app-paste-demo"
  class="band band-spotlight wp-section scroll-mt-20 scroll-reveal"
>
  <div class="relative wp-container">
    <div class="wp-section-head is-centered">
      <SectionEyebrow key="appdemo.label" />
      <h2 class="section-title">
        <span data-i18n="appdemo.titleLead">{t(lang, 'appdemo.titleLead')}</span><span
          class="text-gradient-brand"
          data-i18n="appdemo.titleAccent"
        >{t(lang, 'appdemo.titleAccent')}</span><span
          data-i18n="appdemo.titleTail"
        >{t(lang, 'appdemo.titleTail')}</span>
      </h2>
      <p class="wp-lead mt-4" data-i18n="appdemo.subtitle">{t(lang, 'appdemo.subtitle')}</p>
    </div>

    <div class="apd-stage" data-testid="demo" data-scene="chat">
      <!-- Steps -->
      <ol class="apd-steps" aria-label={t(lang, 'appdemo.flowAria')}>
        <li class="apd-step">
          <span class="apd-num" aria-hidden="true">1</span>
          <div class="apd-step-body">
            <p class="apd-step-title" data-i18n="appdemo.step1.caption">{t(lang, 'appdemo.step1.caption')}</p>
            <div class="apd-hotkey" aria-hidden="true">
              <!-- Default modifier differs per OS: Ctrl on Windows/Linux, Cmd on macOS. -->
              <kbd class="apd-key apd-key--mod-ctrl" data-i18n="hero.hotkey.mod">{t(lang, 'hero.hotkey.mod')}</kbd>
              <kbd class="apd-key apd-key--mod-cmd">⌘</kbd>
              <span class="apd-plus">+</span>
              <kbd class="apd-key">Shift</kbd>
              <span class="apd-plus">+</span>
              <kbd class="apd-key">D</kbd>
            </div>
          </div>
        </li>
        <li class="apd-step">
          <span class="apd-num" aria-hidden="true">2</span>
          <div class="apd-step-body">
            <p class="apd-step-title" data-i18n="appdemo.step2.caption">{t(lang, 'appdemo.step2.caption')}</p>
            {scenes.map((s) => (
              <p class="apd-spoken" data-scene-only={s.id}>
                <span class="apd-quote" aria-hidden="true">{quote.open}</span><span data-i18n={s.reply}>{t(lang, s.reply)}</span><span class="apd-quote" aria-hidden="true">{quote.close}</span>
              </p>
            ))}
          </div>
        </li>
        <li class="apd-step">
          <span class="apd-num" aria-hidden="true">3</span>
          <div class="apd-step-body">
            <p class="apd-step-title" data-i18n="appdemo.step3.caption">{t(lang, 'appdemo.step3.caption')}</p>
            {scenes.map((s) => (
              <p class="apd-step-note" data-scene-only={s.id} data-i18n={s.caption}>{t(lang, s.caption)}</p>
            ))}
          </div>
        </li>
      </ol>

      <!-- Scene -->
      <div class="apd-scene">
        <div class="apd-switch" role="group" aria-label={t(lang, 'appdemo.sceneSwitchAria')} data-i18n-aria="appdemo.sceneSwitchAria">
          {scenes.map((s, i) => (
            <button
              type="button"
              class="apd-switch-btn"
              data-scene-btn={s.id}
              aria-pressed={i === 0 ? 'true' : 'false'}
              data-testid={`demo-scene-${s.id}`}
            ><span data-i18n={s.tab}>{t(lang, s.tab)}</span></button>
          ))}
        </div>

        <div class="apd-window" aria-hidden="true">
          <!-- Chat -->
          <div class="apd-panel" data-scene-only="chat">
            <div class="apd-chrome">
              <span class="apd-appname" data-i18n="appdemo.scene.appName">{t(lang, 'appdemo.scene.appName')}</span>
            </div>
            <div class="apd-panel-body apd-chat">
              <div class="apd-msg-in">
                <span class="apd-avatar">T</span>
                <span class="apd-bubble" data-i18n="appdemo.scene.incoming">{t(lang, 'appdemo.scene.incoming')}</span>
              </div>
              <div class="apd-field apd-field--filled">
                <span data-i18n="appdemo.scene.reply">{t(lang, 'appdemo.scene.reply')}</span><span class="apd-caret"></span>
              </div>
            </div>
          </div>

          <!-- Mail -->
          <div class="apd-panel" data-scene-only="mail">
            <div class="apd-chrome">
              <span class="apd-appname" data-i18n="appdemo.scene.mail.tab">{t(lang, 'appdemo.scene.mail.tab')}</span>
            </div>
            <div class="apd-panel-body">
              <p class="apd-mail-subject" data-i18n="appdemo.scene.mail.subject">{t(lang, 'appdemo.scene.mail.subject')}</p>
              <div class="apd-field apd-field--filled apd-field--tall">
                <span data-i18n="appdemo.scene.mail.reply">{t(lang, 'appdemo.scene.mail.reply')}</span><span class="apd-caret"></span>
              </div>
            </div>
          </div>

          <!-- Editor -->
          <div class="apd-panel" data-scene-only="editor">
            <div class="apd-chrome">
              <span class="apd-appname">review.ts</span>
            </div>
            <div class="apd-panel-body apd-code">
              <span class="apd-ln">41</span><code>if (input.length &gt; MAX_LEN) {'{'}</code>
              <span class="apd-ln">42</span><code>  return reject(input);</code>
              <span class="apd-ln">43</span><code>{'}'}</code>
              <span class="apd-ln">44</span><div class="apd-field apd-field--filled apd-field--comment">
                <span class="apd-comment-mark">//</span>
                <span data-i18n="appdemo.scene.editor.reply">{t(lang, 'appdemo.scene.editor.reply')}</span><span class="apd-caret"></span>
              </div>
            </div>
          </div>

          <div class="apd-inserted">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span data-i18n="appdemo.scene.inserted">{t(lang, 'appdemo.scene.inserted')}</span>
          </div>
        </div>

        <div class="apd-overlay">
          <canvas
            class="apd-overlay-canvas"
            width="692"
            height="160"
            role="img"
            aria-label={t(lang, 'appdemo.overlayAria')}></canvas>
        </div>
      </div>
    </div>

    <p class="apd-callout">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
      <span data-i18n="appdemo.noSwitch">{t(lang, 'appdemo.noSwitch')}</span>
    </p>
  </div>
</section>

<style>
  /* mockup-colours:start: chat avatar palette belongs to the depicted apps */
  #app-paste-demo {
    --apd-avatar-a: #7c5cd9;
    --apd-avatar-b: #3b6fba;
  }
  /* mockup-colours:end */

  /* ---- Stage: steps 4/12, scene 8/12 from lg; stacked below ---- */
  .apd-stage {
    display: grid;
    gap: var(--wp-space-8);
    padding: clamp(var(--wp-space-5), var(--wp-space-3) + 2vw, var(--wp-space-10));
    border-radius: var(--radius-surface);
    border: 1px solid color-mix(in srgb, var(--color-brand-cyan) 16%, transparent);
    background: color-mix(in srgb, var(--color-brand-card) 72%, transparent);
    box-shadow: var(--shadow-overlay);
  }
  @media (min-width: 1024px) {
    .apd-stage {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: clamp(var(--wp-space-8), var(--wp-space-4) + 2vw, 3.5rem);
      align-items: center;
    }
  }

  /* Only the active scene's variants are shown (no-JS default: chat). */
  .apd-stage:not([data-scene="chat"]) [data-scene-only="chat"],
  .apd-stage:not([data-scene="mail"]) [data-scene-only="mail"],
  .apd-stage:not([data-scene="editor"]) [data-scene-only="editor"] {
    display: none;
  }

  /* ---- Steps ---- */
  .apd-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--wp-space-6);
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .apd-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--wp-space-5);
    }
  }
  .apd-step {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--wp-space-4);
    align-items: start;
  }
  .apd-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    font-weight: 700;
    font-size: var(--wp-font-size-sm);
    color: var(--color-brand-cyan);
    background: color-mix(in srgb, var(--color-brand-cyan) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-brand-cyan) 34%, transparent);
  }
  .apd-step-body {
    display: grid;
    gap: var(--wp-space-2);
    padding-top: var(--wp-space-1);
    min-width: 0;
  }
  .apd-step-title {
    margin: 0;
    font-size: var(--type-card-title);
    font-weight: 700;
    color: var(--color-ink);
  }
  .apd-step-note,
  .apd-spoken {
    margin: 0;
    font-size: var(--wp-font-size-md);
    line-height: 1.5;
    color: var(--color-ink-muted);
  }
  .apd-quote { color: var(--color-brand-cyan); }
  .apd-hotkey {
    display: inline-flex;
    align-items: center;
    gap: var(--wp-space-1);
    justify-self: start;
    font-family: var(--font-mono);
    font-size: var(--wp-font-size-sm);
  }
  .apd-key--mod-cmd {
    display: none;
  }
  :global([data-os="macos"]) .apd-key--mod-ctrl {
    display: none;
  }
  :global([data-os="macos"]) .apd-key--mod-cmd {
    display: inline;
  }
  .apd-key {
    padding: var(--wp-space-1) var(--wp-space-2);
    border-radius: var(--radius-chip);
    border: 1px solid color-mix(in srgb, var(--color-brand-cyan) 34%, var(--color-brand-border));
    background: color-mix(in srgb, var(--color-brand-cyan) 12%, var(--color-brand-card));
    color: var(--color-brand-cyan);
    font-weight: 600;
    font-style: normal;
  }
  .apd-plus { color: var(--color-ink-subtle); }

  /* ---- Scene ---- */
  .apd-scene {
    display: grid;
    gap: var(--wp-space-4);
    min-width: 0;
  }
  .apd-switch {
    display: flex;
    flex-wrap: wrap;
    gap: var(--wp-space-2);
  }
  .apd-switch-btn {
    min-height: 44px;
    padding: var(--wp-space-2) var(--wp-space-5);
    border-radius: var(--radius-pill);
    border: 1px solid var(--wp-border-control);
    background: transparent;
    color: var(--color-ink-muted);
    font-size: var(--wp-font-size-md);
    font-weight: 600;
    cursor: pointer;
    transition: color var(--dur-fast) ease, background-color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .apd-switch-btn:hover { color: var(--color-ink); }
  .apd-switch-btn[aria-pressed="true"] {
    color: var(--wp-accent-on-fill);
    background: var(--wp-accent-fill);
    border-color: var(--wp-accent-fill);
  }
  .apd-switch-btn:focus-visible {
    outline: 2px solid var(--wp-focus-ring);
    outline-offset: 2px;
  }

  /* mockup-colours:start: the chat, mail and editor windows imitate the depicted apps */
  .apd-window {
    position: relative;
    border-radius: var(--radius-card);
    border: 1px solid rgb(255 255 255 / 0.1);
    background: color-mix(in srgb, var(--color-brand-darker) 55%, var(--color-brand-card));
    overflow: hidden;
  }
  .apd-chrome {
    padding: var(--wp-space-3) var(--wp-space-5);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    background: rgb(255 255 255 / 0.03);
  }
  .apd-appname {
    font-size: var(--wp-font-size-sm);
    font-weight: 600;
    color: var(--color-ink-muted);
  }
  .apd-panel-body {
    display: grid;
    gap: var(--wp-space-4);
    padding: var(--wp-space-5) var(--wp-space-5) 4.25rem;
    min-height: 15rem;
    align-content: start;
  }
  .apd-msg-in {
    display: flex;
    align-items: flex-start;
    gap: var(--wp-space-3);
  }
  .apd-avatar {
    flex-shrink: 0;
    width: 1.875rem;
    height: 1.875rem;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--wp-font-size-sm);
    font-weight: 700;
    color: #fff;
    /* AA-safe for the white initial (≥4.78:1 across the gradient). */
    background: linear-gradient(135deg, var(--apd-avatar-a), var(--apd-avatar-b));
  }
  .apd-bubble {
    font-size: var(--wp-font-size-md);
    line-height: 1.45;
    color: var(--color-ink);
    background: rgb(255 255 255 / 0.06);
    border-radius: var(--wp-radius-chip) var(--wp-radius-card) var(--wp-radius-card) var(--wp-radius-card);
    padding: var(--wp-space-2) var(--wp-space-4);
  }
  .apd-chat .apd-field { margin-top: 2.5rem; }
  .apd-field {
    padding: var(--wp-space-3) var(--wp-space-4);
    border-radius: var(--radius-control);
    border: 1px solid rgb(255 255 255 / 0.1);
    font-size: var(--wp-font-size-lead);
    line-height: 1.5;
    color: var(--color-ink);
  }
  .apd-field--filled {
    border-color: color-mix(in srgb, var(--color-brand-cyan) 45%, transparent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-brand-cyan) 10%, transparent);
  }
  /* mockup-colours:end */
  .apd-field--tall { min-height: 7.5rem; }
  .apd-mail-subject {
    margin: 0;
    font-size: var(--wp-font-size-md);
    color: var(--color-ink-muted);
  }
  .apd-code {
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--wp-space-2) var(--wp-space-3);
    font-family: var(--font-mono);
    font-size: var(--wp-font-size-sm);
  }
  .apd-code code {
    color: var(--color-ink-muted);
    white-space: pre;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .apd-ln {
    color: var(--color-ink-subtle);
    text-align: right;
  }
  .apd-field--comment {
    font-family: var(--font-sans);
    font-size: var(--wp-font-size-md);
  }
  .apd-comment-mark {
    margin-right: var(--wp-space-2);
    font-family: var(--font-mono);
    color: var(--color-brand-cyan);
  }
  .apd-caret {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: var(--wp-accent-fill);
    animation: apd-blink 1.1s steps(1) infinite;
  }
  @keyframes apd-blink {
    50% { opacity: 0; }
  }
  /* WhisPaste's own success signal, independent of the depicted app. */
  .apd-inserted {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: inline-flex;
    align-items: center;
    gap: var(--wp-space-2);
    padding: var(--wp-space-1) var(--wp-space-3);
    border-radius: var(--radius-pill);
    font-size: var(--wp-font-size-sm);
    font-weight: 600;
    color: var(--color-brand-cyan);
    background: color-mix(in srgb, var(--color-brand-cyan) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-brand-cyan) 34%, transparent);
  }
  .apd-inserted svg { width: 0.9rem; height: 0.9rem; }

  /* The overlay sits where the app puts it: centred near the bottom edge. */
  .apd-overlay {
    display: flex;
    justify-content: center;
    margin-top: -3.25rem;
    position: relative;
    pointer-events: none;
  }
  /* Canvas draws at a fixed 346×80 logical size (scaled by dpr in JS). No CSS
     shadow: the renderer paints the pill's own shadow like the app does. */
  .apd-overlay-canvas {
    display: block;
    width: 300px;
    max-width: 100%;
    height: auto;
  }

  .apd-callout {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--wp-space-2);
    margin: var(--wp-space-6) 0 0;
    font-size: var(--wp-font-size-md);
    color: var(--color-ink-muted);
  }
  .apd-callout svg {
    width: 1rem;
    height: 1rem;
    color: var(--color-brand-cyan);
  }

  @media (max-width: 479px) {
    .apd-panel-body { min-height: 12rem; }
    .apd-inserted { left: 1rem; right: auto; }
    .apd-overlay { margin-top: -1.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .apd-caret { animation: none; }
  }
</style>

<script>
  import { OverlayDemo, type OverlayDemoLang } from '../scripts/overlay-demo';
  import type { OverlayTheme } from '../scripts/overlay-mockup';

  // Scene switcher: buttons with aria-pressed swap the visible example.
  const stage = document.querySelector<HTMLElement>('#app-paste-demo .apd-stage');
  const buttons = stage?.querySelectorAll<HTMLButtonElement>('[data-scene-btn]') ?? [];
  for (const btn of buttons) {
    btn.addEventListener('click', () => {
      if (!stage) return;
      stage.dataset.scene = btn.dataset.sceneBtn;
      for (const b of buttons) b.setAttribute('aria-pressed', String(b === btn));
    });
  }

  // The overlay renders the real WhisPaste recording pill on a <canvas> via the
  // shared `overlay-mockup` renderer — 1:1 with the in-app OverlayPainter —
  // driven through the shared `OverlayDemo` arc. Animates only while on screen,
  // mirrors theme + language, frozen under reduced motion.

  const canvas = document.querySelector<HTMLCanvasElement>(
    '#app-paste-demo .apd-overlay-canvas',
  );

  if (canvas) {
    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    const getTheme = (): OverlayTheme =>
      document.documentElement.classList.contains('light') ? 'light' : 'dark';
    const getLang = (): OverlayDemoLang => {
      const htmlLang = document.documentElement.lang;
      return htmlLang === 'de' || htmlLang === 'ru' ? htmlLang : 'en';
    };

    const demo = new OverlayDemo({ canvas, reducedMotion, getTheme, getLang });

    demo.resize();
    demo.drawFrozen();
    window.addEventListener('resize', () => {
      demo.resize();
      if (!demo.running) demo.drawFrozen();
    });

    new MutationObserver(() => {
      if (!demo.running) demo.drawFrozen();
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });

    const section = document.getElementById('app-paste-demo');
    if (section) {
      new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) demo.start();
            else demo.stop();
          }
        },
        { threshold: 0.2 },
      ).observe(section);
    } else {
      demo.start();
    }
  }
</script>
