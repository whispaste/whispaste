---
import { t } from '../scripts/i18n.ts';

const lang = (Astro.currentLocale === 'en' ? 'en' : 'de') as 'de' | 'en';
---

<!-- App-in-Any-Context Demo — Phase B, Issue 04
     Core promise: hotkey → speak → text appears at cursor, no app switch.
     Pure HTML/CSS mockup — no Canvas, no external deps, reduced-motion safe. -->
<section
  id="app-paste-demo"
  class="band band-spotlight py-24 sm:py-32 scroll-mt-20 scroll-reveal"
>
  <div class="relative max-w-5xl mx-auto px-6">

    <!-- Section header -->
    <div class="text-center mb-16">
      <p
        class="text-brand-cyan text-sm font-semibold tracking-wider uppercase mb-3"
        data-i18n="appdemo.label"
      >{t(lang, 'appdemo.label')}</p>
      <h2 class="section-title">
        <span data-i18n="appdemo.titleLead">{t(lang, 'appdemo.titleLead')}</span><span
          class="text-gradient-brand"
          data-i18n="appdemo.titleAccent"
        >{t(lang, 'appdemo.titleAccent')}</span><span
          data-i18n="appdemo.titleTail"
        >{t(lang, 'appdemo.titleTail')}</span>
      </h2>
      <p
        class="mt-4 text-ink-muted text-lg max-w-2xl mx-auto"
        data-i18n="appdemo.subtitle"
      >{t(lang, 'appdemo.subtitle')}</p>
    </div>

    <!-- Editor mockup stage -->
    <div class="apd-stage">

      <!-- Floating hotkey badge -->
      <div class="apd-hotkey-badge" aria-hidden="true">
        <kbd class="apd-key" data-i18n="hero.hotkey.mod">{t(lang, 'hero.hotkey.mod')}</kbd>
        <span class="apd-key-sep">+</span>
        <kbd class="apd-key">Y</kbd>
      </div>

      <!-- Generic editor window -->
      <div
        class="apd-window"
        role="img"
        aria-label={lang === 'en'
          ? 'Editor mockup: transcribed text appears at cursor after hotkey press'
          : 'Editor-Mockup: Transkribierter Text erscheint am Cursor nach dem Hotkey-Druck'}
      >
        <!-- Title bar -->
        <div class="apd-titlebar" aria-hidden="true">
          <span class="apd-dot apd-dot-r"></span>
          <span class="apd-dot apd-dot-y"></span>
          <span class="apd-dot apd-dot-g"></span>
          <span class="apd-wintitle">Text Editor</span>
        </div>

        <!-- Content area -->
        <div class="apd-content" aria-hidden="true">
          <p
            class="apd-doc-heading"
            data-i18n="appdemo.mockHeading"
          >{t(lang, 'appdemo.mockHeading')}</p>
          <hr class="apd-rule" />
          <p class="apd-body-line apd-typing-line">
            <span data-i18n="appdemo.mockPrefix">{t(lang, 'appdemo.mockPrefix')}</span><!--
            --><span class="apd-typed">
              <span
                class="apd-typed-text"
                data-i18n="appdemo.mockTyped"
              >{t(lang, 'appdemo.mockTyped')}</span>
            </span><!--
            --><span class="apd-caret" aria-hidden="true"></span>
          </p>
        </div>
      </div>
    </div>

    <!-- Three benefit callouts -->
    <ul class="apd-callouts stagger-children">
      <li class="apd-callout stagger-item">
        <svg
          class="apd-callout-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2" y="4" width="20" height="16" rx="2"/>
          <path d="m9 8 3 3-3 3"/><path d="M14 16h4"/>
        </svg>
        <span data-i18n="appdemo.hotkeyHint">{t(lang, 'appdemo.hotkeyHint')}</span>
      </li>
      <li class="apd-callout stagger-item">
        <svg
          class="apd-callout-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
        </svg>
        <span data-i18n="appdemo.noSwitch">{t(lang, 'appdemo.noSwitch')}</span>
      </li>
      <li class="apd-callout stagger-item">
        <svg
          class="apd-callout-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/>
          <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
          <line x1="12" x2="12" y1="19" y2="22"/>
        </svg>
        <span data-i18n="appdemo.noAiEdit">{t(lang, 'appdemo.noAiEdit')}</span>
      </li>
    </ul>

  </div>
</section>

<style>
  /* =========================================================================
     Stage — the visual canvas around the editor window
     ========================================================================= */
  .apd-stage {
    position: relative;
    max-width: 580px;
    margin: 0 auto 3.5rem;
  }

  /* Soft radial glow behind the window — theme-aware */
  .apd-stage::before {
    content: '';
    position: absolute;
    inset: -14% -12% -18%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse 68% 56% at 50% 44%,
      color-mix(in srgb, var(--color-brand-cyan) 20%, transparent) 0%,
      transparent 70%
    );
    filter: blur(8px);
  }

  /* =========================================================================
     Hotkey badge — floats top-right, presses once on scroll-enter
     ========================================================================= */
  .apd-hotkey-badge {
    position: absolute;
    top: -1.1rem;
    right: -0.75rem;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.6rem;
    background: color-mix(in srgb, var(--color-brand-card) 96%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-brand-cyan) 45%, var(--color-brand-border));
    border-radius: 8px;
    box-shadow:
      0 4px 18px rgba(0, 0, 0, 0.38),
      0 0 0 1px color-mix(in srgb, var(--color-brand-cyan) 22%, transparent);
    font-family: ui-monospace, 'Cascadia Code', Menlo, monospace;
    font-size: 0.75rem;
    color: var(--color-ink);
    /* paused; running once section is .visible */
    animation: apd-keypress 0.45s cubic-bezier(0.36, 0, 0.66, -0.56) 0.5s both paused;
  }

  .apd-key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.125rem 0.4rem;
    background: color-mix(in srgb, var(--color-brand-cyan) 14%, var(--color-brand-card));
    border: 1px solid color-mix(in srgb, var(--color-brand-cyan) 35%, var(--color-brand-border));
    border-radius: 4px;
    font-weight: 600;
    color: var(--color-brand-cyan);
    font-style: normal;
  }

  .apd-key-sep {
    color: var(--color-ink-subtle);
    font-size: 0.7rem;
    line-height: 1;
  }

  /* =========================================================================
     Editor window chrome
     ========================================================================= */
  .apd-window {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--color-brand-border);
    background: var(--color-brand-card);
    box-shadow:
      0 26px 68px rgba(0, 0, 0, 0.42),
      0 0 0 1px rgba(56, 217, 240, 0.07);
  }

  html.light .apd-window {
    box-shadow:
      0 14px 44px rgba(15, 23, 42, 0.13),
      0 0 0 1px rgba(8, 145, 178, 0.07);
  }

  .apd-titlebar {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.625rem 1rem;
    background: color-mix(in srgb, var(--color-brand-dark) 75%, var(--color-brand-card));
    border-bottom: 1px solid var(--color-brand-border);
  }

  html.light .apd-titlebar {
    background: var(--color-brand-darker);
  }

  .apd-dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    flex-shrink: 0;
    opacity: 0.8;
  }
  .apd-dot-r { background: #FF5F56; }
  .apd-dot-y { background: #FFBD2E; }
  .apd-dot-g { background: #27C93F; }

  .apd-wintitle {
    margin-left: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-ink-subtle);
    font-weight: 500;
  }

  /* =========================================================================
     Editor content
     ========================================================================= */
  .apd-content {
    padding: 1.5rem 1.75rem 2.25rem;
    overflow: hidden;
  }

  .apd-doc-heading {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-ink);
    margin: 0 0 0.5rem;
  }

  .apd-body-line {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    line-height: 1.65;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
  }

  .apd-rule {
    border: none;
    border-top: 1px solid color-mix(in srgb, var(--color-brand-border) 60%, transparent);
    margin: 0.5rem 0 0.75rem;
    height: 0;
  }

  .apd-typing-line {
    display: flex;
    align-items: baseline;
  }

  /* =========================================================================
     Typing animation — text reveals left-to-right via max-width on the wrapper
     ========================================================================= */
  .apd-typed {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    max-width: 0;
    /* paused; running once section is .visible.
       steps(45, end) gives ~1 step per character for ~45-char texts. */
    animation: apd-type 2.2s steps(45, end) 1.1s forwards paused;
  }

  .apd-typed-text {
    display: inline-block;
    white-space: nowrap;
  }

  /* =========================================================================
     Blinking caret
     ========================================================================= */
  .apd-caret {
    display: inline-block;
    vertical-align: bottom;
    width: 2px;
    height: 0.95em;
    margin-left: 1px;
    background: var(--color-brand-cyan);
    border-radius: 1px;
    /* Stays solid during typing; blinks after it completes.
       fill-mode: none → base opacity:1 applies during the delay window. */
    animation: apd-caret-blink 0.9s step-end infinite 3.5s paused;
  }

  /* =========================================================================
     Trigger: run animations once section scrolls into view
     (.visible added by the IO observer in index.astro)
     ========================================================================= */
  .scroll-reveal.visible .apd-hotkey-badge {
    animation-play-state: running;
  }
  .scroll-reveal.visible .apd-typed {
    animation-play-state: running;
  }
  .scroll-reveal.visible .apd-caret {
    animation-play-state: running;
  }

  /* =========================================================================
     Keyframes
     ========================================================================= */
  @keyframes apd-type {
    from { max-width: 0; }
    to   { max-width: 46ch; }
  }

  @keyframes apd-caret-blink {
    0%,  49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  @keyframes apd-keypress {
    0%   { transform: scale(1)    translateY(0);  }
    45%  { transform: scale(0.91) translateY(2px); }
    100% { transform: scale(1)    translateY(0);  }
  }

  /* =========================================================================
     prefers-reduced-motion: show end-state immediately; hide animated cursor
     ========================================================================= */
  @media (prefers-reduced-motion: reduce) {
    .apd-hotkey-badge { animation: none; }

    .apd-typed {
      animation: none;
      max-width: 46ch;
    }

    .apd-caret {
      animation: none;
      opacity: 0;
    }
  }

  /* =========================================================================
     Benefit callouts grid
     ========================================================================= */
  .apd-callouts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
    max-width: 580px;
    margin: 0 auto;
    list-style: none;
    padding: 0;
  }

  @media (min-width: 480px) {
    .apd-callouts {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .apd-callout {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    padding: 1rem 0.875rem;
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-brand-card) 55%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-brand-border) 55%, transparent);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-ink-muted);
  }

  html.light .apd-callout {
    background: color-mix(in srgb, var(--color-brand-card) 80%, transparent);
  }

  .apd-callout-icon {
    width: 1.625rem;
    height: 1.625rem;
    color: var(--color-brand-cyan);
    flex-shrink: 0;
  }
</style>
