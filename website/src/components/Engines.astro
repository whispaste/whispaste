---
/**
 * `Engines.astro` — the "which local engine?" gegenüberstellung that the
 * site was missing: WhisPaste ships two on-device STT engines (Whisper via
 * whisper.cpp, Parakeet via sherpa-onnx — see `CONTEXT.md` §4.2), but before
 * this section that fact only lived in one FAQ answer and a Languages
 * sentence. This section makes the trade-off (language breadth + GPU vs.
 * CPU speed) visually explicit on the homepage, then hands off to `/engines/`
 * for the full comparison.
 *
 * Card styling reuses the `.feature-card` glass recipe from the removed
 * `Features.astro` (dead code, deleted); keeping the exact class name means
 * the light-mode remap in `global.css` `.feature-card` still applies here
 * for free.
 */
import SectionEyebrow from './SectionEyebrow.astro';
import { t, localePath } from '../scripts/i18n.ts';

const lang = (Astro.currentLocale === 'en' ? 'en' : 'de') as 'de' | 'en';
---

<!-- Engines Section — band-spotlight: alterniert zwischen SpeedComparison
     (band-raised) und AppScreenshots (band-deep), siehe Band-Rhythmus-Kommentar
     in pages/index.astro. Die frühere eigene Radial-Gradient-Ebene ist im
     Spotlight-Glow des Bands aufgegangen (keine doppelte Aura). -->
<section id="engines" class="band band-spotlight py-24 sm:py-32 relative scroll-mt-20">
  <div class="relative max-w-4xl mx-auto px-6">
    <div class="text-center mb-14">
      <SectionEyebrow key="engines.label" class="reveal-up" />
      <h2 class="section-title wp-kinetic-line">{t(lang, "engines.title")}</h2>
      <p class="mt-4 text-ink-muted text-lg max-w-2xl mx-auto reveal-up" data-i18n="engines.desc">{t(lang, "engines.desc")}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6">
      <!-- Whisper -->
      <div class="feature-card group p-6 sm:p-7 rounded-2xl border border-white/[0.06] scroll-reveal">
        <div class="flex items-start justify-between gap-3 mb-1">
          <h3 class="text-white text-xl font-bold" data-i18n="engines.whisper.name">{t(lang, "engines.whisper.name")}</h3>
          <span class="inline-flex items-center rounded-full bg-brand-cyan/10 text-brand-cyan text-[11px] font-semibold px-2.5 py-1 whitespace-nowrap" data-i18n="engines.whisper.tagline">{t(lang, "engines.whisper.tagline")}</span>
        </div>
        <p class="text-ink-subtle text-xs font-medium mb-5" data-i18n="engines.whisper.tech">{t(lang, "engines.whisper.tech")}</p>
        <dl class="engine-stats">
          <div class="engine-stat">
            <dt data-i18n="engines.whisper.stat.languages.label">{t(lang, "engines.whisper.stat.languages.label")}</dt>
            <dd class="wp-nums" data-i18n="engines.whisper.stat.languages.value">{t(lang, "engines.whisper.stat.languages.value")}</dd>
          </div>
          <div class="engine-stat">
            <dt data-i18n="engines.whisper.stat.hardware.label">{t(lang, "engines.whisper.stat.hardware.label")}</dt>
            <dd class="wp-nums" data-i18n="engines.whisper.stat.hardware.value">{t(lang, "engines.whisper.stat.hardware.value")}</dd>
          </div>
          <div class="engine-stat">
            <dt data-i18n="engines.whisper.stat.bestfor.label">{t(lang, "engines.whisper.stat.bestfor.label")}</dt>
            <dd class="wp-nums" data-i18n="engines.whisper.stat.bestfor.value">{t(lang, "engines.whisper.stat.bestfor.value")}</dd>
          </div>
        </dl>
        <p class="text-ink-muted text-sm leading-relaxed" data-i18n="engines.whisper.desc">{t(lang, "engines.whisper.desc")}</p>
      </div>

      <!-- Parakeet -->
      <div class="feature-card group p-6 sm:p-7 rounded-2xl border border-white/[0.06] scroll-reveal">
        <div class="flex items-start justify-between gap-3 mb-1">
          <h3 class="text-white text-xl font-bold" data-i18n="engines.parakeet.name">{t(lang, "engines.parakeet.name")}</h3>
          <span class="inline-flex items-center rounded-full bg-brand-cyan/10 text-brand-cyan text-[11px] font-semibold px-2.5 py-1 whitespace-nowrap" data-i18n="engines.parakeet.tagline">{t(lang, "engines.parakeet.tagline")}</span>
        </div>
        <p class="text-ink-subtle text-xs font-medium mb-5" data-i18n="engines.parakeet.tech">{t(lang, "engines.parakeet.tech")}</p>
        <dl class="engine-stats">
          <div class="engine-stat">
            <dt data-i18n="engines.parakeet.stat.languages.label">{t(lang, "engines.parakeet.stat.languages.label")}</dt>
            <dd class="wp-nums" data-i18n="engines.parakeet.stat.languages.value">{t(lang, "engines.parakeet.stat.languages.value")}</dd>
          </div>
          <div class="engine-stat">
            <dt data-i18n="engines.parakeet.stat.hardware.label">{t(lang, "engines.parakeet.stat.hardware.label")}</dt>
            <dd class="wp-nums" data-i18n="engines.parakeet.stat.hardware.value">{t(lang, "engines.parakeet.stat.hardware.value")}</dd>
          </div>
          <div class="engine-stat">
            <dt data-i18n="engines.parakeet.stat.speed.label">{t(lang, "engines.parakeet.stat.speed.label")}</dt>
            <dd class="wp-nums" data-i18n="engines.parakeet.stat.speed.value">{t(lang, "engines.parakeet.stat.speed.value")}</dd>
          </div>
        </dl>
        <p class="text-ink-muted text-sm leading-relaxed" data-i18n="engines.parakeet.desc">{t(lang, "engines.parakeet.desc")}</p>
      </div>
    </div>

    <p class="mt-8 text-center text-ink-subtle text-sm max-w-xl mx-auto" data-i18n="engines.footnote">{t(lang, "engines.footnote")}</p>

    <div class="mt-5 text-center">
      <a
        href={localePath(lang, "engines")}
        data-testid="engines-cta-link"
        class="group/cta inline-flex items-center gap-1.5 text-sm font-semibold text-brand-cyan hover:text-white transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-cyan rounded-sm"
      >
        <span data-i18n="engines.cta">{t(lang, "engines.cta")}</span>
        <svg class="w-4 h-4 transition-transform group-hover/cta:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* Flat opaque engine cards — same --color-brand-card material as every
     other card on the site, no glass. */
  .feature-card {
    position: relative;
    background: var(--color-brand-card);
    will-change: transform;
    /* Vorher sprang der Hover-Zustand ohne Übergang an (Lokaldefekt) —
       jetzt fließt der Lift auf der gemeinsamen Flow-Kurve. */
    transition:
      transform 0.35s var(--ease-flow),
      box-shadow 0.35s var(--ease-flow),
      border-color 0.35s var(--ease-flow),
      background 0.35s var(--ease-flow);
  }
  .feature-card:hover {
    background: color-mix(in srgb, var(--color-brand-card) 90%, var(--color-brand-cyan));
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-3px);
  }
  .feature-card::after {
    content: "";
    position: absolute;
    inset-inline: 1.25rem;
    top: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--color-brand-cyan) 55%, transparent), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .feature-card:hover::after {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .feature-card {
      transition: none;
    }
    .feature-card:hover {
      transform: none;
    }
  }

  /* Spec-sheet stat rows inside each card. */
  .engine-stats {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: 1rem 0 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .engine-stat {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .engine-stat dt {
    font-size: 0.8125rem;
    color: var(--color-ink-subtle);
  }
  .engine-stat dd {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-ink);
    text-align: right;
  }
</style>
