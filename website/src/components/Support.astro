---
import { t, currentLocale } from '../scripts/i18n.ts';
import { STORES } from '../data/platforms.ts';

const lang = currentLocale(Astro.currentLocale);
const msReviewUrl = STORES.windows.reviewUrl;
const macosReviewUrl = STORES.macos.reviewUrl;
---
<!-- Support: a compact, flat zone above the footer. One outline action
     (sponsoring), everything else as quiet links in one wrapping row. No
     payment UI of our own; all targets are external and open in a new tab. -->
<section id="support" class="band band-deep relative support-zone scroll-mt-20" data-testid="support">
  <div class="relative wp-container support-layout">
    <div class="support-copy">
      <svg class="support-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7.5-4.6-7.5-10.6A4.4 4.4 0 0 1 12 7.6a4.4 4.4 0 0 1 7.5 2.8C19.5 16.4 12 21 12 21Z"/><path d="M9 12h1M12 10v5M15 12h0"/></svg>
      <h2 class="support-title" data-i18n="support.title">{t(lang, "support.title")}</h2>
      <p class="support-desc" data-i18n="support.desc">{t(lang, "support.desc")}</p>
    </div>
    <div class="support-actions">
      <a href="https://github.com/sponsors/silvio-l" target="_blank" rel="noopener" class="support-sponsor" data-testid="support-sponsor">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
        <span data-i18n="support.sponsor">{t(lang, "support.sponsor")}</span>
      </a>
      <ul class="support-links">
        <li><a href="https://ko-fi.com/silviol" target="_blank" rel="noopener" data-testid="support-coffee"><span data-i18n="support.coffee">{t(lang, "support.coffee")}</span></a></li>
        <li><a href="https://www.paypal.com/donate/?hosted_button_id=GY8ZQQGJB9XPY" target="_blank" rel="noopener" data-testid="support-paypal"><span data-i18n="support.paypal">{t(lang, "support.paypal")}</span></a></li>
        <li><a href="https://app.votepit.com/silvio-und-maik/whispaste" target="_blank" rel="noopener" data-testid="support-roadmap"><span data-i18n="support.ideas">{t(lang, "support.ideas")}</span></a></li>
        <li><a href="https://github.com/whispaste/whispaste" target="_blank" rel="noopener" data-testid="support-star"><span data-i18n="support.star">{t(lang, "support.star")}</span></a></li>
        <li data-platform-btn="windows"><a href={msReviewUrl} target="_blank" rel="noopener" data-testid="support-rate-ms-store"><span data-i18n="support.rateMsStore">{t(lang, "support.rateMsStore")}</span></a></li>
        <li data-platform-btn="macos"><a href={macosReviewUrl} target="_blank" rel="noopener" data-testid="support-rate-app-store"><span data-i18n="support.rateAppStore">{t(lang, "support.rateAppStore")}</span></a></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .support-zone {
    padding-block: clamp(3rem, 2rem + 3vw, 4.5rem);
  }
  .support-layout {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 1024px) {
    .support-layout {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: 3rem;
      align-items: center;
    }
  }
  .support-mark {
    width: 1.75rem;
    height: 1.75rem;
    color: var(--color-brand-cyan);
    margin-bottom: 0.75rem;
  }
  .support-title {
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem);
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-ink);
  }
  .support-desc {
    margin-top: 0.75rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
    max-width: var(--measure-lead);
  }
  .support-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .support-sponsor {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.625rem 1.25rem;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, var(--color-brand-cyan) 55%, transparent);
    color: var(--color-ink);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .support-sponsor svg {
    width: 1rem;
    height: 1rem;
    color: #f472b6;
  }
  .support-sponsor:hover {
    background: color-mix(in srgb, var(--color-brand-cyan) 10%, transparent);
    border-color: var(--color-brand-cyan);
  }
  .support-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }
  .support-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.25);
    text-underline-offset: 0.2em;
  }
  .support-links a:hover {
    color: var(--color-ink);
    text-decoration-color: currentColor;
  }
  .support-sponsor:focus-visible,
  .support-links a:focus-visible {
    outline: 2px solid var(--color-brand-cyan);
    outline-offset: 2px;
    border-radius: var(--radius-chip);
  }
  @media (prefers-reduced-motion: reduce) {
    .support-sponsor { transition: none; }
  }
</style>
