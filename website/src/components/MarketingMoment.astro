---
/**
 * `MarketingMoment.astro` — a single, quiet pause between feature sections:
 * one large statement line, not a feature explainer. Previously a warm
 * hand-illustrated scene (inspired by wisprflow.ai); that illustration was
 * the site's one genre-peer asset (pastel teal + cream speech bubbles, the
 * exact "editorial warmth" register the redesign moved away from — see
 * `.scratch/website-redesign/DESIGN-CONTRACT.md`). Replaced with the same
 * instrument/precision vocabulary the rest of the page already uses: a
 * single dominant stage-glow and a faint waveform motif behind the type,
 * no illustration.
 */
import SectionEyebrow from './SectionEyebrow.astro';
import { t } from '../scripts/i18n.ts';

const lang = (Astro.currentLocale === 'en' ? 'en' : 'de') as 'de' | 'en';
---

<section id="marketing-moment" class="band band-deep py-24 sm:py-32 relative overflow-hidden">
  <div class="mm-glow" aria-hidden="true"></div>
  <!-- Faint decorative waveform — echoes the app's own bar-meter, the same
       low-opacity absolute-motif pattern as FAQ/Pricing's background icon. -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <svg class="mm-waveform" width="520" height="120" viewBox="0 0 520 120" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round">
      <path d="M8 60h0M32 45v30M56 20v80M80 50v20M104 35v50M128 10v100M152 42v36M176 55v10M200 25v70M224 48v24M248 15v90M272 40v40M296 5v110M320 44v32M344 30v60M368 52v16M392 20v80M416 46v28M440 12v96M464 50v20M488 35v50M512 60h0" />
    </svg>
  </div>

  <div class="relative max-w-2xl mx-auto px-6 text-center">
    <SectionEyebrow key="marketing.moment.label" class="reveal-up mb-5" />
    <h2 class="mm-statement wp-kinetic-line"><!--
      --><span data-i18n="marketing.moment.titleLead">{t(lang, 'marketing.moment.titleLead')}</span><!--
      --><span class="text-gradient-brand" data-i18n="marketing.moment.titleAccent">{t(lang, 'marketing.moment.titleAccent')}</span><!--
    --></h2>
    <p class="mm-sub reveal-up" data-i18n="marketing.moment.sub">{t(lang, 'marketing.moment.sub')}</p>
  </div>
</section>

<style>
  /* Single dominant stage-glow (contract motif #2: one light source, no
     decorative scatter) — scoped here rather than reusing `.band-spotlight`,
     which is reserved for the emotional/core-message sections elsewhere. */
  .mm-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 70% 55% at 50% 40%,
      color-mix(in srgb, var(--color-brand-cyan) 14%, transparent) 0%,
      transparent 70%
    );
  }
  .mm-waveform {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    color: var(--color-brand-cyan);
    opacity: 0.1;
  }

  .mm-statement {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-weight: 800;
    font-variation-settings: 'wght' 800;
    color: var(--color-ink);
    font-size: clamp(2rem, 1.4rem + 3vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
    margin: 0;
  }
  .mm-sub {
    position: relative;
    z-index: 1;
    margin: 1.25rem auto 0;
    color: var(--color-ink-muted, rgba(226, 232, 240, 0.9));
    font-size: clamp(1rem, 1.7vw, 1.1875rem);
    line-height: 1.65;
    max-width: 46ch;
  }
</style>
