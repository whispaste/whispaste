---
import { t, currentLocale } from '../scripts/i18n.ts';

// Why the store build is the recommended route (maintainer decision): it funds
// the project, is reviewed by Microsoft/Apple and updates itself. Claims stay
// factual — the free GitHub build is a full app too.
interface Props {
  testid: string;
}
const { testid } = Astro.props;
const lang = currentLocale(Astro.currentLocale);

const perks = [
  { key: 'support', icon: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>' },
  { key: 'safe', icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>' },
  { key: 'updates', icon: '<path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/>' },
] as const;
---

<div class="store-perks" data-testid={testid}>
  <p class="store-perks__title" data-i18n="store.perks.title">{t(lang, "store.perks.title")}</p>
  <ul class="store-perks__list">
    {perks.map((p) => (
      <li data-testid={`${testid}-${p.key}`}>
        <span class:list={["store-perks__icon", `is-${p.key}`]} aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
        </span>
        <span>
          <strong data-i18n={`store.perks.${p.key}.title`}>{t(lang, `store.perks.${p.key}.title`)}</strong>
          <span class="store-perks__desc" data-i18n={`store.perks.${p.key}.desc`}>{t(lang, `store.perks.${p.key}.desc`)}</span>
        </span>
      </li>
    ))}
  </ul>
</div>

<style>
  .store-perks__title {
    font-size: var(--wp-font-size-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-cyan);
  }
  .store-perks__list {
    list-style: none;
    margin: var(--wp-space-4) 0 0;
    padding: 0;
    display: grid;
    gap: var(--wp-space-4);
  }
  .store-perks__list li {
    display: flex;
    align-items: flex-start;
    gap: var(--wp-space-4);
  }
  .store-perks strong {
    display: block;
    font-size: var(--wp-font-size-md);
    font-weight: 600;
    color: var(--color-ink);
  }
  .store-perks__desc {
    display: block;
    margin-top: 0.125rem;
    font-size: var(--wp-font-size-sm);
    line-height: 1.55;
    color: var(--color-ink-muted);
  }
  .store-perks__icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border-radius: var(--radius-control);
    color: var(--color-brand-cyan);
    background: color-mix(in srgb, var(--color-brand-cyan) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-brand-cyan) 22%, transparent);
  }
  .store-perks__icon.is-support {
    color: var(--wp-highlight-text);
    background: var(--wp-highlight-soft);
    border-color: color-mix(in srgb, var(--wp-highlight-default) 28%, transparent);
  }
  .store-perks__icon svg {
    width: 1.125rem;
    height: 1.125rem;
  }
</style>
