---
import { t } from '../scripts/i18n.ts';

const lang = (Astro.currentLocale === 'en' ? 'en' : 'de') as 'de' | 'en';

const faqs = [
  { key: 'free' },
  { key: 'offline' },
  { key: 'accuracy' },
  { key: 'sysreq' },
  { key: 'languages' },
  { key: 'privacy' },
  { key: 'windows' },
  { key: 'smartscreen' },
  { key: 'gatekeeper' },
];
---

<!-- FAQ Section -->
<section id="faq" class="band band-raised py-24 sm:py-32 relative scroll-mt-20 overflow-hidden">
  <!-- Decorative context motif: speech bubbles with a question mark — the FAQ
       "ask us anything" cue. Theme-adaptive, faint, non-interactive. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-8 -translate-x-1/2 text-brand-cyan opacity-[0.11]"
  >
    <svg width="250" height="200" viewBox="0 0 250 200" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M35 25h150a20 20 0 0 1 20 20v70a20 20 0 0 1-20 20h-70l-40 30v-30h-40a20 20 0 0 1-20-20V45a20 20 0 0 1 20-20Z" />
      <path d="M92 68a18 18 0 1 1 30 13c-7 6-12 9-12 17" />
      <path d="M110 118h.01" />
    </svg>
  </div>
  <div class="relative max-w-3xl mx-auto px-6">
    <div class="text-center mb-12 scroll-reveal">
      <p class="text-brand-cyan text-sm font-semibold tracking-wider uppercase mb-3" data-i18n="faq.label">{t(lang, "faq.label")}</p>
      <h2 class="section-title"><span data-i18n="faq.titleLead">{t(lang, "faq.titleLead")}</span><span class="text-gradient-brand" data-i18n="faq.titleAccent">{t(lang, "faq.titleAccent")}</span><span data-i18n="faq.titleTail">{t(lang, "faq.titleTail")}</span></h2>
    </div>

    <div class="space-y-3 scroll-reveal" id="faq-accordion">
      {faqs.map(({ key }) => (
        <details class="faq-item group rounded-2xl border border-white/[0.06] overflow-hidden">
          <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer select-none text-white font-medium hover:bg-white/[0.02] transition-colors" data-i18n={`faq.${key}.q`}>
            {t(lang, `faq.${key}.q`)}
            <svg class="faq-chevron w-5 h-5 text-gray-500 shrink-0 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <div class="px-6 pb-5 text-ink-muted text-sm leading-relaxed" data-i18n={`faq.${key}.a`}>{t(lang, `faq.${key}.a`)}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-item {
    background: linear-gradient(135deg, rgba(29, 37, 56, 0.4) 0%, rgba(23, 29, 44, 0.2) 100%);
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::marker {
    content: '';
  }
</style>
