---
const faqs = [
  { key: 'free', q: 'Is WhisPaste really free?', a: 'Yes. WhisPaste is open source under the MIT license. The app with offline transcription, voice snippets, history and more is free. You can download it from GitHub. The Microsoft Store version includes automatic updates and supports the project financially.' },
  { key: 'offline', q: 'Does it actually work offline?', a: 'Fully. WhisPaste includes built-in speech recognition that runs entirely on your computer. No internet needed. If you want, you can also connect a cloud provider for even better accuracy — but that\u2019s your choice, not a requirement.' },
  { key: 'accuracy', q: 'How accurate is the transcription?', a: 'That depends on the model you pick. The small model handles everyday dictation well. Larger models are more precise but need more RAM and processing time. You can switch any time to find the right balance.' },
  { key: 'sysreq', q: 'What are the system requirements?', a: 'Minimum: Windows 10 (64-bit) or macOS 10.15 Catalina+, 4 GB RAM, ~500 MB free disk space. No GPU required — WhisPaste always falls back to CPU. Recommended: 8 GB RAM, a dedicated GPU with 2–4 GB VRAM (NVIDIA CUDA, AMD or Intel Vulkan). Larger models need more VRAM: the compact model needs ~300 MB, the balanced model ~900 MB, and the premium model ~2.6 GB. The app automatically picks a safe model tier for your hardware.' },
  { key: 'languages', q: 'Which languages are supported?', a: 'WhisPaste supports 99 languages — from English and German to Japanese, Arabic, and Hindi. You can switch languages in settings, or let WhisPaste auto-detect what you\'re speaking.' },
  { key: 'privacy', q: 'Is my voice data safe?', a: 'Your audio never leaves your machine in local mode. If you use the cloud path, recordings go directly from your device to the provider you selected — WhisPaste does not proxy or store them. Optional crash reports are transparent and can be turned off any time.' },
  { key: 'windows', q: 'Is WhisPaste available on Mac or Linux?', a: 'WhisPaste is available for Windows and macOS. A Linux version is planned.' },
  { key: 'smartscreen', q: 'Why does Windows show a warning when I download?', a: 'Microsoft SmartScreen warns about any new software that hasn\'t built download reputation yet — it doesn\'t mean the app is unsafe. WhisPaste is open source, and every release is built transparently through GitHub Actions. Click "More info" → "Run anyway" to proceed.' },
  { key: 'gatekeeper', q: 'Why does macOS warn that WhisPaste can\'t be verified?', a: 'macOS Gatekeeper blocks unrecognised apps downloaded outside the App Store. WhisPaste is not yet notarized by Apple — right-click the app → "Open" → confirm in the dialog to proceed. Or install via the Mac App Store, which passes all Apple security checks automatically.' },
];
---

<!-- FAQ Section -->
<section id="faq" class="py-24 sm:py-32 relative scroll-mt-20">
  <div class="relative max-w-3xl mx-auto px-6">
    <div class="text-center mb-12 scroll-reveal">
      <p class="text-brand-cyan text-sm font-semibold tracking-wider uppercase mb-3" data-i18n="faq.label">FAQ</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-white" data-i18n="faq.title">Good questions, honest answers</h2>
    </div>

    <div class="space-y-3 scroll-reveal" id="faq-accordion">
      {faqs.map(({ key, q, a }) => (
        <details class="faq-item group rounded-2xl border border-white/[0.06] overflow-hidden">
          <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer select-none text-white font-medium hover:bg-white/[0.02] transition-colors" data-i18n={`faq.${key}.q`}>
            {q}
            <svg class="faq-chevron w-5 h-5 text-gray-500 shrink-0 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-400 text-sm leading-relaxed" data-i18n={`faq.${key}.a`}>{a}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-item {
    background: linear-gradient(135deg, rgba(29, 37, 56, 0.4) 0%, rgba(23, 29, 44, 0.2) 100%);
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::marker {
    content: '';
  }
</style>
