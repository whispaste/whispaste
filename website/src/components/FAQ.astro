---
import SectionEyebrow from './SectionEyebrow.astro';
import { t, currentLocale } from '../scripts/i18n.ts';
import { FAQ_GROUPS } from './schema/builders.ts';

const lang = currentLocale(Astro.currentLocale);
// FAQ_GROUPS flattened is DEFAULT_FAQ_KEYS, the FAQPage schema order, so
// rich results match the visible text.
---

<!-- FAQ: three topic groups of open divider rows (native details, several
     may be open). Each question has an id so #faq-<key> deep links open it. -->
<section id="faq" class="band band-raised relative wp-section scroll-mt-20" data-testid="faq">
  <div class="relative wp-container faq-layout">
    <div class="wp-section-head faq-head">
      <SectionEyebrow key="faq.label" />
      <h2 class="section-title"><span data-i18n="faq.titleLead">{t(lang, "faq.titleLead")}</span><span class="text-gradient-brand" data-i18n="faq.titleAccent">{t(lang, "faq.titleAccent")}</span><span data-i18n="faq.titleTail">{t(lang, "faq.titleTail")}</span></h2>
    </div>

    <div class="faq-groups" id="faq-accordion">
      {FAQ_GROUPS.map((group) => (
        <div class="faq-group" data-testid={`faq-group-${group.key}`}>
          <h3 class="faq-group__title" data-i18n={`faq.group.${group.key}`}>{t(lang, `faq.group.${group.key}`)}</h3>
          {group.keys.map((key) => (
            <details class="faq-row scroll-mt-24" id={`faq-${key}`} data-testid={`faq-${key}`}>
              <summary class="faq-row__q">
                <span data-i18n={`faq.${key}.q`}>{t(lang, `faq.${key}.q`)}</span>
                <span class="faq-row__icon" aria-hidden="true"></span>
              </summary>
              <div class="faq-row__a" data-i18n={`faq.${key}.a`}>{t(lang, `faq.${key}.a`)}</div>
            </details>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Deep link (#faq-free etc.) opens the targeted question.
  const openFromHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id.startsWith('faq-')) return;
    const el = document.getElementById(id);
    if (el instanceof HTMLDetailsElement) {
      el.open = true;
      el.scrollIntoView({ block: 'start' });
    }
  };
  openFromHash();
  window.addEventListener('hashchange', openFromHash);
</script>

<style>
  .faq-layout {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 1280px) {
    .faq-layout {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: 3rem;
      align-items: start;
    }
    .faq-head {
      position: sticky;
      top: 6rem;
    }
  }
  .faq-head {
    margin-bottom: 0;
  }
  .faq-groups {
    display: grid;
    gap: 2.5rem;
    max-width: 50rem;
  }
  .faq-group__title {
    margin-bottom: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-cyan);
  }
  .faq-row {
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }
  .faq-row__q {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.125rem 0.5rem;
    margin-inline: -0.5rem;
    border-radius: var(--radius-control);
    cursor: pointer;
    list-style: none;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-ink);
    transition: background-color var(--dur-fast) ease;
  }
  .faq-row__q::-webkit-details-marker { display: none; }
  .faq-row__q::marker { content: ''; }
  .faq-row__q:hover { background: rgb(255 255 255 / 0.03); }
  .faq-row__q:focus-visible {
    outline: 2px solid var(--color-brand-cyan);
    outline-offset: 2px;
  }
  /* Plus/minus with reserved space so long questions never squeeze it. */
  .faq-row__icon {
    position: relative;
    flex: 0 0 1.25rem;
    height: 1.25rem;
    margin-top: 0.1rem;
  }
  .faq-row__icon::before,
  .faq-row__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.875rem;
    height: 2px;
    border-radius: 1px;
    background: var(--color-brand-cyan);
    translate: -50% -50%;
    transition: rotate var(--dur-base) ease;
  }
  .faq-row__icon::after { rotate: 90deg; }
  .faq-row[open] .faq-row__icon::after { rotate: 0deg; }
  .faq-row__a {
    padding: 0 0 1.25rem;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-ink-muted);
    max-width: var(--measure-lead);
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-row__q,
    .faq-row__icon::after { transition: none; }
  }
</style>
