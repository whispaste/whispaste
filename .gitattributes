# Default: treat all files as text and normalize to LF on commit and in the
# working tree on every platform. Windows-only scripts override this below.
* text=auto eol=lf

# Binary formats — never normalize
*.ico binary
*.wav binary
*.png binary
*.exe binary
*.bmp binary
*.dll binary
*.pdb binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.mp4 binary
*.pdf binary
*.zip binary
*.gz binary

# Windows-only scripts — must stay CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# GeneratedPluginRegistrant.swift is regenerated by `flutter pub get`/
# `flutter analyze`/`flutter test` on every run, which drops the hand-added
# `#if !MAS_BUILD` guard around AutoUpdaterMacosPlugin.register(...) (see
# macos/patch_plugin_registrant_guard.py for why that guard is load-bearing,
# not cosmetic). The Xcode build phase and the pre-commit hook already heal
# the file on disk at build/commit time; this `clean` filter additionally
# normalizes it for every `git status`/`git diff`/`git add` in between, so
# an unguarded on-disk file (the routine post-`flutter analyze` state) never
# shows as a phantom uncommitted change. Filter itself is configured by
# .githooks/pre-commit (self-installing, see its header) since git filter
# commands can't be declared in .gitattributes.
macos/Flutter/GeneratedPluginRegistrant.swift filter=mas-guard
