# Secrets
.env
.env.local
.mcp.json

# Code-Signing-Geheimnisse — NIEMALS ins Repo (defense-in-depth, falls je
# versehentlich hierher kopiert). Das stabile Selbst-Signatur-Zertifikat lebt
# außerhalb des Repos unter ~/.config/whispaste-signing/ und als GitHub-Secret.
*.p12
*.keychain-db
*.keychain
identity.p12
key.pem
whispaste-signing/

# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
build/
.build/

# DevTools extension state (machine-local, created by Dart/Flutter MCP + DevTools connections)
devtools_options.yaml

# Binaries
*.exe
*.exe~
*.exe.old
*.dll
*.so
*.dylib
# Vendored WinSparkle 0.9.3 runtime DLLs (auto_updater_windows fork) —
# intentional binary commit, provenance + SHA-256 in WinSparkle-0.9.3/PROVENANCE.md
!packages/auto_updater_windows/windows/WinSparkle-0.9.3/**/*.dll

# IDE
.idea/
.vscode/
!.vscode/launch.json.example
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Node
node_modules/

# Astro (website)
website/dist/
website/.astro/

# Supabase
supabase/.temp/

# Fastlane (auto-generated on every run — Gemfile.lock itself IS tracked)
fastlane/report.xml
fastlane/README.md
fastlane/Preview.html
# cert/sigh artifacts: public certs + CSRs (not private keys, those stay in
# the keychain) and provisioning profiles — regenerable via
# `fastlane cert`/`fastlane sigh`, not repo content.
fastlane/*.cer
fastlane/*.certSigningRequest
fastlane/*.provisionprofile

