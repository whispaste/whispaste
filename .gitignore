# Screenshots (local output only — golden test sources are tracked)
# Leading slash anchors to repo root, so website/public/screenshots/ is NOT ignored
/screenshots/
!test/screenshots/
test/screenshots/failures/

# flutter_test golden-mismatch diff artifacts (isolatedDiff/maskedDiff/
# masterImage/testImage quadruplets) — can land in a `failures/` dir under
# ANY golden test's own directory, not just test/screenshots/ (see above).
**/failures/

# Store screenshot tool output (generated, not tracked)
tools/appstore-screens/output/
# Store icon generator output (generated, not tracked)
tools/store-icons/output/
