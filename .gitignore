# ┌─────────────────────────────────────────────────────────────────────┐
# │  PROTECTED PATHS — DO NOT MODIFY THIS SECTION                      │
# │  These entries protect internal files from being pushed to GitHub.  │
# │  The pre-commit hook enforces this section cannot be weakened.      │
# │  Any change to lines between PROTECTED-START and PROTECTED-END     │
# │  will be rejected by the hook.                                     │
# ├─────────────────────────────────────────────────────────────────────┤
# │  PROTECTED-START                                                    │
# ├─────────────────────────────────────────────────────────────────────┤

# Internal files — blanket ignore (NEVER track contents)
.internal/
docs/

# AI agent / skill config (local only)
skills-lock.json
skills.yaml
.github/copilot-instructions.md
.skills/
.agent/
.agents/
.claude/

# Internal dev tools (local only)
cmd/
scripts/*
!scripts/git-hooks/
!scripts/generate-release-notes.ps1
!scripts/security-scan.ps1
!scripts/store-screenshots.py
!scripts/capture-store-screenshots.py
!scripts/premium-screenshots.py

# Internal website files
website/design-system/
website/SEARCH-CONSOLE-SETUP.md
website/test-results/
wack-report.xml

# ├─────────────────────────────────────────────────────────────────────┤
# │  PROTECTED-END                                                      │
# └─────────────────────────────────────────────────────────────────────┘

# Screenshots (local output only — golden test sources are tracked)
screenshots/
!test/screenshots/
test/screenshots/failures/

# Sentry native build artifacts
.sentry-native/

# Temporary files
tmp_funcs.sql

# Design source files
*.afdesign
